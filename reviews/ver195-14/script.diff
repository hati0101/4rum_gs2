+    endloop
+    call TriggerAddAction(chat,function GS19514_BurnChat)
+    call TimerStart(GS19514_BurnClock,1.0,true,function GS19514_BurnTick)
+    call TimerStart(CreateTimer(),0.0,false,function GS19514_BurnBootstrap)
+    set enter = null
+    set hero = null
+    set sold = null
+    set chat = null
+    set area = null
+endfunction
