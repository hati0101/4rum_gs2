+        call TriggerClearActions(gg_trg_FlB_Special_1)
+        call TriggerAddAction(gg_trg_FlB_Special_1,function GS19514_BurnResearch)
+    endif
+    set scan = null
+    set u = null
+endfunction
+function GS19514_BurnInit takes nothing returns nothing
