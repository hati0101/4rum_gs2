 // Sashint restoration test. Hero, skills, buffs and research IDs are isolated.
+function GS144_BootFinish takes timer t, unit u returns nothing
+    local integer key = GetHandleId(t)
+    local integer uid = GetHandleId(u)
+    if u != null and LoadTimerHandle(GS144_Data,uid,2) == t then
+        if LoadBoolean(GS144_Data,uid,5) then
+            call UnitRemoveAbility(u,'SW44')
+                call UnitRemoveAbility(u,'BW45')
+        endif
+        call FlushChildHashtable(GS144_Data,uid)
+    endif
+    call FlushChildHashtable(GS144_Data,key)
+    call PauseTimer(t)
+    call DestroyTimer(t)
+endfunction
+
+function GS144_BootTick takes nothing returns nothing
+    local timer t = GetExpiredTimer()
+    local unit u = LoadUnitHandle(GS144_Data,GetHandleId(t),0)
+    local integer uid = GetHandleId(u)
+    local real now = TimerGetElapsed(GS144_Clock)
+    local boolean ended = false
+    if u == null or GetUnitTypeId(u) == 0 or GetWidgetLife(u) <= 0.405 or LoadTimerHandle(GS144_Data,uid,2) != t then
+        call GS144_BootFinish(t,u)
+    else
+        if GetUnitAbilityLevel(u,'BW44') > 0 then
+            call SaveBoolean(GS144_Data,uid,6,true)
+        endif
+        set ended = now >= LoadReal(GS144_Data,uid,1) or LoadBoolean(GS144_Data,uid,7)
+        if LoadBoolean(GS144_Data,uid,6) and GetUnitAbilityLevel(u,'BW44') == 0 then
+            set ended = true
+        endif
+        // Fail closed if the native item failed to apply its invisibility buff.
+        if now >= LoadReal(GS144_Data,uid,8)+0.50 and not LoadBoolean(GS144_Data,uid,6) then
+            set ended = true
+        endif
+        if ended then
+            call SaveBoolean(GS144_Data,uid,7,true)
+            call SaveBoolean(GS144_Data,uid,0,false)
+            if LoadBoolean(GS144_Data,uid,5) then
+                call UnitRemoveAbility(u,'SW44')
+                call UnitRemoveAbility(u,'BW45')
+                call SaveBoolean(GS144_Data,uid,5,false)
+            endif
+            if not HaveSavedHandle(GS144_Data,uid,3) or now > LoadReal(GS144_Data,uid,4) then
+                call GS144_BootFinish(t,u)
+            endif
+        endif
+    endif
+    set u = null
+    set t = null
+endfunction
+
+function GS144_BootUse takes nothing returns nothing
+    local unit u = GetTriggerUnit()
+    local integer uid = GetHandleId(u)
+    local timer t
+    local real now
+    if GetItemTypeId(GetManipulatedItem()) != 'I01G' then
+        set u = null
+        return
+    endif
+    set t = LoadTimerHandle(GS144_Data,uid,2)
+    if t != null then
+        call GS144_BootFinish(t,u)
+    endif
+    set now = TimerGetElapsed(GS144_Clock)
+    set t = CreateTimer()
+    call SaveUnitHandle(GS144_Data,GetHandleId(t),0,u)
+    call SaveTimerHandle(GS144_Data,uid,2,t)
+    call SaveBoolean(GS144_Data,uid,0,true)
+    call SaveReal(GS144_Data,uid,1,now+7.00)
+    call SaveReal(GS144_Data,uid,8,now)
+    call UnitAddAbility(u,'SW44')
+    call BlzUnitHideAbility(u,'SW44',true)
+    call SaveBoolean(GS144_Data,uid,5,true)
+    call TimerStart(t,0.05,true,function GS144_BootTick)
+    set t = null
+    set u = null
+endfunction
+
+function GS144_BootAttack takes nothing returns nothing
+    local unit u = GetAttacker()
+    local integer uid = GetHandleId(u)
+    local real now = TimerGetElapsed(GS144_Clock)
+    if LoadBoolean(GS144_Data,uid,0) and now <= LoadReal(GS144_Data,uid,1) and not LoadBoolean(GS144_Data,uid,7) then
+        call SaveBoolean(GS144_Data,uid,0,false)
+        call SaveBoolean(GS144_Data,uid,7,true)
+        call SaveUnitHandle(GS144_Data,uid,3,GetTriggerUnit())
+        // Preserve one committed ranged attack after invisibility ends.
+        call SaveReal(GS144_Data,uid,4,now+3.00)
+    endif
+    set u = null
+endfunction
+
+function GS144_BootDamage takes nothing returns nothing
+    local unit u = GetEventDamageSource()
+    local integer uid = GetHandleId(u)
+    if BlzGetEventIsAttack() and GetEventDamage() > 0.00 and LoadUnitHandle(GS144_Data,uid,3) == GetTriggerUnit() and TimerGetElapsed(GS144_Clock) <= LoadReal(GS144_Data,uid,4) then
+        call RemoveSavedHandle(GS144_Data,uid,3)
+        call BlzSetEventDamage(GetEventDamage()+100.00)
+    endif
+    set u = null
+endfunction
+
+function GS144_Init takes nothing returns nothing
+    local trigger t = CreateTrigger()
+    local integer i = 0
+    set GS144_Data = InitHashtable()
+    set GS144_Clock = CreateTimer()
+    call TimerStart(GS144_Clock,1000000000.00,false,null)
+    call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_USE_ITEM)
+    call TriggerAddAction(t,function GS144_BootUse)
+    set t = CreateTrigger()
+    call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_ATTACKED)
+    call TriggerAddAction(t,function GS144_BootAttack)
+    set t = CreateTrigger()
+    loop
+        exitwhen i >= bj_MAX_PLAYER_SLOTS
+        call TriggerRegisterPlayerUnitEvent(t,Player(i),EVENT_PLAYER_UNIT_DAMAGING,null)
+        set i = i+1
+    endloop
+    call TriggerAddAction(t,function GS144_BootDamage)
+    set t = null
+endfunction
