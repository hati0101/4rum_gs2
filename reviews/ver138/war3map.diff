+function GSRI_Snapshot takes unit u returns nothing
+    local integer sid = GetHandleId(u)
+    local integer i = 0
+    local integer count = 0
+    local integer id
+    local integer lv
+    local integer offset
+    local integer profile
+    local integer lengthField
+    local integer endField
+    local ability a
+    local real range
+    call FlushChildHashtable(GSRI_Cache, sid)
+    call FlushChildHashtable(GSRI_CacheIndex, sid)
+    loop
+        set a = BlzGetUnitAbilityByIndex(u, i)
+        exitwhen a == null
+        set id = BlzGetAbilityId(a)
+        if LoadInteger(GSRI_Data, id, 1) != 0 and not HaveSavedInteger(GSRI_CacheIndex, sid, id) then
+            set offset = 1 + count*10
+            set lv = GetUnitAbilityLevel(u, id)-1
+            call SaveInteger(GSRI_CacheIndex, sid, id, offset)
+            call SaveInteger(GSRI_Cache, sid, offset, id)
+            call SaveInteger(GSRI_Cache, sid, offset+1, lv)
+            call SaveInteger(GSRI_Cache, sid, offset+2, BlzGetAbilityIntegerField(a, ABILITY_IF_BUTTON_POSITION_NORMAL_X))
+            call SaveInteger(GSRI_Cache, sid, offset+3, BlzGetAbilityIntegerField(a, ABILITY_IF_BUTTON_POSITION_NORMAL_Y))
+            if lv >= 0 then
+                set range = BlzGetAbilityRealLevelField(a, ABILITY_RLF_CAST_RANGE, lv)
+                set profile = LoadInteger(GSRI_Data, id, 2)
+                if profile == 4 then
+                    set range = BlzGetAbilityRealLevelField(a, ConvertAbilityRealLevelField('Ebl1'), lv)
+                endif
+                call SaveReal(GSRI_Cache, sid, offset+5, range)
+                // Query Channel-only fields only for Channel abilities.
+                if LoadInteger(GSRI_Data, id, 1) == 2 then
+                    call SaveInteger(GSRI_Cache, sid, offset+4, BlzGetAbilityIntegerLevelField(a, ConvertAbilityIntegerLevelField('Ncl2'), lv))
+                endif
+                call SaveReal(GSRI_Cache, sid, offset+6, BlzGetAbilityRealLevelField(a, ABILITY_RLF_AREA_OF_EFFECT, lv))
+                if profile == 3 then
+                    set lengthField = LoadInteger(GSRI_Data, id, 3)
+                    set endField = LoadInteger(GSRI_Data, id, 4)
+                    if lengthField != 0 and endField != 0 then
+                        call SaveReal(GSRI_Cache, sid, offset+7, BlzGetAbilityRealLevelField(a, ConvertAbilityRealLevelField(lengthField), lv))
+                        call SaveReal(GSRI_Cache, sid, offset+8, BlzGetAbilityRealLevelField(a, ConvertAbilityRealLevelField(endField), lv))
+                    endif
+                endif
+            endif
+            set count = count+1
+        endif
+        set i = i+1
+    endloop
+    call SaveInteger(GSRI_Cache, sid, 0, count)
+    set a = null
+endfunction
