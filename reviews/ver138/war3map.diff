+function GSRI_SnapshotTick takes nothing returns nothing
+    local integer i = 1
+    local integer sid
+    local unit u
+    loop
+        exitwhen i > 12
+        set u = udg_HeroPlayer[i]
+        set sid = GetHandleId(u)
+        if GSRI_CacheOwner[i] != sid then
+            call FlushChildHashtable(GSRI_Cache, GSRI_CacheOwner[i])
+            call FlushChildHashtable(GSRI_CacheIndex, GSRI_CacheOwner[i])
+            set GSRI_CacheOwner[i] = sid
+        endif
+        if u != null and GetUnitTypeId(u) != 0 then
+            call GSRI_Snapshot(u)
+        endif
+        set i = i+1
+    endloop
+    set u = null
 endfunction
 
