    if ( not Trig_PhM_Speical_Timer_Func004Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_PhM_Speical_Timer_Actions takes nothing returns nothing
    if ( Trig_PhM_Speical_Timer_Func001C() ) then
        call SetUnitX( udg_Hero_PhM_Spunit1, GetLocationX(PolarProjectionBJ(GetUnitLoc(udg_Hero_PhM_Ultunit), 120.00, ( GetUnitFacing(udg_Hero_PhM_Ultunit) - 180.00 ))) )
        call SetUnitY( udg_Hero_PhM_Spunit1, GetLocationY(PolarProjectionBJ(GetUnitLoc(udg_Hero_PhM_Ultunit), 120.00, ( GetUnitFacing(udg_Hero_PhM_Ultunit) - 180.00 ))) )
        call SetUnitX( udg_Hero_PhM_Spunit2, GetLocationX(PolarProjectionBJ(GetUnitLoc(udg_Hero_PhM_Ultunit), 120.00, ( GetUnitFacing(udg_Hero_PhM_Ultunit) - 140.00 ))) )
        call SetUnitY( udg_Hero_PhM_Spunit2, GetLocationY(PolarProjectionBJ(GetUnitLoc(udg_Hero_PhM_Ultunit), 120.00, ( GetUnitFacing(udg_Hero_PhM_Ultunit) - 140.00 ))) )
        call SetUnitX( udg_Hero_PhM_Spunit3, GetLocationX(PolarProjectionBJ(GetUnitLoc(udg_Hero_PhM_Ultunit), 120.00, ( GetUnitFacing(udg_Hero_PhM_Ultunit) - 220.00 ))) )
        call SetUnitY( udg_Hero_PhM_Spunit3, GetLocationY(PolarProjectionBJ(GetUnitLoc(udg_Hero_PhM_Ultunit), 120.00, ( GetUnitFacing(udg_Hero_PhM_Ultunit) - 220.00 ))) )
    else
        call SetUnitX( udg_Hero_PhM_Spunit1, GetLocationX(PolarProjectionBJ(GetUnitLoc(udg_Hero_PhM), 120.00, ( GetUnitFacing(udg_Hero_PhM) - 180.00 ))) )
        call SetUnitY( udg_Hero_PhM_Spunit1, GetLocationY(PolarProjectionBJ(GetUnitLoc(udg_Hero_PhM), 120.00, ( GetUnitFacing(udg_Hero_PhM) - 180.00 ))) )
        call SetUnitX( udg_Hero_PhM_Spunit2, GetLocationX(PolarProjectionBJ(GetUnitLoc(udg_Hero_PhM), 120.00, ( GetUnitFacing(udg_Hero_PhM) - 140.00 ))) )
        call SetUnitY( udg_Hero_PhM_Spunit2, GetLocationY(PolarProjectionBJ(GetUnitLoc(udg_Hero_PhM), 120.00, ( GetUnitFacing(udg_Hero_PhM) - 140.00 ))) )
        call SetUnitX( udg_Hero_PhM_Spunit3, GetLocationX(PolarProjectionBJ(GetUnitLoc(udg_Hero_PhM), 120.00, ( GetUnitFacing(udg_Hero_PhM) - 220.00 ))) )
        call SetUnitY( udg_Hero_PhM_Spunit3, GetLocationY(PolarProjectionBJ(GetUnitLoc(udg_Hero_PhM), 120.00, ( GetUnitFacing(udg_Hero_PhM) - 220.00 ))) )
    endif
    if ( Trig_PhM_Speical_Timer_Func002C() ) then
        call IssueImmediateOrderBJ( udg_Hero_PhM_Spunit1, "stop" )
        call IssueImmediateOrderBJ( udg_Hero_PhM_Spunit2, "stop" )
        call IssueImmediateOrderBJ( udg_Hero_PhM_Spunit3, "stop" )
    else
    endif
    if ( Trig_PhM_Speical_Timer_Func003C() ) then
        call SetUnitFacingToFaceUnitTimed( udg_Hero_PhM_Spunit1, udg_Hero_PhM, 0.20 )
        call SetUnitFacingToFaceUnitTimed( udg_Hero_PhM_Spunit2, udg_Hero_PhM, 0.20 )
        call SetUnitFacingToFaceUnitTimed( udg_Hero_PhM_Spunit3, udg_Hero_PhM, 0.20 )
    else
    endif
    if ( Trig_PhM_Speical_Timer_Func004C() ) then
        call KillUnit( udg_Hero_PhM_Spunit1 )
        call KillUnit( udg_Hero_PhM_Spunit2 )
        call KillUnit( udg_Hero_PhM_Spunit3 )
        call PauseTimerBJ( true, udg_Hero_PhM_SpTimer )
    else
    endif
endfunction

