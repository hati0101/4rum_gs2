//===========================================================================
// Trigger: FireM Damage
//===========================================================================
function Trig_FireM_Damage_Conditions takes nothing returns boolean
    if ( not ( GetEventDamage() > 10.00 ) ) then
        return false
    endif
    if ( not ( GetEventDamageSource() != udg_Hero_LOI_FireMastery ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(GetTriggerUnit(), GetOwningPlayer(udg_Hero_LOI_Hero)) == true ) ) then
        return false
    endif
    if ( not ( udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetEventDamageSource()))] == udg_Hero_LOI_Hero ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEventDamageSource()) != 'u00B' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEventDamageSource()) != 'n02T' ) ) then
        return false
    endif
    return true
endfunction

function Trig_FireM_Damage_Func014Func003C takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_MAGIC_IMMUNE) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_FireM_Damage_Func014C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetTriggerUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_FireM_Damage_Actions takes nothing returns nothing
    local integer i = 0
    local effect e
    call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "Abilities\\Spells\\Other\\BreathOfFire\\BreathOfFireDamage.mdl" )
    set e = GetLastCreatedEffectBJ()
    loop
    set i = i + 1
    call TriggerSleepAction( 0.90 )
    if ( Trig_FireM_Damage_Func014C() ) then
        if ( Trig_FireM_Damage_Func014Func003C() ) then
            set i = 5
        else
            if IsUnitInvulnerable(GetTriggerUnit()) then
            set i = 5
            endif
            if ( not ( IsUnitInvulnerable(GetTriggerUnit()) ) ) then
            call UnitDamageTargetBJ( udg_Hero_LOI_FireMastery, GetTriggerUnit(), ( GetEventDamage() * ( 0.03 + ( 0.01 * I2R(GetUnitAbilityLevelSwapped('A0WM', udg_Hero_LOI_Hero)) ) ) ), ATTACK_TYPE_HERO, DAMAGE_TYPE_UNIVERSAL )
            endif
        endif
    else
        set i = 5
    endif
    exitwhen i >= 5
    endloop
    call DestroyEffectBJ( e )
    set e = null
endfunction

//===========================================================================
function InitTrig_FireM_Damage takes nothing returns nothing
    set gg_trg_FireM_Damage = CreateTrigger(  )
    call DisableTrigger( gg_trg_FireM_Damage )
    call TriggerAddCondition( gg_trg_FireM_Damage, Condition( function Trig_FireM_Damage_Conditions ) )
    call TriggerAddAction( gg_trg_FireM_Damage, function Trig_FireM_Damage_Actions )
endfunction

