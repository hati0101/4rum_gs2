    set gg_trg_Moon_Strike_Execute = CreateTrigger(  )
    call DisableTrigger( gg_trg_Moon_Strike_Execute )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Moon_Strike_Execute, udg_Hero_MoW_UltiTimer )
