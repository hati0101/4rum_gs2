endfunction

//===========================================================================
// Trigger: Gungsin
//===========================================================================
function Trig_Gungsin_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0EX' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Gungsin_Func005Func005C takes nothing returns boolean
    if ( not ( RAbsBJ(( ModuloReal(( ( AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(udg_Hero_Mon_GungTarget)) - GetUnitFacing(udg_Hero_Mon_GungTarget) ) + 540.00 ), 360.00) - 180.00 )) <= 90.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Gungsin_Func005C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R07R', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Gungsin_Func006C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(udg_Hero_Mon_GungTarget)) <= 1500.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Gungsin_Actions takes nothing returns nothing
    set udg_Hero_Mon_GungTarget = GetSpellTargetUnit()
    call AddSpecialEffectLocBJ( GetUnitLoc(GetTriggerUnit()), "Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl" )
    call d_effect(GetLastCreatedEffectBJ(),0.7)
    call PolledWait( 0.10 )
    if ( Trig_Gungsin_Func005C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(udg_Hero_Mon_GungTarget), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A05H', GetLastCreatedUnit() )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "thunderbolt", udg_Hero_Mon_GungTarget )
        if ( Trig_Gungsin_Func005Func005C() ) then
            call UnitDamageTargetBJ( GetTriggerUnit(), udg_Hero_Mon_GungTarget, ( 30.00 + ( 15.00 * I2R(GetUnitAbilityLevelSwapped('A0EX', GetTriggerUnit())) ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
            call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_Mon_GungTarget), "Abilities\\Spells\\Orc\\FeralSpirit\\feralspiritdone.mdl" )
            call d_effect(GetLastCreatedEffectBJ(),0.7)
        else
        endif
    else
    endif
    if ( Trig_Gungsin_Func006C() ) then
        call SetUnitPositionLoc( GetTriggerUnit(), PolarProjectionBJ(GetUnitLoc(udg_Hero_Mon_GungTarget), 125.00, GetUnitFacing(udg_Hero_Mon_GungTarget)) )
        call IssueTargetOrderBJ( GetTriggerUnit(), "attack", udg_Hero_Mon_GungTarget )
    else
    endif
endfunction

