    call SetUnitLifeBJ( LoadUnitHandleBJ(StringHashBJ("AbW"), StringHashBJ("Hero"), GetLastCreatedHashtableBJ()), ( GetUnitStateSwap(UNIT_STATE_LIFE, LoadUnitHandleBJ(StringHashBJ("AbW"), StringHashBJ("Hero"), GetLastCreatedHashtableBJ())) + ( 30 + ( I2R(GetUnitAbilityLevelSwapped('A0KZ', LoadUnitHandleBJ(StringHashBJ("AbW"), StringHashBJ("Hero"), GetLastCreatedHashtableBJ()))) * 30.00 ) ) ) )
