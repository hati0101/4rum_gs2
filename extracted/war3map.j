//===========================================================================
// Trigger: Fighters Coin
//===========================================================================
function Trig_Fighters_Coin_Conditions takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))], 'prvt') == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(GetDyingUnit(), GetOwningPlayer(udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))])) == true ) ) then
        return false
    endif
    if ( not ( udg_MBDeaths[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))]] < 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fighters_Coin_Func001Func003Func003001002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == true )
endfunction

function Trig_Fighters_Coin_Func001Func003Func003A takes nothing returns nothing
    call AddSpecialEffectLocBJ( GetUnitLoc(GetEnumUnit()), "Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call CreateTextTagUnitBJ( ( "+" + I2S(( 120 - ( 20 * udg_MBDeaths[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))]] ) )) ), GetEnumUnit(), -5.00, 11.00, 100.00, 100.00, 0.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 50.00, 90.00 )
    call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
    call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 2.00 )
    call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 1.50 )
endfunction

function Trig_Fighters_Coin_Func001Func004Func003001002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == true )
endfunction

function Trig_Fighters_Coin_Func001Func004Func003A takes nothing returns nothing
    call AddSpecialEffectLocBJ( GetUnitLoc(GetEnumUnit()), "Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call CreateTextTagUnitBJ( ( "+" + I2S(( 120 - ( 20 * udg_MBDeaths[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))]] ) )) ), GetEnumUnit(), -5.00, 11.00, 100.00, 100.00, 0.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 50.00, 90.00 )
    call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
    call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 2.00 )
    call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 1.50 )
endfunction

function Trig_Fighters_Coin_Func001C takes nothing returns boolean
    if ( not ( IsPlayerAlly(GetOwningPlayer(GetKillingUnitBJ()), udg_Force[1]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fighters_Coin_Actions takes nothing returns nothing
    if ( Trig_Fighters_Coin_Func001C() ) then
        call PlaySoundBJ( gg_snd_FightersCoinGD )
        set bj_forLoopAIndex = 2
        set bj_forLoopAIndexEnd = 6
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call AdjustPlayerStateBJ( ( 120 - ( 20 * udg_MBDeaths[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))]] ) ), udg_SP_Player[GetForLoopIndexA()], PLAYER_STATE_RESOURCE_GOLD )
            set bj_wantDestroyGroup=true
            call ForGroupBJ( GetUnitsOfPlayerMatching(udg_SP_Player[GetForLoopIndexA()], Condition(function Trig_Fighters_Coin_Func001Func004Func003001002)), function Trig_Fighters_Coin_Func001Func004Func003A )
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
    else
        call PlaySoundBJ( gg_snd_FightersCoinDS )
        set bj_forLoopAIndex = 8
        set bj_forLoopAIndexEnd = 12
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call AdjustPlayerStateBJ( ( 120 - ( 20 * udg_MBDeaths[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))]] ) ), udg_SP_Player[GetForLoopIndexA()], PLAYER_STATE_RESOURCE_GOLD )
            set bj_wantDestroyGroup=true
            call ForGroupBJ( GetUnitsOfPlayerMatching(udg_SP_Player[GetForLoopIndexA()], Condition(function Trig_Fighters_Coin_Func001Func003Func003001002)), function Trig_Fighters_Coin_Func001Func003Func003A )
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
    endif
endfunction

