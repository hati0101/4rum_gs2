//===========================================================================
// Trigger: DaS Attack Damage
//===========================================================================
function Trig_DaS_Attack_Damage_Conditions takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_Hero_DaS_AtkTarget ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) != true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_MECHANICAL) != true ) ) then
        return false
    endif
    if ( not ( IsUnitIllusionBJ(GetEventDamageSource()) != true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEventDamageSource()) == 'Uvng' ) ) then
        return false
    endif
    if ( not ( GetEventDamage() > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DaS_Attack_Damage_Func014C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R02H', GetOwningPlayer(udg_Hero_DaS)) == 1 ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) <= ( I2R(( 50 * GetUnitAbilityLevelSwapped('A0LX', udg_Hero_DaS) )) + 100.00 ) ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_DaS_Attack_Damage_Actions takes nothing returns nothing
    local real dmg = GetEventDamage()
    set udg_Hero_DaS_AtkTarget = null
    if udg_Hero_DaS_AvengeBool then
    set udg_Hero_DaS_AvengeBool = false
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetEventDamageSource()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
    call UnitDamageTargetBJ( GetLastCreatedUnit(), GetTriggerUnit(), ( dmg ), ATTACK_TYPE_HERO, DAMAGE_TYPE_UNIVERSAL )
    call CreateTextTagLocBJ( ( I2S(R2I(( dmg ))) + "!" ), GetUnitLoc(GetTriggerUnit()), 0, 10.00, 80, 0.00, 0.00, 0 )
    call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
    call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 1.00 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 65.00, 90 )
    call DestroyEffectBJ( udg_Hero_DaS_AvengeAtkEff )
    set udg_Hero_DaS_AvengeAtkEff = null
    endif
    if ( Trig_DaS_Attack_Damage_Func014C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetEventDamageSource()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 0.50, 'BTLF', GetLastCreatedUnit() )
        call UnitDamageTargetBJ( GetLastCreatedUnit(), GetTriggerUnit(), 30.00, ATTACK_TYPE_HERO, DAMAGE_TYPE_UNIVERSAL )
        call AddSpecialEffectTargetUnitBJ( "head", GetTriggerUnit(), "Abilities\\Weapons\\VengeanceMissile\\VengeanceMissile.mdl" )
        call d_effect(GetLastCreatedEffectBJ(),0.2)
    else
    endif
endfunction

//===========================================================================
function InitTrig_DaS_Attack_Damage takes nothing returns nothing
    set gg_trg_DaS_Attack_Damage = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_DaS_Attack_Damage, Condition( function Trig_DaS_Attack_Damage_Conditions ) )
    call TriggerAddAction( gg_trg_DaS_Attack_Damage, function Trig_DaS_Attack_Damage_Actions )
endfunction


