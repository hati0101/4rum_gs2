//===========================================================================
// Trigger: TrB Special 2
//===========================================================================
function Trig_TrB_Special_2_Conditions takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R08W', GetOwningPlayer(GetAttacker())) >= 1 ) ) then
        return false
    endif
    if ( not ( GetAttacker() == udg_Hero_TrB ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetAttackedUnitBJ()) <= ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetAttackedUnitBJ()) * 0.33 ) ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetAttackedUnitBJ(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(GetAttackedUnitBJ(), GetOwningPlayer(udg_Hero_TrB)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrB_Special_2_Actions takes nothing returns nothing
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetAttacker()), GetUnitLoc(GetAttacker()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0JW', GetLastCreatedUnit() )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "ensnare", GetAttackedUnitBJ() )
    call TextTag( "허약한 사냥감이군...!" , udg_Hero_TrB , 9 , 200 , 0 , 0, 3 )
    call DisableTrigger( GetTriggeringTrigger() )
    call TriggerSleepAction( 8.00 )
    call EnableTrigger( GetTriggeringTrigger() )
endfunction

//===========================================================================
function InitTrig_TrB_Special_2 takes nothing returns nothing
    set gg_trg_TrB_Special_2 = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_TrB_Special_2, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_TrB_Special_2, Condition( function Trig_TrB_Special_2_Conditions ) )
    call TriggerAddAction( gg_trg_TrB_Special_2, function Trig_TrB_Special_2_Actions )
endfunction

