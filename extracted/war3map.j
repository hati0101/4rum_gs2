    set gg_trg_Wound_Slasher = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Wound_Slasher, Condition( function Trig_Wound_Slasher_Conditions ) )
    call TriggerAddAction( gg_trg_Wound_Slasher, function Trig_Wound_Slasher_Actions )
