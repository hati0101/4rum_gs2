//===========================================================================
// Trigger: Ban
//===========================================================================
function Trig_Ban_Conditions takes nothing returns boolean
    if ( not ( SubStringBJ(GetEventPlayerChatString(), 1, 4) == "-밴" ) ) then
        return false
    endif
    if ( not ( TimerGetElapsed(udg_MBTime) <= 14.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ban_Func003Func001C takes nothing returns boolean
    if ( not ( SubStringBJ(GetEventPlayerChatString(), 6, StringLength(GetEventPlayerChatString())) == SubStringBJ(udg_HeroName[GetForLoopIndexA()], 1, ( StringLength(GetEventPlayerChatString()) - 5 )) ) ) then
        return false
    endif
    if ( not ( udg_Hero[GetForLoopIndexA()] != 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ban_Actions takes nothing returns nothing
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = udg_HeroMax[3]
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Ban_Func003Func001C() ) then
            set udg_League_Ban = ( udg_League_Ban + ( "  " + udg_HeroName[GetForLoopIndexA()] ) )
            set bj_forLoopBIndex = 1
            set bj_forLoopBIndexEnd = 12
            loop
                exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
                call SetPlayerUnitAvailableBJ( udg_Hero[GetForLoopIndexA()], false, ConvertedPlayer(GetForLoopIndexB()) )
                set bj_forLoopBIndex = bj_forLoopBIndex + 1
            endloop
            set udg_Hero[GetForLoopIndexA()] = 0
            set udg_RandHero[GetForLoopIndexA()] = true
            call DisplayTimedTextToForce( GetPlayersAll(), 30.00, ( "|cffffcc00" + ( udg_HeroName[GetForLoopIndexA()] + "|r을(를) 밴 하였습니다." ) ) )
            return
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call DisplayTextToForce( GetForceOfPlayer(GetTriggerPlayer()), "TRIGSTR_1703" )
endfunction

//===========================================================================
function InitTrig_Ban takes nothing returns nothing
    set gg_trg_Ban = CreateTrigger(  )
    call TriggerRegisterPlayerChatEvent( gg_trg_Ban, Player(1), "-밴 ", false )
    call TriggerAddCondition( gg_trg_Ban, Condition( function Trig_Ban_Conditions ) )
    call TriggerAddAction( gg_trg_Ban, function Trig_Ban_Actions )
endfunction

