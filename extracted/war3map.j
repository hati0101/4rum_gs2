    if ( Trig_Named_Creep_Killing_RoRo_Func004C() ) then
        call DisplayTimedTextToForce( GetPlayersAll(), 3.00, "TRIGSTR_1466" )
        set bj_forLoopAIndex = 8
        set bj_forLoopAIndexEnd = 12
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call ForGroupBJ( GetUnitsOfPlayerMatching(udg_SP_Player[GetForLoopIndexA()], Condition(function Trig_Named_Creep_Killing_RoRo_Func004Func004Func001001002)), function Trig_Named_Creep_Killing_RoRo_Func004Func004Func001A )
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
    else
        call DisplayTimedTextToForce( GetPlayersAll(), 3.00, "TRIGSTR_1464" )
        set bj_forLoopAIndex = 2
        set bj_forLoopAIndexEnd = 6
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call ForGroupBJ( GetUnitsOfPlayerMatching(udg_SP_Player[GetForLoopIndexA()], Condition(function Trig_Named_Creep_Killing_RoRo_Func004Func002Func001001002)), function Trig_Named_Creep_Killing_RoRo_Func004Func002Func001A )
