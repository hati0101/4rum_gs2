    call PauseUnitBJ( false, GetEnumUnit() )
    call AddSpecialEffectLocBJ( GetUnitLoc(GetEnumUnit()), "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl" )
    call SetUnitPositionLoc( GetEnumUnit(), udg_Hero_DiK_UltiPoint )
    call d_effect(GetLastCreatedEffectBJ(),1)
    call DestroyEffectBJ( LoadEffectHandleBJ(GetHandleIdBJ(GetEnumUnit()), StringHashBJ("MassEff"), GetLastCreatedHashtableBJ()) )
endfunction

function Trig_Mass_Teleport_Move_Actions takes nothing returns nothing
    if ( Trig_Mass_Teleport_Move_Func001C() ) then
        call SetUnitPositionLoc( GetTriggerUnit(), GetUnitLoc(udg_Hero_Dik_UltiTarget) )
        set udg_Hero_DiK_UltiPoint = GetUnitLoc(udg_Hero_Dik_UltiTarget)
    else
    endif
    if ( Trig_Mass_Teleport_Move_Func002C() ) then
        call SetUnitPositionLoc( GetTriggerUnit(), udg_Hero_DiK_UltiPoint )
    else
    endif
    call ForGroupBJ( udg_Hero_DiK_UltiGroup, function Trig_Mass_Teleport_Move_Func004A )
    set udg_Hero_DiK_Ultion = false
    set udg_Hero_Dik_UltiTarget = null
endfunction

