//===========================================================================
// Trigger: Power of Guts
//===========================================================================
function Trig_Power_of_Guts_Conditions takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_Hero_OgL ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A03U', GetTriggerUnit()) > 0 ) ) then
        return false
    endif
    if ( not ( GetUnitLifePercent(GetTriggerUnit()) < 50.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Power_of_Guts_Actions takes nothing returns nothing
    local unit u
    call DisableTrigger( GetTriggeringTrigger() )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call UnitAddAbilityBJ( 'A0SH', GetLastCreatedUnit() )
    set u = GetLastCreatedUnit()
    loop
    exitwhen GetUnitLifePercent(udg_Hero_OgL) >= 50.00 
    call PolledWait( 1.00 )
    endloop
    call RemoveUnit( u )
    call PolledWait( 0.10 )
    call UnitRemoveBuffBJ( 'B099', udg_Hero_OgL )
    call EnableTrigger( GetTriggeringTrigger() )
endfunction

//===========================================================================
function InitTrig_Power_of_Guts takes nothing returns nothing
    set gg_trg_Power_of_Guts = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Power_of_Guts, Condition( function Trig_Power_of_Guts_Conditions ) )
    call TriggerAddAction( gg_trg_Power_of_Guts, function Trig_Power_of_Guts_Actions )
endfunction

