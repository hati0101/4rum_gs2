    if ( not ( GetTriggerUnit() == udg_Hero_ReM_Meca ) ) then
        return false
    endif
    return true
endfunction

function Trig_Satellite_Launcher_Boom_Func003Func002A takes nothing returns nothing
    call KillDestructable( GetEnumDestructable() )
endfunction

function Trig_Satellite_Launcher_Boom_Func003Func008001003 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetTriggerPlayer()) == true )
endfunction

function Trig_Satellite_Launcher_Boom_Func003Func008A takes nothing returns nothing
    call UnitDamageTargetBJ( GetTriggerUnit(), GetEnumUnit(), 5000.00, ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
endfunction

function Trig_Satellite_Launcher_Boom_Func003Func009A takes nothing returns nothing
    call KillDestructable( GetEnumDestructable() )
endfunction

function Trig_Satellite_Launcher_Boom_Func003C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'n01P' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Satellite_Launcher_Boom_Actions takes nothing returns nothing
    if ( Trig_Satellite_Launcher_Boom_Func001C() ) then
        call UnitRemoveAbilityBJ( 'A00L', udg_Hero_LeT )
        call SetPlayerAbilityAvailableBJ( true, 'A144', GetOwningPlayer(udg_Hero_LeT) )
        return
    else
    endif
    if ( Trig_Satellite_Launcher_Boom_Func003C() ) then
        call EnumDestructablesInRectAll( RectFromCenterSizeBJ(GetUnitLoc(GetDyingUnit()), 4000.00, 4000.00), function Trig_Satellite_Launcher_Boom_Func003Func002A )
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetDyingUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0D1', GetLastCreatedUnit() )
        call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
        call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
        call ForGroupBJ( GetUnitsInRangeOfLocMatching(4000.00, GetUnitLoc(GetDyingUnit()), Condition(function Trig_Satellite_Launcher_Boom_Func003Func008001003)), function Trig_Satellite_Launcher_Boom_Func003Func008A )
    else
        call EnumDestructablesInRectAll( RectFromCenterSizeBJ(GetUnitLoc(GetDyingUnit()), 500.00, 500.00), function Trig_Satellite_Launcher_Boom_Func003Func009A )
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetDyingUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0YS', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0YS', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A144', udg_Hero_LeT) )
        call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetDyingUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A14B', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A14B', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A144', udg_Hero_LeT) )
        call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
    endif
endfunction

