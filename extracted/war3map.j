    call UnitApplyTimedLifeBJ( ( 2.50 + ( 0.50 * I2R(GetUnitAbilityLevelSwapped('A03A', GetTriggerUnit())) ) ), 'BTLF', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0FT', GetLastCreatedUnit(), ( GetUnitAbilityLevelSwapped('A03A', GetTriggerUnit()) + ( 4 * GetPlayerTechCountSimple('R006', GetOwningPlayer(GetTriggerUnit())) ) ) )
    call SetUnitAbilityLevelSwapped( 'A0P4', GetLastCreatedUnit(), ( GetUnitAbilityLevelSwapped('A03A', GetTriggerUnit()) + ( 4 * GetPlayerTechCountSimple('R006', GetOwningPlayer(GetTriggerUnit())) ) ) )
endfunction

