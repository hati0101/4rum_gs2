//===========================================================================
// Trigger: Doom Lord Skill Effect
//
// 업그레이드 레벨 구문은 General 폴더의 Hi Special Point과 Special Point
//===========================================================================
function Trig_Doom_Lord_Skill_Effect_Func004C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A0IQ' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0I5' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A02M' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Doom_Lord_Skill_Effect_Conditions takes nothing returns boolean
    if ( not Trig_Doom_Lord_Skill_Effect_Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_Doom_Lord_Skill_Effect_Func002Func001001002002001 takes nothing returns boolean
    return ( UnitHasBuffBJ(GetFilterUnit(), 'B0B3') == true )
endfunction

function Trig_Doom_Lord_Skill_Effect_Func002Func001001002002002 takes nothing returns boolean
    return ( IsUnitOwnedByPlayer(GetFilterUnit(), GetOwningPlayer(GetTriggerUnit())) == true )
endfunction

function Trig_Doom_Lord_Skill_Effect_Func002Func001001002002 takes nothing returns boolean
    return GetBooleanAnd( Trig_Doom_Lord_Skill_Effect_Func002Func001001002002001(), Trig_Doom_Lord_Skill_Effect_Func002Func001001002002002() )
endfunction

function Trig_Doom_Lord_Skill_Effect_Func002Func001A takes nothing returns nothing
    call KillUnit( GetEnumUnit() )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0GD', GetLastCreatedUnit() )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "innerfire", GetTriggerUnit() )
endfunction

function Trig_Doom_Lord_Skill_Effect_Func002C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0IQ' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Doom_Lord_Skill_Effect_Func003Func006C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R01J', GetOwningPlayer(GetTriggerUnit())) > 0 ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(gg_trg_Doom_Lord_Special_2) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Doom_Lord_Skill_Effect_Func003C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A02M' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Doom_Lord_Skill_Effect_Actions takes nothing returns nothing
    local unit target = GetSpellTargetUnit()
    if ( Trig_Doom_Lord_Skill_Effect_Func002C() ) then
        call ForGroupBJ( GetRandomSubGroup(1, GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_Doom_Lord_Skill_Effect_Func002Func001001002002))), function Trig_Doom_Lord_Skill_Effect_Func002Func001A )
    else
    endif
    if ( Trig_Doom_Lord_Skill_Effect_Func003C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(target), GetUnitLoc(target), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A02J', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A02J', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A02M', GetTriggerUnit()) )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "sleep", target )
        if ( Trig_Doom_Lord_Skill_Effect_Func003Func006C() ) then
            set udg_Hero_DoL_SleepUnit = target
            call EnableTrigger( gg_trg_Doom_Lord_Special_2 )
        else
        endif
    else
    endif
endfunction

//===========================================================================
function InitTrig_Doom_Lord_Skill_Effect takes nothing returns nothing
    set gg_trg_Doom_Lord_Skill_Effect = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Doom_Lord_Skill_Effect, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Doom_Lord_Skill_Effect, Condition( function Trig_Doom_Lord_Skill_Effect_Conditions ) )
    call TriggerAddAction( gg_trg_Doom_Lord_Skill_Effect, function Trig_Doom_Lord_Skill_Effect_Actions )
endfunction

//===========================================================================
// Trigger: Doom Lord Special 1
//===========================================================================
function Trig_Doom_Lord_Special_1_Func006C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'n00J' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'u003' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'u004' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'u00B' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Doom_Lord_Special_1_Conditions takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R01E', GetOwningPlayer(GetDyingUnit())) == 1 ) ) then
        return false
    endif
    if ( not Trig_Doom_Lord_Special_1_Func006C() ) then
        return false
    endif
    return true
endfunction

function Trig_Doom_Lord_Special_1_Actions takes nothing returns nothing
    call SetUnitManaBJ( udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))], ( GetUnitStateSwap(UNIT_STATE_MANA, udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))]) + 15.00 ) )
    call SetUnitLifeBJ( udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))], ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))]) + 15.00 ) )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetDyingUnit()))], "Abilities\\Spells\\Undead\\DeathPact\\DeathPactCaster.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
endfunction

//===========================================================================
function InitTrig_Doom_Lord_Special_1 takes nothing returns nothing
    set gg_trg_Doom_Lord_Special_1 = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Doom_Lord_Special_1, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Doom_Lord_Special_1, Condition( function Trig_Doom_Lord_Special_1_Conditions ) )
    call TriggerAddAction( gg_trg_Doom_Lord_Special_1, function Trig_Doom_Lord_Special_1_Actions )
endfunction

//===========================================================================
// Trigger: Doom Lord Special 2
//===========================================================================
function Trig_Doom_Lord_Special_2_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetAttackedUnitBJ()) == 'Udea' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R01J', GetOwningPlayer(GetAttackedUnitBJ())) > 0 ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetAttacker(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_Hero_DoL_SleepUnit, 'B016') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Doom_Lord_Special_2_Actions takes nothing returns nothing
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetAttacker()), GetUnitLoc(GetAttacker()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0SO', GetLastCreatedUnit() )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "sleep", GetAttacker() )
    call TextTag( "전이되는 악몽!" , GetAttacker() , 12 , 180 , 180 , 180, 3 )
    call DisableTrigger( GetTriggeringTrigger() )
endfunction

//===========================================================================
function InitTrig_Doom_Lord_Special_2 takes nothing returns nothing
    set gg_trg_Doom_Lord_Special_2 = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Doom_Lord_Special_2, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_Doom_Lord_Special_2, Condition( function Trig_Doom_Lord_Special_2_Conditions ) )
    call TriggerAddAction( gg_trg_Doom_Lord_Special_2, function Trig_Doom_Lord_Special_2_Actions )
endfunction

//===========================================================================
// Trigger: Summoning Dradon
//===========================================================================
function Trig_Summoning_Dradon_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A02A' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Summoning_Dradon_Func002C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A02A', GetTriggerUnit()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Summoning_Dradon_Func003C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A02A', GetTriggerUnit()) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Summoning_Dradon_Func004C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A02A', GetTriggerUnit()) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Summoning_Dradon_Func022C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetTriggerUnit()) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Hero_DoL_Dragon) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Summoning_Dradon_Func023C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R0B2', GetOwningPlayer(GetTriggerUnit())) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Summoning_Dradon_Actions takes nothing returns nothing
    local integer i = 0
    if ( Trig_Summoning_Dradon_Func002C() ) then
        call CreateNUnitsAtLoc( 1, 'u005', GetTriggerPlayer(), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 200.00, GetUnitFacing(GetTriggerUnit())), GetUnitFacing(GetTriggerUnit()) )
    else
    endif
    if ( Trig_Summoning_Dradon_Func003C() ) then
        call CreateNUnitsAtLoc( 1, 'u006', GetTriggerPlayer(), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 200.00, GetUnitFacing(GetTriggerUnit())), GetUnitFacing(GetTriggerUnit()) )
    else
    endif
    if ( Trig_Summoning_Dradon_Func004C() ) then
        call CreateNUnitsAtLoc( 1, 'u007', GetTriggerPlayer(), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 200.00, GetUnitFacing(GetTriggerUnit())), GetUnitFacing(GetTriggerUnit()) )
    else
    endif
    call RemoveUnit( udg_Hero_DoL_Dragon )
    set udg_Hero_DoL = GetTriggerUnit()
    set udg_Hero_DoL_Dragon = GetLastCreatedUnit()
    set udg_Hero_DoL_DragonBoolen = false
    call PauseUnitBJ( true, GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A035', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A02A', GetTriggerUnit()) )
    loop
    call SetUnitVertexColorBJ( udg_Hero_DoL_Dragon, 100, 100, 100, ( 100 - ( i * 10.00 ) )  )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_DoL_Dragon, "war3mapImported\\BlackHole.mdx" )
    call d_effect(GetLastCreatedEffectBJ(),1)
    call PolledWait( 0.30 )
    set i = i + 1
    exitwhen i == 10
    endloop
    call UnitApplyTimedLifeBJ( 62.00, 'BTLF', udg_Hero_DoL_Dragon )
    call PauseUnitBJ( false, udg_Hero_DoL_Dragon )
    if ( Trig_Summoning_Dradon_Func022C() ) then
        call StopSoundBJ( gg_snd_Doom2, false )
        call PlaySoundAtPointBJ( gg_snd_Doom2, 50.00, GetUnitLoc(GetTriggerUnit()), 20.00 )
        set udg_Hero_DoL_DragonBoolen = true
    else
    endif
    if ( Trig_Summoning_Dradon_Func023C() ) then
        call UnitRemoveAbilityBJ( 'A035', udg_Hero_DoL_Dragon )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Summoning_Dradon takes nothing returns nothing
    set gg_trg_Summoning_Dradon = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Summoning_Dradon, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Summoning_Dradon, Condition( function Trig_Summoning_Dradon_Conditions ) )
    call TriggerAddAction( gg_trg_Summoning_Dradon, function Trig_Summoning_Dradon_Actions )
endfunction

