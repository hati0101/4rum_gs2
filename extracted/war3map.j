    set gg_trg_Summon_Treant = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Summon_Treant, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Summon_Treant, Condition( function Trig_Summon_Treant_Conditions ) )
    call TriggerAddAction( gg_trg_Summon_Treant, function Trig_Summon_Treant_Actions )
