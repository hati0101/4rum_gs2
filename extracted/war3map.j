        set udg_BlueBosuk[1] = ( udg_BlueBosuk[1] + 1 )
        call SetUnitAbilityLevelSwapped( 'A0AX', gg_unit_nfoh_0066, ( udg_BlueBosuk[1] + 1 ) )
        call SetUnitAbilityLevelSwapped( 'A0AG', gg_unit_nfoh_0066, ( udg_BlueBosuk[1] + 1 ) )
    else
        set udg_BlueBosuk[2] = ( udg_BlueBosuk[2] + 1 )
