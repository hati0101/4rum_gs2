//===========================================================================
// Trigger: Knight Charge
//===========================================================================
function Trig_Knight_Charge_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0FB' ) ) then
        return false
    endif
    return true
endfunction

function Charge_Sub takes nothing returns nothing
    local real x = 40 * CosBJ(udg_Hero_RoC_ChargeAngle) 
    local real y = 40 * SinBJ(udg_Hero_RoC_ChargeAngle) 
    local unit u = udg_Hero_RoC
    local item i = CreateItemLoc( 'texp', Location(GetUnitX(u)+x, GetUnitY(u)+y) )
    if DistanceBetweenPoints(Location(GetUnitX(u)+x, GetUnitY(u)+y),GetItemLoc(i)) < 20 then
    call SetUnitX(u,GetItemX(i))
    call SetUnitY(u,GetItemY(i))
    call SetUnitAnimation( u, "walk" )
    call SetUnitFacing( u, udg_Hero_RoC_ChargeAngle )
    set udg_Hero_RoC_ChargeLoopCount = udg_Hero_RoC_ChargeLoopCount - 1
    else
    set udg_Hero_RoC_ChargeLoopCount = 0
    endif
    call RemoveItem( i )    
    if (udg_Hero_RoC_ChargeLoopCount <= 0 ) or udg_Hero_RoC_ChargeStop then
        set udg_Hero_RoC_ChargeStop = false
        set udg_Hero_RoC_ChargeLoopCount = 0
        call DestroyTimer(GetExpiredTimer())
        call ResetUnitAnimation( u )
        call CreateNUnitsAtLoc( 1, 'e038', GetOwningPlayer(u), GetUnitLoc(u), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0XP', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0XP', GetLastCreatedUnit(), ( GetUnitAbilityLevelSwapped('A0FB', u) + ( 4 * GetPlayerTechCountSimple('R07S', GetOwningPlayer(u)) ) ) )
        call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
        call DestroyEffectBJ( udg_Hero_RoC_ChargeEff )
    endif
endfunction

function Trig_Knight_Charge_Actions takes nothing returns nothing
    local timer t = CreateTimer()
    set udg_Hero_RoC_ChargeStop = false
    set udg_Hero_RoC = GetTriggerUnit()
    set udg_Hero_RoC_ChargeAngle = AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetSpellTargetLoc())
    set udg_Hero_RoC_ChargeLoopCount = R2I(( DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetSpellTargetLoc()) / 40.00 ))
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Orc\\Shockwave\\ShockwaveMissile.mdl" )
    set udg_Hero_RoC_ChargeEff = GetLastCreatedEffectBJ()
    call TimerStart(t, 0.04, true, function Charge_Sub)
endfunction

