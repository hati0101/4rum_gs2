    set gg_trg_Charge_Unit_Move = CreateTrigger(  )
    call DisableTrigger( gg_trg_Charge_Unit_Move )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Charge_Unit_Move, 0.03 )
    call TriggerAddAction( gg_trg_Charge_Unit_Move, function Trig_Charge_Unit_Move_Actions )
