//===========================================================================
// Trigger: Stone Guard Special
//===========================================================================
function Trig_Stone_Guard_Special_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A05M' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Stone_Guard_Special_Func003C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R01L', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'ewsp' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Stone_Guard_Special_Actions takes nothing returns nothing
    local location targetpos = GetSpellTargetLoc()
    local unit cast_unit = GetTriggerUnit()
    if ( Trig_Stone_Guard_Special_Func003C() ) then
        call PolledWait( 6.00 )
        set udg_Hero_StG_FSPos = targetpos
        set udg_Hero_StG_FSCaster = cast_unit
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(udg_Hero_StG_FSCaster), udg_Hero_StG_FSPos, bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 7.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A05M', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A05M', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A05M', udg_Hero_StG_FSCaster) )
        call SetUnitManaPercentBJ( GetLastCreatedUnit(), 100 )
        call UnitResetCooldown( GetLastCreatedUnit() )
        call IssuePointOrderLocBJ( GetLastCreatedUnit(), "dreadlordinferno", udg_Hero_StG_FSPos )
        call AddSpecialEffectLocBJ( udg_Hero_StG_FSPos, "Doodads\\Cinematic\\CavernDust\\CavernDust" )
        call d_effect(GetLastCreatedEffectBJ(),1)
    else
    endif
endfunction

