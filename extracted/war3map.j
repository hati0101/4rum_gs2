// Trigger: Charge Unit Move
//===========================================================================
function Trig_Charge_Unit_Move_Func002Func001A takes nothing returns nothing
    call SetUnitPathing( GetEnumUnit(), true )
    call UnitDamageTargetBJ( udg_Hero_DrK, GetEnumUnit(), ( 40.00 + ( 60.00 * I2R(GetUnitAbilityLevelSwapped('A0KT', udg_Hero_DrK)) ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
endfunction

function Trig_Charge_Unit_Move_Func002Func002A takes nothing returns nothing
    call KillDestructable( GetEnumDestructable() )
endfunction

function Trig_Charge_Unit_Move_Func002Func003C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(GetUnitLoc(udg_Hero_DrK), GetUnitLoc(FirstOfGroup(udg_Hero_DrK_group))) > 200.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charge_Unit_Move_Func002Func004Func001A takes nothing returns nothing
    call SetUnitPositionLocFacingBJ( GetEnumUnit(), PolarProjectionBJ(GetUnitLoc(udg_Hero_DrK), 125.00, ( GetUnitFacing(udg_Hero_DrK) - 0.00 )), GetUnitFacing(udg_Hero_DrK) )
endfunction

function Trig_Charge_Unit_Move_Func002Func004Func002A takes nothing returns nothing
    call SetUnitPositionLocFacingBJ( GetEnumUnit(), PolarProjectionBJ(GetUnitLoc(udg_Hero_DrK), 125.00, ( GetUnitFacing(udg_Hero_DrK) - 0.00 )), GetUnitFacing(udg_Hero_DrK) )
endfunction

function Trig_Charge_Unit_Move_Func002Func004C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(GetUnitLoc(udg_Hero_DrK), GetUnitLoc(FirstOfGroup(udg_Hero_DrK_group))) <= 200.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charge_Unit_Move_Func002Func005Func004Func001A takes nothing returns nothing
    call UnitDamageTargetBJ( udg_Hero_DrK, GetEnumUnit(), ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetEnumUnit()) * 0.02 ), ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
endfunction

function Trig_Charge_Unit_Move_Func002Func005Func004Func002Func001A takes nothing returns nothing
    call UnitDamageTargetBJ( udg_Hero_DrK, GetEnteringUnit(), ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetEnumUnit()) * 0.10 ), ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
endfunction

function Trig_Charge_Unit_Move_Func002Func005Func004Func003Func001A takes nothing returns nothing
    call UnitDamageTargetBJ( udg_Hero_DrK, GetEnteringUnit(), ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetEnumUnit()) * 0.10 ), ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
endfunction

function Trig_Charge_Unit_Move_Func002Func005Func004C takes nothing returns boolean
    if ( not ( udg_Hero_DrK_Sp1real >= 100.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charge_Unit_Move_Func002Func005C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R09P', GetOwningPlayer(udg_Hero_DrK)) > 0 ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(udg_Hero_DrK_group) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charge_Unit_Move_Func002C takes nothing returns boolean
    if ( not ( udg_Hero_DrK_ChargeStop == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charge_Unit_Move_Actions takes nothing returns nothing
    if ( Trig_Charge_Unit_Move_Func002C() ) then
        call EnumDestructablesInRectAll( RectFromCenterSizeBJ(GetUnitLoc(udg_Hero_DrK), 300.00, 300.00), function Trig_Charge_Unit_Move_Func002Func002A )
        if ( Trig_Charge_Unit_Move_Func002Func003C() ) then
            call SetUnitPathing( GetEnumUnit(), true )
            call GroupRemoveGroup( udg_Hero_DrK_group, udg_Hero_DrK_group )
        else
        endif
        if ( Trig_Charge_Unit_Move_Func002Func004C() ) then
            call ForGroupBJ( udg_Hero_DrK_group, function Trig_Charge_Unit_Move_Func002Func004Func002A )
        else
            call ForGroupBJ( udg_Hero_DrK_group, function Trig_Charge_Unit_Move_Func002Func004Func001A )
        endif
        if ( Trig_Charge_Unit_Move_Func002Func005C() ) then
            set udg_Hero_DrK_Sp1real = ( udg_Hero_DrK_Sp1real + DistanceBetweenPoints(GetUnitLoc(udg_Hero_DrK), udg_Hero_DrK_Sp1loc) )
            if ( Trig_Charge_Unit_Move_Func002Func005Func004C() ) then
                call ForGroupBJ( udg_Hero_DrK_group, function Trig_Charge_Unit_Move_Func002Func005Func004Func001A )
                call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_DrK, "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl" )
                call DestroyEffectBJ( GetLastCreatedEffectBJ() )
                set udg_Hero_DrK_Sp1real = 0.00
            else
            endif
            set udg_Hero_DrK_Sp1loc = GetUnitLoc(udg_Hero_DrK)
        else
        endif
    else
        call ForGroupBJ( udg_Hero_DrK_group, function Trig_Charge_Unit_Move_Func002Func001A )
        call GroupRemoveGroup( udg_Hero_DrK_group, udg_Hero_DrK_group )
        set udg_Hero_DrK_Sp1real = 0.00
        call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

