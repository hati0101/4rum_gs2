//===========================================================================
function Trig_Hallucination_Func016C takes nothing returns boolean
    if ( ( GetPlayerTechCountSimple('R062', GetOwningPlayer(GetAttacker())) == 1 ) ) then
        return true
    endif
    if ( ( IsUnitInGroup(GetAttacker(), udg_Hero_Hal_Group[3]) != true ) ) then
        return true
    endif
    return false
endfunction

function Trig_Hallucination_Conditions takes nothing returns boolean
    if ( not ( IsUnitIllusionBJ(GetAttacker()) == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))]) == 'Huth' ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A0JZ', udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))]) != 0 ) ) then
        return false
    endif
    if ( not Trig_Hallucination_Func016C() ) then
        return false
    endif
    return true
endfunction

function Trig_Hallucination_Actions takes nothing returns nothing
    local integer rand = GetRandomInt( 1 , 100 )
    local integer chance = 10 // 발동 확률
    if ( rand <= chance ) then
    call DisableTrigger( GetTriggeringTrigger() )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetAttacker()), GetUnitLoc(GetAttacker()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0I8', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0I8', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0JZ', udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))]) )
    call IssueTargetOrderById( GetLastCreatedUnit(), 852274, GetAttacker() )
    call PolledWait( ( 2.25 - ( I2R(GetUnitAbilityLevelSwapped('A0JZ', udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetAttacker()))])) * 0.25 ) ) )
    call EnableTrigger( GetTriggeringTrigger() )
    endif
endfunction

