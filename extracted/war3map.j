// Trigger: BlS Special 4 Damage
//===========================================================================
function Trig_BlS_Special_4_Damage_Conditions takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_Hero_BlS_SajunTarget ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEventDamageSource()) == 'Naka' ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetEventDamageSource(), 'B0B1') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_BlS_Special_4_Damage_Func003C takes nothing returns boolean
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) > ( 1.40 * GetEventDamage() ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_BlS_Special_4_Damage_Actions takes nothing returns nothing
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetEventDamageSource()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    if ( Trig_BlS_Special_4_Damage_Func003C() ) then
        call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) - ( 1.40 * GetEventDamage() ) ) )
    else
        call SetUnitLifeBJ( GetTriggerUnit(), RMaxBJ(1.00, ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) - ( 1.40 + GetEventDamage() ) )) )
        call UnitDamageTargetBJ( GetLastCreatedUnit(), GetTriggerUnit(), ( GetEventDamage() * 1.40 ), ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
    endif
    call UnitRemoveBuffBJ( 'B0B1', udg_Hero_BlS )
endfunction

