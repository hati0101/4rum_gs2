    if ( rand <= chance ) then
    call DisableTrigger( GetTriggeringTrigger() )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetEventDamageSource()), GetUnitLoc(GetEventDamageSource()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A08Z', GetLastCreatedUnit() )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "creepthunderbolt", GetTriggerUnit() )
    call TextTag( "돌진 공격!!" , GetEventDamageSource() , 10 , 255 , 255 , 150, 3 )
    call PolledWait( 4.00 )
    call EnableTrigger( GetTriggeringTrigger() )
    else
    endif
