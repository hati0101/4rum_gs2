function Trig_Shadow_Break_IllDead_Actions takes nothing returns nothing
    if ( Trig_Shadow_Break_IllDead_Func001C() ) then
        call UnitDamageTargetBJ( udg_Hero_BlS, udg_Hero_BlS_SBTarget, ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, udg_Hero_BlS_SBTarget) * 0.10 ), ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
        call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_BlS_SBTarget, "Objects\\Spawnmodels\\Demon\\DemonLargeDeathExplode\\DemonLargeDeathExplode.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
    if ( Trig_Shadow_Break_IllDead_Func002C() ) then
        call UnitDamageTargetBJ( udg_Hero_BlS, udg_Hero_BlS_SBTarget, ( 20.00 + ( 60.00 * ( 1.00 * I2R(GetUnitAbilityLevelSwapped('A09F', udg_Hero_BlS)) ) ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call AddSpecialEffectTargetUnitBJ( "chest", udg_Hero_BlS_SBTarget, "Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
    call UnitDamageTargetBJ( udg_Hero_BlS, udg_Hero_BlS_SBTarget, ( ( udg_Hero_BlS_SBdmg * ( 0.33 + ( 0.07 * I2R(GetPlayerTechCountSimple('R08X', GetOwningPlayer(udg_Hero_BlS))) ) ) ) + 0.00 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_BlS_SBTarget, "Objects\\Spawnmodels\\NightElf\\NightElfLargeDeathExplode\\NightElfLargeDeathExplode.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set udg_Hero_BlS_SBdmg = 0.00
endfunction

