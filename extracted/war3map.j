//===========================================================================
// Trigger: Link of Darkness Cast
//===========================================================================
function Trig_Link_of_Darkness_Cast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A02O' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Link_of_Darkness_Cast_Func002Func001C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(udg_Hero_DrP_LoDTgt)) <= 1000.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Link_of_Darkness_Cast_Func002C takes nothing returns boolean
    if ( not ( IsUnitType(udg_Hero_DrP_LoDTgt, UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Link_of_Darkness_Cast_Func003C takes nothing returns boolean
    if ( not ( IsUnitType(udg_Hero_DrP_LoDTgt, UNIT_TYPE_STRUCTURE) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Link_of_Darkness_Cast_Actions takes nothing returns nothing
    set udg_Hero_DrP_LoDTgt = GetSpellTargetUnit()
    if ( Trig_Link_of_Darkness_Cast_Func002C() ) then
        if ( Trig_Link_of_Darkness_Cast_Func002Func001C() ) then
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A02Z', GetLastCreatedUnit() )
            call SetUnitAbilityLevelSwapped( 'A02Z', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A02O', GetTriggerUnit()) )
            call IssueTargetOrderBJ( GetLastCreatedUnit(), "antimagicshell", udg_Hero_DrP_LoDTgt )
            call PolledWait( 0.10 )
            call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
            set udg_Hero_DrP_LoDTgt = null
        else
            call PauseUnitBJ( true, udg_Hero_DrP_LoDTgt )
            call UnitRemoveBuffBJ( 'Bvul', udg_Hero_DrP_LoDTgt )
            call CreateNUnitsAtLoc( 1, 'e00B', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(udg_Hero_DrP_LoDTgt), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 2.90, 'BTLF', GetLastCreatedUnit() )
        endif
    else
    endif
    if ( Trig_Link_of_Darkness_Cast_Func003C() ) then
        call UnitRemoveBuffBJ( 'Bvul', udg_Hero_DrP_LoDTgt )
    else
    endif
endfunction

