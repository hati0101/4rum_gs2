            call SetUnitAbilityLevelSwapped( 'A08P', GetLastCreatedUnit(), ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) + 4 ) )
        else
            call SetUnitAbilityLevelSwapped( 'A08P', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) )
        endif
        call IssueImmediateOrderBJ( GetLastCreatedUnit(), "stomp" )
    else
    endif
