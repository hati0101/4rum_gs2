        return false
    endif
    return true
endfunction

function Trig_Special_1_Actions takes nothing returns nothing
    if ( Trig_Special_1_Func001C() ) then
        set udg_Hero_FlE_WavePoint = GetUnitLoc(GetSpellTargetUnit())
