//===========================================================================
// Trigger: Item Buy
//===========================================================================
function Trig_Item_Buy_Conditions takes nothing returns boolean
    if ( not ( GetItemLifeBJ(GetManipulatedItem()) != 1.00 ) ) then
        return false
    endif
    if ( not ( GetItemType(GetManipulatedItem()) == ITEM_TYPE_POWERUP ) ) then
        return false
    endif
    return true
endfunction

function Trig_Item_Buy_Func006C takes nothing returns boolean
    if ( not ( GetItemTypeId(GetManipulatedItem()) == 'I0BZ' ) ) then
        return false
    endif
    if ( not ( UnitHasItemOfTypeBJ(GetTriggerUnit(), udg_ItemType[R2I(GetItemLifeBJ(GetManipulatedItem()))]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Item_Buy_Func007Func003C takes nothing returns boolean
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I0C4' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I0BY' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I0C5' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I0C3' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Item_Buy_Func007C takes nothing returns boolean
    if ( not Trig_Item_Buy_Func007Func003C() ) then
        return false
    endif
    if ( not ( UnitHasItemOfTypeBJ(GetTriggerUnit(), udg_ItemType[R2I(GetItemLifeBJ(GetManipulatedItem()))]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Item_Buy_Func011C takes nothing returns boolean
    if ( not ( UnitInventoryCount(GetTriggerUnit()) == 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Item_Buy_Actions takes nothing returns nothing
    local integer a=0
    local integer b=R2I(GetItemLifeBJ(GetManipulatedItem()))
    /////// 포션 스택 ///////
    if ( Trig_Item_Buy_Func006C() ) then
        call SetItemCharges( GetItemOfTypeFromUnitBJ(GetTriggerUnit(), udg_ItemType[R2I(GetItemLifeBJ(GetManipulatedItem()))]), ( GetItemCharges(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), udg_ItemType[R2I(GetItemLifeBJ(GetManipulatedItem()))])) + 3 ) )
        return
    else
    endif
    if ( Trig_Item_Buy_Func007C() ) then
        call SetItemCharges( GetItemOfTypeFromUnitBJ(GetTriggerUnit(), udg_ItemType[R2I(GetItemLifeBJ(GetManipulatedItem()))]), ( GetItemCharges(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), udg_ItemType[R2I(GetItemLifeBJ(GetManipulatedItem()))])) + 1 ) )
        return
    else
    endif
    /////// 아이템 생성 ///////
    call CreateItemLoc( udg_ItemType[R2I(GetItemLifeBJ(GetManipulatedItem()))], GetUnitLoc(GetTriggerUnit()) )
    call SetItemUserData( GetLastCreatedItem(), b )
    if ( Trig_Item_Buy_Func011C() ) then
        set udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = GetLastCreatedItem()
        call SetItemLifeBJ( udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], 500.00 )
        call SetItemUserData( udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], R2I(GetItemLifeBJ(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))])) )
        set bj_forLoopAIndex = 1
        set bj_forLoopAIndexEnd = 6
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call SetItemLifeBJ( UnitItemInSlotBJ(GetTriggerUnit(), GetForLoopIndexA()), 500.00 )
            call SetItemUserData( UnitItemInSlotBJ(GetTriggerUnit(), GetForLoopIndexA()), R2I(GetItemLifeBJ(UnitItemInSlotBJ(GetTriggerUnit(), GetForLoopIndexA()))) )
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
        call ItemMix(188, GetTriggerUnit())
        call ItemMix(189, GetTriggerUnit())
        if StringLength(udg_ItemMix_DB[GetItemUserData(GetLastCreatedItem())]) > 0 then
        call ItemMix(GetItemUserData(GetLastCreatedItem()), GetTriggerUnit())
        endif
        loop
        exitwhen a>6
        if StringLength(udg_ItemMix_DB[GetItemUserData(UnitItemInSlotBJ(GetTriggerUnit(), a))]) > 0 then
        call ItemMix(GetItemUserData(UnitItemInSlotBJ(GetTriggerUnit(), a)), GetTriggerUnit())
        endif
        set a = a+1
        endloop
        set udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = null
    else
        call UnitAddItemSwapped( GetLastCreatedItem(), GetTriggerUnit() )
    endif
endfunction

