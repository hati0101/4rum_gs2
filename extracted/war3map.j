function Trig_Fell_Prince_Attack_Func004C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R06Z', GetOwningPlayer(GetAttacker())) == 1 ) ) then
        return false
    endif
    if ( not Trig_Fell_Prince_Attack_Func004Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Fell_Prince_Attack_Actions takes nothing returns nothing
    if ( Trig_Fell_Prince_Attack_Func001C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetAttacker()), GetUnitLoc(GetAttackedUnitBJ()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0LJ', GetLastCreatedUnit() )
        if ( Trig_Fell_Prince_Attack_Func001Func004C() ) then
            call SetUnitAbilityLevelSwapped( 'A0LJ', GetLastCreatedUnit(), ( 4 + GetUnitAbilityLevelSwapped('A0LB', GetAttacker()) ) )
        else
            call SetUnitAbilityLevelSwapped( 'A0LJ', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0LB', GetAttacker()) )
        endif
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "faeriefire", GetAttackedUnitBJ() )
    else
    endif
    if ( Trig_Fell_Prince_Attack_Func002C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetAttacker()), GetUnitLoc(GetAttackedUnitBJ()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0N6', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0N6', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0L9', GetAttacker()) )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "thunderbolt", GetAttackedUnitBJ() )
        call TextTag( "이연격!" , GetAttacker() , 10 , 255 , 255 , 150, 3 )
        set udg_Hero_FeP_Sp1Target = false
        set udg_Hero_FeP_Sp1Unit = null
    else
    endif
    if ( Trig_Fell_Prince_Attack_Func003C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetAttacker()), GetUnitLoc(GetAttacker()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0LM', GetLastCreatedUnit() )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "soulburn", GetAttackedUnitBJ() )
    else
    endif
    if ( Trig_Fell_Prince_Attack_Func004C() ) then
        call UnitDamageTargetBJ( GetAttacker(), GetAttackedUnitBJ(), 30.00, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL )
    else
    endif
    call DisableTrigger( GetTriggeringTrigger() )
    call PolledWait( 0.30 )
    call EnableTrigger( GetTriggeringTrigger() )
endfunction

