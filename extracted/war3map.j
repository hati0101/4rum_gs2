// Trigger: Wound Slasher
//===========================================================================
function Trig_Wound_Slasher_Conditions takes nothing returns boolean
    if ( not ( GetEventDamageSource() == udg_Hero_SwM ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B0BE') == true ) ) then
        return false
    endif
    if ( not ( UnitHasItemOfTypeBJ(GetEventDamageSource(), 'I04Q') == false ) ) then
        return false
    endif
    if ( not ( UnitHasItemOfTypeBJ(GetEventDamageSource(), 'I05N') == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wound_Slasher_Func003Func001C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R0BR', GetOwningPlayer(GetEventDamageSource())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wound_Slasher_Func003Func003Func001Func002C takes nothing returns boolean
    if ( not ( GetUnitLifePercent(GetTriggerUnit()) <= 40.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wound_Slasher_Func003Func003Func001C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R0BR', GetOwningPlayer(GetEventDamageSource())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wound_Slasher_Func003Func003C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R00A', GetOwningPlayer(GetEventDamageSource())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wound_Slasher_Func003C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_Hero_SwM_WoundUnit ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wound_Slasher_Actions takes nothing returns nothing
    call UnitRemoveBuffBJ( 'B0BE', GetTriggerUnit() )
    call StartTimerBJ( udg_Hero_SwM_WoundTimer, false, 4.00 )
    if ( Trig_Wound_Slasher_Func003C() ) then
        if ( Trig_Wound_Slasher_Func003Func001C() ) then
            set udg_Hero_SwM_WoundCount = IMinBJ(12, ( udg_Hero_SwM_WoundCount + 1 ))
        else
            set udg_Hero_SwM_WoundCount = IMinBJ(4, ( udg_Hero_SwM_WoundCount + 1 ))
        endif
    else
        set udg_Hero_SwM_WoundUnit = GetTriggerUnit()
        if ( Trig_Wound_Slasher_Func003Func003C() ) then
            if ( Trig_Wound_Slasher_Func003Func003Func001C() ) then
                set udg_Hero_SwM_WoundCount = 4
            else
                if ( Trig_Wound_Slasher_Func003Func003Func001Func002C() ) then
                    set udg_Hero_SwM_WoundCount = 4
                    call TextTag( "상처 찢기!" , GetTriggerUnit() , 13 , 120 , 120 , 120, 3 )
                else
                    set udg_Hero_SwM_WoundCount = 1
                endif
            endif
        else
            set udg_Hero_SwM_WoundCount = 1
        endif
    endif
    call SetUnitAbilityLevelSwapped( 'A15B', GetEventDamageSource(), ( ( ( GetUnitAbilityLevelSwapped('A11M', GetEventDamageSource()) - 1 ) * 12 ) + ( udg_Hero_SwM_WoundCount + 1 ) ) )
    call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "Abilities\\Weapons\\HydraliskImpact\\HydraliskImpact.mdl" )
    call d_effect(GetLastCreatedEffectBJ(),0.2)
endfunction

