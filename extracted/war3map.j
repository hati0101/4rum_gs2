function Trig_SpI_Special_1_Actions takes nothing returns nothing
    call UnitRemoveBuffBJ( 'B04R', GetTriggerUnit() )
    call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "EnergyHands.mdx" )
    call d_effect(GetLastCreatedEffectBJ(),1)
    set udg_Hero_SpI_Sp1Dmg = R2I(( I2R(GetHeroStatBJ(bj_HEROSTAT_INT, GetEventDamageSource(), true)) * 0.40 ))
    if ( Trig_SpI_Special_1_Func005C() ) then
        call UnitDamageTargetBJ( GetEventDamageSource(), GetTriggerUnit(), I2R(udg_Hero_SpI_Sp1Dmg), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
