        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R02C', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Spell_Invoker_Special_3_Func006Func001C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(GetSpellTargetLoc(), GetUnitLoc(GetEnumUnit())) <= 400.00 ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAlly(GetEnumUnit(), GetOwningPlayer(GetTriggerUnit())) == true ) ) then
        return false
    endif
    if ( not ( GetTriggerUnit() != GetEnumUnit() ) ) then
        return false
    endif
    return true
endfunction

function Trig_Spell_Invoker_Special_3_Func006A takes nothing returns nothing
    if ( Trig_Spell_Invoker_Special_3_Func006Func001C() ) then
        call UnitRemoveBuffsBJ( bj_REMOVEBUFFS_NEGATIVE, GetEnumUnit() )
    else
    endif
endfunction

function Trig_Spell_Invoker_Special_3_Actions takes nothing returns nothing
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetSpellTargetLoc(), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A10I', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A10I', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A08H', GetTriggerUnit()) )
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "dispel", GetSpellTargetLoc() )
    call ForGroupBJ( GetUnitsInRectAll(GetPlayableMapRect()), function Trig_Spell_Invoker_Special_3_Func006A )
endfunction

