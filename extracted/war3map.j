    call AbsoluteDamage(GetSpellTargetUnit(), GetTriggerUnit(), ( ( 0.50 * I2R(GetHeroStatBJ(bj_HEROSTAT_STR, GetSpellTargetUnit(), true)) ) * ( 2.00 + I2R(GetUnitAbilityLevelSwapped('A0KR', GetTriggerUnit())) ) ))
