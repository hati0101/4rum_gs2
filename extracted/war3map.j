function Trig_Dread_Knight_Special_1_Actions takes nothing returns nothing
    local effect a
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), GetUnitFacing(GetTriggerUnit()) )
    call UnitApplyTimedLifeBJ( 0.20, 'BTLF', GetLastCreatedUnit() )
    if ( Trig_Dread_Knight_Special_1_Func004C() ) then
        call UnitAddAbilityBJ( 'A0VL', GetLastCreatedUnit() )
    else
        if ( Trig_Dread_Knight_Special_1_Func004Func002C() ) then
            call UnitAddAbilityBJ( 'A0VM', GetLastCreatedUnit() )
        else
            if ( Trig_Dread_Knight_Special_1_Func004Func002Func004C() ) then
                call UnitAddAbilityBJ( 'A0VN', GetLastCreatedUnit() )
            else
                if ( Trig_Dread_Knight_Special_1_Func004Func002Func004Func004C() ) then
                    call UnitAddAbilityBJ( 'A0VO', GetLastCreatedUnit() )
                else
                endif
            endif
        endif
    endif
    call AddSpecialEffectLocBJ( GetUnitLoc(GetTriggerUnit()), "Objects\\Spawnmodels\\Undead\\UDeathMedium\\UDeath.mdl" )
    set a = GetLastCreatedEffectBJ()
    call AddSpecialEffectLocBJ( GetUnitLoc(GetTriggerUnit()), "Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl" )
    set a = GetLastCreatedEffectBJ()
    call PolledWait( 7.00 )
    call DestroyEffectBJ( a )
endfunction

