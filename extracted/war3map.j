function Trig_Justice_Func005C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R03R', GetTriggerPlayer()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Justice_Actions takes nothing returns nothing
    set udg_Hero_BlK_Loc[1] = GetUnitLoc(GetSpellAbilityUnit())
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetSpellAbilityUnit()), udg_Hero_BlK_Loc[1], bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0BS', GetLastCreatedUnit() )
    set GS2_JusticeHit = true
    call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), 125.00 * I2R(GetUnitAbilityLevelSwapped('A0BN', GetTriggerUnit()) + 1), ATTACK_TYPE_MAGIC, DAMAGE_TYPE_LIGHTNING )
    if ( Trig_Justice_Func005C() ) then
        call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetSpellTargetUnit()) * 0.08 ), ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
        call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "Abilities\\Spells\\Human\\Resurrect\\ResurrectCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
    set GS2_JusticeHit = false
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "thunderbolt", GetSpellTargetUnit() )
    call RemoveLocation( udg_Hero_BlK_Loc[1] )
endfunction

