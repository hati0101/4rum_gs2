function Trig_TrB_Special_1_Func020C takes nothing returns boolean
    if ( ( GetKillingUnitBJ() == udg_Hero_TrB ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetKillingUnitBJ()) == 'e036' ) ) then
        return true
    endif
    return false
endfunction

function Trig_TrB_Special_1_Conditions takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R082', GetOwningPlayer(GetKillingUnitBJ())) >= 1 ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_Hero_TrB, 'B07Q') == true ) ) then
        return false
    endif
    if ( not ( IsUnitIllusionBJ(GetKillingUnitBJ()) != true ) ) then
        return false
    endif
    if ( not ( IsUnitIllusionBJ(GetDyingUnit()) != true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_STRUCTURE) != true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetDyingUnit()) != 'o000' ) ) then
        return false
    endif
    if ( not Trig_TrB_Special_1_Func020C() ) then
        return false
    endif
    return true
endfunction

function Trig_TrB_Special_1_Func001C takes nothing returns boolean
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_HERO) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrB_Special_1_Func009C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0RD', udg_Hero_TrB) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrB_Special_1_Func010C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0RD', udg_Hero_TrB) == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrB_Special_1_Func011C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0RD', udg_Hero_TrB) == 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrB_Special_1_Func012C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0RD', udg_Hero_TrB) == 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrB_Special_1_Actions takes nothing returns nothing
    if ( Trig_TrB_Special_1_Func001C() ) then
        set udg_Hero_TrB_Sp1int = ( udg_Hero_TrB_Sp1int + 1 )
        call AddSpecialEffectTargetUnitBJ( "head", udg_Hero_TrB, "Objects\\Spawnmodels\\Critters\\Albatross\\CritterBloodAlbatross.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
        set udg_Hero_TrB_Sp1int = 2
    endif
    if ( udg_Hero_TrB_Sp1int == 2 ) then
    set udg_Hero_TrB_Sp1int = 0
    call TextTag( "학살은 계속된다...!" , udg_Hero_TrB , 10 , 200 , 0 , 0, 3 )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_TrB, "Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call UnitRemoveBuffBJ( 'B07Q', udg_Hero_TrB )
    call TriggerSleepAction( 0.10 )
    if ( Trig_TrB_Special_1_Func009C() ) then
        call UnitAddItemByIdSwapped( 'tint', udg_Hero_TrB )
    else
    endif
    if ( Trig_TrB_Special_1_Func010C() ) then
        call UnitAddItemByIdSwapped( 'tin2', udg_Hero_TrB )
    else
    endif
    if ( Trig_TrB_Special_1_Func011C() ) then
        call UnitAddItemByIdSwapped( 'tpow', udg_Hero_TrB )
    else
    endif
    if ( Trig_TrB_Special_1_Func012C() ) then
        call UnitAddItemByIdSwapped( 'manh', udg_Hero_TrB )
    else
    endif
    endif
endfunction

