    set gg_trg_Item_Buy = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Item_Buy, EVENT_PLAYER_UNIT_PICKUP_ITEM )
    call TriggerAddCondition( gg_trg_Item_Buy, Condition( function Trig_Item_Buy_Conditions ) )
    call TriggerAddAction( gg_trg_Item_Buy, function Trig_Item_Buy_Actions )
