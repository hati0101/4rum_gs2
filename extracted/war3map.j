//===========================================================================
function Trig_Rune_of_Resist_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A05S' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'Ocbh' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rune_of_Resist_Func007C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R02B', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rune_of_Resist_Actions takes nothing returns nothing
    call CreateNUnitsAtLoc( 1, 'e00Y', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetSpellTargetUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0F4', GetLastCreatedUnit() )
    set udg_Hero_StG_RoRCnt = ( ( GetUnitAbilityLevelSwapped('A05S', GetTriggerUnit()) * 2 ) + 2 )
    call SetUnitAbilityLevelSwapped( 'A0F4', GetLastCreatedUnit(), udg_Hero_StG_RoRCnt )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "innerfire", GetSpellTargetUnit() )
    if ( Trig_Rune_of_Resist_Func007C() ) then
        call UnitRemoveBuffBJ( 'Bam2', GetSpellTargetUnit() )
        call UnitRemoveBuffBJ( 'B0AK', GetSpellTargetUnit() )
        call UnitRemoveBuffBJ( 'B0AL', GetSpellTargetUnit() )
        call CreateNUnitsAtLoc( 1, 'e00Y', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetSpellTargetUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A070', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A070', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A05S', GetTriggerUnit()) )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "antimagicshell", GetSpellTargetUnit() )
    else
    endif
    call PolledWait( 6.00 )
    call UnitRemoveBuffBJ( 'B08T', GetSpellTargetUnit() )
endfunction

