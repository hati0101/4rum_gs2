        call CreateNUnitsAtLoc( 1, 'e014', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetSpellTargetUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 4.00, 'BTLF', GetLastCreatedUnit() )
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0NF', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0NF', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0LS', GetTriggerUnit()) )
        call IssueImmediateOrderBJ( GetLastCreatedUnit(), "stomp" )
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A024', GetLastCreatedUnit() )
