// Trigger: Stop Moon Protection 2
//===========================================================================
function Trig_Stop_Moon_Protection_2_Conditions takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_Hero_MoW[1] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Stop_Moon_Protection_2_Actions takes nothing returns nothing
    call RemoveUnit( udg_Hero_MoW_StarfallCaster )
    set bj_forLoopAIndex = 1
