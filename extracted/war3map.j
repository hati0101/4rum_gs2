//===========================================================================
// Trigger: Emperor Sign
//
// 원한에 잠긴 추격
//===========================================================================
function Trig_Emperor_Sign_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0OG' ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B07Y') != true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Emperor_Sign_Func001C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetSpellAbilityUnit(), 'BPSE') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Emperor_Sign_Func002C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'Uear' ) ) then
        return false
    endif
    if ( not ( TimerGetRemaining(udg_Hero_DaT_UltiTimer) > 0.01 ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R0BB', GetOwningPlayer(GetSpellTargetUnit())) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Emperor_Sign_Func007Func001C takes nothing returns boolean
    if ( not ( GetItemTypeId(UnitItemInSlotBJ(GetTriggerUnit(), GetForLoopIndexB())) != 'I05W' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Emperor_Sign_Actions takes nothing returns nothing
    if ( Trig_Emperor_Sign_Func001C() ) then
        return
    else
    endif
    if ( Trig_Emperor_Sign_Func002C() ) then
        call UnitRemoveAbilityBJ( 'A07W', udg_Hero_DaT )
        call UnitAddAbilityBJ( 'A0P0', udg_Hero_DaT )
        call SetUnitAbilityLevelSwapped( 'A0P0', udg_Hero_DaT, GetUnitAbilityLevelSwapped('A0PC', udg_Hero_DaT) )
        call PauseTimerBJ( true, udg_Hero_DaT_UltiTimer )
        set udg_Hero_DaT = null
    else
    endif
    call UnitResetCooldown( GetSpellAbilityUnit() )
    set bj_forLoopBIndex = 1
    set bj_forLoopBIndexEnd = 6
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        if ( Trig_Emperor_Sign_Func007Func001C() ) then
            call SetItemDroppableBJ( UnitItemInSlotBJ(GetTriggerUnit(), GetForLoopIndexB()), true )
        else
        endif
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
    call TextTag( "쿨다운 초기화!" , GetTriggerUnit() ,  10 , 255 , 255 , 150 , 3 )
endfunction

