function Trig_SpI_Speical_2_Func001C takes nothing returns boolean
    if ( not ( IsUnitAlly(udg_Hero_SpI_UltiTgt, GetOwningPlayer(udg_Hero_SpI)) != true ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_MANA, udg_Hero_SpI) >= 50.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SpI_Speical_2_Actions takes nothing returns nothing
    if ( Trig_SpI_Speical_2_Func001C() ) then
        call SetUnitManaBJ( udg_Hero_SpI, ( GetUnitStateSwap(UNIT_STATE_MANA, udg_Hero_SpI) - 50.00 ) )
        call UnitDamageTargetBJ( udg_Hero_SpI, udg_Hero_SpI_UltiTgt, ( 100.00 + ( I2R(GetUnitAbilityLevelSwapped('A08J', udg_Hero_SpI)) * 80.00 ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_DIVINE )
    else
    endif
    set udg_Hero_SpI = null
    set udg_Hero_SpI_UltiTgt = null
endfunction

