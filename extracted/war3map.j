function Trig_Lag_Slash_Func005Func002C takes nothing returns boolean
    if ( ( udg_MBKills[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]] > udg_MBKills[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetSpellTargetUnit()))]] ) ) then
        return true
    endif
    if ( Trig_Lag_Slash_Func005Func002Func002C() ) then
        return true
    endif
    return false
endfunction

