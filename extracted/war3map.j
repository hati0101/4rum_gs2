function InitTrig_Blow_Bomb takes nothing returns nothing
    set gg_trg_Blow_Bomb = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Blow_Bomb, EVENT_PLAYER_UNIT_SPELL_EFFECT )
