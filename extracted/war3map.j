    if ( not ( GetPlayerTechCountSimple('R007', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SwM_Skill_Effect_Func001C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A00C' ) ) then
        return false
    endif
    return true
endfunction

function Trig_SwM_Skill_Effect_Func002C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A001' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R009', GetOwningPlayer(GetTriggerUnit())) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SwM_Skill_Effect_Actions takes nothing returns nothing
    if ( Trig_SwM_Skill_Effect_Func001C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 150.00, GetUnitFacing(GetTriggerUnit())), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A00J', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A00J', GetLastCreatedUnit(), ( GetUnitAbilityLevelSwapped('A00C', GetTriggerUnit()) + ( 4 * GetPlayerTechCountSimple('R007', GetOwningPlayer(GetTriggerUnit())) ) ) )
        call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
        if ( Trig_SwM_Skill_Effect_Func001Func007C() ) then
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 150.00, GetUnitFacing(GetTriggerUnit())), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A00D', GetLastCreatedUnit() )
            call SetUnitAbilityLevelSwapped( 'A00D', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A00C', GetTriggerUnit()) )
            call IssueImmediateOrderBJ( GetLastCreatedUnit(), "stomp" )
        else
        endif
    else
    endif
    if ( Trig_SwM_Skill_Effect_Func002C() ) then
        call CreateNUnitsAtLoc( 1, 'e03E', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 100.00, GetUnitFacing(GetTriggerUnit())), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.50, 'BTLF', GetLastCreatedUnit() )
    else
    endif
endfunction

