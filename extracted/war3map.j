    call TriggerRegisterEnterRectSimple( gg_trg_Move, gg_rct_G_Bottom )
    call TriggerRegisterEnterRectSimple( gg_trg_Move, gg_rct_G_Top )
    call TriggerRegisterEnterRectSimple( gg_trg_Move, gg_rct_Move_Bottom_Center )
    call TriggerRegisterEnterRectSimple( gg_trg_Move, gg_rct_Move_Bottom_Left )
    call TriggerRegisterEnterRectSimple( gg_trg_Move, gg_rct_Move_Bottom_Right )
    call TriggerRegisterEnterRectSimple( gg_trg_Move, gg_rct_Move_Bottom_W )
    call TriggerRegisterEnterRectSimple( gg_trg_Move, gg_rct_Move_Center_Left )
