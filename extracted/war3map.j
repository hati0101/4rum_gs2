//===========================================================================
function Trig_OgL_Skill_Effect_Func001C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A07A' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0YK' ) ) then
        return true
    endif
    return false
endfunction

function Trig_OgL_Skill_Effect_Conditions takes nothing returns boolean
    if ( not Trig_OgL_Skill_Effect_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_OgL_Skill_Effect_Func005Func004001003001001001002 takes nothing returns boolean
    return ( UnitHasBuffBJ(GetFilterUnit(), 'B099') == true )
endfunction

function Trig_OgL_Skill_Effect_Func005Func016C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0AA', GetTriggerUnit()) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_OgL_Skill_Effect_Func005C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A07A' ) ) then
        return false
    endif
    return true
endfunction

function Trig_OgL_Skill_Effect_Func006C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0YK' ) ) then
        return false
    endif
    return true
endfunction

function Trig_OgL_Skill_Effect_Actions takes nothing returns nothing
    local integer PlayerId = GetConvertedPlayerId( GetOwningPlayer(GetTriggerUnit()) )
    local integer PowerCnt = 0
    local real UsingMana = 8.00 + I2R(( 4 * GetUnitAbilityLevelSwapped('A07A', GetTriggerUnit()) )) 
    if ( Trig_OgL_Skill_Effect_Func005C() ) then
        set udg_Hero_OgL_PowerBool = true
        loop
        exitwhen PowerCnt >= 5 + I2R(( 1 * GetPlayerTechCountSimple('R01C', GetOwningPlayer(GetTriggerUnit())) ))
        call PolledWait( ( 0.50 - ( I2R(CountUnitsInGroup(GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_OgL_Skill_Effect_Func005Func004001003001001001002)))) * 0.25 ) ) )
        // 요건 체크 및 마나 감소
        if ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) < ( UsingMana ) )  then
        call IssueImmediateOrderBJ( udg_HeroPlayer[PlayerId], "stop" )
        return
        endif
        if ( udg_Hero_OgL_PowerBool == false) then
        return
        endif
        set PowerCnt = PowerCnt + 1
        call SetUnitManaBJ( udg_HeroPlayer[PlayerId], ( GetUnitStateSwap(UNIT_STATE_MANA, udg_HeroPlayer[PlayerId]) - UsingMana ) )
        // 파워 스트라이크 버프
        if ( Trig_OgL_Skill_Effect_Func005Func016C() ) then
            call UnitAddAbilityBJ( 'A0AA', GetTriggerUnit() )
            call TextTagForce( "파워 스트라이크 +1", GetTriggerUnit(), 9, 255, 255, 255, 2, GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())) )
        else
            call SetUnitAbilityLevelSwapped( 'A0AA', GetTriggerUnit(), PowerCnt )
            call TextTagForce( "파워 스트라이크 +1", GetTriggerUnit(), 9, 255, 255, 255, 2, GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())) )
        endif
        endloop
    else
    endif
    if ( Trig_OgL_Skill_Effect_Func006C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A041', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A041', GetLastCreatedUnit(), ( GetUnitAbilityLevelSwapped('A04Y', GetTriggerUnit()) + ( GetPlayerTechCountSimple('R01H', GetOwningPlayer(GetTriggerUnit())) * 4 ) ) )
        call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
    else
    endif
endfunction

