    call ForGroupBJ( GetUnitsInRangeOfLocMatching(250.00, GetUnitLoc(GetTriggerUnit()), Condition(function Trig_Hunting_Net_Func001001003)), function Trig_Hunting_Net_Func001A )
    call CreateNUnitsAtLoc( 1, 'uplg', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
