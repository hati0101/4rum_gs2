//===========================================================================
// Trigger: Move
//===========================================================================
function Trig_Move_Func005C takes nothing returns boolean
    if ( ( GetOwningPlayer(GetTriggerUnit()) == udg_Force[1] ) ) then
        return true
    endif
    if ( ( GetOwningPlayer(GetTriggerUnit()) == udg_Force[2] ) ) then
        return true
    endif
    return false
endfunction

function Trig_Move_Conditions takes nothing returns boolean
    if ( not ( GetUnitUserData(GetTriggerUnit()) != 0 ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) != true ) ) then
        return false
    endif
    if ( not ( DistanceBetweenPoints(GetRectCenter(udg_LineRegion[GetUnitUserData(GetTriggerUnit())]), GetUnitLoc(GetTriggerUnit())) < 1500.00 ) ) then
        return false
    endif
    if ( not Trig_Move_Func005C() ) then
        return false
    endif
    return true
endfunction

function Trig_Move_Func006C takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetTriggerUnit()) == udg_Force[1] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Move_Actions takes nothing returns nothing
    if ( Trig_Move_Func006C() ) then
        call IssuePointOrderLocBJ( GetEnteringUnit(), "attack", GetRectCenter(udg_LineRegion[( GetUnitUserData(GetTriggerUnit()) + 1 )]) )
        call SetUnitUserData( GetEnteringUnit(), ( GetUnitUserData(GetTriggerUnit()) + 1 ) )
    else
        call IssuePointOrderLocBJ( GetEnteringUnit(), "attack", GetRectCenter(udg_LineRegion[( GetUnitUserData(GetTriggerUnit()) - 1 )]) )
        call SetUnitUserData( GetEnteringUnit(), ( GetUnitUserData(GetTriggerUnit()) - 1 ) )
    endif
endfunction

