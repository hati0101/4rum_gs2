    if ( not ( GetUnitCurrentOrder(udg_Hero_PhM_Spunit1) != String2OrderIdBJ("attack") ) ) then
        return false
    endif
    if ( not ( GetUnitCurrentOrder(udg_Hero_PhM_Spunit2) != String2OrderIdBJ("attack") ) ) then
        return false
    endif
    if ( not ( GetUnitCurrentOrder(udg_Hero_PhM_Spunit3) != String2OrderIdBJ("attack") ) ) then
        return false
    endif
    return true
endfunction

