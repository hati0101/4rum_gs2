//===========================================================================
// Trigger: Chain Slush
//
// 근육 절단
//===========================================================================
function Trig_Chain_Slush_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0CF' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Chain_Slush_Func001C takes nothing returns boolean
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) <= 50.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Chain_Slush_Func002C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R045', GetTriggerPlayer()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Chain_Slush_Actions takes nothing returns nothing
    if ( Trig_Chain_Slush_Func001C() ) then
        call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
        call DisplayTimedTextToForce( GetForceOfPlayer(GetTriggerPlayer()), 10.00, "TRIGSTR_1745" )
        return
    else
        call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) - 50.00 ) )
    endif
    if ( Trig_Chain_Slush_Func002C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetTriggerPlayer(), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0CM', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0CM', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0CF', udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]) )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "cripple", GetSpellTargetUnit() )
    else
    endif
endfunction

