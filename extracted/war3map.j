        local effect A
        if ( Trig_Half_Angelic_Speciel_2_Func002C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Human\\DivineShield\\DivineShieldTarget.mdl" )
        set A = GetLastCreatedEffectBJ()
        call SetUnitInvulnerable( GetTriggerUnit(), true )
        call PolledWait( 1.50 )
        call DestroyEffectBJ( A )
        call SetUnitInvulnerable( GetTriggerUnit(), false )
        call PolledWait( 8.50 )
        call EnableTrigger( GetTriggeringTrigger() )
        else
        endif
endfunction

