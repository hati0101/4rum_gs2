// Trigger: Earth Shork
//
// 모든 플레이어의 기본 멜리 게임 초기화
//===========================================================================
function Trig_Earth_Shork_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEventDamageSource()) == 'e01P' ) ) then
        return false
    endif
    if ( not ( GetEventDamage() > 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Earth_Shork_Func003C takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_FLYING) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Earth_Shork_Actions takes nothing returns nothing
    call UnitAddAbilityBJ( 'Arav', GetTriggerUnit() )
    call UnitRemoveAbilityBJ( 'Arav', GetTriggerUnit() )
    if ( Trig_Earth_Shork_Func003C() ) then
        call PolledWait( 0.40 )
    else
        call SetUnitFlyHeightBJ( GetTriggerUnit(), 400.00, 1600.00 )
        call PolledWait( 0.10 )
        call SetUnitFlyHeightBJ( GetTriggerUnit(), 500.00, 500.00 )
        call PolledWait( 0.10 )
        call SetUnitFlyHeightBJ( GetTriggerUnit(), 0.00, 1000.00 )
        call PolledWait( 0.10 )
        call SetUnitFlyHeightBJ( GetTriggerUnit(), 0.00, 1500.00 )
    endif
endfunction

