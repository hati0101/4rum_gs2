//===========================================================================
// Trigger: MeQ Atk
//===========================================================================
function Trig_MeQ_Atk_Func006Func002C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'Hvsh' ) ) then
        return false
    endif
    if ( not ( TimerGetRemaining(udg_Hero_MeQ_SP1Timer) < 0.10 ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEventDamageSource(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MeQ_Atk_Func006C takes nothing returns boolean
    if ( ( GetTriggerUnit() == udg_Hero_MeQ_Atk ) ) then
        return true
    endif
    if ( Trig_MeQ_Atk_Func006Func002C() ) then
        return true
    endif
    return false
endfunction

function Trig_MeQ_Atk_Conditions takes nothing returns boolean
    if ( not ( GetEventDamage() > 10.00 ) ) then
        return false
    endif
    if ( not Trig_MeQ_Atk_Func006C() ) then
        return false
    endif
    return true
endfunction

function Trig_MeQ_Atk_Func003C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A145', GetEventDamageSource()) > 0 ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(GetTriggerUnit(), GetOwningPlayer(GetEventDamageSource())) == true ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_MANA, GetEventDamageSource()) >= ( GetUnitStateSwap(UNIT_STATE_MAX_MANA, GetEventDamageSource()) * 0.01 ) ) ) then
        return false
    endif
    if ( not ( GetTriggerUnit() == udg_Hero_MeQ_Atk ) ) then
        return false
    endif
    return true
endfunction

function Trig_MeQ_Atk_Func004C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'Hvsh' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R0B7', GetOwningPlayer(GetTriggerUnit())) > 0 ) ) then
        return false
    endif
    if ( not ( TimerGetRemaining(udg_Hero_MeQ_SP1Timer) < 0.01 ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEventDamageSource(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_MeQ_Atk_Actions takes nothing returns nothing
    local integer rand = GetRandomInt( 1 , 100 )
    local integer chance = 25 // 발동 확률
    if ( Trig_MeQ_Atk_Func003C() ) then
        set udg_Hero_MeQ_Atk = null
        call UnitDamageTargetBJ( GetEventDamageSource(), GetTriggerUnit(), ( ( GetUnitStateSwap(UNIT_STATE_MAX_MANA, GetEventDamageSource()) * ( 0.50 + ( 0.50 * I2R(GetUnitAbilityLevelSwapped('A145', GetEventDamageSource())) ) ) ) / 100.00 ), ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
        call SetUnitManaBJ( GetEventDamageSource(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetEventDamageSource()) - ( GetUnitStateSwap(UNIT_STATE_MAX_MANA, GetEventDamageSource()) * 0.01 ) ) )
        call TextTag(  "+"+I2S(R2I(( GetUnitStateSwap(UNIT_STATE_MAX_MANA, GetEventDamageSource()) * ( 0.50 + ( 0.50 * I2R(GetUnitAbilityLevelSwapped('A145', GetEventDamageSource())) ) ) ) / 100.00 )) , GetTriggerUnit(), 10 , 0, 0, 100, 3 )
    else
    endif
    if ( Trig_MeQ_Atk_Func004C() ) then
        if rand < chance then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A117', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A117', GetLastCreatedUnit(), 8 )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "thunderbolt", GetEventDamageSource() )
        call StartTimerBJ( udg_Hero_MeQ_SP1Timer, false, 8.00 )
        call TextTag( "석화의 마안!" , GetTriggerUnit() , 10 , 255 , 0 , 0, 3 )
        endif
    else
    endif
endfunction

