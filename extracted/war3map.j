        call SetUnitAbilityLevelSwapped( 'A04Q', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A012', udg_Hero_Ran) )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "chainlightning", GetEnumUnit() )
    else
    endif
endfunction

