function Trig_Burrow_Drive_Dmg_Conditions takes nothing returns boolean
    if ( not ( GetIssuedOrderIdBJ() == String2OrderIdBJ("smart") ) ) then
        return false
    endif
    if ( not ( IsUnitSelected(udg_Hero_DeC, GetTriggerPlayer()) == true ) ) then
        return false
    endif
    if ( not ( IsUnitOwnedByPlayer(udg_Hero_DeC, GetTriggerPlayer()) == true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_Hero_DeC, 'B09O') == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetOrderTargetUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(udg_Hero_DeC, GetOwningPlayer(GetOrderTargetUnit())) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Burrow_Drive_Dmg_Func008Func012C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R069', GetOwningPlayer(udg_Hero_DeC)) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Burrow_Drive_Dmg_Func008C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(GetUnitLoc(udg_Hero_DeC), GetUnitLoc(GetOrderTargetUnit())) <= 650.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Burrow_Drive_Dmg_Actions takes nothing returns nothing
    local location l = GetUnitLoc(udg_Hero_DeC)
    local location a = GetUnitLoc(GetOrderTargetUnit())
    local integer i = 0
    local integer r = R2I(DistanceBetweenPoints(GetUnitLoc(udg_Hero_DeC), GetUnitLoc(GetOrderTargetUnit()))) / 100
    local effect e
    if IsUnitInvulnerable(GetOrderTargetUnit()) then
    else
    if ( Trig_Burrow_Drive_Dmg_Func008C() ) then
        call UnitRemoveBuffBJ( 'B09O', udg_Hero_DeC )
        call SetUnitAnimation( udg_Hero_DeC, "Attack" )
        call UnitDamageTargetBJ( udg_Hero_DeC, GetOrderTargetUnit(), ( ( 20.00 + I2R(GetHeroStatBJ(bj_HEROSTAT_INT, udg_Hero_DeC, true)) ) + ( 80.00 * I2R(GetUnitAbilityLevelSwapped('A0I6', udg_Hero_DeC)) ) ), ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL )
        call AddSpecialEffectLocBJ( GetUnitLoc(GetOrderTargetUnit()), "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_DeC), "Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call SetUnitPositionLocFacingLocBJ( udg_Hero_DeC, PolarProjectionBJ(GetUnitLoc(GetOrderTargetUnit()), -100.00, AngleBetweenPoints(GetUnitLoc(udg_Hero_DeC), GetUnitLoc(GetOrderTargetUnit()))), GetUnitLoc(GetOrderTargetUnit()) )
        call TextTag( I2S(R2I(20.00+(80.00*I2R(GetUnitAbilityLevelSwapped('A0I6', udg_Hero_DeC)))))+"!!" , udg_Hero_DeC , 10 , 200 , 0 , 0, 3 )
        call IssueTargetOrderBJ( udg_Hero_DeC, "attack", GetOrderTargetUnit() )
        if ( Trig_Burrow_Drive_Dmg_Func008Func012C() ) then
            call PauseTimerBJ( true, udg_Hero_DeC_Sp1Timer )
        else
        endif
        loop
        set i = i + 1
        call AddSpecialEffectLocBJ( PolarProjectionBJ((  l ), ( 100.00 * I2R( i ) ), AngleBetweenPoints( l , a )), "Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl" )
        set e = GetLastCreatedEffectBJ()
        call DestroyEffectBJ( e )
        exitwhen ( i >= r )
        endloop
        set l = null
        set a = null
        set e = null
    else
        call DisplayTextToForce( GetForceOfPlayer(GetOwningPlayer(udg_Hero_DeC)), "TRIGSTR_1724" )
    endif
    endif
endfunction

