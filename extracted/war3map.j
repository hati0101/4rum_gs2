// Trigger: MRG Sp 2
//===========================================================================
function Trig_MRG_Sp_2_Conditions takes nothing returns boolean
    if ( not ( GetIssuedOrderIdBJ() == String2OrderIdBJ("smart") ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetOrderTargetUnit()) == 'n01V' ) ) then
        return false
    endif
    if ( not ( IsUnitAlly(GetOrderedUnit(), GetOwningPlayer(udg_Hero_MRG)) == true ) ) then
        return false
    endif
    if ( not ( DistanceBetweenPoints(GetUnitLoc(GetOrderedUnit()), GetUnitLoc(GetOrderTargetUnit())) <= 300.00 ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetOrderedUnit(), 'BPSE') == false ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetOrderedUnit(), 'BSTN') == false ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetOrderedUnit(), 'B065') == false ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetOrderedUnit(), 'B03K') == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_MRG_Sp_2_Actions takes nothing returns nothing
    call SetUnitPositionLoc( GetOrderedUnit(), udg_Hero_MRG_SpPointEnd )
    call AddSpecialEffectTargetUnitBJ( "origin", GetOrderedUnit(), "Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetOrderTargetUnit(), "Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call ExplodeUnitBJ( GetOrderTargetUnit() )
    call TriggerSleepAction( 0.10 )
    call IssueImmediateOrderBJ( GetOrderedUnit(), "stop" )
endfunction

