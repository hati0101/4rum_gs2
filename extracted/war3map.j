    if ( not ( GetUnitAbilityLevelSwapped('A0BO', GetEnumUnit()) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BlK_Change_Func002Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEnumUnit()) == 'Hpb1' ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetEnumUnit()) == GetTriggerPlayer() ) ) then
        return false
    endif
    return true
endfunction

function Trig_BlK_Change_Func002A takes nothing returns nothing
    if ( Trig_BlK_Change_Func002Func001C() ) then
        if ( Trig_BlK_Change_Func002Func001Func001C() ) then
            call UnitRemoveAbilityBJ( 'A0BP', GetEnumUnit() )
            call UnitAddAbilityBJ( 'A0BQ', GetEnumUnit() )
            call SetUnitAbilityLevelSwapped( 'A0BQ', GetEnumUnit(), GetUnitAbilityLevelSwapped('A0BO', GetEnumUnit()) )
        else
        endif
    else
    endif
endfunction

function Trig_BlK_Change_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    call ForGroupBJ( GetUnitsInRectAll(GetPlayableMapRect()), function Trig_BlK_Change_Func002A )
endfunction

