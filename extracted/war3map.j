//===========================================================================
// Trigger: Set Variable Creep Aura
//
// 1 보르트 - 1250 골드 분배. 90초 동안 아군 영웅 체력을 매 초당 1% 씩 회복합니다.
// 2 이리야 - 1250 골드 분배. 150초 동안 아군 공격력이 40% 증가합니다.
// 3 사토시 - 1250 골드 분배. 150초 동안 적군의 공격속도를 30% 감소시키고, 이동속도를 5% 감소시킨다.
// 4 매도그 - 1750 골드 분배. 150초 동안 아군 영웅 방어력이 10 증가합니다.
// 5 밍구 - 1750 골드 분배. 150초 동안 아군 영웅의 공격속도가 60% 증가합니다.
// 6 카에데 - 2500 골드 분배. 150초 동안 적군의 마나 재생력이 -200%가 됩니다.
// 7 즈윈라 - 2500 골드 분배. 150초 동안 적 영웅의 방어력이 8 감소합니다.
// 8 네메시스 -
// 9 젬 제므
// 10 썬더로드
// 11 로우로
// 12 스키즈
// -------특수 유닛-----
// 스키즈 - 2500 골드 분배. 남아있는 적 배럭에 두 마리의 인페르노를 떨어트려 건물에 피해입히고 추가로 건물을 타격한다.
// 나인식스 - 7500 골드 분배.
// 썬더 로드 - 1750 골드 분배. 150초 동안 아군 영웅에게 마법 피해를 600 감소시키는 쉴드를 제공합니다.
//===========================================================================
function Trig_Set_Variable_Creep_Aura_Actions takes nothing returns nothing
    set udg_Creep_NamedAura[1] = 'e02D'
    set udg_Creep_NamedAura[2] = 'e02P'
    set udg_Creep_NamedAura[3] = 'e02Q'
    set udg_Creep_NamedAura[4] = 'e02R'
    set udg_Creep_NamedAura[5] = 'e02S'
    set udg_Creep_NamedAura[6] = 'e02U'
    set udg_Creep_NamedAura[7] = 'e02V'
    set udg_Creep_NamedAura[8] = 'e02T'
    set udg_Creep_NamedAura[9] = 'e02W'
    set udg_Creep_NamedAura[10] = 'e02X'
    set udg_Creep_NamedAura[11] = 'e02Y'
    set udg_Creep_NamedAura[12] = 'e035'
endfunction

//===========================================================================
function InitTrig_Set_Variable_Creep_Aura takes nothing returns nothing
    set gg_trg_Set_Variable_Creep_Aura = CreateTrigger(  )
    call TriggerRegisterTimerEventSingle( gg_trg_Set_Variable_Creep_Aura, 1.10 )
    call TriggerAddAction( gg_trg_Set_Variable_Creep_Aura, function Trig_Set_Variable_Creep_Aura_Actions )
endfunction

//===========================================================================
// Trigger: Set Ability Disabled
//
// 주로 스펠북을 여기서 끄게 만듭니다.
//===========================================================================
function Trig_Set_Ability_Disabled_Actions takes nothing returns nothing
    local integer LoopX = 1
    loop
    exitwhen LoopX > 12
    call SetPlayerAbilityAvailableBJ( false, 'A116', ConvertedPlayer(LoopX) )
    call SetPlayerAbilityAvailableBJ( false, 'A11V', ConvertedPlayer(LoopX) )
    call SetPlayerAbilityAvailableBJ( false, 'A10Y', ConvertedPlayer(LoopX) )
    call SetPlayerAbilityAvailableBJ( false, 'A15K', ConvertedPlayer(LoopX) )
    call SetPlayerAbilityAvailableBJ( false, 'A14Q', ConvertedPlayer(LoopX) )
    call SetPlayerAbilityAvailableBJ( false, 'A0L4', ConvertedPlayer(LoopX) )
    call SetPlayerAbilityAvailableBJ( false, 'A0RB', ConvertedPlayer(LoopX) )
    call SetPlayerAbilityAvailableBJ( false, 'A0UY', ConvertedPlayer(LoopX) )
    set LoopX = LoopX + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Set_Ability_Disabled takes nothing returns nothing
    set gg_trg_Set_Ability_Disabled = CreateTrigger(  )
    call TriggerRegisterTimerEventSingle( gg_trg_Set_Ability_Disabled, 10.00 )
    call TriggerAddAction( gg_trg_Set_Ability_Disabled, function Trig_Set_Ability_Disabled_Actions )
endfunction


