//===========================================================================
// Trigger: DragNet
//===========================================================================
function DragNet_Sub takes nothing returns nothing
    local timer t = GetExpiredTimer() 
    local unit u = LoadUnitHandleBJ(GetHandleIdBJ(t),StringHashBJ("DesNet1"), GetLastCreatedHashtableBJ())
    local location p = Location(LoadRealBJ(GetHandleIdBJ(t),StringHashBJ("DesNet2"), GetLastCreatedHashtableBJ()),LoadRealBJ(GetHandleIdBJ(t),StringHashBJ("DesNet3"), GetLastCreatedHashtableBJ()))
    local location up = GetUnitLoc(u)
    local real dmg =  LoadRealBJ(GetHandleIdBJ(t),StringHashBJ("DesNetDmg"), GetLastCreatedHashtableBJ())
    if UnitHasBuffBJ(u, 'B06F') then
        if (DistanceBetweenPoints(p, up) > 300) and (GetUnitAbilityLevelSwapped('A0FU', udg_Hero_Des) >= 2) then
        call SetUnitPositionLoc( u, p )
        call SaveRealBJ( DistanceBetweenPoints(p, GetUnitLoc(u)), GetHandleIdBJ(t), StringHashBJ("DesNetDistance"), GetLastCreatedHashtableBJ() )
        else
        call SaveRealBJ( GetUnitX(u), GetHandleIdBJ(t), StringHashBJ("DesNet2"), GetLastCreatedHashtableBJ() )
        call SaveRealBJ( GetUnitY(u), GetHandleIdBJ(t), StringHashBJ("DesNet3"), GetLastCreatedHashtableBJ() )
        call SaveRealBJ( LoadRealBJ(GetHandleIdBJ(t),StringHashBJ("DesNetDistance"), GetLastCreatedHashtableBJ())+DistanceBetweenPoints(p, up),GetHandleIdBJ(t), StringHashBJ("DesNetDistance"), GetLastCreatedHashtableBJ())
        endif
        //데미지 주기
        if LoadRealBJ(GetHandleIdBJ(t),StringHashBJ("DesNetDistance"), GetLastCreatedHashtableBJ()) >= 100 then
        call UnitDamageTargetBJ( udg_Hero_Des, u, dmg, ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
        call AddSpecialEffectLocBJ( GetUnitLoc(u), "Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl" )
        call d_effect(GetLastCreatedEffectBJ(), 0.1)
        call SaveRealBJ( 0,GetHandleIdBJ(t), StringHashBJ("DesNetDistance"), GetLastCreatedHashtableBJ())
        endif
    else
        call DestroyTimer(t)
    endif
    call RemoveLocation(up)
    call RemoveLocation(p)
endfunction

function Trig_DragNet_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0GC' ) ) then
        return false
    endif
    return true
endfunction

function Trig_DragNet_Actions takes nothing returns nothing
    local timer t
    local real dmg =  25.00 * I2R(GetUnitAbilityLevelSwapped('A0GC', GetTriggerUnit())) * ( 1 + ( I2R(GetPlayerTechCountSimple('R079', GetOwningPlayer(GetTriggerUnit())))) * 0.33)
    local real d = 0
    local unit u = GetSpellTargetUnit()
    local location p = GetUnitLoc(GetSpellTargetUnit())
    set t = CreateTimer()
    call SaveUnitHandleBJ( u, GetHandleIdBJ(t), StringHashBJ("DesNet1"), GetLastCreatedHashtableBJ() )
    call SaveRealBJ( GetUnitX(u), GetHandleIdBJ(t), StringHashBJ("DesNet2"), GetLastCreatedHashtableBJ() )
    call SaveRealBJ( GetUnitY(u), GetHandleIdBJ(t), StringHashBJ("DesNet3"), GetLastCreatedHashtableBJ() )
    call SaveRealBJ( 0, GetHandleIdBJ(t), StringHashBJ("DesNetDistance"), GetLastCreatedHashtableBJ() )
    call SaveRealBJ( dmg, GetHandleIdBJ(t), StringHashBJ("DesNetDmg"), GetLastCreatedHashtableBJ() )
    call TimerStart(t, 0.1, true, function DragNet_Sub)
endfunction

//===========================================================================
function InitTrig_DragNet takes nothing returns nothing
    set gg_trg_DragNet = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_DragNet, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_DragNet, Condition( function Trig_DragNet_Conditions ) )
    call TriggerAddAction( gg_trg_DragNet, function Trig_DragNet_Actions )
endfunction


//===========================================================================
// Trigger: Retreat Casting
//===========================================================================
function Trig_retreat_Conditions takes nothing returns boolean
    return GetSpellAbilityId() == 'A0PY'
endfunction

function Trig_retreat_Actions takes nothing returns nothing
    local unit t = GetSpellTargetUnit()
    local unit u = GetSpellAbilityUnit()
///자신 이속 증가 및 후방 데미지 무시 효과
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(u), GetUnitLoc(t), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0PZ', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0PZ', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0PY', u) )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "bloodlust", u )
///도발 효과
    if IsUnitType(GetSpellTargetUnit(), UNIT_TYPE_HERO) == true then
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(u), GetUnitLoc(t), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0J9', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0J9', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0PY', u) )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "acidbomb", t )
    call IssueTargetOrderBJ(t, "attack", u)
    endif
///궁극기 3레벨 이상일 경우 드래그 네트 던짐
    if GetUnitAbilityLevelSwapped('A0FU', udg_Hero_Des) >= 3 and GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) >= 30.00 then
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0GC', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0GC', GetLastCreatedUnit(), 1 )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "lightningshield", GetSpellTargetUnit() )
    call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) - 30.00 ) )
    endif
endfunction

