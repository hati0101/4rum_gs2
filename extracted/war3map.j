function Trig_SoH_Ulti_Damage_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEventDamageSource()) == 'e02H' ) ) then
        return false
    endif
    return true
endfunction

function Trig_SoH_Ulti_Damage_Func003Func002Func001C takes nothing returns boolean
    if ( not ( GetRandomInt(1, 100) >= 40 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SoH_Ulti_Damage_Func003Func002C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R03E', GetOwningPlayer(udg_Hero_SoH)) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SoH_Ulti_Damage_Func003C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(GetEventDamageSource())) >= 700.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SoH_Ulti_Damage_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    call UnitDamageTargetBJ( udg_Hero_SoH, GetTriggerUnit(), ( 150.00 + ( 50.00 * I2R(GetUnitAbilityLevelSwapped('A09W', udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetEventDamageSource()))])) ) ), ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
    if ( Trig_SoH_Ulti_Damage_Func003C() ) then
        call UnitDamageTargetBJ( udg_Hero_SoH, GetTriggerUnit(), ( 0.00 + ( 50.00 * I2R(GetUnitAbilityLevelSwapped('A09W', udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetEventDamageSource()))])) ) ), ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
        if ( Trig_SoH_Ulti_Damage_Func003Func002C() ) then
            if ( Trig_SoH_Ulti_Damage_Func003Func002Func001C() ) then
                call UnitDamageTargetBJ( udg_Hero_SoH, GetTriggerUnit(), ( I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Hero_SoH, true)) * 2.00 ), ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
                call TextTag( "헤드샷!" , udg_Hero_SoH , 10 , 255 , 255 , 255, 3 )
                call TextTag( I2S(R2I(I2R(GetHeroStatBJ(bj_HEROSTAT_AGI, udg_Hero_SoH, true)) * 2 ))+"!" , GetTriggerUnit() , 11 , 255 , 0 , 0, 3 )
            else
            endif
        else
        endif
    else
    endif
    call PolledWait( 1.30 )
    call EnableTrigger( GetTriggeringTrigger() )
endfunction

