function Trig_Skin_of_Invincible_Actions takes nothing returns nothing
    local unit a = GetTriggerUnit()
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    if ( Trig_Skin_of_Invincible_Func003C() ) then
        call UnitApplyTimedLifeBJ( 2.50, 'BTLF', GetLastCreatedUnit() )
    else
    endif
    if ( Trig_Skin_of_Invincible_Func004C() ) then
        call UnitApplyTimedLifeBJ( 5.00, 'BTLF', GetLastCreatedUnit() )
    else
    endif
    if ( Trig_Skin_of_Invincible_Func005C() ) then
        call UnitApplyTimedLifeBJ( 7.50, 'BTLF', GetLastCreatedUnit() )
    else
    endif
    call UnitAddAbilityBJ( 'A0XM', GetLastCreatedUnit() )
    if ( Trig_Skin_of_Invincible_Func007C() ) then
        call CreateNUnitsAtLoc( 1, 'e03F', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        if ( Trig_Skin_of_Invincible_Func007Func002C() ) then
            call UnitApplyTimedLifeBJ( 5.00, 'BTLF', GetLastCreatedUnit() )
        else
        endif
        if ( Trig_Skin_of_Invincible_Func007Func003C() ) then
            call UnitApplyTimedLifeBJ( 7.50, 'BTLF', GetLastCreatedUnit() )
        else
        endif
        if ( Trig_Skin_of_Invincible_Func007Func004C() ) then
            call UnitApplyTimedLifeBJ( 10.00, 'BTLF', GetLastCreatedUnit() )
        else
        endif
        call TextTag( "불굴의 의지!" , a , 13 , 120 , 120 , 120, 3 )
    else
    endif
endfunction

