//===========================================================================
// Trigger: ChainBoom Start
//===========================================================================
function Trig_ChainBoom_Start_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A09X' ) ) then
        return false
    endif
    return true
endfunction

function Trig_ChainBoom_Start_Actions takes nothing returns nothing
    local unit target = GetSpellTargetUnit()
    local integer i = 0
    loop
    set i = i + 1
    if ( ( IsUnitAliveBJ(target) == true ) ) then
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(udg_Hero_LOI_Hero), GetUnitLoc(target), bj_UNIT_FACING )
    call AddSpecialEffectLocBJ( GetUnitLoc(target), "Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0Z5', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0Z5', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A09X', GetTriggerUnit()) )
    call IssueImmediateOrderBJ( GetLastCreatedUnit(), "stomp" )
    call TriggerSleepAction( 1.00 )
    endif
    if ( IsUnitEnemy( target, GetOwningPlayer(udg_Hero_LOI_Hero)) == true ) then
    if ( IsUnitType( target, UNIT_TYPE_MAGIC_IMMUNE) == true ) then
    set i = 3
    endif
    if IsUnitInvulnerable( target ) then
    set i = 3
    endif
    endif
    exitwhen i >= 3
    endloop
    set target = null
endfunction

