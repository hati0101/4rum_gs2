//===========================================================================
// Trigger: Asura
//===========================================================================
function Trig_Asura_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0EY' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Asura_Func005C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I011') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Asura_Func007C takes nothing returns boolean
    if ( not ( ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) + 0.00 ) < ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, udg_Hero_Mon_AsuraTarget) * 0.30 ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Asura_Func008Func007C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R04V', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Asura_Func008C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_Mon_AsuraTarget) == true ) ) then
        return false
    endif
    if ( not ( DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(udg_Hero_Mon_AsuraTarget)) <= 1400.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Asura_Actions takes nothing returns nothing
    set udg_Hero_Mon_AsuraTarget = GetSpellTargetUnit()
    call PauseUnitBJ( true, GetTriggerUnit() )
    call PolledWait( 0.20 )
    if ( Trig_Asura_Func005C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        set udg_Hero_Mon_Asura_True = GetLastCreatedUnit()
        call UnitAddItemByIdSwapped( 'I011', udg_Hero_Mon_Asura_True )
    else
    endif
    set udg_Hero_Mon_AsuraMana = ( ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, udg_Hero_Mon_AsuraTarget) * 0.30 ) * ( ( 0.50 + ( I2R(GetUnitAbilityLevelSwapped('A0EY', GetTriggerUnit())) * 0.25 ) ) + 0.00 ) )
    if ( Trig_Asura_Func007C() ) then
        set udg_Hero_Mon_AsuraMana = ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) * ( ( 0.50 + ( I2R(GetUnitAbilityLevelSwapped('A0EY', GetTriggerUnit())) * 0.25 ) ) + 0.00 ) )
    else
    endif
    if ( Trig_Asura_Func008C() ) then
        call PlaySoundBJ( gg_snd_Monk_Asura )
        call SetUnitPositionLoc( GetTriggerUnit(), PolarProjectionBJ(GetUnitLoc(udg_Hero_Mon_AsuraTarget), 125.00, AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(udg_Hero_Mon_AsuraTarget))) )
        call SetUnitAnimation( GetTriggerUnit(), "attack" )
        call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) - ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, udg_Hero_Mon_AsuraTarget) * 0.30 ) ) )
        call AbsoluteDamage(GetTriggerUnit(),udg_Hero_Mon_AsuraTarget, udg_Hero_Mon_AsuraMana + 20)
        call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_Mon_AsuraTarget), "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl" )
        if ( Trig_Asura_Func008Func007C() ) then
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A083', GetLastCreatedUnit() )
            call IssueTargetOrderBJ( GetLastCreatedUnit(), "drunkenhaze", udg_Hero_Mon_AsuraTarget )
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A08Y', GetLastCreatedUnit() )
            call IssueTargetOrderBJ( GetLastCreatedUnit(), "bloodlust", GetTriggerUnit() )
        else
        endif
    else
    endif
    call PolledWait( 0.30 )
    call PauseUnitBJ( false, GetTriggerUnit() )
    set udg_Hero_Mon_AsuraTarget = null
    set udg_Hero_Mon_AsuraMana = 0.00
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call RemoveUnit( udg_Hero_Mon_Asura_True )
endfunction

//===========================================================================
function InitTrig_Asura takes nothing returns nothing
    set gg_trg_Asura = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Asura, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Asura, Condition( function Trig_Asura_Conditions ) )
    call TriggerAddAction( gg_trg_Asura, function Trig_Asura_Actions )
endfunction

