function Trig_Death_Callng_Actions takes nothing returns nothing
    call ReplaceUnitBJ( GetSummonedUnit(), GetUnitTypeId(GetSummonedUnit()), bj_UNIT_STATE_METHOD_RELATIVE )
    call SetUnitExplodedBJ( GetLastReplacedUnitBJ(), true )
    call SetUnitUseFoodBJ( false, GetLastReplacedUnitBJ() )
    call SetUnitVertexColorBJ( GetLastReplacedUnitBJ(), 100, 35.00, 35.00, 0 )
    call UnitRemoveTypeBJ( UNIT_TYPE_UNDEAD, GetLastReplacedUnitBJ() )
    call UnitAddTypeBJ( UNIT_TYPE_SUMMONED, GetLastReplacedUnitBJ() )
    call UnitApplyTimedLifeBJ( 45.00, 'BEfn', GetLastReplacedUnitBJ() )
    call ForGroupBJ( GetUnitsInRectAll(GetPlayableMapRect()), function Trig_Death_Callng_Func008A )
    if ( Trig_Death_Callng_Func009C() ) then
        call RemoveUnit( GetLastReplacedUnitBJ() )
    else
    endif
endfunction

