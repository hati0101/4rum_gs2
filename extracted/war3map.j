function Trig_Anti_Mage_Actions takes nothing returns nothing
    if ( Trig_Anti_Mage_Func001C() ) then
        call UnitRemoveBuffBJ( 'B0C4', GetTriggerUnit() )
        call UnitDamageTargetBJ( GetEventDamageSource(), GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MAX_MANA, GetTriggerUnit()) * 0.03 ), ATTACK_TYPE_MELEE, DAMAGE_TYPE_FIRE )
        call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) - ( GetUnitStateSwap(UNIT_STATE_MAX_MANA, GetTriggerUnit()) * 0.03 ) ) )
    else
        call UnitRemoveBuffBJ( 'B0C4', GetTriggerUnit() )
        call UnitDamageTargetBJ( GetEventDamageSource(), GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MAX_MANA, GetTriggerUnit()) * 0.05 ), ATTACK_TYPE_MELEE, DAMAGE_TYPE_FIRE )
        call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) - ( GetUnitStateSwap(UNIT_STATE_MAX_MANA, GetTriggerUnit()) * 0.05 ) ) )
    endif
endfunction

