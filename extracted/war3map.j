    call TriggerRegisterAnyUnitEventBJ( gg_trg_OgL_Skill_Effect, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_OgL_Skill_Effect, Condition( function Trig_OgL_Skill_Effect_Conditions ) )
