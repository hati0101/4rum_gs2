//===========================================================================
// Trigger: BlK Special 4
//
// 다리 절단
//===========================================================================
function Trig_BlK_Special_4_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetAttacker()) == 'Hpb1' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R03Q', GetOwningPlayer(GetAttacker())) == 1 ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetAttackedUnitBJ(), UNIT_TYPE_STRUCTURE) != true ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(GetAttackedUnitBJ(), GetOwningPlayer(GetAttacker())) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_BlK_Special_4_Actions takes nothing returns nothing
    local integer rand = GetRandomInt( 1 , 100 )
    local integer chance = 20 // 발동 확률
    if ( rand <= chance ) then
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_Hero_BlK_Loc[3] = GetUnitLoc(GetAttacker())
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetAttacker()), udg_Hero_BlK_Loc[3], bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0YG', GetLastCreatedUnit() )
    call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
    call TextTag( "제압!" , GetAttacker() , 13 , 120 , 120 , 120, 3 )
    call PolledWait( 8.00 )
    call EnableTrigger( GetTriggeringTrigger() )
    else
    endif
    call RemoveLocation( udg_Hero_BlK_Loc[3] )
endfunction

