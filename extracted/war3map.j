        return false
    endif
    if ( not ( DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(LoadUnitHandleBJ(StringHashBJ("AbW"), StringHashBJ("Hero"), GetLastCreatedHashtableBJ()))) < 700.00 ) ) then
        return false
