        return false
    endif
    return true
endfunction

function Trig_Moon_Strike_Execute_Func004C takes nothing returns boolean
    if ( not ( udg_Hero_MoW_UltiTimes < 3 ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Hero_DaW_UltiTarget) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Hero_DaW_UltiCaster) == true ) ) then
        return false
    endif
    if ( not ( DistanceBetweenPoints(GetUnitLoc(udg_Hero_DaW_UltiCaster), GetUnitLoc(udg_Hero_DaW_UltiTarget)) <= 1000.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Moon_Strike_Execute_Actions takes nothing returns nothing
    call StartTimerBJ( udg_Hero_MoW_UltiTimer, false, 0.25 )
    if ( Trig_Moon_Strike_Execute_Func003C() ) then
        if ( Trig_Moon_Strike_Execute_Func003Func001C() ) then
            call StopSoundBJ( gg_snd_BuildingDeathLargeHuman, false )
            call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_DaW_UltiCaster, "Abilities\\Weapons\\GryphonRiderMissile\\GryphonRiderMissileTarget.mdl" )
            call d_effect(GetLastCreatedEffectBJ(),1)
            call SetUnitPositionLocFacingLocBJ( udg_Hero_DaW_UltiCaster, PolarProjectionBJ(GetUnitLoc(udg_Hero_DaW_UltiTarget), 50.00, GetRandomDirectionDeg()), GetUnitLoc(udg_Hero_DaW_UltiTarget) )
            call SetUnitAnimation( udg_Hero_DaW_UltiCaster, "attack slam" )
            call SetUnitTimeScalePercent( udg_Hero_DaW_UltiCaster, 170.00 )
            call CreateNUnitsAtLocFacingLocBJ( 1, 'o00J', GetOwningPlayer(GetSpellAbilityUnit()), GetUnitLoc(udg_Hero_DaW_UltiCaster), GetUnitLoc(udg_Hero_DaW_UltiTarget) )
            call UnitApplyTimedLifeBJ( 0.20, 'BTLF', GetLastCreatedUnit() )
            call SetUnitTimeScalePercent( GetLastCreatedUnit(), 250.00 )
            call SetUnitVertexColorBJ( GetLastCreatedUnit(), 100, 0.00, 0.00, 75.00 )
            call SetUnitAnimation( GetLastCreatedUnit(), "attack slam" )
        else
        endif
        call PlaySoundAtPointBJ( gg_snd_BuildingDeathLargeHuman, 100, GetUnitLoc(udg_Hero_DaW_UltiCaster), 500.00 )
        call TriggerSleepAction( 0.00 )
        if ( Trig_Moon_Strike_Execute_Func003Func004C() ) then
            call SetUnitTimeScalePercent( udg_Hero_DaW_UltiCaster, 70.00 )
            if ( Trig_Moon_Strike_Execute_Func003Func004Func002C() ) then
                call UnitDamageTarget(udg_Hero_DaW_UltiCaster,udg_Hero_DaW_UltiTarget,udg_Hero_MoW_UltiDamage[1],false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,null)
            else
                call UnitDamageTarget(udg_Hero_DaW_UltiCaster,udg_Hero_DaW_UltiTarget,udg_Hero_MoW_UltiDamage[1]*0.5,false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,null)
            endif
            call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_DaW_UltiTarget), "Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl" )
            call d_effect(GetLastCreatedEffectBJ(),1)
            call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_DaW_UltiTarget), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl" )
            call d_effect(GetLastCreatedEffectBJ(),1)
        else
        endif
    else
    endif
    if ( Trig_Moon_Strike_Execute_Func004C() ) then
        set udg_Hero_MoW_UltiTimes = ( udg_Hero_MoW_UltiTimes + 1 )
    else
        call DisableTrigger( GetTriggeringTrigger() )
        call TriggerExecute( gg_trg_Moon_Strike_Finish )
    endif
endfunction

