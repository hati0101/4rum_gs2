    if ( not ( SubStringBJ(GetEventPlayerChatString(), 12, StringLength(GetEventPlayerChatString())) != "" ) ) then
        return false
    endif
    return true
endfunction

function Trig_Single_Manekin_Actions takes nothing returns nothing
    if ( Trig_Single_Manekin_Func002C() ) then
        if ( Trig_Single_Manekin_Func002Func003C() ) then
            set bj_forLoopAIndex = 1
            set bj_forLoopAIndexEnd = udg_HeroMax[3]
            loop
                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                if ( Trig_Single_Manekin_Func002Func003Func004Func001C() ) then
                    call CreateNUnitsAtLoc( 1, udg_Hero[GetForLoopIndexA()], Player(7), GetRectCenter(GetPlayableMapRect()), bj_UNIT_FACING )
                    set udg_HeroPlayer[8] = GetLastCreatedUnit()
                    call AddHeroXPSwapped( 3000, GetLastCreatedUnit(), true )
                    return
                else
                endif
                set bj_forLoopAIndex = bj_forLoopAIndex + 1
            endloop
            call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_1527" )
        else
            set bj_forLoopAIndex = 1
            set bj_forLoopAIndexEnd = udg_HeroMax[3]
            loop
                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                if ( Trig_Single_Manekin_Func002Func003Func001Func001C() ) then
                    call CreateNUnitsAtLoc( 1, udg_Hero[GetForLoopIndexA()], Player(1), GetRectCenter(GetPlayableMapRect()), bj_UNIT_FACING )
                    set udg_HeroPlayer[2] = GetLastCreatedUnit()
                    call AddHeroXPSwapped( 3000, GetLastCreatedUnit(), true )
                    return
                else
                    call RemoveUnit( GetLastCreatedUnit() )
                endif
                set bj_forLoopAIndex = bj_forLoopAIndex + 1
            endloop
            call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_1520" )
        endif
    else
        call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_1518" )
    endif
endfunction

