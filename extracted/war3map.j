function Trig_Setting_MapNTimer_Actions takes nothing returns nothing
    call GS2R2_Init()
    call DisplayTimedTextToForce( GetPlayersAll(), 2.00, "TRIGSTR_1849" )
    call StartTimerBJ( udg_Goldgive, true, 6.00 )
    call StartTimerBJ( udg_UnitCreate, false, 120.00 )
    call StartTimerBJ( udg_MBTime, false, 9999999.00 )
    call SetMapFlag( MAP_LOCK_RESOURCE_TRADING, true )
    set udg_Force[1] = Player(0)
    set udg_Force[2] = Player(6)
    call SetPlayerAllianceStateBJ( udg_Force[1], Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL )
    call SetPlayerAllianceStateBJ( Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Force[1], bj_ALLIANCE_NEUTRAL )
    call SetPlayerAllianceStateBJ( udg_Force[2], Player(PLAYER_NEUTRAL_AGGRESSIVE), bj_ALLIANCE_NEUTRAL )
    call SetPlayerAllianceStateBJ( Player(PLAYER_NEUTRAL_AGGRESSIVE), udg_Force[2], bj_ALLIANCE_NEUTRAL )
    call SetPlayerAllianceStateBJ( udg_Force[1], udg_Force[2], bj_ALLIANCE_UNALLIED )
    call SetPlayerAllianceStateBJ( udg_Force[2], udg_Force[1], bj_ALLIANCE_UNALLIED )
    call SetPlayerColorBJ( udg_Force[1], PLAYER_COLOR_RED, true )
    call SetPlayerColorBJ( udg_Force[2], PLAYER_COLOR_GREEN, true )
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_SP_PlayerName[GetForLoopIndexA()] = GetPlayerName(ConvertedPlayer(GetForLoopIndexA()))
        set udg_SP_Player[GetForLoopIndexA()] = ConvertedPlayer(GetForLoopIndexA())
        set udg_SP_Number[GetForLoopIndexA()] = GetForLoopIndexA()
        set udg_HeroRepick[GetForLoopIndexA()] = true
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call ForGroupBJ( GetUnitsInRectAll(GetPlayableMapRect()), function Trig_Setting_MapNTimer_Func017A )
    call CreateNUnitsAtLoc( 1, 'ewsp', Player(0), GetRectCenter(GetPlayableMapRect()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0BV', GetLastCreatedUnit() )
    call IssueImmediateOrderBJ( GetLastCreatedUnit(), "resurrection" )
    call CreateNUnitsAtLoc( 1, 'ewsp', Player(0), GetRectCenter(GetPlayableMapRect()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0BV', GetLastCreatedUnit() )
    call IssueImmediateOrderBJ( GetLastCreatedUnit(), "resurrection" )
    call PolledWait( 0.80 )
    call ForGroupBJ( GetUnitsInRectAll(GetPlayableMapRect()), function Trig_Setting_MapNTimer_Func027A )
    call ForGroupBJ( GetUnitsInRectAll(GetPlayableMapRect()), function Trig_Setting_MapNTimer_Func028A )
    call ForGroupBJ( GetUnitsInRectAll(GetPlayableMapRect()), function Trig_Setting_MapNTimer_Func029A )
    call ForGroupBJ( GetUnitsInRectAll(GetPlayableMapRect()), function Trig_Setting_MapNTimer_Func030A )
    call SetUnitUserData( gg_unit_hbar_0018, 1 )
    call SetUnitUserData( gg_unit_negf_0019, 1 )
    call SetUnitUserData( gg_unit_negf_0020, 1 )
    call SetUnitUserData( gg_unit_hbar_0015, 2 )
    call SetUnitUserData( gg_unit_negf_0016, 2 )
    call SetUnitUserData( gg_unit_negf_0017, 2 )
    call SetUnitUserData( gg_unit_hbar_0021, 3 )
    call SetUnitUserData( gg_unit_n012_0086, 3 )
    call SetUnitUserData( gg_unit_n012_0087, 3 )
    call SetUnitUserData( gg_unit_usep_0035, 4 )
    call SetUnitUserData( gg_unit_ntx2_0033, 4 )
    call SetUnitUserData( gg_unit_ntx2_0034, 4 )
    call SetUnitUserData( gg_unit_usep_0036, 5 )
    call SetUnitUserData( gg_unit_ntx2_0038, 5 )
    call SetUnitUserData( gg_unit_ntx2_0039, 5 )
    call SetUnitUserData( gg_unit_usep_0037, 6 )
    call SetUnitUserData( gg_unit_n013_0022, 6 )
    call SetUnitUserData( gg_unit_n013_0023, 6 )
    call PolledWait( 0.10 )
    call EnumDestructablesInRectAll( GetPlayableMapRect(), function Trig_Setting_MapNTimer_Func050A )
    call FogMaskEnableOff(  )
    call FogEnableOff(  )
    call FogEnableOn(  )
endfunction

