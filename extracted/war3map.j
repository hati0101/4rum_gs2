//
// if ( GetPlayerTechCountSimple('R08G', GetOwningPlayer(GetTriggerUnit())) > 0 ) then
//===========================================================================
function Trig_Soul_Crush_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0JN' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Soul_Crush_Func001C takes nothing returns boolean
    if ( not ( udg_Hero_DeM_Soul >= 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Soul_Crush_Actions takes nothing returns nothing
    if ( Trig_Soul_Crush_Func001C() ) then
        call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), ( ( 50.00 + ( 90.00 * I2R(GetUnitAbilityLevelSwapped('A0JN', GetTriggerUnit())) ) ) * ( 1.10 + ( I2R(GetUnitAbilityLevelSwapped('A00K', GetTriggerUnit())) * 0.10 ) ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        set udg_Hero_DeM_Soul = ( udg_Hero_DeM_Soul - 5 )
        call TextTagForce( I2S(udg_Hero_DeM_Soul), GetTriggerUnit(), 10,255, 50, 150, 3, GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())) )
    else
        call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), ( ( 50.00 + ( 90.00 * I2R(GetUnitAbilityLevelSwapped('A0JN', GetTriggerUnit())) ) ) * 1.00 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    endif
    call CreateNUnitsAtLoc( 1, 'e022', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetSpellTargetUnit()), GetRandomDirectionDeg() )
    call KillUnit( GetLastCreatedUnit() )
    call CreateNUnitsAtLoc( 1, 'e022', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetSpellTargetUnit()), GetRandomDirectionDeg() )
    call KillUnit( GetLastCreatedUnit() )
    call AddSpecialEffectLocBJ( GetUnitLoc(GetSpellTargetUnit()), "Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
endfunction

