function Trig_Vampires_Lord_Special_Actions takes nothing returns nothing
    if ( Trig_Vampires_Lord_Special_Func002C() ) then
        call AdjustPlayerStateBJ( 350, GetOwningPlayer(GetKillingUnitBJ()), PLAYER_STATE_RESOURCE_GOLD )
        call SetUnitLifePercentBJ( udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))], ( GetUnitLifePercent(udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) + 25.00 ) )
        call SetUnitManaPercentBJ( udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))], ( GetUnitManaPercent(udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) + 25.00 ) )
        call TextTag( "카사노바!" , GetTriggerUnit() , 10 , 255 , 255 , 150, 3 )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Vampires_Lord_Special takes nothing returns nothing
    set gg_trg_Vampires_Lord_Special = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Vampires_Lord_Special, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Vampires_Lord_Special, Condition( function Trig_Vampires_Lord_Special_Conditions ) )
    call TriggerAddAction( gg_trg_Vampires_Lord_Special, function Trig_Vampires_Lord_Special_Actions )
endfunction

//===========================================================================
// Trigger: Vampires Lord Special 2 Phoenix
//
// if ( GetUnitTypeId(DeadHero) == 'Hamg' ) then
// if ( udg_Phoenix_Killer != null ) then
//     set KillHero = udg_Phoenix_Killer
//     set KillPlayer = GetOwningPlayer(KillHero)
//     set udg_Phoenix_Killer = null
// endif
// endif
//===========================================================================
function Trig_Vampires_Lord_Special_2_Phoenix_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetDyingUnit()) == 'Hamg' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(udg_Hero_PhM_PhoenixKiller) == 'Udre' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R02W', GetOwningPlayer(udg_Hero_PhM_PhoenixKiller)) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Vampires_Lord_Special_2_Phoenix_Actions takes nothing returns nothing
    call AdjustPlayerStateBJ( 350, GetOwningPlayer(udg_Hero_PhM_PhoenixKiller), PLAYER_STATE_RESOURCE_GOLD )
    call SetUnitLifePercentBJ( udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(udg_Hero_PhM_PhoenixKiller))], ( GetUnitLifePercent(udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) + 25.00 ) )
    call SetUnitManaPercentBJ( udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(udg_Hero_PhM_PhoenixKiller))], ( GetUnitManaPercent(udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) + 25.00 ) )
    call TextTag( "카사노바!" , GetTriggerUnit() , 10 , 255 , 255 , 150, 3 )
endfunction

//===========================================================================
function InitTrig_Vampires_Lord_Special_2_Phoenix takes nothing returns nothing
    set gg_trg_Vampires_Lord_Special_2_Phoenix = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Vampires_Lord_Special_2_Phoenix, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Vampires_Lord_Special_2_Phoenix, Condition( function Trig_Vampires_Lord_Special_2_Phoenix_Conditions ) )
    call TriggerAddAction( gg_trg_Vampires_Lord_Special_2_Phoenix, function Trig_Vampires_Lord_Special_2_Phoenix_Actions )
endfunction

//===========================================================================
// Trigger: Vampires Lord Special 4 Learn
//===========================================================================
function Trig_Vampires_Lord_Special_4_Learn_Conditions takes nothing returns boolean
    if ( not ( GetResearched() == 'R02X' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Vampires_Lord_Special_4_Learn_Func003C takes nothing returns boolean
    if ( not ( GetTimeOfDay() >= 6.00 ) ) then
        return false
    endif
    if ( not ( GetTimeOfDay() <= 18.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Vampires_Lord_Special_4_Learn_Actions takes nothing returns nothing
    call CreateNUnitsAtLoc( 1, 'e00I', GetTriggerPlayer(), GetPlayerStartLocationLoc(GetTriggerPlayer()), bj_UNIT_FACING )
    set udg_Hero_VaL_NightUnit = GetLastCreatedUnit()
    if ( Trig_Vampires_Lord_Special_4_Learn_Func003C() ) then
    else
        call UnitAddAbilityBJ( 'S003', udg_Hero_VaL_NightUnit )
    endif
endfunction

//===========================================================================
function InitTrig_Vampires_Lord_Special_4_Learn takes nothing returns nothing
    set gg_trg_Vampires_Lord_Special_4_Learn = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Vampires_Lord_Special_4_Learn, EVENT_PLAYER_UNIT_RESEARCH_FINISH )
    call TriggerAddCondition( gg_trg_Vampires_Lord_Special_4_Learn, Condition( function Trig_Vampires_Lord_Special_4_Learn_Conditions ) )
    call TriggerAddAction( gg_trg_Vampires_Lord_Special_4_Learn, function Trig_Vampires_Lord_Special_4_Learn_Actions )
endfunction

