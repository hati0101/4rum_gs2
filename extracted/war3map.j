function Trig_PhM_Speical_Timer_Func002Func001Func002C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(GetUnitLoc(udg_Hero_PhM_Spunit2), GetUnitLoc(udg_Hero_PhM_SpAttacker)) > 1200.00 ) ) then
