    if ( not ( IsUnitInGroup(udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetEventDamageSource()))], udg_Assi_Group[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]) != true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Assi_Damage_Add_Actions takes nothing returns nothing
    call StartTimerBJ( udg_Assi_Timer[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], false, 10.00 )
    call StartTimerBJ( udg_Assi_Timer_Atk[GetConvertedPlayerId(GetOwningPlayer(GetEventDamageSource()))], false, 10.00 )
    if ( Trig_Assi_Damage_Add_Func007C() ) then
        call GroupAddUnitSimple( udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetEventDamageSource()))], udg_Assi_Group[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] )
    else
    endif
endfunction

