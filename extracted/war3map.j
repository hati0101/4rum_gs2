    set gg_trg_Brave_Assult = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Brave_Assult, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Brave_Assult, Condition( function Trig_Brave_Assult_Conditions ) )
