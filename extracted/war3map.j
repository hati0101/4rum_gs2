    if ( Trig_LoN_Skill_Effect_Func003C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetTriggerPlayer(), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0EP', GetLastCreatedUnit() )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "creepthunderbolt", GetSpellTargetUnit() )
    else
    endif
    if ( Trig_LoN_Skill_Effect_Func004C() ) then
        set udg_Hero_LoN_UltiPoint = GetSpellTargetLoc()
        call CreateNUnitsAtLoc( 1, 'ewsp', GetTriggerPlayer(), GetSpellTargetLoc(), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A10O', GetLastCreatedUnit() )
        call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
        call ForGroupBJ( GetUnitsInRangeOfLocAll(500.00, udg_Hero_LoN_UltiPoint), function Trig_LoN_Skill_Effect_Func004Func006A )
    else
    endif
    if ( Trig_LoN_Skill_Effect_Func005C() ) then
        call PlaySoundBJ( gg_snd_HeroLichYesAttack1 )
    else
    endif
endfunction

