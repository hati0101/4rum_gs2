    call SetUnitLifeBJ( udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetEventDamageSource()))], ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetEventDamageSource()))]) + ( GetEventDamage() * 0.50 ) ) )
    call AddSpecialEffectTargetUnitBJ( "chest", udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetEventDamageSource()))], "Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
endfunction

