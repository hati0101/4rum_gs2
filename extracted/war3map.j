//===========================================================================
// Trigger: Soul Drain
//
// function STTC takes string STRING, force FORCE, unit UNIT, real red, real green, real blue returns nothing
// GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit()))
// Set Souls_Limit = (((((Level of [다크니스 - 데스 메신져] for (Triggering unit)) x 10) + 10) + ((Current research level of [데스 메신져] 영혼 수집가 for (Owner of (Triggering unit))) x 10)) - Souls)
// Set Souls_Limit = (Min(Souls, 5))
//===========================================================================
function Trig_Soul_Drain_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0SQ' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Soul_Drain_Func003001003 takes nothing returns boolean
    return ( IsUnitDeadBJ(GetFilterUnit()) == true )
endfunction

function Trig_Soul_Drain_Func003Func001C takes nothing returns boolean
    if ( not ( udg_Hero_DeM_SoulLimit > 0 ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_HERO) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Soul_Drain_Func003A takes nothing returns nothing
    if ( Trig_Soul_Drain_Func003Func001C() ) then
        call AddSpecialEffectLocBJ( GetUnitLoc(GetEnumUnit()), "Abilities\\Spells\\Undead\\DeathandDecay\\DeathandDecayTarget.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call RemoveUnit( GetEnumUnit() )
        set udg_Hero_DeM_SoulLimit = ( udg_Hero_DeM_SoulLimit - 1 )
        set udg_Hero_DeM_Soul = ( udg_Hero_DeM_Soul + 1 )
    else
        call DoNothing(  )
    endif
endfunction

function Trig_Soul_Drain_Actions takes nothing returns nothing
    set udg_Hero_DeM_SoulLimit = ( ( ( ( GetUnitAbilityLevelSwapped('A00K', GetTriggerUnit()) * 10 ) + 5 ) + ( 10 * GetPlayerTechCountSimple('R08G', GetOwningPlayer(GetSpellAbilityUnit())) ) ) - udg_Hero_DeM_Soul )
    set udg_Hero_DeM_SoulLimit = IMinBJ(udg_Hero_DeM_SoulLimit, ( ( 5 + GetUnitAbilityLevelSwapped('A00K', GetTriggerUnit()) ) + ( GetPlayerTechCountSimple('R08G', GetOwningPlayer(GetTriggerUnit())) * 5 ) ))
    call ForGroupBJ( GetUnitsInRangeOfLocMatching(350.00, GetSpellTargetLoc(), Condition(function Trig_Soul_Drain_Func003001003)), function Trig_Soul_Drain_Func003A )
    call TextTagForce( I2S(udg_Hero_DeM_Soul), GetTriggerUnit(), 10,255, 50, 150, 3, GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())) )
endfunction

