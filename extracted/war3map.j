    if ( not ( GetPlayerTechCountSimple('R09N', GetOwningPlayer(udg_Hero_LeT)) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Satellite_Launcher_Select_Actions takes nothing returns nothing
    call PlaySoundBJ( gg_snd_LeT_Ulti )
    set udg_Hero_ReM_Meca = GetTriggerUnit()
    set udg_Hero_LeM_UltiInt = ( 3 + ( 1 * GetPlayerTechCountSimple('R09N', GetOwningPlayer(udg_Hero_LeT)) ) )
    call UnitAddAbilityBJ( 'A00L', udg_Hero_LeT )
    call SetUnitAbilityLevelSwapped( 'A00L', udg_Hero_LeT, 2 )
    call SetPlayerAbilityAvailableBJ( false, 'A144', GetOwningPlayer(udg_Hero_LeT) )
    if ( Trig_Satellite_Launcher_Select_Func007C() ) then
        call UnitAddAbilityBJ( 'Avul', udg_Hero_ReM_Meca )
    else
    endif
endfunction

