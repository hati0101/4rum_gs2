        return false
    endif
    return true
endfunction

function Trig_Muscle_Death_Actions takes nothing returns nothing
    call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), ( I2R(GetHeroStatBJ(bj_HEROSTAT_STR, GetSpellTargetUnit(), true)) * 6.00 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_DIVINE )
    if ( Trig_Muscle_Death_Func002C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0HO', GetLastCreatedUnit() )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "cripple", GetSpellTargetUnit() )
    else
    endif
endfunction

