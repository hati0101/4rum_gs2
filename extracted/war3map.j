//===========================================================================
// Trigger: ItemMix
//===========================================================================
function Trig_ItemMix_Conditions takes nothing returns boolean
    if ( not ( GetItemUserData(GetManipulatedItem()) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ItemMix_Actions takes nothing returns nothing
    local integer a=0
    loop
    exitwhen a>6
    call SetItemLifeBJ( UnitItemInSlotBJ(GetTriggerUnit(), a), 500.00 )
    call SetItemUserData( UnitItemInSlotBJ(GetTriggerUnit(), a), R2I(GetItemLifeBJ(UnitItemInSlotBJ(GetTriggerUnit(), a))) )
    set a = a+1
    endloop
    set a = 0
    call ItemMix(188, GetTriggerUnit())
    call ItemMix(189, GetTriggerUnit())
    loop
    exitwhen a>6
    if StringLength(udg_ItemMix_DB[GetItemUserData(UnitItemInSlotBJ(GetTriggerUnit(), a))]) > 0 then
    call ItemMix(GetItemUserData(UnitItemInSlotBJ(GetTriggerUnit(), a)), GetTriggerUnit())
    endif
    set a = a+1
    endloop
endfunction

