function Trig_Doom_Lord_Condition_Func002Func001Func002001001002 takes nothing returns boolean
    return ( UnitHasBuffBJ(GetFilterUnit(), 'B0B3') == true )
endfunction

function Trig_Doom_Lord_Condition_Func002Func001C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0IQ' ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(GetUnitsOfPlayerMatching(GetOwningPlayer(GetTriggerUnit()), Condition(function Trig_Doom_Lord_Condition_Func002Func001Func002001001002))) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Doom_Lord_Condition_Func002C takes nothing returns boolean
    if ( Trig_Doom_Lord_Condition_Func002Func001C() ) then
        return true
    endif
    return false
endfunction

function Trig_Doom_Lord_Condition_Conditions takes nothing returns boolean
    if ( not Trig_Doom_Lord_Condition_Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Doom_Lord_Condition_Func001Func004001001002 takes nothing returns boolean
    return ( UnitHasBuffBJ(GetFilterUnit(), 'B0B3') == true )
endfunction

function Trig_Doom_Lord_Condition_Func001C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0IQ' ) ) then
        return false
    endif
    if ( not ( CountUnitsInGroup(GetUnitsOfPlayerMatching(GetOwningPlayer(GetTriggerUnit()), Condition(function Trig_Doom_Lord_Condition_Func001Func004001001002))) == 0 ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R01F', GetOwningPlayer(GetTriggerUnit())) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Doom_Lord_Condition_Actions takes nothing returns nothing
    if ( Trig_Doom_Lord_Condition_Func001C() ) then
        call DisplayTimedTextToForce( GetForceOfPlayer(GetTriggerPlayer()), 10.00, "TRIGSTR_204" )
        call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
    else
    endif
endfunction

