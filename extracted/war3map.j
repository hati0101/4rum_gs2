//===========================================================================
// Trigger: Brave Assult Effect
//===========================================================================
function Trig_Brave_Assult_Effect_2_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A078' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Brave_Assult_Effect_2_Actions takes nothing returns nothing
    local unit u
    local unit v
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    set u = CreateUnitAtLoc( GetOwningPlayer(GetTriggerUnit()), 'nchg', PolarProjectionBJ(GetUnitLoc(GetSpellTargetUnit()), DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(GetSpellTargetUnit())), ( AngleBetweenPoints(GetUnitLoc(GetSpellTargetUnit()), GetUnitLoc(GetTriggerUnit())) + 10.00 )), ( AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(GetSpellTargetUnit())) - 10.00 ) )
    call AddSpecialEffectTargetUnitBJ( "origin", u, "Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call SetUnitAnimation( u, "attack slam" )
    call SetUnitTimeScalePercent( u, 150.00 )
    call SetUnitVertexColorBJ( u, 100, 100, 100, 50.00 )
    set v = CreateUnitAtLoc( GetOwningPlayer(GetTriggerUnit()), 'nchg', PolarProjectionBJ(GetUnitLoc(GetSpellTargetUnit()), DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(GetSpellTargetUnit())), ( AngleBetweenPoints(GetUnitLoc(GetSpellTargetUnit()), GetUnitLoc(GetTriggerUnit())) - 10.00 )), ( AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(GetSpellTargetUnit())) + 10.00 ) )
    call AddSpecialEffectTargetUnitBJ( "origin", v, "Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call SetUnitAnimation( v, "attack slam" )
    call SetUnitVertexColorBJ( v, 100, 100, 100, 50.00 )

    call PolledWait( 0.70 )
    call RemoveUnit( u )
    call PolledWait( 0.10 )
    call RemoveUnit( v )

    set u = null
    set v = null
endfunction

//===========================================================================
function InitTrig_Brave_Assult_Effect takes nothing returns nothing
    set gg_trg_Brave_Assult_Effect = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Brave_Assult_Effect, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Brave_Assult_Effect, Condition( function Trig_Brave_Assult_Effect_2_Conditions ) )
    call TriggerAddAction( gg_trg_Brave_Assult_Effect, function Trig_Brave_Assult_Effect_2_Actions )
endfunction


