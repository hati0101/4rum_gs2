                call IssueTargetOrderBJ( GetLastCreatedUnit(), "cripple", GetSpellTargetUnit() )
            else
            endif
        else
        endif
    else
    endif
    if ( Trig_Inq_Skill_Effect_Func003C() ) then
        call PlaySoundBJ( gg_snd_HowlOfTerror )
        call CreateNUnitsAtLoc( 1, 'e013', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetSpellTargetUnit()), bj_UNIT_FACING )
