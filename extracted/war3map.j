    set gg_trg_Fell_Prince_Special_1 = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Fell_Prince_Special_1, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Fell_Prince_Special_1, Condition( function Trig_Fell_Prince_Special_1_Conditions ) )
    call TriggerAddAction( gg_trg_Fell_Prince_Special_1, function Trig_Fell_Prince_Special_1_Actions )
endfunction

