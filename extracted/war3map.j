//===========================================================================
// Trigger: Chaos Witch Sp2
//===========================================================================
function Trig_Chaos_Witch_Sp2_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetDyingUnit()) == 'Nbrn' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R018', GetOwningPlayer(GetDyingUnit())) == 1 ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( GetPlayerController(GetOwningPlayer(GetKillingUnitBJ())) == MAP_CONTROL_USER ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(GetKillingUnitBJ(), GetOwningPlayer(GetDyingUnit())) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Chaos_Witch_Sp2_Func003C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R017', GetOwningPlayer(udg_Hero_ChW)) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Chaos_Witch_Sp2_Func004Func001Func006C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R017', GetOwningPlayer(udg_Hero_ChW)) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Chaos_Witch_Sp2_Func004Func001C takes nothing returns boolean
    if ( not ( ConvertedPlayer(GetForLoopIndexA()) != GetOwningPlayer(GetKillingUnitBJ()) ) ) then
        return false
    endif
    if ( not ( GetPlayerController(ConvertedPlayer(GetForLoopIndexA())) == MAP_CONTROL_USER ) ) then
        return false
    endif
    if ( not ( IsPlayerEnemy(ConvertedPlayer(GetForLoopIndexA()), GetOwningPlayer(GetTriggerUnit())) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_HeroPlayer[GetForLoopIndexA()]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Chaos_Witch_Sp2_Actions takes nothing returns nothing
    call TextTag( "예정된 복수" , GetDyingUnit() , 10 , 255 , 50 , 150, 3 )
    set udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] = ( udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] + 6 )
    if ( Trig_Chaos_Witch_Sp2_Func003C() ) then
        set udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] = IMinBJ(15, udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))])
    else
        set udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))] = IMinBJ(12, udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))])
    endif
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Chaos_Witch_Sp2_Func004Func001C() ) then
            set udg_Hero_ChW_Curse[GetForLoopIndexA()] = ( udg_Hero_ChW_Curse[GetForLoopIndexA()] + 3 )
            if ( Trig_Chaos_Witch_Sp2_Func004Func001Func006C() ) then
                set udg_Hero_ChW_Curse[GetForLoopIndexA()] = IMinBJ(15, udg_Hero_ChW_Curse[GetForLoopIndexA()])
            else
                set udg_Hero_ChW_Curse[GetForLoopIndexA()] = IMinBJ(12, udg_Hero_ChW_Curse[GetForLoopIndexA()])
            endif
            call TextTagForce( I2S(udg_Hero_ChW_Curse[GetForLoopIndexA()]), udg_HeroPlayer[GetForLoopIndexA()], 10,255, 50, 150,3, GetPlayersAll() )
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Chaos_Witch_Sp2 takes nothing returns nothing
    set gg_trg_Chaos_Witch_Sp2 = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Chaos_Witch_Sp2, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Chaos_Witch_Sp2, Condition( function Trig_Chaos_Witch_Sp2_Conditions ) )
    call TriggerAddAction( gg_trg_Chaos_Witch_Sp2, function Trig_Chaos_Witch_Sp2_Actions )
endfunction

