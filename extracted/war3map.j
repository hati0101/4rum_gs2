    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_FLYING) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Stomp_Damage_Actions takes nothing returns nothing
    call UnitAddAbilityBJ( 'Arav', GetTriggerUnit() )
    call UnitRemoveAbilityBJ( 'Arav', GetTriggerUnit() )
    call UnitDamageTargetBJ( udg_Hero_DrK, GetTriggerUnit(), ( 40.00 + ( 60.00 * I2R(GetUnitAbilityLevelSwapped('A0VD', udg_Hero_DrK)) ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    if ( Trig_Stomp_Damage_Func004C() ) then
        call PolledWait( 0.40 )
    else
        call SetUnitFlyHeightBJ( GetTriggerUnit(), 400.00, 1600.00 )
        call PolledWait( 0.10 )
        call SetUnitFlyHeightBJ( GetTriggerUnit(), 500.00, 500.00 )
        call PolledWait( 0.10 )
        call SetUnitFlyHeightBJ( GetTriggerUnit(), 0.00, 1000.00 )
        call PolledWait( 0.10 )
        call SetUnitFlyHeightBJ( GetTriggerUnit(), 0.00, 1500.00 )
    endif
endfunction

