//===========================================================================
function Trig_PoD_Skill_Effect_Func008Func003C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A00G' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R002', GetTriggerPlayer()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_PoD_Skill_Effect_Func008C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A003' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A02R' ) ) then
        return true
    endif
    if ( Trig_PoD_Skill_Effect_Func008Func003C() ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0JA' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A005' ) ) then
        return true
    endif
    return false
endfunction

function Trig_PoD_Skill_Effect_Conditions takes nothing returns boolean
    if ( not Trig_PoD_Skill_Effect_Func008C() ) then
        return false
    endif
    return true
endfunction

function Trig_PoD_Skill_Effect_Func003Func014C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R003', GetTriggerPlayer()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_PoD_Skill_Effect_Func003C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A003' ) ) then
        return false
    endif
    return true
endfunction

function Trig_PoD_Skill_Effect_Func004Func004C takes nothing returns boolean
    if ( not ( IsUnitAlly(GetSpellTargetUnit(), GetTriggerPlayer()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_PoD_Skill_Effect_Func004C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A02R' ) ) then
        return false
    endif
    return true
endfunction

