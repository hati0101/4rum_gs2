    if ( not ( GetUnitTypeId(GetAttackedUnitBJ()) == 'Ofar' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R02Q', GetOwningPlayer(GetAttackedUnitBJ())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Thunder_Lizard_Special_1_Actions takes nothing returns nothing
    local integer rand = GetRandomInt( 1 , 100 )
    local integer chance = 16 // 발동 확률
    if ( rand <= chance ) then
    call DisableTrigger( GetTriggeringTrigger() )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetAttackedUnitBJ()), GetUnitLoc(GetAttackedUnitBJ()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A096', GetLastCreatedUnit() )
    call IssueImmediateOrderBJ( GetLastCreatedUnit(), "stomp" )
    call TextTag( "야수의 분노!!" , GetAttackedUnitBJ() , 10 , 255 , 255 , 150, 3 )
    call PolledWait( 6.00 )
    call EnableTrigger( GetTriggeringTrigger() )
    else
    endif
endfunction

