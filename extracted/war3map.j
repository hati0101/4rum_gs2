    if ( not ( IsUnitDeadBJ(udg_Hero_PhM_Ultunit) == true ) ) then
        return false
    endif
    if ( not ( IsUnitDeadBJ(udg_Hero_PhM) == true ) ) then
        return false
    endif
    return true
endfunction

