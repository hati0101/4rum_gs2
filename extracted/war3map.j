//===========================================================================
// Trigger: Skill Remove
//
// 카이 A02R,A006,A005,A031,A032,A0JD,S00J,A0JC
// 시노부(히든) A0YR,A0ML,A13E,A0T0,A13J,A0BE,A09Z,A0ZJ
// 드로우 라이더 A0N9,A13F,A0LI
// 드로우 어쌔신 A0AM,A0AK,A06B,A0AS,A0AT,S002
//===========================================================================
function Trig_Skill_Remove_Actions takes nothing returns nothing
    local unit u = udg_SpeBuilding
/// 카이 ///
    call UnitRemoveAbilityBJ( 'A02R', u )
    call UnitRemoveAbilityBJ( 'A006', u )
    call UnitRemoveAbilityBJ( 'A005', u )
    call UnitRemoveAbilityBJ( 'A031', u )
    call UnitRemoveAbilityBJ( 'A032', u )
    call UnitRemoveAbilityBJ( 'A0JD', u )
    call UnitRemoveAbilityBJ( 'S00J', u )
    call UnitRemoveAbilityBJ( 'A0JC', u )
/// 시노부(히든) ///
    call UnitRemoveAbilityBJ( 'A0YR', u )
    call UnitRemoveAbilityBJ( 'A0ML', u )
    call UnitRemoveAbilityBJ( 'A13E', u )
    call UnitRemoveAbilityBJ( 'A0T0', u )
    call UnitRemoveAbilityBJ( 'A13J', u )
    call UnitRemoveAbilityBJ( 'A0BE', u )
    call UnitRemoveAbilityBJ( 'A09Z', u )
    call UnitRemoveAbilityBJ( 'A0ZJ', u )
/// 드로우 라이더 ///
    call UnitRemoveAbilityBJ( 'A0N9', u )
    call UnitRemoveAbilityBJ( 'A13F', u )
    call UnitRemoveAbilityBJ( 'A0LI', u )
/// 드로우 어쌔신 ///
    call UnitRemoveAbilityBJ( 'A0AM', u )
    call UnitRemoveAbilityBJ( 'A0AK', u )
    call UnitRemoveAbilityBJ( 'A06B', u )
    call UnitRemoveAbilityBJ( 'A0AS', u )
    call UnitRemoveAbilityBJ( 'A0AT', u )
    call UnitRemoveAbilityBJ( 'S002', u )
endfunction

//===========================================================================
function InitTrig_Skill_Remove takes nothing returns nothing
    set gg_trg_Skill_Remove = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Skill_Remove, function Trig_Skill_Remove_Actions )
endfunction


//===========================================================================
// Trigger: Repick
//
// 리픽 한계는 2
//===========================================================================
function Trig_Repick_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())]) != 0 ) ) then
        return false
    endif
    if ( not ( TimerGetElapsed(udg_MBTime) <= 120.00 ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())]) == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())]) != 'H016' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())]) != 'O00M' ) ) then
        return false
    endif
    if ( not ( udg_HeroRepick[GetConvertedPlayerId(GetTriggerPlayer())] == true ) ) then
        return false
    endif
    if ( not ( GetHeroSkillPoints(udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())]) == 1 ) ) then
        return false
    endif
    if ( not ( udg_ModeRandom == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Repick_Func001C takes nothing returns boolean
    if ( not ( udg_RepickTimer[GetConvertedPlayerId(GetTriggerPlayer())] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Repick_Func003C takes nothing returns boolean
    if ( not ( udg_RepickLimit[GetConvertedPlayerId(GetTriggerPlayer())] > 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Repick_Func006C takes nothing returns boolean
    if ( not ( udg_SP_Level == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Repick_Func008Func001C takes nothing returns boolean
    if ( not ( udg_RandHero[GetForLoopIndexA()] == false ) ) then
        return false
    endif
    if ( not ( udg_ModeRandom == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Repick_Func008Func002Func001Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEnumUnit()) == udg_HeroSpeciel[GetForLoopIndexA()] ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetEnumUnit()) == udg_RepickPlayer ) ) then
        return false
    endif
    return true
endfunction

function Trig_Repick_Func008Func002Func001A takes nothing returns nothing
    if ( Trig_Repick_Func008Func002Func001Func001C() ) then
        call RemoveUnit( GetEnumUnit() )
    else
    endif
endfunction

function Trig_Repick_Func008Func002Func002Func001C takes nothing returns boolean
    if ( not ( udg_ModeRandom == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_HeroPlayer[GetForLoopIndexB()]) != true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Repick_Func008Func002C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_HeroPlayer[GetConvertedPlayerId(udg_RepickPlayer)]) == udg_Hero[GetForLoopIndexA()] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Repick_Func009Func001C takes nothing returns boolean
    if ( not ( 'I08I' != GetItemTypeId(UnitItemInSlotBJ(udg_HeroPlayer[GetConvertedPlayerId(udg_RepickPlayer)], GetForLoopIndexA())) ) ) then
        return false
    endif
    if ( not ( 'I06G' != GetItemTypeId(UnitItemInSlotBJ(udg_HeroPlayer[GetConvertedPlayerId(udg_RepickPlayer)], GetForLoopIndexA())) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Repick_Func011C takes nothing returns boolean
    if ( not ( udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())] == udg_Hero_Ele ) ) then
        return false
    endif
    return true
endfunction

function Trig_Repick_Func013Func001Func002C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'o00F' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'o00B' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'e00C' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'e00D' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'o001' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'n00N' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'e02A' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'e02G' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'e02K' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Repick_Func013Func001C takes nothing returns boolean
    if ( not Trig_Repick_Func013Func001Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Repick_Func013A takes nothing returns nothing
    if ( Trig_Repick_Func013Func001C() ) then
        call RemoveUnit( GetEnumUnit() )
    else
    endif
endfunction

function Trig_Repick_Actions takes nothing returns nothing
    if ( Trig_Repick_Func001C() ) then
        return
    else
    endif
    set udg_RepickLimit[GetConvertedPlayerId(GetTriggerPlayer())] = ( udg_RepickLimit[GetConvertedPlayerId(GetTriggerPlayer())] + 1 )
    if ( Trig_Repick_Func003C() ) then
        call DisplayTextToForce( GetForceOfPlayer(GetTriggerPlayer()), "TRIGSTR_1431" )
        return
    else
    endif
    set udg_RepickPlayer = GetTriggerPlayer()
    call MultiboardSetItemStyleBJ( GetLastCreatedMultiboard(), 1, ( udg_SP_Number[GetConvertedPlayerId(udg_RepickPlayer)] + 1 ), false, false )
    if ( Trig_Repick_Func006C() ) then
        call SetPlayerName( GetTriggerPlayer(), ( "플레이어 " + I2S(udg_SP_Number[GetConvertedPlayerId(GetTriggerPlayer())]) ) )
        call MultiboardSetItemValueBJ( udg_MB, 1, ( udg_SP_Number[GetConvertedPlayerId(GetTriggerPlayer())] + 1 ), ( ( udg_Colors[udg_SP_Number[GetConvertedPlayerId(GetTriggerPlayer())]] + GetPlayerName(GetTriggerPlayer()) ) + "|r" ) )
    else
    endif
    call DisplayTimedTextToForce( GetPlayersEnemies(GetTriggerPlayer()), 30.00, ( ( ( udg_Colors[udg_SP_Number[GetConvertedPlayerId(GetTriggerPlayer())]] + GetPlayerName(GetTriggerPlayer()) ) + "|r님의 " ) + ( GetUnitName(udg_HeroPlayer[GetConvertedPlayerId(udg_RepickPlayer)]) + " 영웅을 포기합니다." ) ) )
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = udg_HeroMax[3]
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Repick_Func008Func001C() ) then
            call SetPlayerTechMaxAllowedSwap( udg_Hero[GetForLoopIndexA()], 1, udg_RepickPlayer )
        else
        endif
        if ( Trig_Repick_Func008Func002C() ) then
            call ForGroupBJ( GetUnitsInRectAll(GetPlayableMapRect()), function Trig_Repick_Func008Func002Func001A )
            set bj_forLoopBIndex = 1
            set bj_forLoopBIndexEnd = 12
            loop
                exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
                if ( Trig_Repick_Func008Func002Func002Func001C() ) then
                    call SetPlayerTechMaxAllowedSwap( udg_Hero[GetForLoopIndexA()], 1, ConvertedPlayer(GetForLoopIndexB()) )
                else
                endif
                set bj_forLoopBIndex = bj_forLoopBIndex + 1
            endloop
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 6
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Repick_Func009Func001C() ) then
            call UnitRemoveItemSwapped( UnitItemInSlotBJ(udg_HeroPlayer[GetConvertedPlayerId(udg_RepickPlayer)], GetForLoopIndexA()), udg_HeroPlayer[GetConvertedPlayerId(udg_RepickPlayer)] )
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call RemoveUnit( udg_HeroPlayer[GetConvertedPlayerId(udg_RepickPlayer)] )
    if ( Trig_Repick_Func011C() ) then
        call TriggerExecute( gg_trg_EleHar_Repick )
    else
    endif
    set udg_HeroPlayer[GetConvertedPlayerId(udg_RepickPlayer)] = null
    call ForGroupBJ( GetUnitsInRectOfPlayer(GetPlayableMapRect(), udg_RepickPlayer), function Trig_Repick_Func013A )
    call ConditionalTriggerExecute( gg_trg_Random_Hero )
endfunction

//===========================================================================
function InitTrig_Repick takes nothing returns nothing
    set gg_trg_Repick = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Repick, Condition( function Trig_Repick_Conditions ) )
    call TriggerAddAction( gg_trg_Repick, function Trig_Repick_Actions )
endfunction

