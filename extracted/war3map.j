        call UnitApplyTimedLife( GetLastCreatedUnit(), 'BHwe', 2 )
        call UnitDamageTargetBJ( GetLastCreatedUnit(), udg_Hero_FuF_BS_Target, I2R(udg_Hero_FuF_BS_Damage), ATTACK_TYPE_CHAOS, DAMAGE_TYPE_DIVINE )
        call TextTag(  ""+I2S(udg_Hero_FuF_BS_Damage) , GetTriggerUnit(), 7 , 240, 0, 0, 3 )
        set udg_Hero_FuF_BS_Real = 0.00
        call PolledWait( 0.05 )
        call RemoveLocation( udg_Hero_FuF_BS_Loc )
        call EnableTrigger( GetTriggeringTrigger() )
        return
