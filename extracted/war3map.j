    if ( not ( GetUnitTypeId(GetEventDamageSource()) == 'Hkal' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R02A', GetOwningPlayer(GetEventDamageSource())) == 1 ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B04R') == true ) ) then
        return false
