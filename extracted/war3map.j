function InitTrig_Knight_Charge takes nothing returns nothing
    set gg_trg_Knight_Charge = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Knight_Charge, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Knight_Charge, Condition( function Trig_Knight_Charge_Conditions ) )
