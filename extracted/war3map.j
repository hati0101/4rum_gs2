//===========================================================================
// Trigger: Game End
//===========================================================================
function Trig_Game_End_Func001C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'hhes' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'etoe' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'unp2' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetDyingUnit()) == 'h00Z' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Game_End_Conditions takes nothing returns boolean
    if ( not Trig_Game_End_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Game_End_Actions takes nothing returns nothing
    call PauseAllUnitsBJ( true )
    if GetOwningPlayer(GetTriggerUnit()) == udg_Force[1] then
    call DisplayTimedTextToForce( GetPlayersAll(), 60.00, ( udg_Colors[7] + "   다크니스가 승리했습니다." ) )
    else
    call DisplayTimedTextToForce( GetPlayersAll(), 60.00, ( udg_Colors[1] + "   가디언이 승리했습니다.|r" ) )
    endif
    call DisplayTimedTextToForce( GetPlayersAll(), 60.00, ( udg_Colors[5] + "   공식 사이트 : http://4rum.co.kr" ) )
    call DisplayTimedTextToForce( GetPlayersAll(), 60.00, ( udg_Colors[5] + "   공식 채널 : 4rum" ) )
    call PauseGameOn(  )
endfunction

