//===========================================================================
// Trigger: Des Special 2
//===========================================================================
function Trig_Des_Special_2_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0WE' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Des_Special_2_Actions takes nothing returns nothing
    set udg_Hero_Des_Friend = GetSpellTargetUnit()
    call PolledWait( 10.00 )
    set udg_Hero_Des_Friend = null
endfunction

//===========================================================================
function InitTrig_Des_Special_2 takes nothing returns nothing
    set gg_trg_Des_Special_2 = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Des_Special_2, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Des_Special_2, Condition( function Trig_Des_Special_2_Conditions ) )
    call TriggerAddAction( gg_trg_Des_Special_2, function Trig_Des_Special_2_Actions )
endfunction

//===========================================================================
// Trigger: Des Special 2 Cancle
//===========================================================================
function Trig_Des_Special_2_Cancle_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0WE' ) ) then
        return false
    endif
    if ( not ( IsUnitAlly(GetSpellTargetUnit(), GetOwningPlayer(GetTriggerUnit())) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Des_Special_2_Cancle_Actions takes nothing returns nothing
    call DisplayTextToForce( GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), "TRIGSTR_093" )
    call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
endfunction

//===========================================================================
function InitTrig_Des_Special_2_Cancle takes nothing returns nothing
    set gg_trg_Des_Special_2_Cancle = CreateTrigger(  )
