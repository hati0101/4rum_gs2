//===========================================================================
// Trigger: Tartaros
//===========================================================================
function Trig_Tartaros_Conditions takes nothing returns boolean
    if ( not ( IsUnitDeadBJ(udg_Hero_DrK_UltiPoint) == true ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() == 'A0VB' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tartaros_Func007C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R0A4', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tartaros_Actions takes nothing returns nothing
    call PlaySoundBJ( gg_snd_HPitLordWarcry1 )
    call AddSpecialEffectLocBJ( GetUnitLoc(GetTriggerUnit()), "Objects\\Spawnmodels\\Undead\\UDeathMedium\\UDeath.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call CreateNUnitsAtLoc( 1, 'unec', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    set udg_Hero_DrK_UltiPoint = GetLastCreatedUnit()
    if ( Trig_Tartaros_Func007C() ) then
        call UnitAddAbilityBJ( 'A0KW', udg_Hero_DrK_UltiPoint )
    else
    endif
    call UnitApplyTimedLifeBJ( ( 6.00 + ( 2.00 * I2R(GetUnitAbilityLevelSwapped('A0VB', GetTriggerUnit())) ) ), 'BTLF', GetLastCreatedUnit() )
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 36
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc( 1, 'uobs', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 700.00, ( 10.00 * I2R(GetForLoopIndexA()) )), ( 100.00 + ( 10.00 * I2R(GetForLoopIndexA()) ) ) )
        call UnitApplyTimedLifeBJ( ( 6.00 + ( 2.00 + I2R(GetUnitAbilityLevelSwapped('A0VB', GetTriggerUnit())) ) ), 'BTLF', GetLastCreatedUnit() )
        call SetUnitVertexColorBJ( GetLastCreatedUnit(), 100, 100, 100, 100.00 )
        call TriggerRegisterUnitInRangeSimple( gg_trg_Tartaros_Come_on, 75.00, GetLastCreatedUnit() )
        call AddSpecialEffectLocBJ( GetUnitLoc(GetLastCreatedUnit()), "Objects\\Spawnmodels\\Undead\\UDeathSmall\\UDeathSmall.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        set udg_Hero_DrK_UltiCheck[GetForLoopIndexA()] = true
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

