    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_STRUCTURE) == true ) ) then
        return false
    endif
    if ( not ( GetPlayerController(GetOwningPlayer(GetKillingUnitBJ())) != MAP_CONTROL_USER ) ) then
        return false
    endif
    return true
endfunction

function Trig_Building_Destroy_Gold_Func028Func001002001001001 takes nothing returns boolean
    return ( IsPlayerAlly(GetFilterPlayer(), udg_Force[2]) == true )
endfunction

function Trig_Building_Destroy_Gold_Func028Func001002001001002 takes nothing returns boolean
    return ( GetFilterPlayer() != udg_Force[2] )
endfunction

function Trig_Building_Destroy_Gold_Func028Func001002001001 takes nothing returns boolean
    return GetBooleanAnd( Trig_Building_Destroy_Gold_Func028Func001002001001001(), Trig_Building_Destroy_Gold_Func028Func001002001001002() )
endfunction

function Trig_Building_Destroy_Gold_Func028Func001002001002001 takes nothing returns boolean
    return ( GetPlayerController(GetFilterPlayer()) == MAP_CONTROL_USER )
endfunction

function Trig_Building_Destroy_Gold_Func028Func001002001002002 takes nothing returns boolean
    return ( GetPlayerSlotState(GetFilterPlayer()) == PLAYER_SLOT_STATE_PLAYING )
endfunction

function Trig_Building_Destroy_Gold_Func028Func001002001002 takes nothing returns boolean
    return GetBooleanAnd( Trig_Building_Destroy_Gold_Func028Func001002001002001(), Trig_Building_Destroy_Gold_Func028Func001002001002002() )
endfunction

function Trig_Building_Destroy_Gold_Func028Func001002001 takes nothing returns boolean
    return GetBooleanAnd( Trig_Building_Destroy_Gold_Func028Func001002001001(), Trig_Building_Destroy_Gold_Func028Func001002001002() )
endfunction

function Trig_Building_Destroy_Gold_Func028Func002002001001001 takes nothing returns boolean
    return ( IsPlayerAlly(GetFilterPlayer(), udg_Force[1]) == true )
endfunction

function Trig_Building_Destroy_Gold_Func028Func002002001001002 takes nothing returns boolean
    return ( GetFilterPlayer() != udg_Force[1] )
endfunction

function Trig_Building_Destroy_Gold_Func028Func002002001001 takes nothing returns boolean
    return GetBooleanAnd( Trig_Building_Destroy_Gold_Func028Func002002001001001(), Trig_Building_Destroy_Gold_Func028Func002002001001002() )
endfunction

function Trig_Building_Destroy_Gold_Func028Func002002001002001 takes nothing returns boolean
    return ( GetPlayerController(GetFilterPlayer()) == MAP_CONTROL_USER )
endfunction

function Trig_Building_Destroy_Gold_Func028Func002002001002002 takes nothing returns boolean
    return ( GetPlayerSlotState(GetFilterPlayer()) == PLAYER_SLOT_STATE_PLAYING )
endfunction

function Trig_Building_Destroy_Gold_Func028Func002002001002 takes nothing returns boolean
    return GetBooleanAnd( Trig_Building_Destroy_Gold_Func028Func002002001002001(), Trig_Building_Destroy_Gold_Func028Func002002001002002() )
endfunction

function Trig_Building_Destroy_Gold_Func028Func002002001 takes nothing returns boolean
    return GetBooleanAnd( Trig_Building_Destroy_Gold_Func028Func002002001001(), Trig_Building_Destroy_Gold_Func028Func002002001002() )
endfunction

function Trig_Building_Destroy_Gold_Func028C takes nothing returns boolean
    if ( not ( IsUnitAlly(GetKillingUnitBJ(), udg_Force[1]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Building_Destroy_Gold_Actions takes nothing returns nothing
    local integer gold = 0
    local integer LoopX = 1
    if GetUnitTypeId(GetDyingUnit()) == 'etrp' then
    set gold = 450
    elseif GetUnitTypeId(GetDyingUnit()) == 'hhou' then
    set gold = 80
    elseif GetUnitTypeId(GetDyingUnit()) == 'hgtw' then
    set gold = 100
    elseif GetUnitTypeId(GetDyingUnit()) == 'hbar' then
    set gold = 120
    elseif GetUnitTypeId(GetDyingUnit()) == 'negf' then
    set gold = 200
    elseif GetUnitTypeId(GetDyingUnit()) == 'owtw' then
    set gold = 100
    elseif GetUnitTypeId(GetDyingUnit()) == 'uzg1' then
    set gold = 450
    elseif GetUnitTypeId(GetDyingUnit()) == 'npgf' then
    set gold = 80
    elseif GetUnitTypeId(GetDyingUnit()) == 'usep' then
    set gold = 120
    elseif GetUnitTypeId(GetDyingUnit()) == 'ntx2' then
    set gold = 200
    elseif GetUnitTypeId(GetDyingUnit()) == 'n013' then
    set gold = 200
    elseif GetUnitTypeId(GetDyingUnit()) == 'n012' then
    set gold = 200
    endif
    if ( Trig_Building_Destroy_Gold_Func028C() ) then
        set udg_P_Group = GetPlayersMatching(Condition(function Trig_Building_Destroy_Gold_Func028Func002002001))
    else
        set udg_P_Group = GetPlayersMatching(Condition(function Trig_Building_Destroy_Gold_Func028Func001002001))
    endif
    loop
    exitwhen LoopX > 12
    if IsUnitAlly(GetKillingUnitBJ(), ConvertedPlayer(LoopX)) then
    call AdjustPlayerStateBJ( ( gold / CountPlayersInForceBJ(udg_P_Group) ), ConvertedPlayer(LoopX), PLAYER_STATE_RESOURCE_GOLD )
    endif
    set LoopX = LoopX + 1
    endloop
endfunction

