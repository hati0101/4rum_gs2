function InitTrig_Pick_DawnWolf takes nothing returns nothing
    set gg_trg_Pick_DawnWolf = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Pick_DawnWolf, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Pick_DawnWolf, Condition( function Trig_Pick_DawnWolf_Conditions ) )
    call TriggerAddAction( gg_trg_Pick_DawnWolf, function Trig_Pick_DawnWolf_Actions )
endfunction

