    set gg_trg_First_Surrender = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_First_Surrender, GetEntireMapRect() )
    call TriggerAddCondition( gg_trg_First_Surrender, Condition( function Trig_First_Surrender_Conditions ) )
    call TriggerAddAction( gg_trg_First_Surrender, function Trig_First_Surrender_Actions )
endfunction

//===========================================================================
