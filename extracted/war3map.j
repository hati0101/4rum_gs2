    endif
    return true
endfunction

function Trig_DiK_Special_Func008C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0MY' ) ) then
        return false
    endif
    return true
endfunction

function Trig_DiK_Special_Actions takes nothing returns nothing
    // 홀리라이트 / 징벌의 빛 /성스러운 빛의 위력
    if ( Trig_DiK_Special_Func002C() ) then
        set udg_Hero_DiK_HLTgt = GetSpellTargetUnit()
        if ( Trig_DiK_Special_Func002Func003C() ) then
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 4.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A00W', GetLastCreatedUnit() )
            call SetUnitAbilityLevelSwapped( 'A00W', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A090', GetTriggerUnit()) )
            call IssueTargetOrderBJ( GetLastCreatedUnit(), "holybolt", udg_Hero_DiK_HLTgt )
            if ( Trig_DiK_Special_Func002Func003Func008C() ) then
                call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
                call UnitApplyTimedLifeBJ( 4.00, 'BTLF', GetLastCreatedUnit() )
                call UnitAddAbilityBJ( 'A0DK', GetLastCreatedUnit() )
                call SetUnitAbilityLevelSwapped( 'A0DK', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A090', GetTriggerUnit()) )
                call IssueTargetOrderBJ( GetLastCreatedUnit(), "holybolt", udg_Hero_DiK_HLTgt )
                call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_DiK_HLTgt, "Abilities\\Spells\\Human\\Resurrect\\ResurrectCaster.mdl" )
                call DestroyEffectBJ( GetLastCreatedEffectBJ() )
            else
            endif
        else
            if ( Trig_DiK_Special_Func002Func003Func001C() ) then
                call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
                call UnitApplyTimedLifeBJ( 4.00, 'BTLF', GetLastCreatedUnit() )
                call UnitAddAbilityBJ( 'A016', GetLastCreatedUnit() )
                call SetUnitAbilityLevelSwapped( 'A016', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A090', GetTriggerUnit()) )
                call IssueTargetOrderBJ( GetLastCreatedUnit(), "deathcoil", udg_Hero_DiK_HLTgt )
                if ( Trig_DiK_Special_Func002Func003Func001Func006C() ) then
                    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
                    call UnitApplyTimedLifeBJ( 4.00, 'BTLF', GetLastCreatedUnit() )
                    call UnitAddAbilityBJ( 'A0DJ', GetLastCreatedUnit() )
                    call SetUnitAbilityLevelSwapped( 'A0DJ', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A090', GetTriggerUnit()) )
                    call IssueTargetOrderBJ( GetLastCreatedUnit(), "deathcoil", udg_Hero_DiK_HLTgt )
                    call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_DiK_HLTgt, "Abilities\\Spells\\Human\\Resurrect\\ResurrectCaster.mdl" )
                    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
                else
                endif
            else
            endif
        endif
    else
    endif
    // 선고
    if ( Trig_DiK_Special_Func004C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0WV', GetLastCreatedUnit() )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "doom", GetSpellTargetUnit() )
    else
    endif
    // 화신
    if ( Trig_DiK_Special_Func006C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetPlayerStartLocationLoc(GetOwningPlayer(GetTriggerUnit())), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 60.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A12X', GetLastCreatedUnit() )
    else
    endif
    // 기적의 빛
    if ( Trig_DiK_Special_Func008C() ) then
        call SetUnitLifeBJ( GetSpellTargetUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetSpellTargetUnit()) + ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetSpellTargetUnit()) * 0.35 ) ) )
    else
    endif
endfunction

//===========================================================================
function InitTrig_DiK_Special takes nothing returns nothing
    set gg_trg_DiK_Special = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_DiK_Special, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_DiK_Special, Condition( function Trig_DiK_Special_Conditions ) )
    call TriggerAddAction( gg_trg_DiK_Special, function Trig_DiK_Special_Actions )
endfunction

//===========================================================================
// Trigger: Mass Teleport
//===========================================================================
function Trig_Mass_Teleport_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A066' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mass_Teleport_Func005Func001C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetEnumUnit(), 'B03K') == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( GetEnumUnit() != GetTriggerUnit() ) ) then
        return false
    endif
    if ( not ( GetPlayerController(GetOwningPlayer(GetEnumUnit())) == MAP_CONTROL_USER ) ) then
        return false
    endif
    if ( not ( IsUnitAlly(GetEnumUnit(), GetOwningPlayer(GetTriggerUnit())) == true ) ) then
        return false
    endif
    if ( not ( DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(GetEnumUnit())) <= 800.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mass_Teleport_Func005A takes nothing returns nothing
    if ( Trig_Mass_Teleport_Func005Func001C() ) then
        call GroupAddUnitSimple( GetEnumUnit(), udg_Hero_DiK_UltiGroup )
        call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTo.mdl" )
        call SaveEffectHandleBJ( GetLastCreatedEffectBJ(), GetHandleIdBJ(GetEnumUnit()), StringHashBJ("MassEff"), GetLastCreatedHashtableBJ() )
        call PauseUnitBJ( true, GetEnumUnit() )
    else
    endif
endfunction

function Trig_Mass_Teleport_Func006Func001C takes nothing returns boolean
    if ( ( GetUnitAbilityLevelSwapped('A066', GetTriggerUnit()) == 2 ) ) then
        return true
    endif
    if ( ( GetUnitAbilityLevelSwapped('A066', GetTriggerUnit()) == 4 ) ) then
        return true
    endif
    return false
endfunction

function Trig_Mass_Teleport_Func006C takes nothing returns boolean
    if ( not Trig_Mass_Teleport_Func006Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Mass_Teleport_Func007Func001C takes nothing returns boolean
    if ( ( GetUnitAbilityLevelSwapped('A066', GetTriggerUnit()) == 3 ) ) then
        return true
    endif
    if ( ( GetUnitAbilityLevelSwapped('A066', GetTriggerUnit()) == 6 ) ) then
        return true
    endif
    return false
endfunction

function Trig_Mass_Teleport_Func007C takes nothing returns boolean
    if ( not Trig_Mass_Teleport_Func007Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Mass_Teleport_Actions takes nothing returns nothing
    set udg_Hero_DiK_Ultion = true
    set udg_Hero_Dik_UltiTarget = GetSpellTargetUnit()
    set udg_Hero_DiK_UltiPoint = GetSpellTargetLoc()
    call GroupClear( udg_Hero_DiK_UltiGroup )
    call ForGroupBJ( GetUnitsInRectAll(GetPlayableMapRect()), function Trig_Mass_Teleport_Func005A )
    if ( Trig_Mass_Teleport_Func006C() ) then
        set udg_Hero_DiK = GetTriggerUnit()
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 4.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0DM', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0DM', GetLastCreatedUnit(), 1 )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "antimagicshell", GetTriggerUnit() )
        call StartTimerBJ( udg_Hero_DiK_Timer, false, ( 1.00 + ( 0.50 * I2R(CountUnitsInGroup(udg_Hero_DiK_UltiGroup)) ) ) )
    else
    endif
    if ( Trig_Mass_Teleport_Func007C() ) then
        set udg_Hero_DiK = GetTriggerUnit()
        call SetUnitInvulnerable( GetTriggerUnit(), true )
        call StartTimerBJ( udg_Hero_DiK_Timer, false, ( 1.00 + ( 0.50 * I2R(CountUnitsInGroup(udg_Hero_DiK_UltiGroup)) ) ) )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Mass_Teleport takes nothing returns nothing
    set gg_trg_Mass_Teleport = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Mass_Teleport, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Mass_Teleport, Condition( function Trig_Mass_Teleport_Conditions ) )
    call TriggerAddAction( gg_trg_Mass_Teleport, function Trig_Mass_Teleport_Actions )
endfunction

