//===========================================================================
function Trig_Ranger_Special_1_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetAttacker()) == 'Hvwd' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R00C', GetOwningPlayer(GetAttacker())) == 1 ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetAttackedUnitBJ(), UNIT_TYPE_STRUCTURE) != true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ranger_Special_1_Actions takes nothing returns nothing
    local integer rand = GetRandomInt( 1 , 100 )
    local integer chance = 25 // 발동 확률
    if ( rand <= chance ) then
    call DisableTrigger( GetTriggeringTrigger() )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetAttacker()), GetUnitLoc(GetAttacker()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A00T', GetLastCreatedUnit() )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "ensnare", GetAttackedUnitBJ() )
    call TextTag("그물 던지기!!" , GetAttacker() ,10 , 255 , 255 , 150, 3 )
    call PolledWait( 6.00 )
    call EnableTrigger( GetTriggeringTrigger() )
    else
    endif
endfunction

