function Trig_DaS_Special_1_Buff_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A08M' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R02F', GetTriggerPlayer()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DaS_Special_1_Buff_Func004Func001C takes nothing returns boolean
    if ( not ( IsUnitIdType(GetUnitTypeId(GetEnumUnit()), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetEnumUnit()) == true ) ) then
        return false
    endif
    if ( not ( IsPlayerEnemy(GetOwningPlayer(GetTriggerUnit()), GetOwningPlayer(GetEnumUnit())) == true ) ) then
        return false
    endif
    if ( not ( GetUnitLifePercent(GetEnumUnit()) <= 50.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DaS_Special_1_Buff_Func004A takes nothing returns nothing
    if ( Trig_DaS_Special_1_Buff_Func004Func001C() ) then
        call AddSpecialEffectTargetUnitBJ( "weapon", GetTriggerUnit(), "Abilities\\Weapons\\GreenDragonMissile\\GreenDragonMissile.mdl" )
        set udg_Hero_DaS_AvengeAtkEff = GetLastCreatedEffectBJ()
        set udg_Hero_DaS_AvengeBool = true
        call d_effect(GetLastCreatedEffectBJ(),5)
        call CreateTextTagLocBJ( "TRIGSTR_1717", GetUnitLoc(GetTriggerUnit()), 0, 10.00, 100, 0.00, 0.00, 0 )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 1.00 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 65.00, 90 )
        call TriggerExecute( gg_trg_DaS_Special_1_Off )
        return
    else
    endif
endfunction

function Trig_DaS_Special_1_Buff_Actions takes nothing returns nothing
    call ForGroupBJ( GetUnitsInRangeOfLocAll(350.00, GetSpellTargetLoc()), function Trig_DaS_Special_1_Buff_Func004A )
