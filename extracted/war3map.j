    set gg_trg_Shadow_Break_IllDead = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Shadow_Break_IllDead, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Shadow_Break_IllDead, Condition( function Trig_Shadow_Break_IllDead_Conditions ) )
    call TriggerAddAction( gg_trg_Shadow_Break_IllDead, function Trig_Shadow_Break_IllDead_Actions )
endfunction

