    set gg_trg_Fell_Prince_Attack = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Fell_Prince_Attack, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_Fell_Prince_Attack, Condition( function Trig_Fell_Prince_Attack_Conditions ) )
    call TriggerAddAction( gg_trg_Fell_Prince_Attack, function Trig_Fell_Prince_Attack_Actions )
endfunction

//===========================================================================
// Trigger: Shadow Jail Cast
//===========================================================================
function Trig_Shadow_Jail_Cast_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A09S' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shadow_Jail_Cast_Func007C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R06X', GetOwningPlayer(GetTriggerUnit())) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shadow_Jail_Cast_Func009Func004C takes nothing returns boolean
    if ( not ( IsUnitAlly(udg_Hero_FeP_UltiTarget, udg_Force[1]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shadow_Jail_Cast_Func009C takes nothing returns boolean
    if ( not ( IsUnitAlly(udg_Hero_FeP_UltiTarget, GetOwningPlayer(GetTriggerUnit())) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shadow_Jail_Cast_Actions takes nothing returns nothing
    set udg_Hero_FeP_UltiTarget = GetSpellTargetUnit()
    call PolledWait( 0.05 )
    call UnitRemoveBuffBJ( 'BNsq', udg_Hero_FeP_UltiTarget )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(udg_Hero_FeP_UltiTarget), GetUnitLoc(udg_Hero_FeP_UltiTarget), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0L0', GetLastCreatedUnit() )
    if ( Trig_Shadow_Jail_Cast_Func007C() ) then
        call SetUnitAbilityLevelSwapped( 'A0L0', GetLastCreatedUnit(), 2 )
    else
        call SetUnitAbilityLevelSwapped( 'A0L0', GetLastCreatedUnit(), 1 )
    endif
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "sleep", udg_Hero_FeP_UltiTarget )
    if ( Trig_Shadow_Jail_Cast_Func009C() ) then
        call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_FeP_UltiTarget), "Objects\\Spawnmodels\\Undead\\UCancelDeath\\UCancelDeath.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        if ( Trig_Shadow_Jail_Cast_Func009Func004C() ) then
            call SetUnitPositionLoc( udg_Hero_FeP_UltiTarget, GetRectCenter(gg_rct_G_Home_Revive) )
        else
            call SetUnitPositionLoc( udg_Hero_FeP_UltiTarget, GetRectCenter(gg_rct_D_Home_Revive) )
        endif
    else
    endif
    call StartTimerBJ( CreateTimer(), true, 1 )
    call SaveUnitHandleBJ( udg_Hero_FeP_UltiTarget, GetHandleIdBJ(GetLastCreatedTimerBJ()), StringHashBJ("Jail_target"), GetLastCreatedHashtableBJ() )
    call SaveIntegerBJ( ( 7 + ( GetPlayerTechCountSimple('R06X', GetTriggerPlayer()) * 4 ) ), GetHandleIdBJ(GetLastCreatedTimerBJ()), StringHashBJ("Jail_sec"), GetLastCreatedHashtableBJ() )
    call SaveRealBJ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_FeP_UltiTarget), GetHandleIdBJ(GetLastCreatedTimerBJ()), StringHashBJ("Jail_hp"), GetLastCreatedHashtableBJ() )
    call SaveRealBJ( GetUnitStateSwap(UNIT_STATE_MANA, udg_Hero_FeP_UltiTarget), GetHandleIdBJ(GetLastCreatedTimerBJ()), StringHashBJ("Jail_mp"), GetLastCreatedHashtableBJ() )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Shadow_Jail_Loop, GetLastCreatedTimerBJ() )
    set udg_Hero_FeP_UltiTarget = null
endfunction

//===========================================================================
function InitTrig_Shadow_Jail_Cast takes nothing returns nothing
    set gg_trg_Shadow_Jail_Cast = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Shadow_Jail_Cast, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Shadow_Jail_Cast, Condition( function Trig_Shadow_Jail_Cast_Conditions ) )
    call TriggerAddAction( gg_trg_Shadow_Jail_Cast, function Trig_Shadow_Jail_Cast_Actions )
endfunction

//===========================================================================
// Trigger: Shadow Jail Loop
//===========================================================================
function Trig_Shadow_Jail_Loop_Func009Func001C takes nothing returns boolean
    if ( ( LoadIntegerBJ(GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("Jail_sec"), GetLastCreatedHashtableBJ()) <= 0 ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(LoadUnitHandleBJ(GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("Jail_target"), GetLastCreatedHashtableBJ()), 'B08M') != true ) ) then
        return true
    endif
    return false
endfunction

function Trig_Shadow_Jail_Loop_Func009C takes nothing returns boolean
    if ( not Trig_Shadow_Jail_Loop_Func009Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Shadow_Jail_Loop_Actions takes nothing returns nothing
    call SaveIntegerBJ( ( LoadIntegerBJ(GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("Jail_sec"), GetLastCreatedHashtableBJ()) - 1 ), GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("Jail_sec"), GetLastCreatedHashtableBJ() )
    call CreateTextTagUnitBJ( ( I2S(LoadIntegerBJ(GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("Jail_sec"), GetLastCreatedHashtableBJ())) + "!" ), LoadUnitHandleBJ(GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("Jail_target"), GetLastCreatedHashtableBJ()), 0.00, 15.00, 50.00, 50.00, 50.00, 0 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 30.00, 90.00 )
    call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
    call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 0.80 )
    call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 0.50 )
    call SetUnitLifeBJ( LoadUnitHandleBJ(GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("Jail_target"), GetLastCreatedHashtableBJ()), LoadRealBJ(GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("Jail_hp"), GetLastCreatedHashtableBJ()) )
    call SetUnitManaBJ( LoadUnitHandleBJ(GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("Jail_target"), GetLastCreatedHashtableBJ()), LoadRealBJ(GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("Jail_mp"), GetLastCreatedHashtableBJ()) )
    if ( Trig_Shadow_Jail_Loop_Func009C() ) then
        call DestroyTimer(GetExpiredTimer())
    else
    endif
endfunction

//===========================================================================
function InitTrig_Shadow_Jail_Loop takes nothing returns nothing
    set gg_trg_Shadow_Jail_Loop = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Shadow_Jail_Loop, function Trig_Shadow_Jail_Loop_Actions )
endfunction

