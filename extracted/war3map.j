    if ( not ( GetPlayerTechCountSimple('R02J', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Soul_Mastery_Learn_Actions takes nothing returns nothing
    set udg_Hero_DeM = GetTriggerUnit()
    if ( Trig_Soul_Mastery_Learn_Func002C() ) then
        call EnableTrigger( gg_trg_DeM_Special_2_Timer )
    else
    endif
    if ( Trig_Soul_Mastery_Learn_Func003C() ) then
        if ( Trig_Soul_Mastery_Learn_Func003Func002C() ) then
            call UnitRemoveAbilityBJ( 'A0BF', GetTriggerUnit() )
            call UnitMakeAbilityPermanent ( GetTriggerUnit() , false, 'A0BF')
        else
        endif
        call UnitAddAbilityBJ( 'A0UL', GetTriggerUnit() )
        call UnitMakeAbilityPermanent ( GetTriggerUnit() , true, 'A0UL')
    else
        if ( Trig_Soul_Mastery_Learn_Func003Func003C() ) then
            call UnitAddAbilityBJ( 'A0BF', GetTriggerUnit() )
            call UnitMakeAbilityPermanent ( GetTriggerUnit() , true, 'A0BF')
        else
        endif
    endif
    if ( Trig_Soul_Mastery_Learn_Func004C() ) then
        call SetUnitAbilityLevelSwapped( 'A0UL', GetTriggerUnit(), GetLearnedSkillLevel() )
    else
        call SetUnitAbilityLevelSwapped( 'A0BF', GetTriggerUnit(), GetLearnedSkillLevel() )
    endif
endfunction

