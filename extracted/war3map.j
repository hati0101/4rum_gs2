function Trig_Death_Promise_Actions takes nothing returns nothing
    local integer time = 5 * GetPlayerTechCountSimple('R08H', GetOwningPlayer(GetTriggerUnit()))
    local unit Target = GetSpellTargetUnit()
    local unit Caster = GetTriggerUnit()
    local integer Damage = 0
    call DisableTrigger( GetTriggeringTrigger() )
    call PlaySoundBJ( gg_snd_HeroDreadlordYesAttack2 )
    if ( udg_Hero_DeM_Soul >= 5 ) then
        set Damage = GetUnitAbilityLevelSwapped('A00K', GetTriggerUnit()) + 1
    set udg_Hero_DeM_Soul = ( udg_Hero_DeM_Soul - 5 )
    call TextTagForce( I2S(udg_Hero_DeM_Soul), GetTriggerUnit(), 10,255, 50, 150, 3, GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())) )
    endif
    call DisplayTextToForce( GetPlayersAllies(GetOwningPlayer(GetSpellAbilityUnit())), ( "데스 프로마이즈 : " + ( udg_Colors[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetSpellTargetUnit()))]] + GetUnitName(GetSpellTargetUnit()) ) ) )
    call PingMinimapLocForForce( GetPlayersAllies(GetOwningPlayer(GetSpellAbilityUnit())), GetSpellTargetLoc(), 2.00 )
    call PolledWait( ( 6.00 - I2R(( time )) ) )
    call CreateNUnitsAtLocFacingLocBJ( 1, 'e00V', GetOwningPlayer(Caster), GetRectCenter(GetPlayableMapRect()), GetUnitLoc(GetTriggerUnit()) )
    call UnitApplyTimedLifeBJ( 10, 'BTLF', GetLastCreatedUnit() )
    call MakeUnitFollow(GetLastCreatedUnit(), Target, 30)
    call PolledWait( 9.00 )
    call PlaySoundBJ( gg_snd_HeroDreadlordYesAttack3 )
