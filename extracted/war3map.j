function Aqua_Sub takes nothing returns boolean
    if IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(GetEventDamageSource())) != true then
    return false
    elseif IsUnitType(GetFilterUnit(), UNIT_TYPE_MAGIC_IMMUNE) then
    return false
    elseif IsUnitAliveBJ(GetFilterUnit()) != true then
    return false
    elseif IsUnitType(GetFilterUnit(), UNIT_TYPE_MECHANICAL) then
    return false
    endif
    return true
endfunction

