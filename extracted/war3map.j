    if ( not ( GetTriggerUnit() == udg_Hero_ShT_AtkTarget ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) != true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_MECHANICAL) != true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEventDamageSource()) == 'Oshd' ) ) then
        return false
    endif
    return true
endfunction

function Trig_ShT_Attack_Func003C takes nothing returns boolean
    if ( not ( CountLivingPlayerUnitsOfTypeId('e03I', GetOwningPlayer(GetEventDamageSource())) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ShT_Attack_Func004Func004C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R02Z', GetOwningPlayer(GetEventDamageSource())) == 1 ) ) then
        return false
    endif
    return true
endfunction

