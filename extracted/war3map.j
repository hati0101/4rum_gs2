//===========================================================================
// Trigger: Backstab Atk
//
// call v_u_vtext( GetEventDamageSource(),GetTriggerUnit(), "+"+I2S(damege) , GetTriggerUnit() , 0 , 3 , 10 , 255 , 255 , 150 )
//===========================================================================
function Trig_Backstab_Atk_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEventDamageSource()) == 'Ewrd' ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(GetTriggerUnit(), GetOwningPlayer(GetEventDamageSource())) == true ) ) then
        return false
    endif
    if ( not ( udg_Hero_DrA_Backstab == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Backstab_Atk_Func004C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R03B', GetOwningPlayer(GetEventDamageSource())) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Backstab_Atk_Func005Func003C takes nothing returns boolean
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_DrA_BackstabTarget) > I2R(udg_Hero_DrA_BackstabDmg) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Backstab_Atk_Func005C takes nothing returns boolean
    if ( not ( RAbsBJ(( ModuloReal(( ( udg_Hero_DrA_BaskStabAngle - GetUnitFacing(GetTriggerUnit()) ) + 540.00 ), 360.00) - 180.00 )) <= 90.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Backstab_Atk_Actions takes nothing returns nothing
    call UnitRemoveBuffBJ( 'B02O', GetEventDamageSource() )
    set udg_Hero_DrA_BackstabTarget = GetTriggerUnit()
    set udg_Hero_DrA_Backstab = false
    if ( Trig_Backstab_Atk_Func004C() ) then
        set udg_Hero_DrA_BackstabDmg = ( 30 + ( GetUnitAbilityLevelSwapped('A0AK', GetEventDamageSource()) * 30 ) )
    else
        set udg_Hero_DrA_BackstabDmg = ( 30 + ( GetUnitAbilityLevelSwapped('A0AK', GetEventDamageSource()) * 30 ) )
        set udg_Hero_DrA_BackstabDmg = R2I(( 2.00 * I2R(udg_Hero_DrA_BackstabDmg) ))
    endif
    if ( Trig_Backstab_Atk_Func005C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(udg_Hero_DrA), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        if ( Trig_Backstab_Atk_Func005Func003C() ) then
            call UnitDamageTargetBJ( GetLastCreatedUnit(), udg_Hero_DrA_BackstabTarget, I2R(udg_Hero_DrA_BackstabDmg), ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
        else
            call SetUnitLifeBJ( udg_Hero_DrA_BackstabTarget, RMaxBJ(1.00, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_DrA_BackstabTarget) - I2R(udg_Hero_DrA_BackstabDmg) )) )
            call UnitDamageTargetBJ( GetLastCreatedUnit(), udg_Hero_DrA_BackstabTarget, I2R(udg_Hero_DrA_BackstabDmg), ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
        endif
        call TextTagForce(  "백스탭!", udg_Hero_DrA_BackstabTarget, 10 , 250 , 128 , 114 , 3, GetPlayersAll())
        call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
    call PolledWait( 0.10 )
    set udg_Hero_DrA_BackstabTarget = null
endfunction

//===========================================================================
function InitTrig_Backstab_Atk takes nothing returns nothing
    set gg_trg_Backstab_Atk = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Backstab_Atk, Condition( function Trig_Backstab_Atk_Conditions ) )
    call TriggerAddAction( gg_trg_Backstab_Atk, function Trig_Backstab_Atk_Actions )
endfunction

