endfunction
//===========================================================================
// Trigger: Charge Unit
//
// 원한에 잠긴 추격
//===========================================================================
function Trig_Charge_Unit_Conditions takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetEnteringUnit()) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_MECHANICAL) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( GetEnteringUnit() != udg_Hero_DrK ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(GetEnteringUnit(), GetOwningPlayer(udg_Hero_DrK)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitInGroup(GetEnteringUnit(), udg_Hero_DrK_group) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charge_Unit_Func003C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_DrK) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charge_Unit_Actions takes nothing returns nothing
    if IsUnitInvulnerable(GetEnteringUnit()) then
    else
    if ( Trig_Charge_Unit_Func003C() ) then
        call GroupAddUnitSimple( GetEnteringUnit(), udg_Hero_DrK_group )
        call SetUnitPathing( GetEnteringUnit(), false )
        call PolledWait( 2 )
        call SetUnitPathing( GetEnteringUnit(), true )
        call GroupRemoveGroup( udg_Hero_DrK_group, udg_Hero_DrK_group )
    else
    endif
    endif
endfunction

