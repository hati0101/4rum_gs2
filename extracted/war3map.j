//===========================================================================
// Trigger: Blow Bomb
//===========================================================================
function Trig_Blow_Bomb_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A00N' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blow_Bomb_Actions takes nothing returns nothing
    call CreateNUnitsAtLocFacingLocBJ( 1, 'ewsp', GetTriggerPlayer(), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 5.00, ( GetUnitFacing(GetTriggerUnit()) - 0.00 )), GetUnitLoc(GetTriggerUnit()) )
    call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0LT', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0LT', GetLastCreatedUnit(), ( GetUnitAbilityLevelSwapped('A00N', GetTriggerUnit()) + ( 4 * GetPlayerTechCountSimple('R0AR', GetOwningPlayer(GetTriggerUnit())) ) ) )
    call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
    call CreateNUnitsAtLocFacingLocBJ( 1, 'ewsp', GetTriggerPlayer(), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 5.00, ( GetUnitFacing(GetTriggerUnit()) - 0.00 )), GetUnitLoc(GetTriggerUnit()) )
    call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0EQ', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0EQ', GetLastCreatedUnit(), ( GetUnitAbilityLevelSwapped('A00N', GetTriggerUnit()) + ( 4 * GetPlayerTechCountSimple('R0AR', GetOwningPlayer(GetTriggerUnit())) ) ) )
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "silence", GetUnitLoc(GetTriggerUnit()) )
    call Knockback(GetTriggerUnit(),AngleBetweenPoints(GetUnitLoc(GetLastCreatedUnit()), GetUnitLoc(GetTriggerUnit())),300,700)
    if ( GetPlayerTechCountSimple('R0AR', GetOwningPlayer( GetTriggerUnit() )) == 1 ) then
       call CreateNUnitsAtLocFacingLocBJ( 1, 'ewsp', GetTriggerPlayer(), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 5.00, ( GetUnitFacing(GetTriggerUnit()) - 0.00 )), GetUnitLoc(GetTriggerUnit()) )
       call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
       call UnitAddAbilityBJ( 'A0P2', GetLastCreatedUnit() )
       call IssueTargetOrderBJ( GetLastCreatedUnit(), "bloodlust", GetTriggerUnit() )
    endif
endfunction

