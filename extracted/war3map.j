// Trigger: BloodThirst
//===========================================================================
function Trig_BloodThirst_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) != true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_MECHANICAL) != true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEventDamageSource()) == 'Udre' ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(GetTriggerUnit(), GetOwningPlayer(GetEventDamageSource())) == true ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A0GQ', GetEventDamageSource()) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BloodThirst_Func001Func006C takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R02Y', GetOwningPlayer(GetEventDamageSource())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BloodThirst_Func001Func007C takes nothing returns boolean
    if ( not ( udg_Hero_VaL_SBS_Boolean == true ) ) then
        return false
    endif
    if ( not ( GetUnitLifePercent(GetTriggerUnit()) <= 90.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BloodThirst_Func001Func008Func007C takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R02Y', GetOwningPlayer(GetEventDamageSource())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BloodThirst_Func001Func008C takes nothing returns boolean
    if ( not ( GetUnitLifePercent(GetTriggerUnit()) <= ( ( I2R(GetUnitAbilityLevelSwapped('A0GQ', GetEventDamageSource())) * 10.00 ) + 25.00 ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_BloodThirst_Func001C takes nothing returns boolean
    if ( not Trig_BloodThirst_Func001Func007C() ) then
        return false
    endif
    return true
endfunction

function Trig_BloodThirst_Actions takes nothing returns nothing
    if ( Trig_BloodThirst_Func001C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetEventDamageSource()), GetUnitLoc(GetEventDamageSource()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A09I', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A09I', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0GQ', GetEventDamageSource()) )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "bloodlust", GetEventDamageSource() )
        if ( Trig_BloodThirst_Func001Func006C() ) then
            call CreateNUnitsAtLoc( 1, 'e01Z', GetOwningPlayer(GetEventDamageSource()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 5.00, 'BTLF', GetLastCreatedUnit() )
            call SetUnitAbilityLevelSwapped( 'A0DP', GetLastCreatedUnit(), 2 )
            call IssueTargetOrderBJ( GetLastCreatedUnit(), "faeriefire", GetTriggerUnit() )
        else
        endif
    else
        if ( Trig_BloodThirst_Func001Func008C() ) then
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetEventDamageSource()), GetUnitLoc(GetEventDamageSource()), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A09I', GetLastCreatedUnit() )
            call SetUnitAbilityLevelSwapped( 'A09I', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0GQ', GetEventDamageSource()) )
            call IssueTargetOrderBJ( GetLastCreatedUnit(), "bloodlust", GetEventDamageSource() )
            if ( Trig_BloodThirst_Func001Func008Func007C() ) then
                call CreateNUnitsAtLoc( 1, 'e01Z', GetOwningPlayer(GetEventDamageSource()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
                call UnitApplyTimedLifeBJ( 5.00, 'BTLF', GetLastCreatedUnit() )
                call SetUnitAbilityLevelSwapped( 'A0DP', GetLastCreatedUnit(), 2 )
                call IssueTargetOrderBJ( GetLastCreatedUnit(), "faeriefire", GetTriggerUnit() )
            else
            endif
        else
        endif
    endif
endfunction

