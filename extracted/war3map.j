//===========================================================================
function Trig_Spirit_Avenger_______u_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A01H' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Spirit_Avenger_______u_Func004C takes nothing returns boolean
    if ( not ( udg_Hero_FaM_IsUltiCast == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Spirit_Avenger_______u_Func011C takes nothing returns boolean
    if ( not ( udg_Hero_FaM_IsUltiCast == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Spirit_Avenger_______u_Func018C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R00Y', GetTriggerPlayer()) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Spirit_Avenger_______u_Func020001003001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == true )
endfunction

function Trig_Spirit_Avenger_______u_Func020001003002 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetTriggerPlayer()) == true )
endfunction

function Trig_Spirit_Avenger_______u_Func020001003 takes nothing returns boolean
    return GetBooleanAnd( Trig_Spirit_Avenger_______u_Func020001003001(), Trig_Spirit_Avenger_______u_Func020001003002() )
endfunction

function Trig_Spirit_Avenger_______u_Func020A takes nothing returns nothing
    call UnitDamageTargetBJ( GetTriggerUnit(), GetEnumUnit(), ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetEnumUnit()) * 0.13 ), ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl" )
    call d_effect(GetLastCreatedEffectBJ(),1)
endfunction

function Trig_Spirit_Avenger_______u_Actions takes nothing returns nothing
    local location point = GetSpellTargetLoc()
    set udg_Hero_FaM_IsUltiCast = true
    call PlaySoundBJ( gg_snd_SpiritAvenger )
    call PolledWait( 0.25 )
    if ( Trig_Spirit_Avenger_______u_Func004C() ) then
        return
    else
    endif
    call CreateNUnitsAtLoc( 1, 'e00Y', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 10.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A01Q', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0ER', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A01Q', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A01H', GetTriggerUnit()) )
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "blizzard", point )
    call PolledWait( 1.25 )
    if ( Trig_Spirit_Avenger_______u_Func011C() ) then
        return
    else
    endif
    call CreateNUnitsAtLoc( 1, 'e00Y', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 10.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A01R', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A01R', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A01H', GetTriggerUnit()) )
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "rainoffire", point )
    set udg_Hero_FaM_IsUltiCast = false
    if ( Trig_Spirit_Avenger_______u_Func018C() ) then
        return
    else
    endif
    call PolledWait( 1.25 )
    call ForGroupBJ( GetUnitsInRangeOfLocMatching(( 500.00 + ( I2R(GetUnitAbilityLevelSwapped('A01H', GetTriggerUnit())) * 100.00 ) ), point, Condition(function Trig_Spirit_Avenger_______u_Func020001003)), function Trig_Spirit_Avenger_______u_Func020A )
    call RemoveLocation(point)
    set point = null
endfunction

//===========================================================================
function InitTrig_Spirit_Avenger_cast takes nothing returns nothing
    set gg_trg_Spirit_Avenger_cast = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Spirit_Avenger_cast, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Spirit_Avenger_cast, Condition( function Trig_Spirit_Avenger_______u_Conditions ) )
    call TriggerAddAction( gg_trg_Spirit_Avenger_cast, function Trig_Spirit_Avenger_______u_Actions )
endfunction


