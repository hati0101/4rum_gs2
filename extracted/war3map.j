    if ( not ( GetPlayerTechCountSimple('R08G', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(gg_trg_DeM_Special_2_Timer) != true ) ) then
        return false
    endif
    return true
endfunction

