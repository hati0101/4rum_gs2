//===========================================================================
// Trigger: Arcane Arrow Eff
//===========================================================================
function Trig_Arcane_Arrow_Eff_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0YN' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Arcane_Arrow_Eff_Actions takes nothing returns nothing
    local unit wisp
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetSpellTargetUnit()), bj_UNIT_FACING )
    set wisp = GetLastCreatedUnit()
    if GetSpellTargetUnit() != LoadUnitHandleBJ(StringHashBJ("ArA"), StringHashBJ("ArrowTgt"), GetLastCreatedHashtableBJ()) or TimerGetRemaining(udg_Hero_ArA_ArrowTimer) == 0.00 then
    call SaveIntegerBJ( 0, StringHashBJ("ArA"), StringHashBJ("ArrowCnt"), GetLastCreatedHashtableBJ() )
    call SaveUnitHandleBJ( GetSpellTargetUnit(), StringHashBJ("ArA"), StringHashBJ("ArrowTgt"), GetLastCreatedHashtableBJ() )
    endif
    if  LoadIntegerBJ(StringHashBJ("ArA"), StringHashBJ("ArrowCnt"), GetLastCreatedHashtableBJ()) >= 4  then
    call SaveIntegerBJ( 0, StringHashBJ("ArA"), StringHashBJ("ArrowCnt"), GetLastCreatedHashtableBJ() )
    endif
    call SaveIntegerBJ( ( LoadIntegerBJ(StringHashBJ("ArA"), StringHashBJ("ArrowCnt"), GetLastCreatedHashtableBJ()) + 1 ), StringHashBJ("ArA"), StringHashBJ("ArrowCnt"), GetLastCreatedHashtableBJ() )
    call StartTimerBJ( udg_Hero_ArA_ArrowTimer, false, 5.00 )
    call CreateNUnitsAtLoc( 1, 'e024', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call SetUnitScalePercent( GetLastCreatedUnit(), 50.00, 50.00, 50.00 )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0YO', GetLastCreatedUnit() )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "deathcoil", GetSpellTargetUnit() )
    if LoadIntegerBJ(StringHashBJ("ArA"), StringHashBJ("ArrowCnt"), GetLastCreatedHashtableBJ()) == 2 then
    call UnitAddAbilityBJ( 'A0LG', wisp )
    call IssueTargetOrderBJ( wisp, "faeriefire", LoadUnitHandleBJ(StringHashBJ("ArA"), StringHashBJ("ArrowTgt"), GetLastCreatedHashtableBJ()) )
    elseif LoadIntegerBJ(StringHashBJ("ArA"), StringHashBJ("ArrowCnt"), GetLastCreatedHashtableBJ()) == 3 then
    call UnitAddAbilityBJ( 'A0Z7', wisp )
    call IssueTargetOrderBJ( wisp, "soulburn", LoadUnitHandleBJ(StringHashBJ("ArA"), StringHashBJ("ArrowTgt"), GetLastCreatedHashtableBJ()) )
    elseif LoadIntegerBJ(StringHashBJ("ArA"), StringHashBJ("ArrowCnt"), GetLastCreatedHashtableBJ()) == 4 then
    call UnitAddAbilityBJ( 'A08X', wisp )
    call SetUnitAbilityLevelSwapped( 'A08X', wisp, ( GetPlayerTechCountSimple('R03U', GetOwningPlayer(wisp)) + 1 ) )
    call IssueTargetOrderBJ( wisp, "cripple", LoadUnitHandleBJ(StringHashBJ("ArA"), StringHashBJ("ArrowTgt"), GetLastCreatedHashtableBJ()) )
    endif
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', wisp )
endfunction

//===========================================================================
function InitTrig_Arcane_Arrow_Eff takes nothing returns nothing
    set gg_trg_Arcane_Arrow_Eff = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Arcane_Arrow_Eff, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Arcane_Arrow_Eff, Condition( function Trig_Arcane_Arrow_Eff_Conditions ) )
