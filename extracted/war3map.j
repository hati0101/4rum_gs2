    if ( not ( GetSpellAbilityId() == 'A0T8' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Earth_Shake_Func004C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B09M') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Earth_Shake_Func005Func003C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B09M') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Earth_Shake_Func005C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R08O', GetTriggerPlayer()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Earth_Shake_Func006C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B09M') == true ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R016', GetTriggerPlayer()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Earth_Shake_Actions takes nothing returns nothing
    set udg_Hero_ToW_ESPoint = GetSpellTargetLoc()
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetSpellTargetLoc(), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    if ( Trig_Earth_Shake_Func004C() ) then
        call UnitAddAbilityBJ( 'A0TB', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0TB', GetLastCreatedUnit(), ( GetUnitAbilityLevelSwapped('A0T8', GetTriggerUnit()) * 4 ) )
        call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
    else
        call UnitAddAbilityBJ( 'A0TB', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0TB', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0T8', GetTriggerUnit()) )
        call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
    endif
    if ( Trig_Earth_Shake_Func005C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), udg_Hero_ToW_ESPoint, bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        if ( Trig_Earth_Shake_Func005Func003C() ) then
            call UnitAddAbilityBJ( 'A055', GetLastCreatedUnit() )
            call SetUnitAbilityLevelSwapped( 'A055', GetLastCreatedUnit(), 2 )
            call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
        else
            call UnitAddAbilityBJ( 'A055', GetLastCreatedUnit() )
            call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
        endif
    else
    endif
    if ( Trig_Earth_Shake_Func006C() ) then
        call CreateNUnitsAtLoc( 1, 'e01P', GetOwningPlayer(GetTriggerUnit()), udg_Hero_ToW_ESPoint, bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0HJ', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0HJ', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0T8', GetTriggerUnit()) )
        call IssueImmediateOrderBJ( GetLastCreatedUnit(), "stomp" )
    else
    endif
endfunction

