//===========================================================================
function Trig_Initialize_Func005Func001C takes nothing returns boolean
    if ( not ( GetPlayerController(udg_SP_Player[GetForLoopIndexA()]) == MAP_CONTROL_USER ) ) then
        return false
    endif
    if ( not ( GetPlayerSlotState(udg_SP_Player[GetForLoopIndexA()]) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    return true
endfunction

function Trig_Initialize_Func006Func001C takes nothing returns boolean
    if ( not ( GetPlayerController(udg_SP_Player[GetForLoopIndexA()]) == MAP_CONTROL_USER ) ) then
        return false
    endif
    if ( not ( GetPlayerSlotState(udg_SP_Player[GetForLoopIndexA()]) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    return true
endfunction

function Trig_Initialize_Actions takes nothing returns nothing
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 6
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetPlayerAllianceStateBJ( ConvertedPlayer(GetForLoopIndexA()), udg_Force[1], bj_ALLIANCE_ALLIED_VISION )
        call SetPlayerAllianceStateBJ( udg_Force[1], ConvertedPlayer(GetForLoopIndexA()), bj_ALLIANCE_ALLIED_VISION )
        call SetPlayerAllianceStateBJ( ConvertedPlayer(GetForLoopIndexA()), udg_Force[2], bj_ALLIANCE_UNALLIED )
        call SetPlayerAllianceStateBJ( udg_Force[2], ConvertedPlayer(GetForLoopIndexA()), bj_ALLIANCE_UNALLIED )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set bj_forLoopAIndex = 7
    set bj_forLoopAIndexEnd = 12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetPlayerAllianceStateBJ( ConvertedPlayer(GetForLoopIndexA()), udg_Force[2], bj_ALLIANCE_ALLIED_VISION )
        call SetPlayerAllianceStateBJ( udg_Force[2], ConvertedPlayer(GetForLoopIndexA()), bj_ALLIANCE_ALLIED_VISION )
        call SetPlayerAllianceStateBJ( ConvertedPlayer(GetForLoopIndexA()), udg_Force[1], bj_ALLIANCE_UNALLIED )
        call SetPlayerAllianceStateBJ( udg_Force[1], ConvertedPlayer(GetForLoopIndexA()), bj_ALLIANCE_UNALLIED )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set udg_Cnt_Player[0] = 0
    set udg_Cnt_Player[1] = 0
    set bj_forLoopAIndex = 2
    set bj_forLoopAIndexEnd = 6
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Initialize_Func005Func001C() ) then
            set udg_Cnt_Player[0] = ( udg_Cnt_Player[0] + 1 )
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set bj_forLoopAIndex = 8
    set bj_forLoopAIndexEnd = 12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Initialize_Func006Func001C() ) then
            set udg_Cnt_Player[1] = ( udg_Cnt_Player[1] + 1 )
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call TriggerSleepAction( 0.50 )
    call PlaySoundBJ( gg_snd_ClanInvitation )
    call DisplayTimedTextToForce( GetPlayersAll(), 20.00, "TRIGSTR_1850" )
    call DisplayTimedTextToForce( GetPlayersAll(), 20.00, "TRIGSTR_1851" )
    call CreateQuestBJ( bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_1853", "TRIGSTR_1854", "ReplaceableTextures\\CommandButtons\\BTNHumanCaptureFlag.blp" )
    call CreateQuestBJ( bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_1855", "TRIGSTR_1857", "ReplaceableTextures\\CommandButtons\\BTNOrcCaptureFlag.blp" )
    call CreateQuestBJ( bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_1858", "TRIGSTR_1861", "ReplaceableTextures\\CommandButtons\\BTNOrcCaptureFlag.blp" )
    call CreateQuestBJ( bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_1862", "TRIGSTR_1863", "ReplaceableTextures\\CommandButtons\\BTNUndeadCaptureFlag.blp" )
    call CreateQuestBJ( bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_1865", "TRIGSTR_1866", "ReplaceableTextures\\CommandButtons\\BTNNightElfCaptureFlag.blp" )
    call CreateQuestBJ( bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_1867", "TRIGSTR_1869", "ReplaceableTextures\\CommandButtons\\BTNBox.blp" )
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_1870", "TRIGSTR_1871", "ReplaceableTextures\\CommandButtons\\BTNSpellBookBLS.blp" )
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_1873", "TRIGSTR_1874", "ReplaceableTextures\\CommandButtons\\BTNSpellBookBLS.blp" )
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_1875", "TRIGSTR_1877", "ReplaceableTextures\\CommandButtons\\BTNBlink.blp" )
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_1880", "TRIGSTR_1887", "ReplaceableTextures\\CommandButtons\\BTNTomeBrown.blp" )
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_1890", "TRIGSTR_1892", "ReplaceableTextures\\CommandButtons\\BTNMedalionOfCourage.blp" )
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_1894", "TRIGSTR_1897", "ReplaceableTextures\\CommandButtons\\BTNTomeBrown.blp" )
    call CreateQuestBJ( bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_1904", "TRIGSTR_1907", "ReplaceableTextures\\CommandButtons\\BTNTomeBrown.blp" )
    call EnableTrigger( gg_trg_Building_Backdoor )
    call EnableTrigger( gg_trg_Game_End )
    call EnableTrigger( gg_trg_Building_Destroy_Gold )
    call EnableTrigger( gg_trg_MegaCreep_System )
    set udg_GiveGoldAmount[1] = 13
    set udg_GiveGoldAmount[2] = 13
    set udg_Version = "플레이어 상태창"
    set udg_Creep_LvGroupCnt[0] = 0
    set udg_Creep_LvGroupCnt[1] = 0
    set udg_Creep_LvGroupCnt[2] = 0
    call SetPlayerName( Player(0), "TRIGSTR_1909" )
    call SetPlayerName( Player(6), "TRIGSTR_1911" )
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 16
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetPlayerHandicapXPBJ( ConvertedPlayer(GetForLoopIndexA()), 90.00 )
        call SetPlayerFlagBJ( PLAYER_STATE_GIVES_BOUNTY, true, ConvertedPlayer(GetForLoopIndexA()) )
        call AdjustPlayerStateBJ( 800, ConvertedPlayer(GetForLoopIndexA()), PLAYER_STATE_RESOURCE_GOLD )
        call CreateNUnitsAtLoc( 1, 'ewsp', ConvertedPlayer(GetForLoopIndexA()), GetPlayerStartLocationLoc(ConvertedPlayer(GetForLoopIndexA())), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 150.00, 'BTLF', GetLastCreatedUnit() )
        call CreateNUnitsAtLoc( 1, 'ewsp', ConvertedPlayer(GetForLoopIndexA()), GetPlayerStartLocationLoc(ConvertedPlayer(GetForLoopIndexA())), bj_UNIT_FACING )
        set udg_DamageSource[GetForLoopIndexA()] = GetLastCreatedUnit()
        call TriggerRegisterPlayerChatEvent( gg_trg_Repick, ConvertedPlayer(GetForLoopIndexA()), "-랜덤", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Repick, ConvertedPlayer(GetForLoopIndexA()), "-foseja", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Repick, ConvertedPlayer(GetForLoopIndexA()), "-random", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Repick, ConvertedPlayer(GetForLoopIndexA()), "-ㄱ무애ㅡ", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Random_Hero, ConvertedPlayer(GetForLoopIndexA()), "-random", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Random_Hero, ConvertedPlayer(GetForLoopIndexA()), "-랜덤", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Random_Hero, ConvertedPlayer(GetForLoopIndexA()), "-ㄱ무애ㅡ", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Random_Hero, ConvertedPlayer(GetForLoopIndexA()), "-foseja", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Enemy, ConvertedPlayer(GetForLoopIndexA()), "-matchup", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Enemy, ConvertedPlayer(GetForLoopIndexA()), "-ma", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Enemy, ConvertedPlayer(GetForLoopIndexA()), "-적", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Enemy, ConvertedPlayer(GetForLoopIndexA()), "-wjr", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Enemy, ConvertedPlayer(GetForLoopIndexA()), "-영웅", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Ally, ConvertedPlayer(GetForLoopIndexA()), "-아군", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Ally, ConvertedPlayer(GetForLoopIndexA()), "-dkrns", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Ally, ConvertedPlayer(GetForLoopIndexA()), "-ally", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_MoveSpeed, ConvertedPlayer(GetForLoopIndexA()), "-movespeed", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_MoveSpeed, ConvertedPlayer(GetForLoopIndexA()), "-ms", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_MoveSpeed, ConvertedPlayer(GetForLoopIndexA()), "-이동속도", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_MoveSpeed, ConvertedPlayer(GetForLoopIndexA()), "-이속", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_MoveSpeed, ConvertedPlayer(GetForLoopIndexA()), "-dlthr", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Home, ConvertedPlayer(GetForLoopIndexA()), "-귀환", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Debugging, ConvertedPlayer(GetForLoopIndexA()), "-디버그", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Debugging_Setup, ConvertedPlayer(GetForLoopIndexA()), "-디버그", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Debugging_Vote, ConvertedPlayer(GetForLoopIndexA()), "-찬성", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Single_WTF, ConvertedPlayer(GetForLoopIndexA()), "-wtf", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Single_WTFoff, ConvertedPlayer(GetForLoopIndexA()), "-wtfoff", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Single_revive, ConvertedPlayer(GetForLoopIndexA()), "-부활", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Single_Manekin, ConvertedPlayer(GetForLoopIndexA()), "-마네킹 ", false )
        call TriggerRegisterPlayerChatEvent( gg_trg_Single_sight, ConvertedPlayer(GetForLoopIndexA()), "-sight", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Single_Gold, ConvertedPlayer(GetForLoopIndexA()), "-gold ", false )
        call TriggerRegisterPlayerChatEvent( gg_trg_Single_Special, ConvertedPlayer(GetForLoopIndexA()), "-sp ", false )
        call TriggerRegisterPlayerChatEvent( gg_trg_Single_EXP, ConvertedPlayer(GetForLoopIndexA()), "-exp", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Single_Line, ConvertedPlayer(GetForLoopIndexA()), "-라인", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Single_Mob, ConvertedPlayer(GetForLoopIndexA()), "-몹", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Single_Day, ConvertedPlayer(GetForLoopIndexA()), "-낮", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Single_Night, ConvertedPlayer(GetForLoopIndexA()), "-밤", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Test_Unlock, ConvertedPlayer(GetForLoopIndexA()), "-패스", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Sight, ConvertedPlayer(GetForLoopIndexA()), "시야 ", false )
        call TriggerRegisterPlayerChatEvent( gg_trg_Sight2, ConvertedPlayer(GetForLoopIndexA()), "tldi ", false )
        call TriggerRegisterPlayerChatEvent( gg_trg_Single_Alliance, ConvertedPlayer(GetForLoopIndexA()), "-동맹", true )
        call TriggerRegisterPlayerChatEvent( gg_trg_Single_AllianceManekin, ConvertedPlayer(GetForLoopIndexA()), "-아군 ", false )
        call TriggerRegisterPlayerEventEndCinematic( gg_trg_Stop_Moon_Protection, ConvertedPlayer(GetForLoopIndexA()) )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call TriggerExecute( gg_trg_Starting_Environment )
    call PolledWait( 240.00 )
    call SetPlayerTechResearchedSwap( 'R006', 1, Player(0) )
    call SetPlayerTechResearchedSwap( 'R006', 1, Player(6) )
endfunction

