        return false
    endif
    return true
endfunction

function Trig_Brave_Assult_Func002Func001Func001Func001C takes nothing returns boolean
    if ( not ( udg_MBKills[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]] < udg_MBKills[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetSpellTargetUnit()))]] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Brave_Assult_Func002Func001Func001C takes nothing returns boolean
    if ( not ( GetHeroLevel(GetSpellTargetUnit()) == GetHeroLevel(GetTriggerUnit()) ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R0BT', GetOwningPlayer(GetTriggerUnit())) >= 1 ) ) then
        return false
    endif
    if ( not ( udg_MBKills[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]] >= udg_MBKills[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetSpellTargetUnit()))]] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Brave_Assult_Func002Func001Func002Func002C takes nothing returns boolean
    if ( not ( GetHeroLevel(GetSpellTargetUnit()) == GetHeroLevel(GetTriggerUnit()) ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R0BT', GetOwningPlayer(GetTriggerUnit())) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Brave_Assult_Func002Func001Func002C takes nothing returns boolean
    if ( ( udg_MBKills[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]] < udg_MBKills[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetSpellTargetUnit()))]] ) ) then
        return true
    endif
    if ( Trig_Brave_Assult_Func002Func001Func002Func002C() ) then
        return true
    endif
    return false
endfunction

function Trig_Brave_Assult_Func002Func001C takes nothing returns boolean
    if ( not Trig_Brave_Assult_Func002Func001Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Brave_Assult_Func002Func002Func001Func002C takes nothing returns boolean
    if ( not ( GetHeroLevel(GetSpellTargetUnit()) == GetHeroLevel(GetTriggerUnit()) ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R0BT', GetOwningPlayer(GetTriggerUnit())) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Brave_Assult_Func002Func002Func001C takes nothing returns boolean
    if ( ( udg_MBKills[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]] > udg_MBKills[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetSpellTargetUnit()))]] ) ) then
        return true
    endif
    if ( Trig_Brave_Assult_Func002Func002Func001Func002C() ) then
        return true
    endif
    return false
endfunction

function Trig_Brave_Assult_Func002Func002Func009C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R093', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    if ( not ( udg_MBKills[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]] > udg_MBKills[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetSpellTargetUnit()))]] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Brave_Assult_Func002Func002C takes nothing returns boolean
    if ( not Trig_Brave_Assult_Func002Func002Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Brave_Assult_Func002C takes nothing returns boolean
    if ( not ( IsUnitType(GetSpellTargetUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Brave_Assult_Actions takes nothing returns nothing
    call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), ( 50.00 + ( 50.00 * I2R(GetUnitAbilityLevelSwapped('A078', GetTriggerUnit())) ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_DIVINE )
    if ( Trig_Brave_Assult_Func002C() ) then
        if ( Trig_Brave_Assult_Func002Func001C() ) then
            if ( Trig_Brave_Assult_Func002Func001Func001C() ) then
                call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), RMaxBJ(0.00, RMinBJ(( 60.00 + ( 60.00 * I2R(GetUnitAbilityLevelSwapped('A078', GetTriggerUnit())) ) ), ( 1.00 * ( 20.00 + ( 20.00 * I2R(GetUnitAbilityLevelSwapped('A078', GetTriggerUnit())) ) ) ))), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_DIVINE )
            else
                if ( Trig_Brave_Assult_Func002Func001Func001Func001C() ) then
                    call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), RMaxBJ(0.00, RMinBJ(( 60.00 + ( 60.00 * I2R(GetUnitAbilityLevelSwapped('A078', GetTriggerUnit())) ) ), ( ( I2R(udg_MBKills[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetSpellTargetUnit()))]]) - I2R(udg_MBKills[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]]) ) * ( 20.00 + ( 20.00 * I2R(GetUnitAbilityLevelSwapped('A078', GetTriggerUnit())) ) ) ))), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_DIVINE )
                else
                endif
            endif
            call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), RMaxBJ(0.00, RMinBJ(( 60.00 + ( 60.00 * I2R(GetUnitAbilityLevelSwapped('A078', GetTriggerUnit())) ) ), ( ( I2R(udg_MBKills[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetSpellTargetUnit()))]]) - I2R(udg_MBKills[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]]) ) * ( 20.00 + ( 20.00 * I2R(GetUnitAbilityLevelSwapped('A078', GetTriggerUnit())) ) ) ))), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_DIVINE )
            call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        else
        endif
        if ( Trig_Brave_Assult_Func002Func002C() ) then
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 4.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A10M', GetLastCreatedUnit() )
            call SetUnitAbilityLevelSwapped( 'A10M', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A078', GetTriggerUnit()) )
            call IssueTargetOrderBJ( GetLastCreatedUnit(), "faeriefire", GetSpellTargetUnit() )
            call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
            if ( Trig_Brave_Assult_Func002Func002Func009C() ) then
                call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), RMaxBJ(0.00, RMinBJ(( 40.00 + ( 40.00 * I2R(GetUnitAbilityLevelSwapped('A078', GetTriggerUnit())) ) ), ( ( I2R(udg_MBKills[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]]) - I2R(udg_MBKills[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetSpellTargetUnit()))]]) ) * ( 20.00 + ( 20.00 * I2R(GetUnitAbilityLevelSwapped('A078', GetTriggerUnit())) ) ) ))), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_DIVINE )
            else
            endif
        else
        endif
    else
    endif
endfunction

