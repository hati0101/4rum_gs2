//===========================================================================
// Trigger: Death Hero New
//
// udg_SP_Number[
// if ( UnitHasItemOfTypeBJ(udg_Ogre_Lord, 'I0A7') == true ) then
//     call RemoveItem( GetItemOfTypeFromUnitBJ(udg_Ogre_Lord, 'I0A7') )
//     call UnitAddItemByIdSwapped( 'I04Q', udg_Ogre_Lord )
// else
// endif
// I0A8 ->I05N
// I0A9 ->I079
// udg_MBKills[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]] - udg_MBDeaths[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]
// SP_Player[] (플래이어)
// 셔플된 플래이어를 취급하는 순서대로 표시
// ex)플래이어2가 셔플후 7이되었을경우
// SP_Player[7]=player(2)
// SP_Number[] (정수)
// 배열에 게임시작시 플래이어번호를 넣어주면 현제 몇번 취급인지 알려줌
// ex)플래이어2가 셔플후 7이되었을경우
// SP_Number[2]=7
// //혹여나 나중에 필요하면 아이템 체크
// if (UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I076') == true ) then
// call RemoveItem( GetItemOfTypeFromUnitBJ(GetTriggerUnit(), 'I076') )
// call UnitAddItemByIdSwapped( 'I05M', GetTriggerUnit() )
// else
// endif
//===========================================================================
function Trig_Death_Hero_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Death_Hero_Actions takes nothing returns nothing
local unit DeadHero=GetDyingUnit()
local unit KillHero=GetKillingUnit()
local player KillPlayer=GetOwningPlayer(KillHero)
local player DeadPlayer=GetOwningPlayer(DeadHero)
local real HeroGold = (((GetHeroLevel(DeadHero) + 5)*((30+(udg_MBKills[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]*2))-(udg_MBDeaths[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]*3)))*0.25)
local string DeadMsg
local rect gg_rct_Hero_Respawn 
local integer Index = 1
local integer IndexEnd = 12
local integer RIndex = 1
local integer i = 0
local unit ManaEater


if ( GetUnitTypeId(DeadHero) == 'Hamg' ) then
if ( udg_Hero_PhM_PhoenixKiller != null ) then
    set KillHero = udg_Hero_PhM_PhoenixKiller
    set KillPlayer = GetOwningPlayer(KillHero)
    set udg_Hero_PhM_PhoenixKiller = null
endif
endif

//데스페라도 사망시 현상금 감소
if (GetUnitAbilityLevelSwapped('A0FU', DeadHero) >= 1)then
    set HeroGold = HeroGold - (60 * GetUnitAbilityLevelSwapped('A0FU', DeadHero))
endif

//데스페라도가 아군 영웅을 살해한 경우
if KillHero == udg_Hero_Des and IsUnitAlly(DeadHero, GetOwningPlayer(KillHero)) and DeadPlayer!=KillPlayer then
    call PlaySoundBJ( gg_snd_CowardSmash )
    call DisplayTimedTextToForce(GetPlayersAll(),10.00,(udg_Colors[udg_SP_Number[GetConvertedPlayerId(KillPlayer)]]+GetPlayerName(KillPlayer)+"|r("+GetUnitName(udg_HeroPlayer[GetConvertedPlayerId(KillPlayer)])+")님이 "+udg_Colors[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]+GetPlayerName(DeadPlayer)+"|r("+GetUnitName(DeadHero)+")님을 살해했습니다. "))
    if (GetUnitAbilityLevelSwapped('A0FU', KillHero) >= 1)then
        call AdjustPlayerStateBJ( GetHeroLevel(DeadHero)* 10,KillPlayer,PLAYER_STATE_RESOURCE_GOLD)
    endif
endif

//가디언 원더 현상금
if ( GetUnitTypeId(DeadHero) == 'Ocbh' ) then
if ( udg_Hero_StG_WonderKiller != null) then
    set KillHero = udg_HeroPlayer[GetConvertedPlayerId( udg_Hero_StG_WonderKiller )]
    set KillPlayer = udg_Hero_StG_WonderKiller
    set udg_Hero_StG_WonderKiller = null
endif
endif

//마력방출
if ( DeadHero == udg_Hero_SpI_Sp1Target ) then
if ( KillHero == null ) then
    set KillHero = udg_Hero_SpI_Sp1Atker
    set KillPlayer = GetOwningPlayer(udg_Hero_SpI_Sp1Atker)
    call AdjustPlayerStateBJ(150, KillPlayer, PLAYER_STATE_RESOURCE_GOLD)
    call TextTagForce( "+150", DeadHero, 10, 255, 255, 215, 3, GetForceOfPlayer(GetOwningPlayer(KillHero)))
    set udg_Hero_SpI_Sp1Target = null
endif
endif


//리비도
if ( DeadHero == udg_Hero_DaP_LibidoTarget ) then
if ( KillHero == null ) then
    set KillHero = DeadHero
    set KillPlayer = GetOwningPlayer(DeadHero)
endif
endif

//백스탭
if ( DeadHero == udg_Hero_DrA_BackstabTarget ) then
if ( KillHero == null ) then
    set KillHero = udg_Hero_DrA
    set KillPlayer = GetOwningPlayer(udg_Hero_DrA)
    call AdjustPlayerStateBJ(150, KillPlayer, PLAYER_STATE_RESOURCE_GOLD)
    call TextTagForce( "+150", DeadHero, 10, 255, 255, 215, 3, GetForceOfPlayer(GetOwningPlayer(KillHero)))
    set udg_Hero_DrA_BackstabTarget = null
endif
endif


//부활장소 설정
set gg_rct_Hero_Respawn=gg_rct_G_Home_Revive
if (IsPlayerAlly(DeadPlayer,udg_Force[2])) then
set gg_rct_Hero_Respawn=gg_rct_D_Home_Revive
endif

//보상금의 음수값 제거
if (HeroGold <= 0) then
set HeroGold = 0
endif

//플래임 블레이더 사망시 불사의 심장 제거
if ( GetUnitTypeId(DeadHero) == 'Odrt' ) then
call UnitRemoveAbilityBJ( 'A0LT', DeadHero )
endif


//가디언의 영웅이 죽었을때
if (IsPlayerAlly(DeadPlayer,udg_Force[1])) then
    if (DeadPlayer==KillPlayer) then
        call DisplayTimedTextToForce(GetPlayersAll(),10.00,(udg_Colors[udg_SP_Number[GetConvertedPlayerId(KillPlayer)]]+GetPlayerName(KillPlayer)+"|r("+GetUnitName(udg_HeroPlayer[GetConvertedPlayerId(KillPlayer)])+")님이 자살했습니다."))
    elseif KillPlayer == Player(PLAYER_NEUTRAL_AGGRESSIVE) then
        call DisplayTimedTextToForce(GetPlayersAll(),10.00,(udg_Colors[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]+GetPlayerName(DeadPlayer)+"|r("+GetUnitName(udg_HeroPlayer[GetConvertedPlayerId(DeadPlayer)])+")님이 중립 크립에게 살해당했습니다."))
    elseif (IsPlayerAlly(KillPlayer,udg_Force[2])) then
        if (KillPlayer==udg_Force[2]) then
            set DeadMsg = (udg_Colors[udg_SP_Number[7]]+GetPlayerName(KillPlayer)+"|r에 의해 "+udg_Colors[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]+GetPlayerName(DeadPlayer)+"|r("+GetUnitName(DeadHero)+")님이 살해당했습니다.")
            if (HeroGold > 0) then
                set DeadMsg = (DeadMsg+udg_Colors[5]+"(+"+I2S(R2I(HeroGold))+"골드)|r")
            endif
            call DisplayTimedTextToForce(GetPlayersAll(),10.00,DeadMsg)
            //어시부분//
            if ( CountUnitsInGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)]) >= 1 ) then
            set DeadMsg = ("|cffFF8000어시스트|r - ")
            loop
            set i = CountUnitsInGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])
            exitwhen ( i == 0 )
            set i = i - 1
            set DeadMsg = (DeadMsg+udg_Colors[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])))]]+GetPlayerName(GetOwningPlayer(FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])))+"|r"+" ")
            set udg_MBAssis[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])))]]=(udg_MBAssis[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])))]]+1)
            call AdjustPlayerStateBJ(R2I(HeroGold),GetOwningPlayer(FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])),PLAYER_STATE_RESOURCE_GOLD)
            call GroupRemoveUnitSimple( FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)]), udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)] )
            endloop
            call DisplayTimedTextToForce(GetPlayersAll(),10.00,DeadMsg)
            call StartTimerBJ( udg_Assi_Timer[GetConvertedPlayerId(DeadPlayer)], false, 0.00 )
            endif
            ////////////

        else
            set DeadMsg = (udg_Colors[udg_SP_Number[GetConvertedPlayerId(KillPlayer)]]+GetPlayerName(KillPlayer)+"|r("+GetUnitName(udg_HeroPlayer[GetConvertedPlayerId(KillPlayer)])+")님이 "+udg_Colors[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]+GetPlayerName(DeadPlayer)+"|r("+GetUnitName(DeadHero)+")님을 살해했습니다. ")
            if (HeroGold > 0) then
                set DeadMsg = (DeadMsg+udg_Colors[5]+"(+"+I2S(R2I(HeroGold))+"골드)|r")
            endif
            call DisplayTimedTextToForce(GetPlayersAll(),10.00,DeadMsg)
            //어시부분//
            if ( CountUnitsInGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)]) >= 2 ) then
            call GroupRemoveUnitSimple( udg_HeroPlayer[GetConvertedPlayerId(KillPlayer)], udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)] )
            set DeadMsg = ("|cffFF8000어시스트|r - ")
            loop
            set i = CountUnitsInGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])
            exitwhen ( i == 0 )
            set i = i - 1
            set DeadMsg = (DeadMsg+udg_Colors[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])))]]+GetPlayerName(GetOwningPlayer(FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])))+"|r"+" ")
            set udg_MBAssis[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])))]]=(udg_MBAssis[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])))]]+1)
            call AdjustPlayerStateBJ(R2I(HeroGold),GetOwningPlayer(FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])),PLAYER_STATE_RESOURCE_GOLD)
            call GroupRemoveUnitSimple( FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)]), udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)] )
            endloop
            call StartTimerBJ( udg_Assi_Timer[GetConvertedPlayerId(DeadPlayer)], false, 0.00 )
            call DisplayTimedTextToForce(GetPlayersAll(),10.00,DeadMsg)
            endif
            ////////////
            set udg_Combo[udg_SP_Number[GetConvertedPlayerId(KillPlayer)]]=(udg_Combo[udg_SP_Number[GetConvertedPlayerId(KillPlayer)]]+1)
            set udg_MBKills[udg_SP_Number[GetConvertedPlayerId(KillPlayer)]]=(udg_MBKills[udg_SP_Number[GetConvertedPlayerId(KillPlayer)]]+1)
            call AdjustPlayerStateBJ(R2I(HeroGold),KillPlayer,PLAYER_STATE_RESOURCE_GOLD)
        endif
        call SetPlayerStateBJ(DeadPlayer, PLAYER_STATE_RESOURCE_GOLD, ( GetPlayerState(DeadPlayer, PLAYER_STATE_RESOURCE_GOLD) - R2I(HeroGold) ) )
        set udg_Combo[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]=0
        set udg_MBDeaths[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]=(udg_MBDeaths[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]+1)
        set udg_MBKills[7]=(udg_MBKills[7]+1)
        set udg_MBDeaths[1]=(udg_MBDeaths[1]+1)
        set udg_TeamCombo[2]=(udg_TeamCombo[2]+1)
        set udg_TeamCombo[1]=0       
    endif
endif


//다크니스의 영웅이 죽었을때
if (IsPlayerAlly(DeadPlayer,udg_Force[2])) then
if (DeadPlayer==KillPlayer) then
call DisplayTimedTextToForce(GetPlayersAll(),10.00,(udg_Colors[udg_SP_Number[GetConvertedPlayerId(KillPlayer)]]+GetPlayerName(KillPlayer)+"|r("+GetUnitName(udg_HeroPlayer[GetConvertedPlayerId(KillPlayer)])+")님이 자살했습니다."))
elseif KillPlayer == Player(PLAYER_NEUTRAL_AGGRESSIVE) then
        call DisplayTimedTextToForce(GetPlayersAll(),10.00,(udg_Colors[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]+GetPlayerName(DeadPlayer)+"|r("+GetUnitName(udg_HeroPlayer[GetConvertedPlayerId(DeadPlayer)])+")님이 중립 크립에게 살해당했습니다."))
elseif (IsPlayerAlly(KillPlayer,udg_Force[1])) then
if (KillPlayer==udg_Force[1]) then
            set DeadMsg = (udg_Colors[udg_SP_Number[1]]+GetPlayerName(KillPlayer)+"|r에 의해 "+udg_Colors[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]+GetPlayerName(DeadPlayer)+"|r("+GetUnitName(DeadHero)+")님이 살해당했습니다.")
            if (HeroGold > 0) then
                set DeadMsg = (DeadMsg+udg_Colors[5]+"(+"+I2S(R2I(HeroGold))+"골드)|r")
            endif
            call DisplayTimedTextToForce(GetPlayersAll(),10.00,DeadMsg)
            //어시부분//
            if ( CountUnitsInGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)]) >= 1 ) then
            set DeadMsg = ("|cffFF8000어시스트|r - ")
            loop
            set i = CountUnitsInGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])
            exitwhen ( i == 0 )
            set i = i - 1
            set DeadMsg = (DeadMsg+udg_Colors[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])))]]+GetPlayerName(GetOwningPlayer(FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])))+"|r"+" ")
            set udg_MBAssis[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])))]]=(udg_MBAssis[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])))]]+1)
            call AdjustPlayerStateBJ(R2I(HeroGold),GetOwningPlayer(FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])),PLAYER_STATE_RESOURCE_GOLD)
            call GroupRemoveUnitSimple( FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)]), udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)] )
            endloop
            call DisplayTimedTextToForce(GetPlayersAll(),10.00,DeadMsg)
            call StartTimerBJ( udg_Assi_Timer[GetConvertedPlayerId(DeadPlayer)], false, 0.00 )
            endif
            ////////////
        else
            set DeadMsg = (udg_Colors[udg_SP_Number[GetConvertedPlayerId(KillPlayer)]]+GetPlayerName(KillPlayer)+"|r("+GetUnitName(udg_HeroPlayer[GetConvertedPlayerId(KillPlayer)])+")님이 "+udg_Colors[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]+GetPlayerName(DeadPlayer)+"|r("+GetUnitName(DeadHero)+")님을 살해했습니다. ")
            if (HeroGold > 0) then
                set DeadMsg = (DeadMsg+udg_Colors[5]+"(+"+I2S(R2I(HeroGold))+"골드)|r")
            endif
            call DisplayTimedTextToForce(GetPlayersAll(),10.00,DeadMsg)
            //어시부분//
            if ( CountUnitsInGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)]) >= 2 ) then
            call GroupRemoveUnitSimple( udg_HeroPlayer[GetConvertedPlayerId(KillPlayer)], udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)] )
            set DeadMsg = ("|cffFF8000어시스트|r - ")
            loop
            set i = CountUnitsInGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])
            exitwhen ( i == 0 )
            set i = i - 1
            set DeadMsg = (DeadMsg+udg_Colors[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])))]]+GetPlayerName(GetOwningPlayer(FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])))+"|r"+" ")
            set udg_MBAssis[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])))]]=(udg_MBAssis[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])))]]+1)
            call AdjustPlayerStateBJ(R2I(HeroGold),GetOwningPlayer(FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)])),PLAYER_STATE_RESOURCE_GOLD)
            call GroupRemoveUnitSimple( FirstOfGroup(udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)]), udg_Assi_Group[GetConvertedPlayerId(DeadPlayer)] )
            endloop
            call StartTimerBJ( udg_Assi_Timer[GetConvertedPlayerId(DeadPlayer)], false, 0.00 )
            call DisplayTimedTextToForce(GetPlayersAll(),10.00,DeadMsg)
            endif
            ////////////

set udg_Combo[udg_SP_Number[GetConvertedPlayerId(KillPlayer)]]=(udg_Combo[udg_SP_Number[GetConvertedPlayerId(KillPlayer)]]+1)
set udg_MBKills[udg_SP_Number[GetConvertedPlayerId(KillPlayer)]]=(udg_MBKills[udg_SP_Number[GetConvertedPlayerId(KillPlayer)]]+1)
call AdjustPlayerStateBJ(R2I(HeroGold),KillPlayer,PLAYER_STATE_RESOURCE_GOLD)
endif
call SetPlayerStateBJ(DeadPlayer, PLAYER_STATE_RESOURCE_GOLD, ( GetPlayerState(DeadPlayer, PLAYER_STATE_RESOURCE_GOLD) - R2I(HeroGold) ) )
set udg_Combo[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]=0
set udg_MBDeaths[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]=(udg_MBDeaths[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]+1)
set udg_MBKills[1]=(udg_MBKills[1]+1)
set udg_MBDeaths[7]=(udg_MBDeaths[7]+1)
set udg_TeamCombo[1]=(udg_TeamCombo[1]+1)
set udg_TeamCombo[2]=0
endif
endif


//사운드 체크
if (DeadPlayer!=KillPlayer) then
if (GetPlayerTechCountSimple('R04N', KillPlayer) == 1) then
call PlaySoundBJ( gg_snd_SoulDeath )
endif
endif


//유령 설정
call PolledWait(1.05)
call AddSpecialEffectLocBJ( GetUnitLoc(DeadHero), "Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl" )
call DestroyEffectBJ( GetLastCreatedEffectBJ() )
call ReviveHeroLoc( DeadHero, GetRectCenter(gg_rct_Hero_Respawn), false )
call SetUnitVertexColorBJ( DeadHero, 100, 100, 100, 50.00 )
call UnitRemoveBuffsExBJ( bj_BUFF_POLARITY_EITHER, bj_BUFF_RESIST_EITHER, DeadHero, false, false )
call SetUnitFlyHeightBJ( DeadHero, 0.00, 100000000.00 )
call SetUnitInvulnerable( DeadHero, true )
call PauseUnitBJ( false, DeadHero )
call CreateNUnitsAtLoc( 1, 'e030', GetOwningPlayer(DeadHero), GetUnitLoc(DeadHero), bj_UNIT_FACING )
set ManaEater = GetLastCreatedUnit()
call UnitAddAbilityBJ( 'A00V', ManaEater )
call UnitAddAbilityBJ( 'A021', ManaEater )
call IssuePointOrderLocBJ( ManaEater, "silence", GetUnitLoc(DeadHero) )

//부활
call TriggerExecute(gg_trg_Multi_Board_Kills_Update)

//부활 시간
if (udg_MBDeaths[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]>=udg_MBKills[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]) then
  set udg_RevivalTimer[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]=(GetHeroLevel(DeadHero)*4)
else
  set udg_RevivalTimer[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]=(((udg_MBKills[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]] - udg_MBDeaths[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]])*2) + (GetHeroLevel(DeadHero))*4)
endif

//부활시간 증가 패널티
if (IsPlayerAlly(DeadPlayer,udg_Force[1])) and (udg_ModeNA == false) then
set RIndex = 2
loop
  exitwhen RIndex >= 7
  if (udg_RevivalTimer[RIndex]>=1) then
    set udg_RevivalTimer[RIndex]=udg_RevivalTimer[RIndex] + 5
  endif
  set RIndex = RIndex + 1
endloop
endif

if (IsPlayerAlly(DeadPlayer,udg_Force[2])) and (udg_ModeNA == false) then
set RIndex = 7
loop
  exitwhen RIndex >= 13
  if (udg_RevivalTimer[RIndex]>=1) then
    set udg_RevivalTimer[RIndex]=udg_RevivalTimer[RIndex] + 5
  endif
  set RIndex = RIndex + 1
endloop
endif

// DG 모드 영구 25% 감소
if (udg_ModeDG==true) then
set udg_RevivalTimer[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]=(udg_RevivalTimer[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]/3*2)

if (TimerGetElapsed(udg_MBTime) >= 1800.00) then
set udg_RevivalTimer[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]=(udg_RevivalTimer[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]/2)
endif
endif

// 영혼의 파괴 체크
if (DeadPlayer!=KillPlayer) then
if (GetPlayerTechCountSimple('R04N', KillPlayer) == 1) then
call PlaySoundBJ( gg_snd_SoulDeath )
if (GetHeroLevel(DeadHero)*3 > 40) then
set udg_RevivalTimer[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]=(udg_RevivalTimer[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]+40)
else
set udg_RevivalTimer[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]=(udg_RevivalTimer[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]+(GetHeroLevel(DeadHero)*3))
endif
endif
endif

//리비도의 인도 체크
if ( DeadHero == udg_Hero_DaP_LibidoTarget ) then
if ( GetPlayerTechCountSimple('R00B', GetOwningPlayer(udg_Hero_DaP)) == 1 ) then
if ( KillHero == DeadHero ) then
call PlaySoundBJ( gg_snd_DaP_Special )
set udg_RevivalTimer[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]=(udg_RevivalTimer[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]/2) 
endif
endif
endif

//NA 모드 부활시간 감소
if udg_ModeNA then
set udg_RevivalTimer[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]=(udg_RevivalTimer[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]/4)
endif

set udg_RevivalTimer[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]=R2I(I2R(udg_RevivalTimer[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]])*0.60+0.50)
loop
call PolledWait(0.90)
set udg_RevivalTimer[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]=udg_RevivalTimer[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]-1
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),3,udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]+1,"   " +I2S(udg_RevivalTimer[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]))
exitwhen udg_RevivalTimer[udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]]<1
endloop
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),3,udg_SP_Number[GetConvertedPlayerId(DeadPlayer)]+1,"   ")
call PanCameraToTimedLocForPlayer( GetTriggerPlayer(), GetUnitLoc(DeadHero), 0 )


//부활시 무적, 버프 해제, 마나 원상복귀, 투명도 0%
call AddSpecialEffectTargetUnitBJ( "origin", DeadHero, "Abilities\\Spells\\Other\\Awaken\\Awaken.mdl" )
call SetUnitFlyHeightBJ( DeadHero, 0.00, 100000000.00 )
call DestroyEffectBJ( GetLastCreatedEffectBJ() )
call SetUnitInvulnerable( DeadHero, false )
call SetUnitVertexColorBJ( DeadHero, 100, 100, 100, 0.00 )
call SetUnitManaPercentBJ( DeadHero, 100 )
call UnitRemoveBuffsExBJ( bj_BUFF_POLARITY_EITHER, bj_BUFF_RESIST_EITHER, DeadHero, true, true )
call SetUnitTimeScalePercent( DeadHero, 100 )
call KillUnit( ManaEater )
call KillUnit( udg_Hero_DoL_UndeadHero[GetConvertedPlayerId(GetOwningPlayer(udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(DeadHero))]))] )

//블랙쉐이커
if (GetUnitTypeId(DeadHero) == 'Naka') then
call StartTimerBJ( udg_Hero_BlS_SajunBuffTimer, false, 0.60 )
endif

//엘리멘탈리스트
if (GetUnitTypeId(DeadHero) == 'Nman') then
call TriggerExecute( gg_trg_EleHar_Get )
endif

endfunction

