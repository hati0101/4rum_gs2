    if ( not ( TimerGetRemaining(udg_Hero_PaB_TimerDec[1]) == 0.00 ) ) then
        return false
    endif
    if ( not ( udg_Hero_PaB_Boolean[1] == true ) ) then
        return false
    endif
    return true
endfunction

