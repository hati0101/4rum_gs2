endfunction

function Trig_Hell_Ready_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsOfTypeIdAll('e008')) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hell_Ready_Actions takes nothing returns nothing
    local effect a = null
    if ( Trig_Hell_Ready_Func002C() ) then
        set udg_Hero_LOI_Loca = GetSpellTargetLoc()
        call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Orc\\AncestralSpirit\\AncestralSpiritCaster.mdl" )
        set a = GetLastCreatedEffectBJ()
        call TriggerSleepAction( 1.00 )
        call DestroyEffectBJ( a )
    else
        call DisplayTextToForce( GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), "TRIGSTR_1750" )
        call TriggerSleepAction( 0.10 )
        call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
    endif
endfunction

