    if ( not ( GetPlayerController(udg_SP_Player[GetForLoopIndexA()]) == MAP_CONTROL_USER ) ) then
        return false
    endif
    if ( not ( GetPlayerSlotState(udg_SP_Player[GetForLoopIndexA()]) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    return true
endfunction

function Trig_Leaving_Game_Func005C takes nothing returns boolean
    if ( not ( IsPlayerAlly(GetTriggerPlayer(), udg_Force[2]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Leaving_Game_Func009C takes nothing returns boolean
    if ( not ( IsPlayerAlly(GetTriggerPlayer(), udg_Force[1]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Leaving_Game_Actions takes nothing returns nothing
    local integer i = 0
    local integer g = R2I(I2R(GetPlayerState(GetTriggerPlayer(), PLAYER_STATE_RESOURCE_GOLD)) * 0.8)
    call DisplayTimedTextToForce( GetPlayersAll(), 30, ( ( udg_Colors[udg_SP_Number[GetConvertedPlayerId(GetTriggerPlayer())]] + udg_SP_PlayerName[GetConvertedPlayerId(GetTriggerPlayer())] ) + "|r님이 게임에서 나갔습니다." ) )
    if ( Trig_Leaving_Game_Func004C() ) then
        set bj_forLoopAIndex = 2
        set bj_forLoopAIndexEnd = 6
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            if ( Trig_Leaving_Game_Func004Func001Func001C() ) then
                set i = i + 1
            else
            endif
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
        set bj_forLoopAIndex = 2
        set bj_forLoopAIndexEnd = 6
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            if ( Trig_Leaving_Game_Func004Func002Func001C() ) then
                call AdjustPlayerStateBJ( ( g / i ), udg_SP_Player[GetForLoopIndexA()], PLAYER_STATE_RESOURCE_GOLD )
            else
            endif
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
        set udg_GoldBonusTimer[1] = ( udg_GoldBonusTimer[1] + 600 )
        call DisplayTimedTextToForce( GetPlayersAll(), 30, "TRIGSTR_1207" )
    else
    endif
    if ( Trig_Leaving_Game_Func005C() ) then
        set bj_forLoopAIndex = 8
        set bj_forLoopAIndexEnd = 12
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            if ( Trig_Leaving_Game_Func005Func001Func001C() ) then
                set i = i + 1
            else
            endif
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
        set bj_forLoopAIndex = 8
        set bj_forLoopAIndexEnd = 12
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            if ( Trig_Leaving_Game_Func005Func002Func001C() ) then
                call AdjustPlayerStateBJ( ( g / i ), udg_SP_Player[GetForLoopIndexA()], PLAYER_STATE_RESOURCE_GOLD )
            else
            endif
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
        set udg_GoldBonusTimer[2] = ( udg_GoldBonusTimer[2] + 600 )
        call DisplayTimedTextToForce( GetPlayersAll(), 30, "TRIGSTR_1242" )
    else
    endif
    call ShareEverythingWithTeam( GetTriggerPlayer() )
    call MultiboardSetItemValueBJ( udg_MB, 2, ( udg_SP_Number[GetConvertedPlayerId(GetTriggerPlayer())] + 1 ), ( ( "|CFF404040" + GetPlayerName(GetTriggerPlayer()) ) + "|r" ) )
    call MultiboardDisplayBJ( true, udg_MB )
    if ( Trig_Leaving_Game_Func009C() ) then
        set udg_Cnt_Player[0] = ( udg_Cnt_Player[0] - 1 )
    else
        set udg_Cnt_Player[1] = ( udg_Cnt_Player[1] - 1 )
    endif
endfunction

//===========================================================================
function InitTrig_Leaving_Game takes nothing returns nothing
    set gg_trg_Leaving_Game = CreateTrigger(  )
    call TriggerRegisterPlayerEventLeave( gg_trg_Leaving_Game, Player(1) )
    call TriggerRegisterPlayerEventLeave( gg_trg_Leaving_Game, Player(2) )
    call TriggerRegisterPlayerEventLeave( gg_trg_Leaving_Game, Player(3) )
    call TriggerRegisterPlayerEventLeave( gg_trg_Leaving_Game, Player(4) )
    call TriggerRegisterPlayerEventLeave( gg_trg_Leaving_Game, Player(5) )
    call TriggerRegisterPlayerEventLeave( gg_trg_Leaving_Game, Player(7) )
    call TriggerRegisterPlayerEventLeave( gg_trg_Leaving_Game, Player(8) )
    call TriggerRegisterPlayerEventLeave( gg_trg_Leaving_Game, Player(9) )
    call TriggerRegisterPlayerEventLeave( gg_trg_Leaving_Game, Player(10) )
    call TriggerRegisterPlayerEventLeave( gg_trg_Leaving_Game, Player(11) )
    call TriggerAddAction( gg_trg_Leaving_Game, function Trig_Leaving_Game_Actions )
endfunction

