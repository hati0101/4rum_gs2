    if ( not ( udg_Hero_ShT_Passiveint == 3 ) ) then
        return false
    endif
    if ( not ( TimerGetRemaining(udg_Hero_ShT_PassiveTimer[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]) < 0.10 ) ) then
        return false
    endif
    return true
endfunction

function Trig_ShT_Attack_Func005Func001C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == udg_Hero_ShT_PassiveTgt ) ) then
        return false
    endif
    return true
endfunction

function Trig_ShT_Attack_Func005C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0G6', GetEventDamageSource()) >= 1 ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_ShT_Attack_Func006C takes nothing returns boolean
    if ( not ( udg_Hero_ShT_Boolen == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_ShT_Attack_Actions takes nothing returns nothing
    set udg_Hero_ShT_AtkTarget = null
    if ( Trig_ShT_Attack_Func003C() ) then
        call CreateNUnitsAtLoc( 1, 'e03I', GetOwningPlayer(GetEventDamageSource()), GetRectCenter(GetPlayableMapRect()), bj_UNIT_FACING )
    else
    endif
    if ( Trig_ShT_Attack_Func004C() ) then
        call SetUnitLifeBJ( GetEventDamageSource(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetEventDamageSource()) + ( ( I2R(GetUnitAbilityLevelSwapped('A09P', GetEventDamageSource())) * 20.00 ) + 0.00 ) ) )
        call AddSpecialEffectTargetUnitBJ( "origin", GetEventDamageSource(), "Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        if ( Trig_ShT_Attack_Func004Func004C() ) then
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A0PQ', GetLastCreatedUnit() )
            call IssueTargetOrderBJ( GetLastCreatedUnit(), "soulburn", GetTriggerUnit() )
        else
        endif
        set udg_Hero_ShT_Sneak = false
    else
    endif
    if ( Trig_ShT_Attack_Func005C() ) then
        if ( Trig_ShT_Attack_Func005Func001C() ) then
            set udg_Hero_ShT_Passiveint = IMinBJ(3, ( udg_Hero_ShT_Passiveint + 1 ))
            if ( Trig_ShT_Attack_Func005Func001Func002C() ) then
                set udg_Hero_ShT_Passiveint = 0
                call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
                call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
                call UnitAddAbilityBJ( 'A0WC', GetLastCreatedUnit() )
                call SetUnitAbilityLevelSwapped( 'A0WC', GetLastCreatedUnit(), ( 1 + GetUnitAbilityLevelSwapped('A0G6', GetEventDamageSource()) ) )
                call IssueTargetOrderBJ( GetLastCreatedUnit(), "cripple", GetTriggerUnit() )
                call StartTimerBJ( udg_Hero_ShT_PassiveTimer[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], false, 7.00 )
                if ( Trig_ShT_Attack_Func005Func001Func002Func008C() ) then
                    call CreateNUnitsAtLoc( 1, 'e003', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
                    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
                    call UnitAddAbilityBJ( 'A0Q3', GetLastCreatedUnit() )
                    call IssueTargetOrderBJ( GetLastCreatedUnit(), "faeriefire", GetTriggerUnit() )
                else
                endif
            else
            endif
        else
            set udg_Hero_ShT_PassiveTgt = GetTriggerUnit()
            set udg_Hero_ShT_Passiveint = 1
        endif
        call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Items\\WandOfNeutralization\\NeutralizationMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call TextTagForce( I2S(udg_Hero_ShT_Passiveint), GetTriggerUnit(), 12, 60, 60, 60, 2, GetForceOfPlayer(GetOwningPlayer(GetEventDamageSource())) )
    else
    endif
    if ( Trig_ShT_Attack_Func006C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0TI', GetLastCreatedUnit() )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "doom", GetTriggerUnit() )
        call TextTag( "차원 비틀기!" , GetTriggerUnit() , 12 , 60 , 60 , 60, 3 )
        call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        set udg_Hero_ShT_Boolen = false
    else
    endif
endfunction

