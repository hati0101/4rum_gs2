    call DisableTrigger( gg_trg_Charge_Unit )
    call TriggerAddCondition( gg_trg_Charge_Unit, Condition( function Trig_Charge_Unit_Conditions ) )
    call TriggerAddAction( gg_trg_Charge_Unit, function Trig_Charge_Unit_Actions )
endfunction

