//===========================================================================
// Trigger: Creep Killing
//===========================================================================
function Trig_Creep_Killing_Conditions takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetDyingUnit(), GetUnitsOfPlayerAll(Player(PLAYER_NEUTRAL_AGGRESSIVE))) == true ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetKillingUnitBJ()) != udg_Force[1] ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetKillingUnitBJ()) != udg_Force[2] ) ) then
        return false
    endif
    if ( not ( IsUnitIllusionBJ(GetDyingUnit()) != true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Creep_Killing_Func002Func001Func001002001001001001 takes nothing returns boolean
    return ( IsPlayerAlly(GetFilterPlayer(), udg_Force[2]) == true )
endfunction

function Trig_Creep_Killing_Func002Func001Func001002001001001002 takes nothing returns boolean
    return ( GetFilterPlayer() != udg_Force[2] )
endfunction

function Trig_Creep_Killing_Func002Func001Func001002001001001 takes nothing returns boolean
    return GetBooleanAnd( Trig_Creep_Killing_Func002Func001Func001002001001001001(), Trig_Creep_Killing_Func002Func001Func001002001001001002() )
endfunction

function Trig_Creep_Killing_Func002Func001Func001002001001002001 takes nothing returns boolean
    return ( GetPlayerController(GetFilterPlayer()) == MAP_CONTROL_USER )
endfunction

function Trig_Creep_Killing_Func002Func001Func001002001001002002 takes nothing returns boolean
    return ( GetPlayerSlotState(GetFilterPlayer()) == PLAYER_SLOT_STATE_PLAYING )
endfunction

