//===========================================================================
// Trigger: Libido Dead
//===========================================================================
function Trig_Libido_Dead_Func001Func001Func003C takes nothing returns boolean
    if ( ( IsUnitType(GetEnumUnit(), UNIT_TYPE_HERO) == true ) ) then
        return true
    endif
    if ( ( GetEnumUnit() == udg_Hero_DaP_LibidoTarget ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'u000' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'u001' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'u002' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'o00N' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'o00O' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'o00P' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetEnumUnit()) == 'o00P' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Libido_Dead_Func001Func001C takes nothing returns boolean
    if ( not Trig_Libido_Dead_Func001Func001Func003C() ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetEnumUnit(), 'B03K') == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Libido_Dead_Func001A takes nothing returns nothing
    if ( Trig_Libido_Dead_Func001Func001C() ) then
        call AddSpecialEffectLocBJ( GetUnitLoc(GetEnumUnit()), "Abilities\\\\Spells\\\\Undead\\\\Possession\\\\PossessionTarget.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call SetUnitInvulnerable( GetEnumUnit(), false )
        call UnitRemoveBuffsBJ( bj_REMOVEBUFFS_ALL, GetEnumUnit() )
        call UnitRemoveBuffBJ( 'B01Z', GetEnumUnit() )
        call KillUnit( GetEnumUnit() )
    else
    endif
endfunction

function Trig_Libido_Dead_Actions takes nothing returns nothing
    call ForGroupBJ( GetUnitsInRectOfPlayer(GetEntireMapRect(), GetOwningPlayer(udg_Hero_DaP_LibidoTarget)), function Trig_Libido_Dead_Func001A )
endfunction

