//===========================================================================
function Trig_Grand_Phantasm_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A11A' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Grand_Phantasm_Func001002003 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == true )
endfunction

function Trig_Grand_Phantasm_Func008A takes nothing returns nothing
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetEnumUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0IG', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0IG', GetLastCreatedUnit(), ( GetUnitAbilityLevelSwapped('A11A', GetTriggerUnit()) + ( GetPlayerTechCountSimple('R063', GetOwningPlayer(GetTriggerUnit())) * 3 ) ) )
    call IssueTargetOrderById( GetLastCreatedUnit(), 852274, GetEnumUnit() )
endfunction

function Trig_Grand_Phantasm_Actions takes nothing returns nothing
    set udg_Hero_Hal_UltiGroup = GetUnitsInRangeOfLocMatching(( 320.00 + ( 50.00 * I2R(GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit())) ) ), GetSpellTargetLoc(), Condition(function Trig_Grand_Phantasm_Func001002003))
    call CreateNUnitsAtLoc( 1, 'e00V', GetOwningPlayer(GetTriggerUnit()), GetSpellTargetLoc(), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetSpellTargetLoc(), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 3.50, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0K3', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0K3', GetTriggerUnit(), GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) )
    call ForGroupBJ( udg_Hero_Hal_UltiGroup, function Trig_Grand_Phantasm_Func008A )
    call GroupClear( udg_Hero_Hal_UltiGroup )
endfunction

