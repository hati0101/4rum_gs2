function Trig_View_Curse_Func002Func001C takes nothing returns boolean
    if ( not ( udg_Hero_ChW_Curse[GetForLoopIndexA()] > 0 ) ) then
        return false
    endif
    if ( not ( IsPlayerEnemy(GetTriggerPlayer(), ConvertedPlayer(GetForLoopIndexA())) == true ) ) then
        return false
    endif
    if ( not ( GetPlayerController(ConvertedPlayer(GetForLoopIndexA())) == MAP_CONTROL_USER ) ) then
        return false
    endif
    return true
endfunction

function Trig_View_Curse_Actions takes nothing returns nothing
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_View_Curse_Func002Func001C() ) then
            call DisplayTimedTextToForce( GetForceOfPlayer(GetTriggerPlayer()), 5.00, ( ( ( udg_Colors[GetForLoopIndexA()] + ( GetUnitName(udg_HeroPlayer[GetForLoopIndexA()]) + "|r" ) ) + "의 현재 저주 중첩 : " ) + I2S(udg_Hero_ChW_Curse[GetForLoopIndexA()]) ) )
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

