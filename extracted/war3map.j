    call CreateNUnitsAtLoc( 1, 'e00U', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 700.00, AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetSpellTargetLoc())), bj_UNIT_FACING )
