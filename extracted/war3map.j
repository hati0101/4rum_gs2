    set udg_Hero_Ran_NetNum[2] = 4
    set udg_Hero_Ran_NetNum[3] = 5
    set udg_Hero_Ran_NetNum[4] = 6
    if ( Trig_Hunting_Net_Warn_Func005C() ) then
        call DisplayTimedTextToForce( GetForceOfPlayer(GetTriggerPlayer()), 10.00, "TRIGSTR_1771" )
        call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
        return
    else
    endif
    if ( Trig_Hunting_Net_Warn_Func006C() ) then
        call ForGroupBJ( GetUnitsOfTypeIdAll('n004'), function Trig_Hunting_Net_Warn_Func006Func001A )
        set bj_wantDestroyGroup=true
