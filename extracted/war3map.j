    if ( not ( TimerGetRemaining(udg_Hero_Des_Sp3Timer) > 0.01 ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())]) == 'Hapm' ) ) then
        return false
    endif
