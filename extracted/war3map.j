//===========================================================================
function Trig_Surrender_Guardian_Func003Func003A takes nothing returns nothing
    set udg_Surrender_Bool[GetConvertedPlayerId(GetEnumPlayer())] = false
endfunction

function Trig_Surrender_Guardian_Func003C takes nothing returns boolean
    if ( not ( udg_Cnt_Player[0] <= ( udg_Surrender_Int[1] + 1 ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Surrender_Guardian_Actions takes nothing returns nothing
    call DestroyTimerDialogBJ( udg_Surrender_Window[1] )
    call StartTimerBJ( udg_Surrender_Timer[3], false, 300.00 )
    if ( Trig_Surrender_Guardian_Func003C() ) then
        call DisplayTimedTextToForce( GetPlayersAll(), 10.00, "TRIGSTR_1401" )
        call DisplayTimedTextToForce( GetPlayersAll(), 60.00, ( udg_Colors[1] + "   5초 후 다크니스가 승리합니다.|r" ) )
        call PlaySoundBJ( gg_snd_DarkVictory )
        call PolledWait( 5.00 )
        call KillUnit( gg_unit_etoe_0012 )
    else
        call DisplayTimedTextToForce( GetPlayersAll(), 10.00, "TRIGSTR_1376" )
        set udg_Surrender_Int[1] = 0
        call ForForce( GetPlayersAllies(udg_Force[1]), function Trig_Surrender_Guardian_Func003Func003A )
    endif
endfunction

