// Trigger: Multi Board Kills Update
//===========================================================================
function Trig_Multi_Board_Kills_Update_Func006C takes nothing returns boolean
    if ( not ( udg_TeamCombo[1] >= 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Multi_Board_Kills_Update_Func007C takes nothing returns boolean
    if ( not ( udg_TeamCombo[2] >= 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Multi_Board_Kills_Update_Func008Func001C takes nothing returns boolean
    if ( not ( udg_Combo[GetForLoopIndexA()] >= 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Multi_Board_Kills_Update_Func009Func001C takes nothing returns boolean
    if ( not ( udg_Combo[GetForLoopIndexA()] >= 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Multi_Board_Kills_Update_Actions takes nothing returns nothing
    set udg_MB = GetLastCreatedMultiboard()
    call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 6, 2, ( "    " + I2S(udg_MBDeaths[1]) ) )
    call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 6, 8, ( "    " + I2S(udg_MBDeaths[7]) ) )
    call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 5, 2, ( "    " + I2S(udg_MBKills[1]) ) )
    call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 5, 8, ( "    " + I2S(udg_MBKills[7]) ) )
    if ( Trig_Multi_Board_Kills_Update_Func006C() ) then
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 4, 2, ( "    " + I2S(udg_TeamCombo[1]) ) )
    else
    endif
    if ( Trig_Multi_Board_Kills_Update_Func007C() ) then
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 4, 8, ( "    " + I2S(udg_TeamCombo[2]) ) )
    else
    endif
    set bj_forLoopAIndex = 2
    set bj_forLoopAIndexEnd = 6
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Multi_Board_Kills_Update_Func008Func001C() ) then
            call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 4, ( GetForLoopIndexA() + 1 ), ( "    " + I2S(udg_Combo[GetForLoopIndexA()]) ) )
        else
        endif
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 5, ( GetForLoopIndexA() + 1 ), ( "    " + I2S(udg_MBKills[GetForLoopIndexA()]) ) )
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 6, ( GetForLoopIndexA() + 1 ), ( "    " + I2S(udg_MBDeaths[GetForLoopIndexA()]) ) )
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 7, ( GetForLoopIndexA() + 1 ), ( "    " + I2S(udg_MBAssis[GetForLoopIndexA()]) ) )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set bj_forLoopAIndex = 8
    set bj_forLoopAIndexEnd = 12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Multi_Board_Kills_Update_Func009Func001C() ) then
            call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 4, ( GetForLoopIndexA() + 1 ), ( "    " + I2S(udg_Combo[GetForLoopIndexA()]) ) )
        else
        endif
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 5, ( GetForLoopIndexA() + 1 ), ( "    " + I2S(udg_MBKills[GetForLoopIndexA()]) ) )
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 6, ( GetForLoopIndexA() + 1 ), ( "    " + I2S(udg_MBDeaths[GetForLoopIndexA()]) ) )
        call MultiboardSetItemValueBJ( GetLastCreatedMultiboard(), 7, ( GetForLoopIndexA() + 1 ), ( "    " + I2S(udg_MBAssis[GetForLoopIndexA()]) ) )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

