        return false
    endif
    return true
endfunction

function Trig_Wraith_of_Blood_Earth_Spirit_Start_Actions takes nothing returns nothing
    set udg_Hero_ToW_UltiCaster = GetSpellAbilityUnit()
    call UnitRemoveBuffBJ( 'B06G', GetTriggerUnit() )
    call UnitRemoveBuffBJ( 'B06I', GetTriggerUnit() )
    call UnitRemoveBuffBJ( 'B03N', GetTriggerUnit() )
    call UnitRemoveBuffBJ( 'B07E', GetTriggerUnit() )
    call EnableTrigger( gg_trg_Wraith_of_Blood_Earth_Spirit_Grow )
    set udg_Hero_ToW_IsLive = true
    call StartTimerBJ( udg_Hero_ToW_UltiTimer, false, ( 4.00 + ( 2.00 * I2R(GetUnitAbilityLevelSwapped('A0ZH', udg_Hero_ToW_UltiCaster)) ) ) )
    call PlaySoundBJ( gg_snd_TaurenYesAttack2 )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetSpellAbilityUnit()), GetUnitLoc(GetSpellAbilityUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( ( 4.00 + ( 2.00 * I2R(GetUnitAbilityLevelSwapped('A0ZH', GetTriggerUnit())) ) ), 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0LE', GetLastCreatedUnit() )
    set udg_Hero_ToW_UltiBuffUnit = GetLastCreatedUnit()
    call SetUnitTimeScalePercent( udg_Hero_ToW_UltiCaster, 160.00 )
    call PolledWait( 0.40 )
    call SetUnitTimeScalePercent( udg_Hero_ToW_UltiCaster, 100.00 )
    call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
endfunction

