        return false
    endif
    return true
endfunction

function Trig_Battle_Franzy_Actions takes nothing returns nothing
    set udg_Hero_Gla = udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]
    if ( Trig_Battle_Franzy_Func002C() ) then
        set udg_Hero_Gla_Kill = ( udg_Hero_Gla_Kill + GetUnitAbilityLevelSwapped('A0AR', udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) )
    else
        set udg_Hero_Gla_Kill = ( udg_Hero_Gla_Kill + GetUnitAbilityLevelSwapped('A0AR', udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) )
    endif
    if ( Trig_Battle_Franzy_Func003C() ) then
        set udg_Hero_Gla_BFLevel = udg_Hero_Gla_Kill
    else
        if ( Trig_Battle_Franzy_Func003Func001C() ) then
            set udg_Hero_Gla_BFLevel = IMinBJ(( 2 + ( 2 * GetUnitAbilityLevelSwapped('A0AR', udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) ) ), ( udg_Hero_Gla_BFLevel + GetUnitAbilityLevelSwapped('A0AR', udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) ))
        else
            set udg_Hero_Gla_BFLevel = IMinBJ(( 2 + ( 2 * GetUnitAbilityLevelSwapped('A0AR', udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) ) ), ( udg_Hero_Gla_BFLevel + 1 ))
        endif
    endif
    call StartTimerBJ( udg_Hero_Gla_BFTimer, false, 0.10 )
endfunction

