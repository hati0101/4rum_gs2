function InitTrig_Tartaros takes nothing returns nothing
    set gg_trg_Tartaros = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Tartaros, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Tartaros, Condition( function Trig_Tartaros_Conditions ) )
    call TriggerAddAction( gg_trg_Tartaros, function Trig_Tartaros_Actions )
endfunction

//===========================================================================
// Trigger: Tartaros Come on
//===========================================================================
function Trig_Tartaros_Come_on_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'uobs' ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) != udg_Force[1] ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) != udg_Force[2] ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetTriggerUnit()) != Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B03K') == false ) ) then
        return false
    endif
    if ( not ( IsUnitAlly(GetTriggerUnit(), GetOwningPlayer(udg_Hero_DrK_UltiPoint)) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Hero_DrK_UltiPoint) == true ) ) then
        return false
    endif
    if ( not ( udg_Hero_DrK_UltiCheck[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tartaros_Come_on_Actions takes nothing returns nothing
    local lightning a
    call UnitRemoveBuffBJ( 'B06F', GetTriggerUnit() )
    call AddSpecialEffectLocBJ( GetUnitLoc(GetTriggerUnit()), "Objects\\Spawnmodels\\Undead\\UDeathSmall\\UDeathSmall.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Objects\\Spawnmodels\\Undead\\UDeathSmall\\UDeathSmall.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddLightningLoc( "DRAL", GetUnitLoc(GetTriggerUnit()), GetUnitLoc(udg_Hero_DrK_UltiPoint) )
    set a = GetLastCreatedLightningBJ()
    call SetUnitPositionLoc( GetTriggerUnit(), GetUnitLoc(udg_Hero_DrK_UltiPoint) )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(udg_Hero_DrK), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0Z6', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0Z6', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0VB', udg_Hero_DrK) )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "thunderbolt", GetTriggerUnit() )
    set udg_Hero_DrK_UltiCheck[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = false
    call TriggerSleepAction( 0.30 )
    call DestroyLightningBJ( a )
    set a = null
endfunction

