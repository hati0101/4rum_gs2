endfunction

//===========================================================================
// Trigger: Arcane Shooting
//===========================================================================
function Trig_Arcane_Shooting_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetAttackedUnitBJ(), UNIT_TYPE_STRUCTURE) != true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetAttackedUnitBJ(), UNIT_TYPE_MECHANICAL) != true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetAttacker()) == 'Emoo' ) ) then
        return false
    endif
    if ( not ( LoadBooleanBJ(GetHandleIdBJ(GetAttacker()), StringHashBJ("ArcShoot"), GetLastCreatedHashtableBJ()) == false ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(GetAttackedUnitBJ(), GetOwningPlayer(GetAttacker())) == true ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A0BX', GetAttacker()) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Arcane_Shooting_Actions takes nothing returns nothing
    set udg_Hero_ArA_Loc = GetUnitLoc(GetAttacker())
    call SaveBooleanBJ( true, GetHandleIdBJ(GetAttacker()), StringHashBJ("ArcShoot"), GetLastCreatedHashtableBJ() )
    call PolledWait( 0.15 )
    call CreateNUnitsAtLoc( 1, 'e024', GetOwningPlayer(GetAttacker()), udg_Hero_ArA_Loc, bj_UNIT_FACING )
    call SetUnitScalePercent( GetLastCreatedUnit(), 80.00, 80.00, 80.00 )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0YN', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0YN', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0BX', GetAttacker()) )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "deathcoil", GetAttackedUnitBJ() )
    call PolledWait( ( 8.00 - ( I2R(GetUnitAbilityLevelSwapped('A0BX', GetAttacker())) * 1.00 ) ) )
    call SaveBooleanBJ( false, GetHandleIdBJ(GetAttacker()), StringHashBJ("ArcShoot"), GetLastCreatedHashtableBJ() )
    call RemoveLocation( udg_Hero_ArA_Loc )
endfunction

//===========================================================================
function InitTrig_Arcane_Shooting takes nothing returns nothing
    set gg_trg_Arcane_Shooting = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Arcane_Shooting, EVENT_PLAYER_UNIT_ATTACKED )
