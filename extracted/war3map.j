//===========================================================================
// Trigger: AnT Special 1
//===========================================================================
function Trig_AnT_Special_1_Func017001002001002 takes nothing returns boolean
    return ( GetDestructableTypeId(GetFilterDestructable()) == 'VTlt' )
endfunction

function Trig_AnT_Special_1_Conditions takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R06T', GetOwningPlayer(GetAttacker())) >= 1 ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetAttacker()) == 'Nsjs' ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetAttackedUnitBJ(), UNIT_TYPE_STRUCTURE) != true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetAttackedUnitBJ(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetAttackedUnitBJ(), UNIT_TYPE_MAGIC_IMMUNE) != true ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(GetAttackedUnitBJ(), GetOwningPlayer(GetAttacker())) == true ) ) then
        return false
    endif
    if ( not ( DistanceBetweenPoints(GetUnitLoc(GetAttackedUnitBJ()), GetDestructableLoc(RandomDestructableInRectBJ(RectFromCenterSizeBJ(GetUnitLoc(GetAttackedUnitBJ()), 400.00, 400.00), Condition(function Trig_AnT_Special_1_Func017001002001002)))) <= 400.00 ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetAttackedUnitBJ(), 'BEer') != true ) ) then
        return false
    endif
    return true
endfunction

function Trig_AnT_Special_1_Actions takes nothing returns nothing
    set udg_Hero_AnT_Loc = GetUnitLoc(GetAttackedUnitBJ())
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetAttacker()), udg_Hero_AnT_Loc, bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0WB', GetLastCreatedUnit() )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "entanglingroots", GetAttackedUnitBJ() )
    call TextTag( "속박의 뿌리!" , GetAttacker() , 13 , 120 , 120 , 120, 3 )
    call RemoveLocation( udg_Hero_AnT_Loc )
    call DisableTrigger( GetTriggeringTrigger() )
    call TriggerSleepAction( 5.00 )
    call EnableTrigger( GetTriggeringTrigger() )
endfunction

//===========================================================================
function InitTrig_AnT_Special_1 takes nothing returns nothing
    set gg_trg_AnT_Special_1 = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_AnT_Special_1, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_AnT_Special_1, Condition( function Trig_AnT_Special_1_Conditions ) )
