        return false
    endif
    return true
endfunction

function Trig_Coward_Smash_Func002C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0FU', GetTriggerUnit()) >= 1 ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(GetSpellTargetUnit(), GetOwningPlayer(GetTriggerUnit())) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Coward_Smash_Func003C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R077', GetOwningPlayer(GetTriggerUnit())) > 0 ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(GetSpellTargetUnit(), GetOwningPlayer(GetTriggerUnit())) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Coward_Smash_Actions takes nothing returns nothing
    call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), ( ( 40.00 + ( 25.00 * I2R(GetPlayerTechCountSimple('R077', GetOwningPlayer(GetTriggerUnit()))) ) ) + ( 40.00 * I2R(GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit())) ) ), ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
    if ( Trig_Coward_Smash_Func002C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0W7', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0W7', GetLastCreatedUnit(), ( GetPlayerTechCountSimple('R077', GetOwningPlayer(GetTriggerUnit())) + 1 ) )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "doom", GetSpellTargetUnit() )
    else
    endif
    if ( Trig_Coward_Smash_Func003C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A117', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A117', GetLastCreatedUnit(), 4 )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "thunderbolt", GetSpellTargetUnit() )
    else
    endif
endfunction

