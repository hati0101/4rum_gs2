    call TriggerAddAction( gg_trg_Stop_Moon_Protection_2, function Trig_Stop_Moon_Protection_2_Actions )
endfunction

//===========================================================================
// Trigger: Stop Moon Protection 3
//
// 문울프가 문 프로텍션 도중에 데미지를 받으면 자신을 포함한 소환수들의 모든 버프가 풀린다. 달의 분노 특성도 깨진다.
//===========================================================================
function Trig_Stop_Moon_Protection_3_Conditions takes nothing returns boolean
    if ( not ( udg_Hero_MoW_MPOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Stop_Moon_Protection_3_Actions takes nothing returns nothing
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 3
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call UnitRemoveAbilityBJ( 'Avul', udg_Hero_MoW[GetForLoopIndexA()] )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set udg_Hero_MoW_MPOn = false
    call RemoveUnit( udg_Hero_MoW_StarfallCaster )
    call UnitRemoveBuffBJ( 'BIrl', udg_Hero_MoW[1] )
    call UnitRemoveBuffBJ( 'BIrl', udg_Hero_MoW[2] )
    call UnitRemoveBuffBJ( 'BIrl', udg_Hero_MoW[3] )
endfunction

//===========================================================================
function InitTrig_Stop_Moon_Protection_3 takes nothing returns nothing
    set gg_trg_Stop_Moon_Protection_3 = CreateTrigger(  )
    call DisableTrigger( gg_trg_Stop_Moon_Protection_3 )
    call TriggerAddCondition( gg_trg_Stop_Moon_Protection_3, Condition( function Trig_Stop_Moon_Protection_3_Conditions ) )
    call TriggerAddAction( gg_trg_Stop_Moon_Protection_3, function Trig_Stop_Moon_Protection_3_Actions )
endfunction

