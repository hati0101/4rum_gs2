    local integer i = GetUnitAbilityLevelSwapped('A0YR', udg_Hero_PaB)
    if ( Trig_Cool_Reset_Sunbo_Func003C() ) then
        set udg_Hero_PaB_Boolean[1] = false
    else
    endif
    if ( Trig_Cool_Reset_Sunbo_Func004C() ) then
        call TextTagForce( "순보 재사용", udg_Hero_PaB, 10, 255, 255, 150, 2, GetForceOfPlayer(GetOwningPlayer(udg_Hero_PaB)) )
        set udg_Hero_PaB_Boolean[1] = false
        call UnitRemoveAbilityBJ( 'A0YR', udg_Hero_PaB )
        call UnitAddAbilityBJ( 'A0YR', udg_Hero_PaB )
        if ( i > 4 ) then
        if ( Trig_Cool_Reset_Sunbo_Func004Func006C() ) then
            call SetUnitAbilityLevelSwapped( 'A0YR', udg_Hero_PaB, ( GetUnitAbilityLevelSwapped('A0A6', udg_Hero_PaB) + 4 ) )
        else
            call SetUnitAbilityLevelSwapped( 'A0YR', udg_Hero_PaB, GetUnitAbilityLevelSwapped('A0A6', udg_Hero_PaB) )
        endif
        else
        call SetUnitAbilityLevelSwapped( 'A0YR', udg_Hero_PaB, GetUnitAbilityLevelSwapped('A0A6', udg_Hero_PaB) )
        endif
    else
    endif
    set i = 0
endfunction

