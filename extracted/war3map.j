//===========================================================================
// Trigger: Horseback
//===========================================================================
function Trig_Horseback_Conditions takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0GV', udg_Hero_RoC) >= 1 ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_Hero_RoC, 'B03K') != true ) ) then
        return false
    endif
    if ( not ( DistanceBetweenPoints(udg_Hero_RoC_loc, GetUnitLoc(udg_Hero_RoC)) > 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Horseback_Func001C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(udg_Hero_RoC_loc, GetUnitLoc(udg_Hero_RoC)) >= 500.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Horseback_Func003Func001C takes nothing returns boolean
    if ( not ( udg_Hero_RoC_Int <= 5 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Horseback_Func003C takes nothing returns boolean
    if ( not ( udg_Hero_RoC_real >= 200.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Horseback_Actions takes nothing returns nothing
    if ( Trig_Horseback_Func001C() ) then
        set udg_Hero_RoC_real = ( udg_Hero_RoC_real + 0.00 )
    else
        set udg_Hero_RoC_real = ( udg_Hero_RoC_real + DistanceBetweenPoints(udg_Hero_RoC_loc, GetUnitLoc(udg_Hero_RoC)) )
    endif
    set udg_Hero_RoC_loc = GetUnitLoc(udg_Hero_RoC)
    if ( Trig_Horseback_Func003C() ) then
        if ( Trig_Horseback_Func003Func001C() ) then
            call AddSpecialEffectTargetUnitBJ( "chest", udg_Hero_RoC, "Abilities\\Spells\\Orc\\WarDrums\\DrumsCasterHeal.mdl" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        else
        endif
        set udg_Hero_RoC_real = 0.00
        set udg_Hero_RoC_Int = IMinBJ(( udg_Hero_RoC_Int + 1 ), 6)
        call SetUnitAbilityLevelSwapped( 'A0KP', udg_Hero_RoC, ( ( ( GetUnitAbilityLevelSwapped('A0GV', udg_Hero_RoC) - 1 ) * 6 ) + ( udg_Hero_RoC_Int + 1 ) ) )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Horseback takes nothing returns nothing
    set gg_trg_Horseback = CreateTrigger(  )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Horseback, 0.50 )
    call TriggerAddCondition( gg_trg_Horseback, Condition( function Trig_Horseback_Conditions ) )
    call TriggerAddAction( gg_trg_Horseback, function Trig_Horseback_Actions )
endfunction

