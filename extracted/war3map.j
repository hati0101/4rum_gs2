//===========================================================================
// Trigger: Sunbo
//
// 모든 플레이어의 기본 멜리 게임 초기화
//===========================================================================
function Trig_Sunbo_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0YR' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sunbo_Func006C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R09Z', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sunbo_Actions takes nothing returns nothing
    local location l = GetUnitLoc(GetTriggerUnit())
    local location a = GetSpellTargetLoc()
    local integer i = 0
    local integer r = R2I(DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetSpellTargetLoc())) / 100
    local effect e
    if ( Trig_Sunbo_Func006C() ) then
        call UnitAddItemByIdSwapped( 'I03T', GetTriggerUnit() )
    else
    endif
    loop
    set i = i + 1
    call AddSpecialEffectLocBJ( PolarProjectionBJ((  l ), ( 100.00 * I2R( i ) ), AngleBetweenPoints( l , a )), "war3mapImported\\SandWaveDamage.mdx" )
    set e = GetLastCreatedEffectBJ()
    call PolledWait( 0.01 )
    call DestroyEffectBJ( e )
    exitwhen ( i >= r )
    endloop
    set l = null
    set a = null
    set e = null
endfunction

//===========================================================================
function InitTrig_Sunbo takes nothing returns nothing
    set gg_trg_Sunbo = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Sunbo, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Sunbo, Condition( function Trig_Sunbo_Conditions ) )
    call TriggerAddAction( gg_trg_Sunbo, function Trig_Sunbo_Actions )
endfunction

