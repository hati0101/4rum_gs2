    if ( not ( GetUnitTypeId(GetEventDamageSource()) == 'Otch' ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B0CO') == true ) ) then
        return false
    endif
    if ( not ( UnitHasItemOfTypeBJ(GetEventDamageSource(), 'I04Q') == false ) ) then
        return false
