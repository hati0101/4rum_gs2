//===========================================================================
// Trigger: Debugging Setup
//===========================================================================
function Trig_Debugging_Setup_Func005C takes nothing returns boolean
    if ( ( RectContainsUnit(gg_rct_D_Home, udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())]) == true ) ) then
        return true
    endif
    if ( ( RectContainsUnit(gg_rct_G_Home, udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())]) == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_Debugging_Setup_Conditions takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())]) == true ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())], 'B03K') == false ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())]) != 'O005' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())]) != 'U00I' ) ) then
        return false
    endif
    if ( not Trig_Debugging_Setup_Func005C() ) then
        return false
    endif
    return true
endfunction

function Trig_Debugging_Setup_Func006Func009Func001002001001001001 takes nothing returns boolean
    return ( IsPlayerAlly(GetFilterPlayer(), udg_Force[2]) == true )
endfunction

function Trig_Debugging_Setup_Func006Func009Func001002001001001002 takes nothing returns boolean
    return ( GetPlayerSlotState(GetFilterPlayer()) == PLAYER_SLOT_STATE_PLAYING )
endfunction

function Trig_Debugging_Setup_Func006Func009Func001002001001001 takes nothing returns boolean
    return GetBooleanAnd( Trig_Debugging_Setup_Func006Func009Func001002001001001001(), Trig_Debugging_Setup_Func006Func009Func001002001001001002() )
endfunction

function Trig_Debugging_Setup_Func006Func009Func002002001001001001 takes nothing returns boolean
    return ( IsPlayerAlly(GetFilterPlayer(), udg_Force[1]) == true )
endfunction

function Trig_Debugging_Setup_Func006Func009Func002002001001001002 takes nothing returns boolean
    return ( GetPlayerSlotState(GetFilterPlayer()) == PLAYER_SLOT_STATE_PLAYING )
endfunction

function Trig_Debugging_Setup_Func006Func009Func002002001001001 takes nothing returns boolean
    return GetBooleanAnd( Trig_Debugging_Setup_Func006Func009Func002002001001001001(), Trig_Debugging_Setup_Func006Func009Func002002001001001002() )
endfunction

function Trig_Debugging_Setup_Func006Func009C takes nothing returns boolean
    if ( not ( IsUnitAlly(udg_HeroPlayer[udg_Debugging_Vote_PN], udg_Force[1]) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Debugging_Setup_Func006C takes nothing returns boolean
    if ( not ( udg_Debugging_Vote_Bool == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Debugging_Setup_Actions takes nothing returns nothing
    if ( Trig_Debugging_Setup_Func006C() ) then
        set udg_Debugging_Vote_Bool = true
        call DisplayTimedTextToForce( GetPlayersAll(), 10.00, ( ( ( udg_Colors[udg_SP_Number[GetConvertedPlayerId(GetTriggerPlayer())]] + GetPlayerName(GetTriggerPlayer()) ) + "|r님이" ) + " 디버그를 요청하였습니다. 10초 내로 상대 진영의 모든 플레이어가 찬성하면 디버그가 진행됩니다. -찬성을 입력하면 투표가 됩니다." ) )
        call StartTimerBJ( udg_Debug_Timer, false, 10.00 )
        call CreateTimerDialogBJ( GetLastCreatedTimerBJ(), "TRIGSTR_1698" )
        set udg_Debug_Window = GetLastCreatedTimerDialogBJ()
        call TimerDialogDisplayBJ( true, udg_Debug_Window )
        if ( Trig_Debugging_Setup_Func006Func009C() ) then
            set udg_Debugging_Vote_Max = ( CountPlayersInForceBJ(GetPlayersMatching(Condition(function Trig_Debugging_Setup_Func006Func009Func002002001001001))) - 0 )
        else
            set udg_Debugging_Vote_Max = ( CountPlayersInForceBJ(GetPlayersMatching(Condition(function Trig_Debugging_Setup_Func006Func009Func001002001001001))) - 0 )
        endif
        set bj_forLoopAIndex = 1
        set bj_forLoopAIndexEnd = 12
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            set udg_Debugging_Vote_PB[GetForLoopIndexA()] = false
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
        set udg_Debugging_Vote_Int = 0
        call TriggerSleepAction( 10.00 )
        call TimerDialogDisplayBJ( false, udg_Debug_Window )
        call DestroyTimerDialogBJ( udg_Debug_Window )
    else
        call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_1699" )
    endif
endfunction

//===========================================================================
function InitTrig_Debugging_Setup takes nothing returns nothing
    set gg_trg_Debugging_Setup = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Debugging_Setup, Condition( function Trig_Debugging_Setup_Conditions ) )
    call TriggerAddAction( gg_trg_Debugging_Setup, function Trig_Debugging_Setup_Actions )
endfunction

//===========================================================================
// Trigger: Debugging
//===========================================================================
function Trig_Debugging_Func018C takes nothing returns boolean
    if ( ( IsUnitAliveBJ(udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())]) != true ) ) then
        return false
    endif
    if ( ( UnitHasBuffBJ(udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())], 'B03K') == true ) ) then
        return false
    endif
    if ( ( IsUnitPausedBJ(udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())]) == true ) ) then
        return false
    endif
    if ( ( RectContainsUnit(gg_rct_D_Home, udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())]) == true ) ) then
        return true
    endif
    if ( ( RectContainsUnit(gg_rct_G_Home, udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())]) == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_Debugging_Conditions takes nothing returns boolean
    if ( not Trig_Debugging_Func018C() ) then
        return false
    endif
    return true
endfunction

function Trig_Debugging_Actions takes nothing returns nothing
    local integer pn = GetConvertedPlayerId(GetTriggerPlayer())
    local integer skill = 0
////////////스탯 스킬류 저장//////////////////////////////
    if ( ( GetUnitTypeId(udg_HeroPlayer[pn]) == 'Npbm' ) ) then //판다 워리어//
    set skill = ( GetUnitAbilityLevelSwapped('A0H4', udg_HeroPlayer[pn]) * 4 )
    endif
    if ( ( GetUnitTypeId(udg_HeroPlayer[pn]) == 'Hart' ) ) then //룬나이트//
    set skill = ( 2 + ( GetUnitAbilityLevelSwapped('A0GK', udg_HeroPlayer[pn]) * 3 ) )
    endif
    if ( ( GetUnitTypeId(udg_HeroPlayer[pn]) == 'Nplh' ) ) then //드레드 나이트//
    set skill = ( GetUnitAbilityLevelSwapped('A0VC', udg_HeroPlayer[pn]) * 5 )
    endif
    if ( ( GetUnitTypeId(udg_HeroPlayer[pn]) == 'Huth' ) ) then //할루시네이터//
    set skill = ( GetUnitAbilityLevelSwapped('A0JZ', udg_HeroPlayer[pn]) * 3 )
    endif
//////////////////////////////////////////////////////////
    set udg_Debugging_Vote_PN = pn
    set udg_Debug_Bool[pn] = true
    call SetUnitInvulnerable( udg_HeroPlayer[pn], true )
    call PauseUnitBJ( true, udg_HeroPlayer[pn] )
    call PolledWait( 10.00 )
    if ( ( udg_Debugging_Vote_Max == udg_Debugging_Vote_Int ) ) then
        call CreateNUnitsAtLoc( 1, GetUnitTypeId(udg_HeroPlayer[pn]), ConvertedPlayer(pn), GetUnitLoc(udg_HeroPlayer[pn]), bj_UNIT_FACING )
        call SetHeroXP( GetLastCreatedUnit(), GetHeroXP(udg_HeroPlayer[pn]), false )
        call ModifyHeroStat( bj_HEROSTAT_STR, GetLastCreatedUnit(), bj_MODIFYMETHOD_SET, GetHeroStatBJ(bj_HEROSTAT_STR, udg_HeroPlayer[pn], false) )
        call ModifyHeroStat( bj_HEROSTAT_AGI, GetLastCreatedUnit(), bj_MODIFYMETHOD_SET, GetHeroStatBJ(bj_HEROSTAT_AGI, udg_HeroPlayer[pn], false) )
        call ModifyHeroStat( bj_HEROSTAT_INT, GetLastCreatedUnit(), bj_MODIFYMETHOD_SET, GetHeroStatBJ(bj_HEROSTAT_INT, udg_HeroPlayer[pn], false) )
        call UnitAddItemSwapped( UnitItemInSlotBJ(udg_HeroPlayer[pn], 1), GetLastCreatedUnit() )
        call UnitAddItemSwapped( UnitItemInSlotBJ(udg_HeroPlayer[pn], 2), GetLastCreatedUnit() )
        call UnitAddItemSwapped( UnitItemInSlotBJ(udg_HeroPlayer[pn], 3), GetLastCreatedUnit() )
        call UnitAddItemSwapped( UnitItemInSlotBJ(udg_HeroPlayer[pn], 4), GetLastCreatedUnit() )
        call UnitAddItemSwapped( UnitItemInSlotBJ(udg_HeroPlayer[pn], 5), GetLastCreatedUnit() )
        call UnitAddItemSwapped( UnitItemInSlotBJ(udg_HeroPlayer[pn], 6), GetLastCreatedUnit() )
        call RemoveUnit( udg_HeroPlayer[pn] )
        set udg_HeroPlayer[pn] = GetLastCreatedUnit()
////////////스탯 감소//////////////////////////////
    if ( ( GetUnitTypeId(udg_HeroPlayer[pn]) == 'Npbm' ) ) then //판다 워리어//
    call ModifyHeroStat( bj_HEROSTAT_AGI, udg_HeroPlayer[pn], bj_MODIFYMETHOD_SUB, skill )
    endif
    if ( ( GetUnitTypeId(udg_HeroPlayer[pn]) == 'Hart' ) ) then //룬나이트//
    call ModifyHeroStat( bj_HEROSTAT_INT, udg_HeroPlayer[pn], bj_MODIFYMETHOD_SUB, skill )
    endif
    if ( ( GetUnitTypeId(udg_HeroPlayer[pn]) == 'Nplh' ) ) then //드레드 나이트//
    call ModifyHeroStat( bj_HEROSTAT_STR, udg_HeroPlayer[pn], bj_MODIFYMETHOD_SUB, skill )
    endif
    if ( ( GetUnitTypeId(udg_HeroPlayer[pn]) == 'Huth' ) ) then //할루시네이터//
    call ModifyHeroStat( bj_HEROSTAT_AGI, udg_HeroPlayer[pn], bj_MODIFYMETHOD_SUB, skill )
    endif
//////////////////////////////////////////////////////////
////////////드로우 프리스티스 특성관련////////////////////
        if ( ( GetPlayerTechCountSimple('R01M', GetTriggerPlayer()) == 1 ) ) then
            call UnitAddAbilityBJ( 'A02V', udg_HeroPlayer[pn] )
        endif
        if ( ( GetPlayerTechCountSimple('R01P', GetTriggerPlayer()) == 1 ) ) then
            call UnitAddAbilityBJ( 'A02X', udg_HeroPlayer[pn] )
        endif
//////////////////////////////////////////////////////////
///////////////엘리멘탈리스트 특성관련////////////////////
        if ( ( GetPlayerTechCountSimple('R08T', GetTriggerPlayer()) == 1 ) ) then
            call IncUnitAbilityLevelSwapped( 'A13S', udg_HeroPlayer[pn] )
        endif
//////////////////////////////////////////////////////////
    call DisplayTextToForce( GetPlayersAll(), "상대팀의 만장일치로 디버깅이 되었습니다." )
        set udg_Debugging_Vote_Bool = false
        set udg_Debug_Bool[pn] = false
    else
    set udg_Debugging_Vote_Bool = false
    set udg_Debug_Bool[pn] = false
    call DisplayTextToForce( GetPlayersAll(), "상대팀이 만장일치가 되지 않아 디버깅이 되지 않습니다." )
    call SetUnitInvulnerable( udg_HeroPlayer[pn], false )
    call PauseUnitBJ( false, udg_HeroPlayer[pn] )
    endif
endfunction

//===========================================================================
function InitTrig_Debugging takes nothing returns nothing
    set gg_trg_Debugging = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Debugging, Condition( function Trig_Debugging_Conditions ) )
    call TriggerAddAction( gg_trg_Debugging, function Trig_Debugging_Actions )
endfunction


//===========================================================================
// Trigger: Debugging Vote
//===========================================================================
function Trig_Debugging_Vote_Conditions takes nothing returns boolean
    if ( not ( IsPlayerEnemy(GetTriggerPlayer(), GetOwningPlayer(udg_HeroPlayer[udg_Debugging_Vote_PN])) == true ) ) then
        return false
    endif
    if ( not ( udg_Debugging_Vote_PB[GetConvertedPlayerId(GetTriggerPlayer())] == false ) ) then
        return false
    endif
    if ( not ( udg_Debugging_Vote_Bool == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Debugging_Vote_Actions takes nothing returns nothing
    set udg_Debugging_Vote_PB[GetConvertedPlayerId(GetTriggerPlayer())] = true
    set udg_Debugging_Vote_Int = ( udg_Debugging_Vote_Int + 1 )
    call DisplayTimedTextToForce( GetPlayersAll(), 10.00, ( ( ( udg_Colors[udg_SP_Number[GetConvertedPlayerId(GetTriggerPlayer())]] + GetPlayerName(GetTriggerPlayer()) ) + "|r님이" ) + " 찬성하셨습니다" ) )
endfunction

//===========================================================================
function InitTrig_Debugging_Vote takes nothing returns nothing
    set gg_trg_Debugging_Vote = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Debugging_Vote, Condition( function Trig_Debugging_Vote_Conditions ) )
    call TriggerAddAction( gg_trg_Debugging_Vote, function Trig_Debugging_Vote_Actions )
endfunction

//===========================================================================
// Trigger: Home
//===========================================================================
function Trig_home2_Conditions takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_home2_Actions takes nothing returns nothing

    local integer pn = GetConvertedPlayerId(GetTriggerPlayer())
    local integer A = 1
    local integer A_end = 40
    local unit wispkun

    if ( udg_debug_or_home[pn] == true ) then
        return
    endif

    set udg_debug_or_home[pn] = true

    call CreateNUnitsAtLoc( 1, 'ewsp', GetTriggerPlayer(), GetUnitLoc(udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())]), bj_UNIT_FACING )
    set wispkun = GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ( 42.00, 'BTLF', GetLastCreatedUnit() )
//    call UnitAddAbilityBJ( 'A0NV', GetLastCreatedUnit() )
//    call IssueTargetOrderBJ( GetLastCreatedUnit(), "doom", udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())] )
    call UnitAddAbilityBJ( 'A0NT', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'S00D', GetLastCreatedUnit() )

    loop
        exitwhen A > A_end
        call PolledWait( 1.00 )
        if ( IsUnitAliveBJ(udg_HeroPlayer[pn]) == false ) then
        call DisplayTextToForce( GetForceOfPlayer(ConvertedPlayer(pn)), "귀환이 취소되었습니다." )
        call KillUnit( wispkun )
        set udg_debug_or_home[pn] = false
        return
        endif
        set A = A + 1
    endloop

    if ( IsUnitAlly(udg_HeroPlayer[pn], udg_Force[1]) == true ) then
        call SetUnitPositionLoc( udg_HeroPlayer[pn], GetRectCenter(gg_rct_G_Home) )
    endif
    if ( IsUnitAlly(udg_HeroPlayer[pn], udg_Force[2]) == true ) then
        call SetUnitPositionLoc( udg_HeroPlayer[pn], GetRectCenter(gg_rct_D_Home) )
    endif
    
    set udg_debug_or_home[pn] = false

endfunction

//===========================================================================
function InitTrig_Home takes nothing returns nothing
    set gg_trg_Home = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Home, Condition( function Trig_home2_Conditions ) )
    call TriggerAddAction( gg_trg_Home, function Trig_home2_Actions )
endfunction


