    if ( not ( GetPlayerTechCountSimple('R012', GetOwningPlayer(udg_Hero_BlS)) >= 1 ) ) then
        return false
    endif
    if ( not ( CountLivingPlayerUnitsOfTypeId('e01D', GetOwningPlayer(GetTriggerUnit())) >= 1 ) ) then
        return false
    endif
    return true
endfunction

