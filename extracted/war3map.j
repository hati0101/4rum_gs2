//===========================================================================
// Trigger: First Surrender
//===========================================================================
function Trig_First_Surrender_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'hgyr' ) ) then
        return false
    endif
    return true
endfunction

function Trig_First_Surrender_Func001C takes nothing returns boolean
    if ( not ( udg_Surrender_Bool[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_First_Surrender_Func002Func004Func001C takes nothing returns boolean
    if ( not ( IsUnitAlly(GetTriggerUnit(), udg_Force[1]) == true ) ) then
        return false
    endif
    if ( not ( TimerGetRemaining(udg_Surrender_Timer[3]) > 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_First_Surrender_Func002Func004Func002C takes nothing returns boolean
    if ( not ( IsUnitAlly(GetTriggerUnit(), udg_Force[2]) == true ) ) then
        return false
    endif
    if ( not ( TimerGetRemaining(udg_Surrender_Timer[4]) > 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_First_Surrender_Func002Func004C takes nothing returns boolean
    if ( Trig_First_Surrender_Func002Func004Func001C() ) then
        return true
    endif
    if ( Trig_First_Surrender_Func002Func004Func002C() ) then
        return true
    endif
    return false
endfunction

function Trig_First_Surrender_Func002C takes nothing returns boolean
    if ( not Trig_First_Surrender_Func002Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_First_Surrender_Func003Func001C takes nothing returns boolean
    if ( not ( TimerGetRemaining(udg_Surrender_Timer[2]) == 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_First_Surrender_Func003Func002C takes nothing returns boolean
    if ( not ( TimerGetRemaining(udg_Surrender_Timer[1]) == 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_First_Surrender_Func003C takes nothing returns boolean
    if ( not ( IsUnitAlly(GetTriggerUnit(), udg_Force[1]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_First_Surrender_Actions takes nothing returns nothing
    if ( Trig_First_Surrender_Func001C() ) then
        call DisplayTimedTextToForce( GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), 10.00, "TRIGSTR_1357" )
        call RemoveUnit( GetTriggerUnit() )
        return
    else
    endif
    if ( Trig_First_Surrender_Func002C() ) then
        call DisplayTimedTextToForce( GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), 10.00, "TRIGSTR_1358" )
        call RemoveUnit( GetTriggerUnit() )
        return
    else
    endif
    if ( Trig_First_Surrender_Func003C() ) then
        if ( Trig_First_Surrender_Func003Func002C() ) then
            call StartTimerBJ( udg_Surrender_Timer[1], false, 40.00 )
            set udg_Surrender_Int[1] = 1
            call CreateTimerDialogBJ( udg_Surrender_Timer[1], "TRIGSTR_1371" )
            set udg_Surrender_Window[1] = GetLastCreatedTimerDialogBJ()
            call TimerDialogDisplayBJ( true, udg_Surrender_Window[1] )
            call TimerDialogSetTitleBJ( udg_Surrender_Window[1], ( "가디언 (" + ( I2S(udg_Surrender_Int[1]) + "명 항복)" ) ) )
            call DisplayTimedTextToForce( GetPlayersAllies(udg_Force[1]), 10.00, ( ( udg_Colors[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]] + udg_SP_PlayerName[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] ) + "|r님이 항복 투표를 제의하였습니다." ) )
            call DisplayTimedTextToForce( GetPlayersAllies(udg_Force[2]), 10.00, "TRIGSTR_1374" )
            set udg_Surrender_Bool[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = true
        else
            set udg_Surrender_Int[1] = ( udg_Surrender_Int[1] + 1 )
            call TimerDialogSetTitleBJ( udg_Surrender_Window[1], ( "가디언 (" + ( I2S(udg_Surrender_Int[1]) + "명 항복)" ) ) )
            set udg_Surrender_Bool[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = true
        endif
    else
        if ( Trig_First_Surrender_Func003Func001C() ) then
            call StartTimerBJ( udg_Surrender_Timer[2], false, 40.00 )
            set udg_Surrender_Int[2] = 1
            call CreateTimerDialogBJ( udg_Surrender_Timer[2], "TRIGSTR_1360" )
            set udg_Surrender_Window[2] = GetLastCreatedTimerDialogBJ()
            call TimerDialogDisplayBJ( true, udg_Surrender_Window[2] )
            call TimerDialogSetTitleBJ( udg_Surrender_Window[2], ( "다크니스 (" + ( I2S(udg_Surrender_Int[2]) + "명 항복)" ) ) )
            call DisplayTimedTextToForce( GetPlayersAllies(udg_Force[2]), 10.00, ( ( udg_Colors[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]] + udg_SP_PlayerName[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] ) + "|r님이 항복 투표를 제의하였습니다." ) )
            call DisplayTimedTextToForce( GetPlayersAllies(udg_Force[1]), 10.00, "TRIGSTR_1362" )
            set udg_Surrender_Bool[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = true
        else
            set udg_Surrender_Int[2] = ( udg_Surrender_Int[2] + 1 )
            call TimerDialogSetTitleBJ( udg_Surrender_Window[2], ( "다크니스 (" + ( I2S(udg_Surrender_Int[2]) + "명 항복)" ) ) )
            set udg_Surrender_Bool[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = true
        endif
    endif
    call RemoveUnit( GetTriggerUnit() )
endfunction

