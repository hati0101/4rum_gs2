    set gg_trg_MeQ_Atk = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_MeQ_Atk, Condition( function Trig_MeQ_Atk_Conditions ) )
    call TriggerAddAction( gg_trg_MeQ_Atk, function Trig_MeQ_Atk_Actions )
endfunction

