    endif
    return true
endfunction

function Trig_Drunk_Attack_Damage_Func002C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetEventDamageSource(), 'B06P') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Drunk_Attack_Damage_Actions takes nothing returns nothing
    if ( Trig_Drunk_Attack_Damage_Func001C() ) then
        if ( Trig_Drunk_Attack_Damage_Func001Func002C() ) then
            call StartTimerBJ( udg_Hero_PaB_TimerDec[1], false, RMaxBJ(0.01, ( TimerGetRemaining(udg_Hero_PaB_TimerDec[1]) - ( 0.15 + ( 0.15 * I2R(GetUnitAbilityLevelSwapped('A0ZL', udg_Hero_PaB)) ) ) )) )
            call StartTimerBJ( udg_Hero_PaB_TimerDec[2], false, RMaxBJ(0.01, ( TimerGetRemaining(udg_Hero_PaB_TimerDec[2]) - ( 0.15 + ( 0.15 * I2R(GetUnitAbilityLevelSwapped('A0ZL', udg_Hero_PaB)) ) ) )) )
            call StartTimerBJ( udg_Hero_PaB_TimerDec[3], false, RMaxBJ(0.01, ( TimerGetRemaining(udg_Hero_PaB_TimerDec[3]) - ( 0.15 + ( 0.15 * I2R(GetUnitAbilityLevelSwapped('A0ZL', udg_Hero_PaB)) ) ) )) )
            if ( Trig_Drunk_Attack_Damage_Func001Func002Func005C() ) then
                if ( udg_Hero_PaB_Integer >= ( 5 - ( GetPlayerTechCountSimple('R0A6', GetOwningPlayer(GetEventDamageSource())) * 1 ) ) ) then
                call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetEventDamageSource()), GetUnitLoc(udg_Hero_PaB_Target), bj_UNIT_FACING )
                call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
                call UnitAddAbilityBJ( 'A0T0', GetLastCreatedUnit() )
                call SetUnitAbilityLevelSwapped( 'A0T0', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0ZL', GetEventDamageSource()) )
                call IssueTargetOrderBJ( GetLastCreatedUnit(), "thunderbolt", udg_Hero_PaB_Target )
                call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile.mdl" )
                call DestroyEffectBJ( GetLastCreatedEffectBJ() )
                set udg_Hero_PaB_Integer = 0
                if ( Trig_Drunk_Attack_Damage_Func001Func002Func005Func011C() ) then
                    set udg_Hero_PaB_Boolean[4] = true
                    call SetUnitAbilityLevelSwapped( 'A0YR', udg_Hero_PaB, ( GetUnitAbilityLevelSwapped('A0A6', udg_Hero_PaB) + 4 ) )
                    call SetUnitAbilityLevelSwapped( 'A13E', udg_Hero_PaB, ( GetUnitAbilityLevelSwapped('A022', udg_Hero_PaB) + 4 ) )
                    call SetUnitAbilityLevelSwapped( 'A0ML', udg_Hero_PaB, ( GetUnitAbilityLevelSwapped('A0CU', udg_Hero_PaB) + 4 ) )
                else
                endif
                else
                set udg_Hero_PaB_Integer = ( udg_Hero_PaB_Integer + 1 )
                endif
            else
            endif
        else
        endif
        if ( Trig_Drunk_Attack_Damage_Func001Func003C() ) then
            if ( Trig_Drunk_Attack_Damage_Func001Func003Func001C() ) then
                call SetUnitAbilityLevelSwapped( 'A138', GetEventDamageSource(), GetUnitAbilityLevelSwapped('A138', GetEventDamageSource())-1 )
            else
                call SetUnitAbilityLevelSwapped( 'A138', GetEventDamageSource(), 1 )
                call UnitRemoveBuffBJ( 'B04O', GetEventDamageSource() )
                call SetUnitAbilityLevelSwapped( 'A14C', GetEventDamageSource(), 1 )
            endif
        else
        endif
        set udg_Hero_PaB_Target = null
    else
    endif
    if ( Trig_Drunk_Attack_Damage_Func002C() ) then
        call UnitRemoveBuffBJ( 'B06P', GetEventDamageSource() )
    else
    endif
endfunction

