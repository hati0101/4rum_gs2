//===========================================================================
// Trigger: Moon Blink
//===========================================================================
function Trig_Moon_Blink_Func010C takes nothing returns boolean
    if ( ( GetUnitTypeId(udg_Hero_MoW[2]) != 'o00F' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(udg_Hero_MoW[3]) != 'o00B' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Moon_Blink_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0FM' ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A0FO', GetSpellAbilityUnit()) >= 2 ) ) then
        return false
    endif
    if ( not Trig_Moon_Blink_Func010C() ) then
        return false
    endif
    return true
endfunction

function Trig_Moon_Blink_Actions takes nothing returns nothing
    call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_MoW[2]), "Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl" )
    call SetUnitPositionLocFacingBJ( udg_Hero_MoW[2], PolarProjectionBJ(GetSpellTargetLoc(), 250.00, ( GetUnitFacing(GetSpellAbilityUnit()) + 30.00 )), ( GetUnitFacing(GetSpellAbilityUnit()) + 30.00 ) )
    call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_MoW[2]), "Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl" )
    call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_MoW[3]), "Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl" )
    call SetUnitPositionLocFacingBJ( udg_Hero_MoW[3], PolarProjectionBJ(GetSpellTargetLoc(), 250.00, ( GetUnitFacing(GetSpellAbilityUnit()) - 30.00 )), ( GetUnitFacing(GetSpellAbilityUnit()) - 30.00 ) )
    call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_MoW[3]), "Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl" )
endfunction

