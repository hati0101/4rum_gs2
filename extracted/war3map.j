// Trigger: Item Stack
//===========================================================================
function Trig_Item_Stack_Func017C takes nothing returns boolean
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I019' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I016' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I01A' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I018' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'I017' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'mnst' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'pgma' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(GetManipulatedItem()) == 'pghe' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Item_Stack_Conditions takes nothing returns boolean
    if ( not Trig_Item_Stack_Func017C() ) then
        return false
    endif
    return true
endfunction

function Trig_Item_Stack_Actions takes nothing returns nothing
    local integer a=0
    local integer stack=0
    local integer count=0
    local integer itype = GetItemTypeId(GetManipulatedItem())
    loop
    if GetItemTypeId(GetManipulatedItem()) == GetItemTypeId(UnitItemInSlotBJ(GetTriggerUnit(), a)) then
    set count=count+1
    set stack=stack+GetItemCharges(UnitItemInSlotBJ(GetTriggerUnit(), a))
    endif
    exitwhen a>=6
    set a=a+1
    endloop
    if count >1 then
    call RemoveItem( GetItemOfTypeFromUnitBJ(GetTriggerUnit(), GetItemTypeId(GetManipulatedItem())) )
    call SetItemCharges( GetItemOfTypeFromUnitBJ(GetTriggerUnit(), itype), stack )
    endif
endfunction

