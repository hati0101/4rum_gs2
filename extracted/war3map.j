//===========================================================================
// Trigger: Wrath of Blood
//===========================================================================
function Trig_Wrath_of_Blood_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0U5' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wrath_of_Blood_Actions takes nothing returns nothing
    local unit wisp
    call DisableTrigger( gg_trg_Blood_Strike_Start )
    call DisableTrigger( gg_trg_Blood_Strike_Timer )
    call DisableTrigger( gg_trg_Blood_Strike_DM )
    call SetUnitAnimation( GetTriggerUnit(), "stand spin" )
    call PlaySoundBJ( gg_snd_GromYesAttack2 )
    call CreateNUnitsAtLoc( 1, 'e00O', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call SetUnitAbilityLevelSwapped( 'A0CH', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0U5', GetTriggerUnit()) )
    set wisp = GetLastCreatedUnit()
    call IssuePointOrderLocBJ( wisp, "rainofchaos", GetUnitLoc(GetTriggerUnit()) )
    loop
    exitwhen GetUnitCurrentOrder(GetTriggerUnit()) != String2OrderIdBJ("starfall")
    call PolledWait( 0.10 )
    endloop
    call ResetUnitAnimation( GetTriggerUnit() )
    call EnableTrigger( gg_trg_Blood_Strike_DM )
    call EnableTrigger( gg_trg_Blood_Strike_Start )
    call EnableTrigger( gg_trg_Blood_Strike_Timer )
    call KillUnit( wisp )
endfunction

