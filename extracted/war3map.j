    endif
    return true
endfunction

function Trig_Free_Annihilation_Orb_Conditions takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B07X') == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) != true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_MECHANICAL) != true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEventDamageSource()) == 'Ekgg' ) ) then
        return false
    endif
    if ( not ( IsUnitIllusionBJ(GetEventDamageSource()) != true ) ) then
        return false
    endif
    if ( not Trig_Free_Annihilation_Orb_Func010C() ) then
        return false
    endif
    return true
endfunction

function Trig_Free_Annihilation_Orb_Func004Func006C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R00N', GetOwningPlayer(GetEventDamageSource())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Free_Annihilation_Orb_Func004Func014C takes nothing returns boolean
    if ( ( UnitHasBuffBJ(GetTriggerUnit(), 'BNsi') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(GetTriggerUnit(), 'BNso') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(GetTriggerUnit(), 'B0BG') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(GetTriggerUnit(), 'B02K') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(GetTriggerUnit(), 'B07W') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(GetTriggerUnit(), 'B080') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(GetTriggerUnit(), 'B017') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(GetTriggerUnit(), 'B064') == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_Free_Annihilation_Orb_Func004C takes nothing returns boolean
    if ( not Trig_Free_Annihilation_Orb_Func004Func014C() ) then
        return false
    endif
    return true
endfunction

function Trig_Free_Annihilation_Orb_Actions takes nothing returns nothing
    local integer rand = GetRandomInt( 1 , 100 )
    local integer chance = 5 * (GetUnitAbilityLevelSwapped('A0RG', GetEventDamageSource())) // 발동 확률
    call UnitRemoveBuffBJ( 'B07X', GetTriggerUnit() )
    if ( Trig_Free_Annihilation_Orb_Func004C() ) then
        set udg_Hero_Sil_FADmg = ( I2R(( GetHeroStatBJ(bj_HEROSTAT_INT, GetEventDamageSource(), true) + GetHeroStatBJ(bj_HEROSTAT_AGI, GetEventDamageSource(), true) )) * ( 0.15 + ( 0.05 * I2R(( GetUnitAbilityLevelSwapped('A0RG', GetEventDamageSource()) + GetPlayerTechCountSimple('R00N', GetOwningPlayer(GetEventDamageSource())) )) ) ) )
        call UnitDamageTargetBJ( GetEventDamageSource(), GetTriggerUnit(), udg_Hero_Sil_FADmg, ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
        call CreateTextTagLocBJ( ( I2S(R2I(udg_Hero_Sil_FADmg)) + "!" ), GetUnitLoc(GetTriggerUnit()), 0, 10.00, 0.00, 0.00, 100.00, 0 )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 1.00 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 65.00, 90 )
    else
        if ( rand <= chance ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A03G', GetLastCreatedUnit() )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "soulburn", GetTriggerUnit() )
        if ( Trig_Free_Annihilation_Orb_Func004Func006C() ) then
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A11C', GetLastCreatedUnit() )
            call IssueTargetOrderBJ( GetLastCreatedUnit(), "doom", GetTriggerUnit() )
        else
        endif
        endif
    endif
endfunction

