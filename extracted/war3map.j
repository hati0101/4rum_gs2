//===========================================================================
// Trigger: Death Hero EXP
//===========================================================================
function Trig_Death_Hero_EXP_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Death_Hero_EXP_Func002Func001C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(GetUnitLoc(udg_HeroPlayer[GetForLoopIndexA()]), GetUnitLoc(GetDyingUnit())) <= 1225.00 ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(udg_HeroPlayer[GetForLoopIndexA()], GetOwningPlayer(GetDyingUnit())) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_HeroPlayer[GetForLoopIndexA()]) == true ) ) then
        return false
    endif
    if ( not ( udg_HeroPlayer[GetForLoopIndexA()] != null ) ) then
        return false
    endif
    return true
endfunction

function Trig_Death_Hero_EXP_Func005C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(GetUnitLoc(udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]), GetUnitLoc(GetDyingUnit())) > 1225.00 ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) == true ) ) then
        return false
    endif
    if ( not ( GetPlayerController(GetOwningPlayer(GetKillingUnitBJ())) == MAP_CONTROL_USER ) ) then
        return false
    endif
    return true
endfunction

function Trig_Death_Hero_EXP_Func007Func001C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(GetUnitLoc(udg_HeroPlayer[GetForLoopIndexA()]), GetUnitLoc(GetDyingUnit())) <= 1225.00 ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(udg_HeroPlayer[GetForLoopIndexA()], GetOwningPlayer(GetDyingUnit())) == true ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_HeroPlayer[GetForLoopIndexA()]) == true ) ) then
        return false
    endif
    if ( not ( udg_HeroPlayer[GetForLoopIndexA()] != null ) ) then
        return false
    endif
    return true
endfunction

function Trig_Death_Hero_EXP_Actions takes nothing returns nothing
    local integer i = 0
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Death_Hero_EXP_Func002Func001C() ) then
            set i = i + 1
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    if ( i == 0 ) then
    if ( Trig_Death_Hero_EXP_Func005C() ) then
        call AddHeroXPSwapped( ( ( 50 + ( GetHeroLevel(GetDyingUnit()) * 40 ) ) + 0 ), udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))], true )
    else
    endif
    elseif i > 1 then
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Death_Hero_EXP_Func007Func001C() ) then
            call AddHeroXPSwapped( ( ( 25 + ( GetHeroLevel(GetDyingUnit()) * 20 ) ) / i ), udg_HeroPlayer[GetForLoopIndexA()], true )
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    endif
    set i = 0
endfunction

//===========================================================================
function InitTrig_Death_Hero_EXP takes nothing returns nothing
    set gg_trg_Death_Hero_EXP = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Death_Hero_EXP, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Death_Hero_EXP, Condition( function Trig_Death_Hero_EXP_Conditions ) )
    call TriggerAddAction( gg_trg_Death_Hero_EXP, function Trig_Death_Hero_EXP_Actions )
endfunction

