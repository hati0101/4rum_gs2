// Trigger: Leap Attack Down
//===========================================================================
function Trig_Leap_Attack_Down_Func004Func008A takes nothing returns nothing
    call KillDestructable( GetEnumDestructable() )
endfunction

function Trig_Leap_Attack_Down_Func004Func009C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R096', GetOwningPlayer(udg_Hero_Gla)) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Leap_Attack_Down_Func004Func022Func003C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_Hero_Gla, 'B086') == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Leap_Attack_Down_Func004Func022C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R097', GetOwningPlayer(udg_Hero_Gla)) == 1 ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A0AR', udg_Hero_Gla) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Leap_Attack_Down_Func004C takes nothing returns boolean
    if ( not ( udg_Hero_Gla_LeapIndex == 10 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Leap_Attack_Down_Actions takes nothing returns nothing
    set udg_Hero_Gla_LeapIndex = ( udg_Hero_Gla_LeapIndex + 1 )
    call SetUnitPositionLoc( udg_Hero_Gla, PolarProjectionBJ(udg_Hero_Gla_LeapStartLoc, ( ( udg_Hero_Gla_LeapHeight / 1.43 ) + ( I2R(udg_Hero_Gla_LeapIndex) * ( udg_Hero_Gla_LeapHeight / 33.33 ) ) ), udg_Hero_Gla_LeapAngle) )
    if ( Trig_Leap_Attack_Down_Func004C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        set udg_Hero_Gla_LeapIndex = 0
        call SetUnitTimeScalePercent( udg_Hero_Gla, 130.00 )
        call PolledWait( 0.05 )
        call SetUnitInvulnerable( udg_Hero_Gla, false )
        call PauseUnitBJ( false, udg_Hero_Gla )
        call SetUnitPathing( udg_Hero_Gla, true )
        call EnumDestructablesInRectAll( RectFromCenterSizeBJ(PolarProjectionBJ(GetUnitLoc(udg_Hero_Gla), 100.00, GetUnitFacing(udg_Hero_Gla)), 400.00, 400.00), function Trig_Leap_Attack_Down_Func004Func008A )
        if ( Trig_Leap_Attack_Down_Func004Func009C() ) then
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(udg_Hero_Gla), PolarProjectionBJ(GetUnitLoc(udg_Hero_Gla), 100.00, GetUnitFacing(udg_Hero_Gla)), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 4.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A0CE', GetLastCreatedUnit() )
            call SetUnitAbilityLevelSwapped( 'A0CE', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0AV', udg_Hero_Gla) )
            call IssueImmediateOrderBJ( GetLastCreatedUnit(), "stomp" )
        else
        endif
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(udg_Hero_Gla), PolarProjectionBJ(GetUnitLoc(udg_Hero_Gla), 100.00, GetUnitFacing(udg_Hero_Gla)), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 4.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0BH', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0BH', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0AV', udg_Hero_Gla) )
        call IssueImmediateOrderBJ( GetLastCreatedUnit(), "creepthunderclap" )
        call AddSpecialEffectLocBJ( PolarProjectionBJ(GetUnitLoc(udg_Hero_Gla), 100.00, GetUnitFacing(udg_Hero_Gla)), "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectLocBJ( PolarProjectionBJ(GetUnitLoc(udg_Hero_Gla), 100.00, GetUnitFacing(udg_Hero_Gla)), "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call SetUnitTimeScalePercent( udg_Hero_Gla, 100.00 )
        call ResetUnitAnimation( udg_Hero_Gla )
        // 유닛을 정상으로 만들고, 여러가지 효과를 줌
        if ( Trig_Leap_Attack_Down_Func004Func022C() ) then
            if ( Trig_Leap_Attack_Down_Func004Func022Func003C() ) then
                set udg_Hero_Gla_BFLevel = 3
            else
                set udg_Hero_Gla_BFLevel = IMinBJ(( 2 + ( 2 * GetUnitAbilityLevelSwapped('A0AR', udg_Hero_Gla) ) ), ( udg_Hero_Gla_BFLevel + 3 ))
            endif
            call StartTimerBJ( udg_Hero_Gla_BFTimer, false, 0.10 )
        else
        endif
    else
    endif
endfunction

