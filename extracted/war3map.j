    if ( not ( GetLearnedSkillLevel() > 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_MRG_Learns_Actions takes nothing returns nothing
    if ( Trig_MRG_Learns_Func002C() ) then
        call UnitAddAbilityBJ( 'A0T5', GetTriggerUnit() )
    else
        call SetUnitAbilityLevelSwapped( 'A0T5', GetTriggerUnit(), GetLearnedSkillLevel() )
    endif
    if ( Trig_MRG_Learns_Func003C() ) then
        call SetPlayerTechResearchedSwap( 'R06C', GetLearnedSkillLevel(), GetOwningPlayer(GetTriggerUnit()) )
    else
    endif
    if ( Trig_MRG_Learns_Func004C() ) then
        call SetPlayerTechResearchedSwap( 'R06B', ( ( GetLearnedSkillLevel() + ( 4 * GetPlayerTechCountSimple('R08J', GetOwningPlayer(udg_Hero_MRG)) ) ) - 1 ), GetOwningPlayer(GetTriggerUnit()) )
    else
    endif
endfunction

