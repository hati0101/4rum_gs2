    else
        set bj_forLoopAIndex = 8
        set bj_forLoopAIndexEnd = 12
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call DisplayTimedTextToForce( GetForceOfPlayer(GetTriggerPlayer()), 30.00, ( ( ( udg_Colors[GetForLoopIndexA()] + GetPlayerName(udg_SP_Player[GetForLoopIndexA()]) ) + "|r님의 영웅 : " ) + GetUnitName(udg_HeroPlayer[GetConvertedPlayerId(udg_SP_Player[GetForLoopIndexA()])]) ) )
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
    endif
endfunction

