function Trig_Drunken_Attack_Timer_Actions takes nothing returns nothing
    if ( Trig_Drunken_Attack_Timer_Func002C() ) then
        call SetUnitAbilityLevelSwapped( 'A138', udg_Hero_PaW, 1 )
        call UnitRemoveBuffBJ( 'B04O', udg_Hero_PaW )
        call KillUnit( udg_Hero_PaW_DrunkenUnit )
        if ( Trig_Drunken_Attack_Timer_Func002Func004C() ) then
            call SetUnitLifeBJ( udg_Hero_PaW, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_PaW) + ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, udg_Hero_PaW) * 0.03 ) ) )
            call SetUnitManaBJ( udg_Hero_PaW, ( GetUnitStateSwap(UNIT_STATE_MANA, udg_Hero_PaW) + ( GetUnitStateSwap(UNIT_STATE_MAX_MANA, udg_Hero_PaW) * 0.01 ) ) )
            call AddSpecialEffectTargetUnitBJ( "chest", udg_Hero_PaW, "Abilities\\Spells\\Other\\HealingSpray\\HealBottleMissile.mdl" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
            call TextTag( "술이 술술 넘어간다!" , udg_Hero_PaW , 9 , 255 , 255 , 150, 3 )
        else
        endif
        call TextTagForce( I2S(GetUnitAbilityLevelSwapped('A138', udg_Hero_PaW) - 1), udg_Hero_PaW, 10, 255, 100, 100, 2, GetForceOfPlayer(GetOwningPlayer(udg_Hero_PaW)) )
        call PauseTimerBJ( true, udg_Hero_PaW_AttackTimer )
    else
        call SetUnitAbilityLevelSwapped( 'A138', udg_Hero_PaW, GetUnitAbilityLevelSwapped('A138', udg_Hero_PaW)-2 )
        if ( Trig_Drunken_Attack_Timer_Func002Func008C() ) then
            call SetUnitLifeBJ( udg_Hero_PaW, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_PaW) + ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, udg_Hero_PaW) * 0.03 ) ) )
            call SetUnitManaBJ( udg_Hero_PaW, ( GetUnitStateSwap(UNIT_STATE_MANA, udg_Hero_PaW) + ( GetUnitStateSwap(UNIT_STATE_MAX_MANA, udg_Hero_PaW) * 0.01 ) ) )
            call AddSpecialEffectTargetUnitBJ( "chest", udg_Hero_PaW, "Abilities\\Spells\\Other\\HealingSpray\\HealBottleMissile.mdl" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
            call TextTag( "술이 술술 넘어간다!" , udg_Hero_PaW , 9 , 255 , 255 , 150, 3 )
        else
        endif
        call TextTagForce( I2S(GetUnitAbilityLevelSwapped('A138', udg_Hero_PaW) - 1), udg_Hero_PaW, 10, 255, 100, 100, 2, GetForceOfPlayer(GetOwningPlayer(udg_Hero_PaW)) )
        call StartTimerBJ( udg_Hero_PaW_AttackTimer, false, 6.00 )
    endif
endfunction

