    if ( not ( GetSpellAbilityId() == 'A03K' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Brain_Shock_Func004Func002C takes nothing returns boolean
    if ( ( UnitHasBuffBJ(GetSpellTargetUnit(), 'B0BG') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(GetSpellTargetUnit(), 'B02K') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(GetSpellTargetUnit(), 'BNsi') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(GetSpellTargetUnit(), 'B080') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(GetSpellTargetUnit(), 'B017') == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_Brain_Shock_Func004C takes nothing returns boolean
    if ( not Trig_Brain_Shock_Func004Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Brain_Shock_Actions takes nothing returns nothing
    call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), ( 20.00 + ( I2R(GetUnitAbilityLevelSwapped('A03K', GetTriggerUnit())) * 80.00 ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    if ( Trig_Brain_Shock_Func004C() ) then
        call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), ( 50.00 * I2R(GetPlayerTechCountSimple('R00R', GetOwningPlayer(GetTriggerUnit()))) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A011', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A011', GetLastCreatedUnit(), ( GetPlayerTechCountSimple('R00R', GetOwningPlayer(GetTriggerUnit())) + 1 ) )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "cripple", GetSpellTargetUnit() )
    else
    endif
endfunction

