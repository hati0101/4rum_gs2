//===========================================================================
// Trigger: Full Inv Get
//
// 모든 플레이어의 기본 멜리 게임 초기화
//===========================================================================
function Trig_Full_Inv_Get_Conditions takes nothing returns boolean
    if ( not ( GetIssuedOrderIdBJ() != String2OrderIdBJ("attack") ) ) then
        return false
    endif
    if ( not ( IsItemOwned(GetOrderTargetItem()) == false ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(GetOrderTargetUnit()) == false ) ) then
        return false
    endif
    if ( not ( UnitInventoryCount(GetTriggerUnit()) == 6 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Full_Inv_Get_Func003C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetItemLoc(GetOrderTargetItem())) >= 170.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Full_Inv_Get_Func010Func009Func004C takes nothing returns boolean
    if ( ( GetItemTypeId(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]) == 'I019' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]) == 'I016' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]) == 'I01A' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]) == 'I017' ) ) then
        return true
    endif
    if ( ( GetItemTypeId(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]) == 'I018' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Full_Inv_Get_Func010Func009C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(GetTriggerUnit(), GetItemTypeId(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))])) == true ) ) then
        return false
    endif
    if ( not Trig_Full_Inv_Get_Func010Func009Func004C() ) then
        return false
    endif
    return true
endfunction

function Trig_Full_Inv_Get_Func010C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0W3', GetTriggerUnit()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Full_Inv_Get_Actions takes nothing returns nothing
    local item i = GetOrderTargetItem()
    local integer a=0
    if ( Trig_Full_Inv_Get_Func003C() ) then
        call IssueTargetItemOrder( GetTriggerUnit(), "move", GetOrderTargetItem() )
    else
        call SetUnitFacingTimed( GetTriggerUnit(), AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetItemLoc(GetOrderTargetItem())), 0.01 )
    endif
    call PolledWait( 0.01 )
    call UnitAddAbilityBJ( 'A0W3', GetTriggerUnit() )
    loop
    if ( Trig_Full_Inv_Get_Func010C() ) then
        if ( DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetItemLoc( i )) <= 170.00 ) then
        set udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = i
        call SetItemLifeBJ( udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], 500.00 )
        call SetItemUserData( udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], R2I(GetItemLifeBJ(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))])) )
        set bj_forLoopAIndex = 1
        set bj_forLoopAIndexEnd = 6
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call SetItemLifeBJ( UnitItemInSlotBJ(GetTriggerUnit(), GetForLoopIndexA()), 500.00 )
            call SetItemUserData( UnitItemInSlotBJ(GetTriggerUnit(), GetForLoopIndexA()), R2I(GetItemLifeBJ(UnitItemInSlotBJ(GetTriggerUnit(), GetForLoopIndexA()))) )
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
        call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
        call UnitRemoveAbilityBJ( 'A0W3', GetTriggerUnit() )
        if ( Trig_Full_Inv_Get_Func010Func009C() ) then
            call SetItemCharges( GetItemOfTypeFromUnitBJ(GetTriggerUnit(), GetItemTypeId(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))])), ( GetItemCharges(GetItemOfTypeFromUnitBJ(GetTriggerUnit(), GetItemTypeId(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]))) + GetItemCharges(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]) ) )
            call RemoveItem( udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] )
        else
        endif
        call ItemMix(188, GetTriggerUnit())
        call ItemMix(189, GetTriggerUnit())
        if StringLength(udg_ItemMix_DB[GetItemUserData(i)]) > 0 then
        call ItemMix(GetItemUserData(i), GetTriggerUnit())
        endif
        loop
        exitwhen a>5
        if StringLength(udg_ItemMix_DB[GetItemUserData(UnitItemInSlotBJ(GetTriggerUnit(), a))]) > 0 then
        call ItemMix(GetItemUserData(UnitItemInSlotBJ(GetTriggerUnit(), a)), GetTriggerUnit())
        endif
        set a = a+1
        endloop
        set udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = null
        endif
    else
    endif
    call PolledWait( 0.10 )
    exitwhen ( GetUnitAbilityLevelSwapped('A0W3', GetTriggerUnit()) == 0 )
    endloop
endfunction

