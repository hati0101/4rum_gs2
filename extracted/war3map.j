    call AddSpecialEffectTargetUnitBJ( "chest", udg_Hero_DeC, "Abilities\\Weapons\\ChimaeraAcidMissile\\ChimaeraAcidMissile.mdl" )
    set udg_Hero_DeC_VenomEff[udg_Hero_DeC_VenomEffCounter] = GetLastCreatedEffectBJ()
    set udg_Hero_DeC_VenomEffCounter = ( udg_Hero_DeC_VenomEffCounter + 1 )
