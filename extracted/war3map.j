    call DestroyEffectBJ( udg_Hero_MoW_UltiEff[1] )
    call DestroyEffectBJ( udg_Hero_MoW_UltiEff2[1] )
    call DestroyEffectBJ( udg_Hero_MoW_UltiEff2[2] )
    call ResetUnitAnimation( udg_Hero_DaW_UltiCaster )
    call CreateNUnitsAtLocFacingLocBJ( 1, 'e03J', GetOwningPlayer(udg_Hero_DaW_UltiCaster), GetRectCenter(GetPlayableMapRect()), GetUnitLoc(udg_Hero_DaW_UltiCaster) )
    call SetUnitTimeScalePercent( udg_Hero_DaW_UltiCaster, 100.00 )
    set udg_Hero_MoW_UltiTimes = 0
    set udg_Hero_DaW_UltiTarget = null
    call GroupClear( udg_Hero_MoW_UltiTgtGroup )
