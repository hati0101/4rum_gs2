function Trig_SwM_Learn_Func001C takes nothing returns boolean
    if ( ( GetLearnedSkillBJ() == 'A0UC' ) ) then
        return true
    endif
    if ( ( GetLearnedSkillBJ() == 'A00E' ) ) then
        return true
    endif
    if ( ( GetLearnedSkillBJ() == 'A11M' ) ) then
        return true
    endif
    return false
endfunction

function Trig_SwM_Learn_Conditions takes nothing returns boolean
    if ( not Trig_SwM_Learn_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_SwM_Learn_Func002Func002C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A001', GetTriggerUnit()) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SwM_Learn_Func002Func003C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R009', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_SwM_Learn_Func002C takes nothing returns boolean
    if ( not ( GetLearnedSkillBJ() == 'A0UC' ) ) then
        return false
    endif
    return true
endfunction

function Trig_SwM_Learn_Func003C takes nothing returns boolean
    if ( not ( GetLearnedSkillBJ() == 'A00E' ) ) then
        return false
    endif
    return true
endfunction

function Trig_SwM_Learn_Func004C takes nothing returns boolean
    if ( not ( GetLearnedSkillBJ() == 'A11M' ) ) then
        return false
    endif
    return true
endfunction

function Trig_SwM_Learn_Actions takes nothing returns nothing
    if ( Trig_SwM_Learn_Func002C() ) then
        if ( Trig_SwM_Learn_Func002Func002C() ) then
            call UnitAddAbilityBJ( 'A001', GetTriggerUnit() )
        else
        endif
        if ( Trig_SwM_Learn_Func002Func003C() ) then
            call SetUnitAbilityLevelSwapped( 'A001', GetTriggerUnit(), ( 4 + GetLearnedSkillLevel() ) )
        else
            call SetUnitAbilityLevelSwapped( 'A001', GetTriggerUnit(), GetLearnedSkillLevel() )
        endif
    else
    endif
    if ( Trig_SwM_Learn_Func003C() ) then
        call SetPlayerTechResearchedSwap( 'R0AX', ( GetLearnedSkillLevel() - 1 ), GetOwningPlayer(GetTriggerUnit()) )
    else
    endif
    if ( Trig_SwM_Learn_Func004C() ) then
        call SetUnitAbilityLevelSwapped( 'A0RF', GetTriggerUnit(), ( 1 + GetLearnedSkillLevel() ) )
    else
    endif
endfunction

