function Trig_Wolfs_Slush_Start_Actions takes nothing returns nothing
    call SetUnitInvulnerable( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], true )
    set udg_Hero_MoW_UltiDamage[1] = ( 20.00 + ( I2R(GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetSpellAbilityUnit())) * 40.00 ) )
    set udg_Hero_MoW_UltiDamage[2] = ( 10.00 + ( I2R(GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetSpellAbilityUnit())) * 20.00 ) )
    set udg_Hero_MoW_UltiDamage[3] = ( 10.00 + ( I2R(GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetSpellAbilityUnit())) * 20.00 ) )
    set udg_Hero_MoW_UltiIndex = 1
    loop
        exitwhen udg_Hero_MoW_UltiIndex > 3
        if ( Trig_Wolfs_Slush_Start_Func005Func001C() ) then
            call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_MoW[udg_Hero_MoW_UltiIndex], "Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile.mdl" )
            set udg_Hero_MoW_UltiEff[udg_Hero_MoW_UltiIndex] = GetLastCreatedEffectBJ()
        else
        endif
        set udg_Hero_MoW_UltiIndex = udg_Hero_MoW_UltiIndex + 1
    endloop
    set udg_Hero_MoW_UltiTgtGroup = GetUnitsInRangeOfLocMatching(600.00, GetUnitLoc(GetSpellAbilityUnit()), Condition(function Trig_Wolfs_Slush_Start_Func006002003))
    if ( Trig_Wolfs_Slush_Start_Func007C() ) then
        set udg_Hero_MoW_UltiIndex = 1
        loop
            exitwhen udg_Hero_MoW_UltiIndex > 3
            if ( Trig_Wolfs_Slush_Start_Func007Func003Func001C() ) then
                call StopSoundBJ( gg_snd_BuildingDeathLargeHuman, false )
                set udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex] = GroupPickRandomUnit(udg_Hero_MoW_UltiTgtGroup)
                call SetUnitInvulnerable( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], true )
                call PauseUnitBJ( true, udg_Hero_MoW[udg_Hero_MoW_UltiIndex] )
                call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_MoW[udg_Hero_MoW_UltiIndex], "Abilities\\Weapons\\GryphonRiderMissile\\GryphonRiderMissileTarget.mdl" )
                call SetUnitPositionLocFacingLocBJ( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], PolarProjectionBJ(GetUnitLoc(udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex]), 50.00, GetRandomDirectionDeg()), GetUnitLoc(udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex]) )
                call SetUnitAnimation( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], "attack slam" )
                call SetUnitTimeScalePercent( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], 170.00 )
                call CreateNUnitsAtLocFacingLocBJ( 1, 'o00J', GetOwningPlayer(GetSpellAbilityUnit()), GetUnitLoc(udg_Hero_MoW[udg_Hero_MoW_UltiIndex]), GetUnitLoc(udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex]) )
                call UnitApplyTimedLifeBJ( 0.20, 'BTLF', GetLastCreatedUnit() )
                call SetUnitTimeScalePercent( GetLastCreatedUnit(), 250.00 )
                call SetUnitVertexColorBJ( GetLastCreatedUnit(), 100, 0.00, 0.00, 75.00 )
                call SetUnitAnimation( GetLastCreatedUnit(), "attack slam" )
            else
            endif
            set udg_Hero_MoW_UltiIndex = udg_Hero_MoW_UltiIndex + 1
        endloop
        call PlaySoundAtPointBJ( gg_snd_BuildingDeathLargeHuman, 100, GetUnitLoc(udg_Hero_MoW[1]), 500.00 )
        call TriggerSleepAction( 0.00 )
        set udg_Hero_MoW_UltiIndex = 1
        loop
            exitwhen udg_Hero_MoW_UltiIndex > 3
            if ( Trig_Wolfs_Slush_Start_Func007Func006Func001C() ) then
                call SetUnitTimeScalePercent( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], 30.00 )
                call UnitDamageTargetBJ( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex], udg_Hero_MoW_UltiDamage[udg_Hero_MoW_UltiIndex], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_LIGHTNING )
                if ( Trig_Wolfs_Slush_Start_Func007Func006Func001Func003001() ) then
                    call UnitDamageTargetBJ( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex], 80.00, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_LIGHTNING )
                else
                    call DoNothing(  )
                endif
                call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex]), "Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl" )
                call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex]), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl" )
            else
            endif
            set udg_Hero_MoW_UltiIndex = udg_Hero_MoW_UltiIndex + 1
        endloop
        call GroupClear( udg_Hero_MoW_UltiTgtGroup )
    else
        set udg_Hero_MoW_UltiTgtGroup = GetUnitsInRangeOfLocMatching(600.00, GetUnitLoc(GetSpellAbilityUnit()), Condition(function Trig_Wolfs_Slush_Start_Func007Func001002003))
        if ( Trig_Wolfs_Slush_Start_Func007Func002C() ) then
            set udg_Hero_MoW_UltiIndex = 1
            loop
                exitwhen udg_Hero_MoW_UltiIndex > 3
                if ( Trig_Wolfs_Slush_Start_Func007Func002Func001Func001C() ) then
                    call StopSoundBJ( gg_snd_BuildingDeathLargeHuman, false )
                    set udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex] = GroupPickRandomUnit(udg_Hero_MoW_UltiTgtGroup)
                    call SetUnitInvulnerable( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], true )
                    call PauseUnitBJ( true, udg_Hero_MoW[udg_Hero_MoW_UltiIndex] )
                    call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_MoW[udg_Hero_MoW_UltiIndex], "Abilities\\Weapons\\GryphonRiderMissile\\GryphonRiderMissileTarget.mdl" )
                    call SetUnitPositionLocFacingLocBJ( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], PolarProjectionBJ(GetUnitLoc(udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex]), 50.00, GetRandomDirectionDeg()), GetUnitLoc(udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex]) )
                    call SetUnitAnimation( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], "attack slam" )
                    call SetUnitTimeScalePercent( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], 170.00 )
                    call CreateNUnitsAtLocFacingLocBJ( 1, 'o00J', GetOwningPlayer(GetSpellAbilityUnit()), GetUnitLoc(udg_Hero_MoW[udg_Hero_MoW_UltiIndex]), GetUnitLoc(udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex]) )
                    call UnitApplyTimedLifeBJ( 0.20, 'BTLF', GetLastCreatedUnit() )
                    call SetUnitTimeScalePercent( GetLastCreatedUnit(), 250.00 )
                    call SetUnitVertexColorBJ( GetLastCreatedUnit(), 100, 0.00, 0.00, 75.00 )
                    call SetUnitAnimation( GetLastCreatedUnit(), "attack slam" )
                else
                endif
                set udg_Hero_MoW_UltiIndex = udg_Hero_MoW_UltiIndex + 1
            endloop
            call PlaySoundAtPointBJ( gg_snd_BuildingDeathLargeHuman, 100, GetUnitLoc(udg_Hero_MoW[1]), 500.00 )
            call TriggerSleepAction( 0.00 )
            set udg_Hero_MoW_UltiIndex = 1
            loop
                exitwhen udg_Hero_MoW_UltiIndex > 3
                if ( Trig_Wolfs_Slush_Start_Func007Func002Func004Func001C() ) then
                    call SetUnitTimeScalePercent( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], 30.00 )
                    call UnitDamageTargetBJ( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex], ( udg_Hero_MoW_UltiDamage[udg_Hero_MoW_UltiIndex] / 3.00 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL )
                    if ( Trig_Wolfs_Slush_Start_Func007Func002Func004Func001Func003001() ) then
                        call UnitDamageTargetBJ( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex], 80.00, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_LIGHTNING )
                    else
                        call DoNothing(  )
                    endif
                    call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex]), "Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl" )
                    call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex]), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl" )
                else
                endif
                set udg_Hero_MoW_UltiIndex = udg_Hero_MoW_UltiIndex + 1
            endloop
            call GroupClear( udg_Hero_MoW_UltiTgtGroup )
        else
        endif
    endif
    call PolledWait( 0.00 )
    call StartTimerBJ( udg_Hero_MoW_UltiTimer, false, 0.26 )
    call EnableTrigger( gg_trg_Wolfs_Slush_Execute )
endfunction

