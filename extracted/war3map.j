//===========================================================================
// Trigger: FaM Special 2
//===========================================================================
function Trig_FaM_Special_2_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A01I' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R00V', GetTriggerPlayer()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_FaM_Special_2_Actions takes nothing returns nothing
    local integer rand = GetRandomInt( 1 , 100 )
    local integer chance = 60 // 발동 확률
    local real mana = ( 15.00 + ( I2R(GetUnitAbilityLevelSwapped('A01I', GetTriggerUnit())) * 15.00 ) )
    local unit target = GetSpellTargetUnit()
    call PolledWait( 0.15 )
    if ( rand > chance ) then
    return
    endif
    if ( IsUnitAliveBJ(target) == false ) then
    return
    endif
    if ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) >= mana ) then
    call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) - mana ) )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 5.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A01T', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A01T', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A01I', GetTriggerUnit()) )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "chainlightning", target )
    call TextTag( "멀티 캐스트!!" , GetTriggerUnit() , 10 , 255 , 255 , 150, 3 )
    else
    endif
endfunction

//===========================================================================
function InitTrig_FaM_Special_2 takes nothing returns nothing
    set gg_trg_FaM_Special_2 = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_FaM_Special_2, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_FaM_Special_2, Condition( function Trig_FaM_Special_2_Conditions ) )
    call TriggerAddAction( gg_trg_FaM_Special_2, function Trig_FaM_Special_2_Actions )
endfunction

//===========================================================================
// Trigger: Ice Wall
//===========================================================================
function Trig_Ice_Wall_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A01J' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ice_Wall_Func031C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R00W', GetTriggerPlayer()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ice_Wall_Actions takes nothing returns nothing
    local location point = GetSpellTargetLoc()
    local unit center
    local unit left
    local unit left2
    local unit right
    local unit right2
    local real time = 3
    local integer rand = GetRandomInt( 1 , 100 )
    local integer chance = 100 // 발동 확률
    call CreateNUnitsAtLoc( 1, 'h002', GetTriggerPlayer(), point, bj_UNIT_FACING )
    set center = GetLastCreatedUnit()
    call CreateNUnitsAtLoc( 1, 'h002', GetTriggerPlayer(), PolarProjectionBJ(point, 200.00, ( AngleBetweenPoints(point, GetUnitLoc(GetTriggerUnit())) + 90.00 )), bj_UNIT_FACING )
    set left = GetLastCreatedUnit()
    call CreateNUnitsAtLoc( 1, 'h002', GetTriggerPlayer(), PolarProjectionBJ(point, 400.00, ( AngleBetweenPoints(point, GetUnitLoc(GetTriggerUnit())) + 90.00 )), bj_UNIT_FACING )
    set left2 = GetLastCreatedUnit()
    call CreateNUnitsAtLoc( 1, 'h002', GetTriggerPlayer(), PolarProjectionBJ(point, 200.00, ( AngleBetweenPoints(point, GetUnitLoc(GetTriggerUnit())) - 90.00 )), bj_UNIT_FACING )
    set right = GetLastCreatedUnit()
    call CreateNUnitsAtLoc( 1, 'h002', GetTriggerPlayer(), PolarProjectionBJ(point, 400.00, ( AngleBetweenPoints(point, GetUnitLoc(GetTriggerUnit())) - 90.00 )), bj_UNIT_FACING )
    set right2 = GetLastCreatedUnit()
    //  
    call UnitApplyTimedLifeBJ( time, 'BTLF', center )
    call UnitApplyTimedLifeBJ( time, 'BTLF', right )
    call UnitApplyTimedLifeBJ( time, 'BTLF', left )
    call UnitApplyTimedLifeBJ( time, 'BTLF', right2 )
    call UnitApplyTimedLifeBJ( time, 'BTLF', left2 )
    call UnitAddAbilityBJ( 'A01Z', center )
    call UnitAddAbilityBJ( 'A01Z', left )
    call UnitAddAbilityBJ( 'A01Z', right )
    call UnitAddAbilityBJ( 'A01Z', left2 )
    call UnitAddAbilityBJ( 'A01Z', right2 )
    if ( Trig_Ice_Wall_Func031C() ) then
        if ( rand <= chance ) then
        call SetUnitAbilityLevelSwapped( 'A01Z', center, 2 )
        call SetUnitAbilityLevelSwapped( 'A01Z', left, 2 )
        call SetUnitAbilityLevelSwapped( 'A01Z', right, 2 )
        call SetUnitAbilityLevelSwapped( 'A01Z', left2, 2 )
        call SetUnitAbilityLevelSwapped( 'A01Z', right2, 2 )
        else
        endif
    else
    endif
    call IssuePointOrderLocBJ( center, "cloudoffog", GetUnitLoc(center) )
    call IssuePointOrderLocBJ( left, "cloudoffog", GetUnitLoc(left) )
    call IssuePointOrderLocBJ( right, "cloudoffog", GetUnitLoc(right) )
    call IssuePointOrderLocBJ( left2, "cloudoffog", GetUnitLoc(left2) )
    call IssuePointOrderLocBJ( right2, "cloudoffog", GetUnitLoc(right2) )
endfunction

