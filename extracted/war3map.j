    if ( not ( GetPlayerTechCountSimple('R01H', GetOwningPlayer(GetEventDamageSource())) == 1 ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B08C') == true ) ) then
        return false
    endif
    if ( not ( GetEventDamageSource() == udg_Hero_OgL ) ) then
        return false
