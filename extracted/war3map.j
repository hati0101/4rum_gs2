//===========================================================================
// Trigger: Tidal
//
// 모든 플레이어의 기본 멜리 게임 초기화
//===========================================================================
function Trig_Tidal_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A12D' ) ) then
        return false
    endif
    if ( not ( TimerGetRemaining(udg_Hero_Ele_Tidaltimer) == 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tidal_Func004A takes nothing returns nothing
    call KillDestructable( GetEnumDestructable() )
endfunction

function Trig_Tidal_Func007C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R08E', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tidal_Actions takes nothing returns nothing
    call PlaySoundBJ( gg_snd_PandarenBrewmasterStormWarcry1 )
    call EnumDestructablesInRectAll( RectFromCenterSizeBJ(GetUnitLoc(udg_Hero_Ele), 750.00, 750.00), function Trig_Tidal_Func004A )
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 4
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc( 1, 'e01Q', GetOwningPlayer(GetTriggerUnit()), GetRandomLocInRect(RectFromCenterSizeBJ(GetUnitLoc(GetTriggerUnit()), 100.00, 100.00)), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call CreateNUnitsAtLoc( 1, 'e01Q', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    if ( Trig_Tidal_Func007C() ) then
        call SetUnitAbilityLevelSwapped( 'A13Q', GetLastCreatedUnit(), ( GetUnitAbilityLevelSwapped('A12D', GetTriggerUnit()) + 3 ) )
    else
        call SetUnitAbilityLevelSwapped( 'A13Q', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A12D', GetTriggerUnit()) )
    endif
    call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
    call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call UnitAddAbilityBJ( 'A0H3', GetLastCreatedUnit() )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call IssueImmediateOrderBJ( GetLastCreatedUnit(), "stomp" )
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc( 1, 'e01R', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 10.00, ( 30.00 * I2R(GetForLoopIndexA()) )), ( 30.00 * I2R(GetForLoopIndexA()) ) )
        call UnitApplyTimedLifeBJ( 0.50, 'BTLF', GetLastCreatedUnit() )
        call IssuePointOrderLocBJ( GetLastCreatedUnit(), "move", PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 500.00, ( 30.00 * I2R(GetForLoopIndexA()) )) )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set udg_Hero_Ele_Int = ( udg_Hero_Ele_Int - 4 )
    call TextTagForce( I2S(udg_Hero_Ele_Int), udg_Hero_Ele, 10, 45, 143, 38, 3, GetForceOfPlayer(GetOwningPlayer(udg_Hero_Ele)) )
endfunction

