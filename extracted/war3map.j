//===========================================================================
function Trig_Tidal_Damage_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEventDamageSource()) == 'e01Q' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tidal_Damage_Func001C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'N02D' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tidal_Damage_Func006Func001C takes nothing returns boolean
    if ( ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_FLYING) == true ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'N02D' ) ) then
        return true
    endif
    return false
endfunction

