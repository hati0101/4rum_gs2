    call SetUnitAbilityLevelSwapped( 'A0YN', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0TL', GetTriggerUnit()) )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "deathcoil", GetSpellTargetUnit() )
    call RemoveLocation( udg_Hero_ArA_Loc )
endfunction

