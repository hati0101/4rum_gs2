    if ( not ( GetTriggerUnit() == GetSpellTargetUnit() ) ) then
        return false
    endif
    return true
endfunction

function Trig_DiK_Special_Func009C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A090' ) ) then
        return true
    endif
    if ( Trig_DiK_Special_Func009Func002C() ) then
        return true
    endif
    if ( Trig_DiK_Special_Func009Func003C() ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0MY' ) ) then
