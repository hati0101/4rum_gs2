//===========================================================================
// Trigger: display leaderboard
//
// call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),1,(GetForLoopIndexA()+1),(udg_Colors[GetForLoopIndexA()]+(GetPlayerName(udg_SP_Player[GetForLoopIndexA()])+"|r")))
//===========================================================================
function Trig_display_leaderboard_Actions takes nothing returns nothing
call CreateMultiboardBJ(7,14,(udg_Version))
set udg_MB = GetLastCreatedMultiboard()
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),1,1,"  ")
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),2,1,"플레이어")
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),3,1," 부활")
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),4,1," 콤보")
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),5,1,"  킬")
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),6,1," 데스")
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),7,1," 어시")
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),2,2,(udg_Colors[1]+("가디언"+"|r")))
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),2,8,(udg_Colors[7]+("다크니스"+"|r")))
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),5,8,"    0")
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),6,8,"    0")
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),5,2,"    0")
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),6,2,"    0")
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=14
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call MultiboardSetItemWidthBJ(GetLastCreatedMultiboard(),1,GetForLoopIndexA(),1.30)
call MultiboardSetItemWidthBJ(GetLastCreatedMultiboard(),2,GetForLoopIndexA(),9.80)
call MultiboardSetItemWidthBJ(GetLastCreatedMultiboard(),3,GetForLoopIndexA(),3.70)
call MultiboardSetItemWidthBJ(GetLastCreatedMultiboard(),4,GetForLoopIndexA(),3.00)
call MultiboardSetItemWidthBJ(GetLastCreatedMultiboard(),5,GetForLoopIndexA(),3.50)
call MultiboardSetItemWidthBJ(GetLastCreatedMultiboard(),6,GetForLoopIndexA(),3.60)
call MultiboardSetItemWidthBJ(GetLastCreatedMultiboard(),7,GetForLoopIndexA(),3.50)
call MultiboardSetItemColorBJ(GetLastCreatedMultiboard(),3,GetForLoopIndexA(),86.20,86.20,0.00,0)
call MultiboardSetItemColorBJ(GetLastCreatedMultiboard(),4,GetForLoopIndexA(),50.00,750.00,25.00,0)
call MultiboardSetItemColorBJ(GetLastCreatedMultiboard(),5,GetForLoopIndexA(),100.00,0.00,0.00,0)
call MultiboardSetItemColorBJ(GetLastCreatedMultiboard(),6,GetForLoopIndexA(),0.00,5.00,100.00,0)
call MultiboardSetItemColorBJ(GetLastCreatedMultiboard(),7,GetForLoopIndexA(),94.00,37.00,96.00,0)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set bj_forLoopAIndex=2
set bj_forLoopAIndexEnd=6
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
if(GetPlayerSlotState(udg_SP_Player[GetForLoopIndexA()]) == PLAYER_SLOT_STATE_PLAYING)then
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),2,(GetForLoopIndexA()+1),(udg_Colors[GetForLoopIndexA()]+(GetPlayerName(udg_SP_Player[GetForLoopIndexA()])+"|r")))
else
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),2,(GetForLoopIndexA()+1),((udg_Colors[GetForLoopIndexA()]+"비어있음")+"|r"))
endif
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),3,(GetForLoopIndexA()+1),"    ")
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),5,(GetForLoopIndexA()+1),"    0")
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),6,(GetForLoopIndexA()+1),"    0")
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),7,(GetForLoopIndexA()+1),"    0")
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set bj_forLoopAIndex=8
set bj_forLoopAIndexEnd=12
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
if(GetPlayerSlotState(udg_SP_Player[GetForLoopIndexA()]) == PLAYER_SLOT_STATE_PLAYING)then
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),2,(GetForLoopIndexA()+1),(udg_Colors[GetForLoopIndexA()]+(GetPlayerName(udg_SP_Player[GetForLoopIndexA()])+"|r")))
else
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),2,(GetForLoopIndexA()+1),((udg_Colors[GetForLoopIndexA()]+"비어있음")+"|r"))
endif
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),3,(GetForLoopIndexA()+1),"    ")
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),5,(GetForLoopIndexA()+1),"    0")
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),6,(GetForLoopIndexA()+1),"    0")
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),7,(GetForLoopIndexA()+1),"    0")
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=7
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set bj_forLoopBIndex=1
set bj_forLoopBIndexEnd=14
loop
exitwhen bj_forLoopBIndex>bj_forLoopBIndexEnd
call MultiboardSetItemStyleBJ(GetLastCreatedMultiboard(),GetForLoopIndexA(),GetForLoopIndexB(),true,false)
set bj_forLoopBIndex=bj_forLoopBIndex+1
endloop
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),2,14,"경과된 시간")
call MultiboardSetItemColorBJ(GetLastCreatedMultiboard(),5,14,100.00,100.00,100.00,0)
call MultiboardDisplayBJ(true,GetLastCreatedMultiboard())
call MultiboardMinimizeBJ(false,GetLastCreatedMultiboard())
call DestroyTrigger(GetTriggeringTrigger())
endfunction

function InitTrig_display_leaderboard takes nothing returns nothing
set gg_trg_display_leaderboard=CreateTrigger()
call TriggerRegisterTimerEventSingle(gg_trg_display_leaderboard,1.00)
call TriggerAddAction(gg_trg_display_leaderboard,function Trig_display_leaderboard_Actions)
endfunction
//===========================================================================
// Trigger: Multi Board Refresh
//===========================================================================
function Trig_Multi_Board_Refresh_Func003C takes nothing returns boolean
    if ( not ( udg_Seconds < 10 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Multi_Board_Refresh_Func004C takes nothing returns boolean
    if ( not ( udg_GoldBonusTimer[1] > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Multi_Board_Refresh_Func005C takes nothing returns boolean
    if ( not ( udg_GoldBonusTimer[2] > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Multi_Board_Refresh_Actions takes nothing returns nothing
    set udg_Minutes=((R2I(TimerGetElapsed(udg_MBTime))/60)-(1/2))
    set udg_Seconds=ModuloInteger(R2I(TimerGetElapsed(udg_MBTime)),60)
    if ( Trig_Multi_Board_Refresh_Func003C() ) then
        call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),5,14,(" "+(I2S(udg_Minutes)+(":0"+I2S(udg_Seconds)))))
    else
        call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),5,14,(" "+(I2S(udg_Minutes)+(":"+I2S(udg_Seconds)))))
    endif
    if ( Trig_Multi_Board_Refresh_Func004C() ) then
        set udg_GoldBonusTimer[1] = ( udg_GoldBonusTimer[1] - 1 )
    else
    endif
    if ( Trig_Multi_Board_Refresh_Func005C() ) then
        set udg_GoldBonusTimer[2] = ( udg_GoldBonusTimer[2] - 1 )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Multi_Board_Refresh takes nothing returns nothing
    set gg_trg_Multi_Board_Refresh = CreateTrigger(  )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Multi_Board_Refresh, 1.00 )
    call TriggerAddAction( gg_trg_Multi_Board_Refresh, function Trig_Multi_Board_Refresh_Actions )
endfunction

