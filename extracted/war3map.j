//===========================================================================
// Trigger: Set Summoned Unit
//===========================================================================
function Trig_Set_Summoned_Unit_Func001Func002C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'o00I' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'o00E' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Set_Summoned_Unit_Func001C takes nothing returns boolean
    if ( not Trig_Set_Summoned_Unit_Func001Func002C() ) then
        return false
    endif
    if ( not ( IsUnitIllusionBJ(GetSummonedUnit()) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Set_Summoned_Unit_Func002Func005C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'o00F' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'o00G' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'o00H' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetSummonedUnit()) == 'o00I' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Set_Summoned_Unit_Func002C takes nothing returns boolean
    if ( not Trig_Set_Summoned_Unit_Func002Func005C() ) then
        return false
    endif
