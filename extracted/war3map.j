//===========================================================================
function Trig_Blazing_Rider_Start_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0Z4' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blazing_Rider_Start_Actions takes nothing returns nothing
    set udg_Hero_FlB_ChargeTarget = GetSpellTargetUnit()
    call IssueTargetOrderBJ( udg_Hero_FlB, "attack", udg_Hero_FlB_ChargeTarget )
    call UnitAddItemByIdSwapped( 'I0BB', GetTriggerUnit() )
    call StartTimerBJ( udg_Hero_FlB_ChargeDur, false, 6.00 )
    call UnitShareVisionBJ( true, udg_Hero_FlB_ChargeTarget, GetOwningPlayer(udg_Hero_FlB) )
    loop
    exitwhen ( udg_Hero_FlB_ChargeTarget == null )
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call PolledWait( 0.50 )
    endloop
endfunction

