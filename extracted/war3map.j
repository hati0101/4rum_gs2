    if ( not ( GetAttacker() == udg_Hero_DrR ) ) then
        return false
    endif
    if ( not ( TimerGetRemaining(udg_Hero_DrR_ReflexTimer[2]) == 0.00 ) ) then
        return false
    endif
    if ( not ( udg_Hero_DrR_ReflexCount > 0 ) ) then
        return false
    endif
    return true
endfunction

