function Trig_Venom_Blast_Start_Actions takes nothing returns nothing
    call StartTimerBJ( udg_Hero_DeC_VenomTimer, false, 4.00 )
    call StartTimerBJ( udg_Hero_DeC_VenomEffTimer, true, 0.50 )
    call AddSpecialEffectTargetUnitBJ( "chest", udg_Hero_DeC, "Abilities\\Weapons\\ChimaeraAcidMissile\\ChimaeraAcidMissile.mdl" )
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call DestroyEffectBJ( udg_Hero_DeC_VenomEff[GetForLoopIndexA()] )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set udg_Hero_DeC_VenomEff[1] = GetLastCreatedEffectBJ()
    set udg_Hero_DeC_VenomEffCounter = 2
endfunction

