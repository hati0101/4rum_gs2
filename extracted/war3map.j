//===========================================================================
function Trig_Hole_of_Abyss_Func003C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A07W' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0P0' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Hole_of_Abyss_Conditions takes nothing returns boolean
    if ( not Trig_Hole_of_Abyss_Func003C() ) then
        return false
    endif
    return true
endfunction

function Trig_Hole_of_Abyss_Func001C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R07E', GetOwningPlayer(GetSpellAbilityUnit())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hole_of_Abyss_Func002C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A07W' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hole_of_Abyss_Func004C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0P0' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hole_of_Abyss_Actions takes nothing returns nothing
    if ( Trig_Hole_of_Abyss_Func001C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetSpellAbilityUnit()), GetUnitLoc(GetSpellAbilityUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( ( 4.00 + ( 1 * I2R(GetUnitAbilityLevelSwapped('A0PC', GetSpellAbilityUnit())) ) ), 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'S00B', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'S00B', GetLastCreatedUnit(), 2 )
    else
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetSpellAbilityUnit()), GetUnitLoc(GetSpellAbilityUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( ( 4.00 + ( 1 * I2R(GetUnitAbilityLevelSwapped('A0PC', GetSpellAbilityUnit())) ) ), 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'S00B', GetLastCreatedUnit() )
    endif
    if ( Trig_Hole_of_Abyss_Func002C() ) then
        set udg_Hero_DaT = GetTriggerUnit()
        call StartTimerBJ( udg_Hero_DaT_UltiTimer, false, 110.00 )
    else
    endif
    if ( Trig_Hole_of_Abyss_Func004C() ) then
        call PlaySoundBJ( gg_snd_DaT_Ulti )
        call CreateNUnitsAtLoc( 1, 'e000', GetOwningPlayer(GetSpellAbilityUnit()), GetSpellTargetLoc(), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( ( 4.00 + ( 1 * I2R(GetUnitAbilityLevelSwapped('A0PC', GetSpellAbilityUnit())) ) ), 'BTLF', GetLastCreatedUnit() )
    else
    endif
endfunction

