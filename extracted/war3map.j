//===========================================================================
// Trigger: GoT Special 3
//
// set chance = ( ( 20 - ( GetPlayerTechCountSimple('R07I', GetOwningPlayer(GetSpellAbilityUnit())) * 15 ) )
// set chance = ( ( 45 - ( GetUnitAbilityLevelSwapped('A0NU', GetSpellAbilityUnit()) * 5 ) ) - ( GetPlayerTechCountSimple('R07I', GetOwningPlayer(GetSpellAbilityUnit())) * 10 ) )
//===========================================================================
function Trig_GoT_Special_3_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0NU' ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R07H', GetTriggerPlayer()) == 1 ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetSpellTargetUnit()) <= ( 210.00 + ( 40.00 * I2R(GetUnitAbilityLevelSwapped('A0NU', GetSpellAbilityUnit())) ) ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_GoT_Special_3_Actions takes nothing returns nothing
    local integer rand = GetRandomInt(1, 100)
    local integer chance
    local unit t = GetSpellTargetUnit()
    local lightning l
    set chance = ( 25 - ( GetPlayerTechCountSimple('R07I', GetOwningPlayer(GetSpellAbilityUnit())) * 25 ) )
     
    if ( rand > chance ) then
    call AbsoluteDamage(GetTriggerUnit(),t, 99999)
    call TextTag( "즉사광선!" , GetSpellTargetUnit() , 10 , 255 , 255 , 150 ,3)
    call AddSpecialEffectTargetUnitBJ( "origin", GetSpellTargetUnit(), "Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl" )
    call d_effect(GetLastCreatedEffectBJ(),2)
    call AddLightningLoc( "AFOD", GetUnitLoc(GetTriggerUnit()), GetUnitLoc(GetSpellTargetUnit()) )
    set l = bj_lastCreatedLightning
    call PolledWait( 0.30 )
    call DestroyLightning(l)
    else
    call CreateNUnitsAtLoc( 1, 'e00Q', GetOwningPlayer(GetSpellTargetUnit()), GetUnitLoc(GetSpellTargetUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0NR', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0NR', GetSpellAbilityUnit(), GetUnitAbilityLevelSwapped('A0NU', GetSpellAbilityUnit()) )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "chainlightning", GetSpellAbilityUnit() )
    call TextTag( "오류:0x002" , GetSpellTargetUnit() , 10 , 255 , 255 , 150 ,3)
    endif
endfunction

