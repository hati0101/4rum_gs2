    call CreateNUnitsAtLoc( 1, 'e015', GetOwningPlayer(udg_Hero_DeM), GetUnitLoc(udg_Hero_DeM_UltiTarget), 72.00 )
    call UnitApplyTimedLifeBJ( 0.50, 'BTLF', GetLastCreatedUnit() )
    call UnitDamageTargetBJ( udg_Hero_DeM, udg_Hero_DeM_UltiTarget, ( 100.00 + I2R(( 100 * GetUnitAbilityLevelSwapped('A0T1', udg_Hero_DeM) )) ), ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
    call UnitDamageTargetBJ( udg_Hero_DeM, udg_Hero_DeM_UltiTarget, ( 125.00 + I2R(( 125 * GetUnitAbilityLevelSwapped('A0T1', udg_Hero_DeM) )) ), ATTACK_TYPE_HERO, DAMAGE_TYPE_UNIVERSAL )
    if Damage>0 then
        call UnitDamageTargetBJ( Caster, Target, ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, udg_Hero_DeM_UltiTarget) * 0.02 * R2I(Damage) ), ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
        call UnitDamageTargetBJ( Caster, Target, ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, udg_Hero_DeM_UltiTarget) * 0.02 * R2I(Damage) ), ATTACK_TYPE_HERO, DAMAGE_TYPE_UNIVERSAL )
    endif
