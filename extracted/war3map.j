    set gg_trg_Pick_Blader = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Pick_Blader, EVENT_PLAYER_HERO_LEVEL )
    call TriggerAddCondition( gg_trg_Pick_Blader, Condition( function Trig_Pick_Blader_Conditions ) )
    call TriggerAddAction( gg_trg_Pick_Blader, function Trig_Pick_Blader_Actions )
