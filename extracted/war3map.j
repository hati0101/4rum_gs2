        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not Trig_Battle_Franzy_Func007C() ) then
        return false
    endif
    return true
