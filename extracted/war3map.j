    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B08T') == true ) ) then
        return false
    endif
    if ( not ( GetEventDamage() > 0.05 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rune_of_Resist_Attacked_Func002C takes nothing returns boolean
    if ( not ( udg_Hero_StG_RoRCnt <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rune_of_Resist_Attacked_Actions takes nothing returns nothing
    set udg_Hero_StG_RoRCnt = ( udg_Hero_StG_RoRCnt - 1 )
    if ( Trig_Rune_of_Resist_Attacked_Func002C() ) then
        call UnitRemoveBuffBJ( 'B08T', GetTriggerUnit() )
        return
    else
    endif
    call CreateNUnitsAtLoc( 1, 'e00Q', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0F4', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0F4', GetLastCreatedUnit(), udg_Hero_StG_RoRCnt )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "innerfire", GetTriggerUnit() )
endfunction

