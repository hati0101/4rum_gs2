    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'nftk' ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEventDamageSource(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_DamageTaken_Func010Func006Func001Func001001002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == true )
endfunction

function Trig_DamageTaken_Func010Func006Func001Func001A takes nothing returns nothing
    call CreateNUnitsAtLocFacingLocBJ( 1, 'e003', udg_Force[1], GetUnitLoc(GetEnumUnit()), GetRectCenter(GetPlayableMapRect()) )
    call UnitApplyTimedLifeBJ( 10.00, 'BTLF', GetLastCreatedUnit() )
    call MakeUnitFollow(GetLastCreatedUnit(), GetEnumUnit(), 30)
endfunction

