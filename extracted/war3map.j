    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Battle_Reflex_Lost_Actions takes nothing returns nothing
    call StartTimerBJ( udg_Hero_DrR_ReflexTimer[2], false, 4.00 )
    call PauseTimerBJ( true, udg_Hero_DrR_ReflexTimer[1] )
    call PolledWait( 4.00 )
    if ( Trig_Battle_Reflex_Lost_Func007C() ) then
        set udg_Hero_DrR_ReflexCount = 0
        call SetUnitAbilityLevelSwapped( 'A14A', udg_Hero_DrR, 1 )
        call SetUnitAbilityLevelSwapped( 'A12J', udg_Hero_DrR, 1 )
        call StartTimerBJ( udg_Hero_DrR_ReflexTimer[1], false, 10.00 )
    else
    endif
endfunction

