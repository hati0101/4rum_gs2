    if ( Trig_Inq_Skill_Effect_Func001C() ) then
        call CreateNUnitsAtLoc( 1, 'e00Q', GetOwningPlayer(GetSpellAbilityUnit()), GetSpellTargetLoc(), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 8.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0M5', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0M5', GetLastCreatedUnit(), ( ( GetPlayerTechCountSimple('R07G', GetOwningPlayer(udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))])) * 4 ) + GetUnitAbilityLevelSwapped('A0M8', udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]) ) )
        call IssuePointOrderLocBJ( GetLastCreatedUnit(), "rainoffire", GetUnitLoc(GetLastCreatedUnit()) )
    else
    endif
    if ( Trig_Inq_Skill_Effect_Func002C() ) then
        if ( Trig_Inq_Skill_Effect_Func002Func001C() ) then
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetSpellAbilityUnit()), GetSpellTargetLoc(), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A0AQ', GetLastCreatedUnit() )
            call SetUnitAbilityLevelSwapped( 'A0AQ', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0LV', GetSpellAbilityUnit()) )
            call IssueTargetOrderBJ( GetLastCreatedUnit(), "bloodlust", GetSpellTargetUnit() )
        else
        endif
        if ( Trig_Inq_Skill_Effect_Func002Func002C() ) then
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetSpellAbilityUnit()), GetSpellTargetLoc(), bj_UNIT_FACING )
