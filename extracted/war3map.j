    if ( not ( GetSpellAbilityId() == 'A0ZS' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hell_Start_Actions takes nothing returns nothing
    call PlaySoundBJ( gg_snd_Volcrize )
    call CreateNUnitsAtLoc( 1, 'e008', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 10.00, AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), udg_Hero_LOI_Loca)), AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), udg_Hero_LOI_Loca) )
    set udg_Hero_LOI_Unit = GetLastCreatedUnit()
    set udg_Hero_LOI_UltiIN_1 = 0
    set udg_Hero_LOI_UltiIN_2 = 1
    set udg_Hero_LOI_Limit = 0
    call UnitApplyTimedLifeBJ( 3.50, 'BTLF', GetLastCreatedUnit() )
    call TriggerRegisterUnitInRangeSimple( gg_trg_Hell_Explode, 100.00, GetLastCreatedUnit() )
    call EnableTrigger( gg_trg_Hell_Moving )
    call EnableTrigger( gg_trg_Hell_Explode )
endfunction

