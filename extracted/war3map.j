//===========================================================================
// Trigger: Pack Horse Give
//===========================================================================
function Trig_Pack_Horse_Give_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0ZW' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pack_Horse_Give_Actions takes nothing returns nothing
    local unit horse = GetTriggerUnit()
    local unit hero = GetSpellTargetUnit()
    local integer a = 0
    loop
    exitwhen a > 6
    if ( UnitInventoryCount(hero) == 6 ) then
        set udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(hero))] = UnitItemInSlotBJ(horse, a)
        call SetItemLifeBJ( udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(hero))], 500.00 )
        call SetItemUserData( udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(hero))], R2I(GetItemLifeBJ(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(hero))])) )
        set udg_PackHorseT = hero
    call TriggerExecute( gg_trg_Pack_Horse_Give_Mix )
    else
        call UnitAddItemSwapped( UnitItemInSlotBJ(horse, a), hero )
    endif
    set a = a+1
    endloop
    // 본진으로 귀환
    if IsUnitAlly(horse, udg_Force[1]) then
        call IssuePointOrderLocBJ( horse, "move", GetRectCenter(gg_rct_G_Home) )
    else
        call IssuePointOrderLocBJ( horse, "move", GetRectCenter(gg_rct_D_Home) )
    endif
endfunction

//===========================================================================
function InitTrig_Pack_Horse_Give takes nothing returns nothing
    set gg_trg_Pack_Horse_Give = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Pack_Horse_Give, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Pack_Horse_Give, Condition( function Trig_Pack_Horse_Give_Conditions ) )
    call TriggerAddAction( gg_trg_Pack_Horse_Give, function Trig_Pack_Horse_Give_Actions )
endfunction

//===========================================================================
// Trigger: Pack Horse Give Mix
//===========================================================================
function Trig_Pack_Horse_Give_Mix_Actions takes nothing returns nothing
    local unit t = udg_PackHorseT
    local integer a=0
    loop
    exitwhen a>6
    call SetItemLifeBJ( UnitItemInSlotBJ(t, a), 500.00 )
    call SetItemUserData( UnitItemInSlotBJ(t, a), R2I(GetItemLifeBJ(UnitItemInSlotBJ(t, a))) )
    set a = a+1
    endloop
    set a = 0
    call ItemMix(188, t)
    call ItemMix(189, t)
    if StringLength(udg_ItemMix_DB[GetItemUserData(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(t))])]) > 0 then
    call ItemMix(GetItemUserData(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(t))]), t)
    endif
    loop
    exitwhen a>6
    if StringLength(udg_ItemMix_DB[GetItemUserData(UnitItemInSlotBJ(t, a))]) > 0 then
    call ItemMix(GetItemUserData(UnitItemInSlotBJ(t, a)), t)
    endif
    set a = a+1
    endloop
endfunction

