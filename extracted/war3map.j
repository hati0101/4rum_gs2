//===========================================================================
function Trig_Curruption_Arrow_Conditions takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B02H') == true ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEventDamageSource()) == 'Usyl' ) ) then
        return false
    endif
    if ( not ( GetEventDamage() > 1.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Curruption_Arrow_Func004C takes nothing returns boolean
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) >= ( 5.00 * I2R(GetUnitAbilityLevelSwapped('A149', GetEventDamageSource())) ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Curruption_Arrow_Actions takes nothing returns nothing
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetEventDamageSource()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitDamageTarget(GetLastCreatedUnit(), GetTriggerUnit(),( 10.00 * I2R(GetUnitAbilityLevelSwapped('A149', GetEventDamageSource())) ),false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,null)
    if ( Trig_Curruption_Arrow_Func004C() ) then
        call UnitRemoveBuffBJ( 'B02H', GetTriggerUnit() )
        call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) - ( 5.00 * I2R(GetUnitAbilityLevelSwapped('A149', GetEventDamageSource())) ) ) )
        call SetUnitManaBJ( GetEventDamageSource(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetEventDamageSource()) + ( 5.00 * I2R(GetUnitAbilityLevelSwapped('A149', GetEventDamageSource())) ) ) )
        call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "Abilities\\Spells\\Human\\Feedback\\ArcaneTowerAttack.mdl" )
        call d_effect(GetLastCreatedEffectBJ(),1)
