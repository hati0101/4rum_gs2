// 다리 절단
//===========================================================================
function Trig_RoC_AtkDmg_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEventDamageSource()) == 'Ocb2' ) ) then
        return false
    endif
    if ( not ( GetTriggerUnit() == udg_Hero_RoC_AtkTgt ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A0GV', udg_Hero_RoC) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_RoC_AtkDmg_Func001C takes nothing returns boolean
    if ( not ( udg_Hero_RoC_Int >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_RoC_AtkDmg_Func002C takes nothing returns boolean
    if ( not ( udg_Hero_RoC_Atkint == ( 1 + ( GetPlayerTechCountSimple('R09I', GetOwningPlayer(GetEventDamageSource())) * 1 ) ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_RoC_AtkDmg_Func003Func002001003 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Hero_RoC)) == true )
endfunction

function Trig_RoC_AtkDmg_Func003Func002A takes nothing returns nothing
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetEventDamageSource()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
    call UnitDamageTargetBJ( GetLastCreatedUnit(), GetEnumUnit(), ( 10.00 + ( 10.00 * I2R(GetUnitAbilityLevelSwapped('A0GV', udg_Hero_RoC)) ) ), ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL )
    call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "Objects\\Spawnmodels\\Critters\\Albatross\\CritterBloodAlbatross.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
endfunction

function Trig_RoC_AtkDmg_Func003C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R09F', GetOwningPlayer(GetEventDamageSource())) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_RoC_AtkDmg_Actions takes nothing returns nothing
    if ( Trig_RoC_AtkDmg_Func001C() ) then
        set udg_Hero_RoC_Atkint = ( udg_Hero_RoC_Atkint + 1 )
    else
    endif
    if ( Trig_RoC_AtkDmg_Func002C() ) then
        set udg_Hero_RoC_AtkTgt = null
        set udg_Hero_RoC_real = 0.00
        set udg_Hero_RoC_Int = 0
        set udg_Hero_RoC_Atkint = 0
        call SetUnitAbilityLevelSwapped( 'A0KP', udg_Hero_RoC, 1 )
    else
    endif
    if ( Trig_RoC_AtkDmg_Func003C() ) then
        set bj_wantDestroyGroup=true
        call ForGroupBJ( GetUnitsInRangeOfLocMatching(200.00, GetUnitLoc(GetEventDamageSource()), Condition(function Trig_RoC_AtkDmg_Func003Func002001003)), function Trig_RoC_AtkDmg_Func003Func002A )
    else
    endif
endfunction

//===========================================================================
function InitTrig_RoC_AtkDmg takes nothing returns nothing
    set gg_trg_RoC_AtkDmg = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_RoC_AtkDmg, Condition( function Trig_RoC_AtkDmg_Conditions ) )
    call TriggerAddAction( gg_trg_RoC_AtkDmg, function Trig_RoC_AtkDmg_Actions )
endfunction

