//===========================================================================
// Trigger: Vendetta
//===========================================================================
function Trig_Vendetta_Func014C takes nothing returns boolean
    if ( ( UnitHasBuffBJ(udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))], 'B05W') == true ) ) then
        return true
    endif
    if ( ( UnitHasBuffBJ(GetKillingUnitBJ(), 'B05W') == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_Vendetta_Conditions takes nothing returns boolean
    if ( not ( IsPlayerEnemy(GetOwningPlayer(GetKillingUnitBJ()), GetOwningPlayer(udg_Hero_AbW)) == true ) ) then
        return false
    endif
    if ( not ( IsPlayerEnemy(GetOwningPlayer(GetKillingUnitBJ()), GetOwningPlayer(GetDyingUnit())) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_GROUND) == true ) ) then
        return false
    endif
    if ( not Trig_Vendetta_Func014C() ) then
        return false
    endif
    return true
endfunction

function Trig_Vendetta_Func003C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))], 'B05W') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Vendetta_Func009C takes nothing returns boolean
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Vendetta_Actions takes nothing returns nothing
    local unit killer
    local unit wisp
    if ( Trig_Vendetta_Func003C() ) then
        set killer = udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]
    else
        set killer = GetKillingUnitBJ()
    endif
    call UnitRemoveBuffBJ( 'B05W', killer )
    call CreateNUnitsAtLoc( 1, 'e02I', GetOwningPlayer(udg_Hero_AbW), GetUnitLoc(udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]), bj_UNIT_FACING )
    set wisp = GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0KS', GetLastCreatedUnit() )
    if ( Trig_Vendetta_Func009C() ) then
        call SetUnitAbilityLevelSwapped( 'A0KS', GetLastCreatedUnit(), ( ( 8 + GetUnitAbilityLevelSwapped('A0KO', udg_Hero_AbW) ) + ( GetPlayerTechCountSimple('R06O', GetOwningPlayer(GetLastCreatedUnit())) * 4 ) ) )
    else
        call SetUnitAbilityLevelSwapped( 'A0KS', GetLastCreatedUnit(), ( GetUnitAbilityLevelSwapped('A0KO', udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetLastCreatedUnit()))]) + ( GetPlayerTechCountSimple('R06O', GetOwningPlayer(GetLastCreatedUnit())) * 4 ) ) )
    endif
    call IssueTargetOrderBJ( wisp, "frostnova", killer )
endfunction

