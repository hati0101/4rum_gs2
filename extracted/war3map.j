//===========================================================================
// Trigger: Des Special 3 Wake
//===========================================================================
function Trig_Des_Special_3_Wake_Actions takes nothing returns nothing
    local integer randmsg = GetRandomInt( 1 , 2 )
    if ( randmsg == 1 ) then
    call TextTag( "훼이크다 이 병신들아!" , udg_Hero_Des , 10 , 255 , 255 , 255, 3 )
    elseif ( randmsg == 2 ) then
    call TextTag( "You just activated my trap card" , udg_Hero_Des , 10 , 255 , 255 , 255, 3 )
    endif
    call PauseUnitBJ( false, udg_Hero_Des )
    call SetUnitInvulnerable( udg_Hero_Des, false )
    call SetUnitTimeScalePercent( udg_Hero_Des, 100.00 )
    call ResetUnitAnimation( udg_Hero_Des )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(udg_Hero_Des), GetUnitLoc(udg_Hero_Des), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A14K', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A14K', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0PY', udg_Hero_Des) )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "bloodlust", udg_Hero_Des )
    call PolledWait( 20.00 )
    call EnableTrigger( gg_trg_Des_Special_3_HP )
endfunction

//===========================================================================
function InitTrig_Des_Special_3_Wake takes nothing returns nothing
    set gg_trg_Des_Special_3_Wake = CreateTrigger(  )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Des_Special_3_Wake, udg_Hero_Des_Sp3Timer )
    call TriggerAddAction( gg_trg_Des_Special_3_Wake, function Trig_Des_Special_3_Wake_Actions )
endfunction

