    set gg_trg_ChainBoom_Start = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_ChainBoom_Start, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_ChainBoom_Start, Condition( function Trig_ChainBoom_Start_Conditions ) )
