    if ( not ( GetPlayerTechCountSimple('R02J', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A0UL', GetTriggerUnit()) == 0 ) ) then
        return false
    endif
    return true
endfunction

