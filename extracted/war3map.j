//===========================================================================
// Trigger: Battle Reflex Get
//===========================================================================
function Trig_Battle_Reflex_Get_Func002Func003C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R09A', GetOwningPlayer(udg_Hero_DrR)) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Battle_Reflex_Get_Func002C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_Hero_DrR) == 'Opgh' ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Hero_DrR) == true ) ) then
        return false
    endif
    if ( not ( udg_Hero_DrR_ReflexCount < 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Battle_Reflex_Get_Actions takes nothing returns nothing
    call StartTimerBJ( udg_Hero_DrR_ReflexTimer[1], false, 3.00 )
    if ( Trig_Battle_Reflex_Get_Func002C() ) then
        set udg_Hero_DrR_ReflexCount = IMinBJ(( udg_Hero_DrR_ReflexCount + 1 ), 4)
        call SetUnitAbilityLevelSwapped( 'A14A', udg_Hero_DrR, ( ( ( GetUnitAbilityLevelSwapped('A0FR', udg_Hero_DrR) - 1 ) * 4 ) + ( udg_Hero_DrR_ReflexCount + 1 ) ) )
        if ( Trig_Battle_Reflex_Get_Func002Func003C() ) then
            call IncUnitAbilityLevelSwapped( 'A12J', udg_Hero_DrR )
        else
        endif
    else
    endif
endfunction

