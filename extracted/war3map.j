    if ( Trig_Blessing_Of_The_Moon_Func001C() ) then
    else
        if ( Trig_Blessing_Of_The_Moon_Func001Func001C() ) then
            set udg_Hero_DaW_Loc[1] = GetUnitLoc(GetSpellTargetUnit())
