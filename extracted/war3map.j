    endif
    return true
endfunction

function Trig_DiK_Special_Func002Func003Func001Func006C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R00L', GetTriggerPlayer()) == 1 ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_DiK_HLTgt) >= ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, udg_Hero_DiK_HLTgt) * 0.50 ) ) ) then
        return false
    endif
    return true
endfunction

