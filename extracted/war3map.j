function Trig_BlK_Learn_Func003C takes nothing returns boolean
    if ( ( GetLearnedSkillBJ() == 'A0BO' ) ) then
        return true
    endif
    if ( ( GetLearnedSkillBJ() == 'A0NP' ) ) then
        return true
    endif
