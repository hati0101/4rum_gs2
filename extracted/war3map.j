//===========================================================================
function Trig_Mode_AP_Conditions takes nothing returns boolean
    if ( not ( TimerGetElapsed(udg_MBTime) <= 14.00 ) ) then
        return false
    endif
    if ( not ( udg_ModeAllpick == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mode_AP_Actions takes nothing returns nothing
    set udg_ModeAllpick = true
    call PlaySoundBJ( gg_snd_GoodJob )
    call DisplayTimedTextToForce( GetPlayersAll(), 30, "TRIGSTR_1503" )
    call PingMinimapLocForForceEx( GetPlayersAll(), GetRectCenter(gg_rct_G_Select), 12.00, bj_MINIMAPPINGSTYLE_FLASHY, 100, 100, 100 )
    call PingMinimapLocForForceEx( GetPlayersAll(), GetRectCenter(gg_rct_D_Select), 12.00, bj_MINIMAPPINGSTYLE_FLASHY, 100, 100, 100 )
    call SetUnitOwner( gg_unit_n015_0040, Player(PLAYER_NEUTRAL_PASSIVE), true )
    call SetUnitOwner( gg_unit_n016_0041, Player(PLAYER_NEUTRAL_PASSIVE), true )
    call SetUnitOwner( gg_unit_n017_0088, Player(PLAYER_NEUTRAL_PASSIVE), true )
    call SetUnitOwner( gg_unit_n019_0090, Player(PLAYER_NEUTRAL_PASSIVE), true )
    call SetUnitOwner( gg_unit_n018_0091, Player(PLAYER_NEUTRAL_PASSIVE), true )
    call SetUnitOwner( gg_unit_n01A_0089, Player(PLAYER_NEUTRAL_PASSIVE), true )
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc( 1, 'e003', ConvertedPlayer(GetForLoopIndexA()), GetRectCenter(gg_rct_D_Select), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 120.00, 'BTLF', GetLastCreatedUnit() )
        call CreateNUnitsAtLoc( 1, 'e003', ConvertedPlayer(GetForLoopIndexA()), GetRectCenter(gg_rct_G_Select), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 120.00, 'BTLF', GetLastCreatedUnit() )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

