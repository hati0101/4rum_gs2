    set gg_trg_Vampires_Lord_Special_4_On = CreateTrigger(  )
    call TriggerRegisterGameStateEventTimeOfDay( gg_trg_Vampires_Lord_Special_4_On, EQUAL, 18.00 )
    call TriggerAddAction( gg_trg_Vampires_Lord_Special_4_On, function Trig_Vampires_Lord_Special_4_On_Actions )
