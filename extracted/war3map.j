function Trig_AnT_Skill_Effect_Actions takes nothing returns nothing
    local unit a = GetTriggerUnit()
    if ( Trig_AnT_Skill_Effect_Func002C() ) then
        set udg_Hero_AnT_Loc = GetUnitLoc(GetTriggerUnit())
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetSpellAbilityUnit()), udg_Hero_AnT_Loc, bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0L7', GetLastCreatedUnit() )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "doom", GetSpellTargetUnit() )
        call RemoveLocation( udg_Hero_AnT_Loc )
    else
    endif
    if ( Trig_AnT_Skill_Effect_Func003C() ) then
        call PlaySoundBJ( gg_snd_AnT_Ulti )
        set bj_wantDestroyGroup=true
        call ForGroupBJ( GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_AnT_Skill_Effect_Func003Func003001002)), function Trig_AnT_Skill_Effect_Func003Func003A )
    else
    endif
    if ( Trig_AnT_Skill_Effect_Func004C() ) then
        set udg_Hero_AnT_Loc = GetUnitLoc(GetTriggerUnit())
        call CreateNUnitsAtLoc( 1, 'e03B', GetOwningPlayer(GetTriggerUnit()), udg_Hero_AnT_Loc, bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 3.50, 'BTLF', GetLastCreatedUnit() )
        call RemoveLocation( udg_Hero_AnT_Loc )
    else
    endif
    if ( Trig_AnT_Skill_Effect_Func005C() ) then
        call TriggerSleepAction( 1.50 )
        call SetUnitAbilityLevelSwapped( 'A0W0', a, ( GetUnitAbilityLevelSwapped('A0RW', a) + 1 ) )
    else
    endif
endfunction

