    return ( udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetFilterUnit()))] > 0 )
endfunction

function Trig_Time_of_Death_Func007001003002 takes nothing returns boolean
    return GetBooleanAnd( Trig_Time_of_Death_Func007001003002001(), Trig_Time_of_Death_Func007001003002002() )
endfunction

function Trig_Time_of_Death_Func007001003 takes nothing returns boolean
    return GetBooleanAnd( Trig_Time_of_Death_Func007001003001(), Trig_Time_of_Death_Func007001003002() )
endfunction

function Trig_Time_of_Death_Func007Func001Func001C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R017', GetOwningPlayer(udg_Hero_ChW)) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Time_of_Death_Func007Func001C takes nothing returns boolean
    if ( not ( udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetEnumUnit()))] > 12 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Time_of_Death_Func007A takes nothing returns nothing
    if ( Trig_Time_of_Death_Func007Func001C() ) then
        if ( Trig_Time_of_Death_Func007Func001Func001C() ) then
            set udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetEnumUnit()))] = 15
        else
            set udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetEnumUnit()))] = 12
        endif
    else
    endif
    call CreateNUnitsAtLoc( 1, 'e00G', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetEnumUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 5.00, 'BTLF', GetLastCreatedUnit() )
    call UnitDamageTargetBJ( udg_Hero_ChW, GetEnumUnit(), ( 25.00 + I2R(( GetUnitAbilityLevelSwapped('A11L', udg_Hero_ChW) * 75 )) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call GroupAddUnitSimple( GetEnumUnit(), udg_Hero_ChW_UltiGroup )
    call CreateTextTagLocBJ( ( I2S(( 25 + ( GetUnitAbilityLevelSwapped('A11L', udg_Hero_ChW) * 75 ) )) + "!" ), GetUnitLoc(GetEnumUnit()), 0, 13.00, 100.00, 20.00, 60.00, 0 )
    call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
    call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 1.30 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 65.00, 90 )
    call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "war3mapImported\\DarkDoomTarget.mdx" )
    call SaveEffectHandleBJ( GetLastCreatedEffectBJ(), GetHandleIdBJ(GetEnumUnit()), StringHashBJ("SepiUltiEff"), GetLastCreatedHashtableBJ() )
endfunction

function Trig_Time_of_Death_Actions takes nothing returns nothing
    call PlaySoundBJ( gg_snd_CwUlti )
    set udg_Hero_ChW_UltiPoint = GetSpellTargetLoc()
    set udg_Hero_ChW_UltiDmg = ( 9 + ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) * 3 ) )
    set udg_Hero_ChW_UltiCount = 0
    call StartTimerBJ( udg_Hero_ChW_UltiTimer, false, 1.00 )
    call ForGroupBJ( udg_Hero_ChW_UltiGroup, function Trig_Time_of_Death_Func006A )
    call ForGroupBJ( GetUnitsInRangeOfLocMatching(( 200.00 + ( 150.00 * I2R(GetUnitAbilityLevelSwapped('A11L', GetTriggerUnit())) ) ), udg_Hero_ChW_UltiPoint, Condition(function Trig_Time_of_Death_Func007001003)), function Trig_Time_of_Death_Func007A )
endfunction

