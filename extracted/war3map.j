        set udg_Hero_Gla_BFLevel = IMinBJ(( 2 + ( 2 * GetUnitAbilityLevelSwapped('A0AR', GetAttacker()) ) ), ( udg_Hero_Gla_BFLevel + 1 ))
    endif
    call StartTimerBJ( udg_Hero_Gla_BFTimer, false, 0.10 )
    call DisableTrigger( GetTriggeringTrigger() )
    call TriggerSleepAction( 0.30 )
