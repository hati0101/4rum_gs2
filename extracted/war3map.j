//===========================================================================
// Trigger: New Creep Timer
//===========================================================================
function Trig_New_Creep_Timer_Conditions takes nothing returns boolean
    if ( not ( GetPlayerController(GetOwningPlayer(GetTriggerUnit())) == MAP_CONTROL_CREEP ) ) then
        return false
    endif
    return true
endfunction

function Trig_New_Creep_Timer_Func002Func001Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(udg_Creep_Group[GetForLoopIndexA()]) <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_New_Creep_Timer_Func002Func001C takes nothing returns boolean
    if ( not ( IsUnitInGroup(GetTriggerUnit(), udg_Creep_Group[GetForLoopIndexA()]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_New_Creep_Timer_Actions takes nothing returns nothing
    set bj_forLoopAIndex = 0
    set bj_forLoopAIndexEnd = 11
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_New_Creep_Timer_Func002Func001C() ) then
            call GroupRemoveUnitSimple( GetTriggerUnit(), udg_Creep_Group[GetForLoopIndexA()] )
            if ( Trig_New_Creep_Timer_Func002Func001Func002C() ) then
                call StartTimerBJ( udg_Creep_Timer[GetForLoopIndexA()], false, udg_Creep_R_Timer )
            else
            endif
            return
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_New_Creep_Timer takes nothing returns nothing
    set gg_trg_New_Creep_Timer = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_New_Creep_Timer, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_New_Creep_Timer, Condition( function Trig_New_Creep_Timer_Conditions ) )
    call TriggerAddAction( gg_trg_New_Creep_Timer, function Trig_New_Creep_Timer_Actions )
endfunction

//===========================================================================
// Trigger: Creep Spawn
//
// 크립의 타입을 설정하고 싶다면
// Set Variable Creep 이라는 트리거를 찾아가기 바람.
// 900
// 1500
// 2100
// 2700
//===========================================================================
function Trig_Creep_Spawn_Actions takes nothing returns nothing
    local integer nCreepLv
    local integer nRand
    local unit u

    loop
        set nRand = GetRandomInt( 1, udg_Creep_DiceMax ) + udg_Creep_DiceBonus
        exitwhen ( nRand <= 233 )
    endloop

    call GroupClear( udg_Creep_Group[udg_Creep_Number] )
    if ( nRand <= 50 ) then
    set nCreepLv = 1
    elseif ( nRand <= 85 ) then
    set nCreepLv = 2
    elseif ( nRand <= 120) then
    set nCreepLv = 3
    elseif ( nRand <= 145 ) then
    set nCreepLv = 4
    elseif ( nRand <= 165 ) then
    set nCreepLv = 5
    elseif ( nRand <= 185 ) then
    set nCreepLv = 6
    elseif ( nRand <= 200 ) then
    set nCreepLv = 7
    elseif ( nRand <= 210 ) then
    set nCreepLv = 8
    elseif ( nRand <= 220 ) then
    set nCreepLv = 9
    elseif ( nRand <= 226 ) then
    set nCreepLv = 10
    elseif ( nRand <= 230 ) then
    set nCreepLv = 11
    elseif ( nRand <= 233 ) then
    set nCreepLv = 12
    endif

    set nCreepLv = ( ( nCreepLv - 1 ) * 5 )
    if ( udg_Creep_Type[nCreepLv] != 0 ) then
    call CreateNUnitsAtLoc( 1, udg_Creep_Type[nCreepLv], Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRectCenter(udg_Creep_SpawnZone[udg_Creep_Number]), bj_UNIT_FACING )
    call GroupAddUnitSimple( GetLastCreatedUnit(), udg_Creep_Group[udg_Creep_Number] )
    set u = GetLastCreatedUnit()
    call SetUnitUserData( u, udg_Creep_Number )
    endif
    if ( udg_Creep_Type[nCreepLv+1] != 0 ) then
    call CreateNUnitsAtLoc( 1, udg_Creep_Type[nCreepLv+1], Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRectCenter(udg_Creep_SpawnZone[udg_Creep_Number]), bj_UNIT_FACING )
    call GroupAddUnitSimple( GetLastCreatedUnit(), udg_Creep_Group[udg_Creep_Number] )
    set u = GetLastCreatedUnit()
    call SetUnitUserData( u, udg_Creep_Number )
    endif
    if ( udg_Creep_Type[nCreepLv+2] != 0 ) then
    call CreateNUnitsAtLoc( 1, udg_Creep_Type[nCreepLv+2], Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRectCenter(udg_Creep_SpawnZone[udg_Creep_Number]), bj_UNIT_FACING )
    call GroupAddUnitSimple( GetLastCreatedUnit(), udg_Creep_Group[udg_Creep_Number] )
    set u = GetLastCreatedUnit()
    call SetUnitUserData( u, udg_Creep_Number )
    endif
    if ( udg_Creep_Type[nCreepLv+3] != 0 ) then
    call CreateNUnitsAtLoc( 1, udg_Creep_Type[nCreepLv+3], Player(PLAYER_NEUTRAL_AGGRESSIVE), GetRectCenter(udg_Creep_SpawnZone[udg_Creep_Number]), bj_UNIT_FACING )
    call GroupAddUnitSimple( GetLastCreatedUnit(), udg_Creep_Group[udg_Creep_Number] )
    set u = GetLastCreatedUnit()
    call SetUnitUserData( u, udg_Creep_Number )
    endif

//// Named Creep Check Procedure ///////////////////////////////////////////////////////////////////////////////////
    if ( TimerGetElapsed(udg_MBTime) >= 900.00 ) then
        if ( udg_Creep_NamedCheck[1] == true ) then
        if ( udg_Creep_Type[nCreepLv+4] != 0 ) then
            set udg_Creep_NamedCheck[1] = false
            set udg_Creep_NamedCheck[2] = true
            call ReplaceUnitBJ( u, udg_Creep_Type[nCreepLv+4], bj_UNIT_STATE_METHOD_RELATIVE )
            set udg_Creep_Type[nCreepLv+4] = 0
            call GroupAddUnitSimple( GetLastReplacedUnitBJ(), udg_Creep_Group[udg_Creep_Number] )
            call SetUnitUserData( GetLastReplacedUnitBJ(), udg_Creep_Number )
            call PingMinimapLocForForce( GetPlayersAll(), GetUnitLoc(GetLastReplacedUnitBJ()), 5.00 )
            call PlaySoundBJ( gg_snd_QuestNew )
            call DisplayTextToForce( GetPlayersAll(), "|cffffcc00네임드|r 등장!" )
        endif
        endif
    endif
    if ( TimerGetElapsed(udg_MBTime) >= 1500.00 ) then
        if ( udg_Creep_NamedCheck[2] == true ) then
        if ( udg_Creep_Type[nCreepLv+4] != 0 ) then
            set udg_Creep_NamedCheck[2] = false
            set udg_Creep_NamedCheck[3] = true
            call ReplaceUnitBJ( u, udg_Creep_Type[nCreepLv+4], bj_UNIT_STATE_METHOD_RELATIVE )
            set udg_Creep_Type[nCreepLv+4] = 0
            call GroupAddUnitSimple( GetLastReplacedUnitBJ(), udg_Creep_Group[udg_Creep_Number] )
            call SetUnitUserData( GetLastReplacedUnitBJ(), udg_Creep_Number )
            call PingMinimapLocForForce( GetPlayersAll(), GetUnitLoc(GetLastReplacedUnitBJ()), 5.00 )
            call PlaySoundBJ( gg_snd_QuestNew )
            call SetPlayerTechResearchedSwap( 'R05U', 1, Player(PLAYER_NEUTRAL_AGGRESSIVE) )
            call DisplayTextToForce( GetPlayersAll(), "|cffffcc00네임드|r 등장!" )
        endif
        endif
    endif
    if ( TimerGetElapsed(udg_MBTime) >= 2100.00 ) then
        if ( udg_Creep_NamedCheck[3] == true ) then
        if ( udg_Creep_Type[nCreepLv+4] != 0 ) then
            set udg_Creep_NamedCheck[3] = false
            set udg_Creep_NamedCheck[4] = true
            call ReplaceUnitBJ( u, udg_Creep_Type[nCreepLv+4], bj_UNIT_STATE_METHOD_RELATIVE )
            set udg_Creep_Type[nCreepLv+4] = 0
            call GroupAddUnitSimple( GetLastReplacedUnitBJ(), udg_Creep_Group[udg_Creep_Number] )
            call SetUnitUserData( GetLastReplacedUnitBJ(), udg_Creep_Number )
            call PingMinimapLocForForce( GetPlayersAll(), GetUnitLoc(GetLastReplacedUnitBJ()), 5.00 )
            call PlaySoundBJ( gg_snd_QuestNew )
            call SetPlayerTechResearchedSwap( 'R05U', 2, Player(PLAYER_NEUTRAL_AGGRESSIVE) )
            call DisplayTextToForce( GetPlayersAll(), "|cffffcc00네임드|r 등장!" )
        endif
        endif
    endif
    if ( TimerGetElapsed(udg_MBTime) >= 2700.00 ) then
        if ( udg_Creep_NamedCheck[4] == true ) then
        if ( udg_Creep_Type[nCreepLv+4] != 0 ) then
            set udg_Creep_NamedCheck[4] = false
            set udg_Creep_NamedCheck[5] = true
            call ReplaceUnitBJ( u, udg_Creep_Type[nCreepLv+4], bj_UNIT_STATE_METHOD_RELATIVE )
            set udg_Creep_Type[nCreepLv+4] = 0
            call GroupAddUnitSimple( GetLastReplacedUnitBJ(), udg_Creep_Group[udg_Creep_Number] )
            call SetUnitUserData( GetLastReplacedUnitBJ(), udg_Creep_Number )
            call PingMinimapLocForForce( GetPlayersAll(), GetUnitLoc(GetLastReplacedUnitBJ()), 5.00 )
            call PlaySoundBJ( gg_snd_QuestNew )
            call SetPlayerTechResearchedSwap( 'R05U', 3, Player(PLAYER_NEUTRAL_AGGRESSIVE) )
            call DisplayTextToForce( GetPlayersAll(), "|cffffcc00네임드|r 등장!" )
        endif
        endif
    endif
    if ( TimerGetElapsed(udg_MBTime) >= 3300.00 ) then
        if ( udg_Creep_NamedCheck[5] == true ) then
        if ( udg_Creep_Type[nCreepLv+4] != 0 ) then
            set udg_Creep_NamedCheck[5] = false
            set udg_Creep_NamedCheck[6] = true
            call ReplaceUnitBJ( u, udg_Creep_Type[nCreepLv+4], bj_UNIT_STATE_METHOD_RELATIVE )
            set udg_Creep_Type[nCreepLv+4] = 0
            call GroupAddUnitSimple( GetLastReplacedUnitBJ(), udg_Creep_Group[udg_Creep_Number] )
            call SetUnitUserData( GetLastReplacedUnitBJ(), udg_Creep_Number )
            call PingMinimapLocForForce( GetPlayersAll(), GetUnitLoc(GetLastReplacedUnitBJ()), 5.00 )
            call PlaySoundBJ( gg_snd_QuestNew )
            call SetPlayerTechResearchedSwap( 'R05U', 3, Player(PLAYER_NEUTRAL_AGGRESSIVE) )
            call DisplayTextToForce( GetPlayersAll(), "|cffffcc00네임드|r 등장!" )
        endif
        endif
    endif
    if ( TimerGetElapsed(udg_MBTime) >= 3900.00 ) then
        if ( udg_Creep_NamedCheck[6] == true ) then
            set udg_Creep_NamedCheck[6] = false
            call ReplaceUnitBJ( u, udg_Creep_Type[99], bj_UNIT_STATE_METHOD_RELATIVE )
            call GroupAddUnitSimple( GetLastReplacedUnitBJ(), udg_Creep_Group[udg_Creep_Number] )
            call SetUnitUserData( GetLastReplacedUnitBJ(), udg_Creep_Number )
            call PingMinimapLocForForce( GetPlayersAll(), GetUnitLoc(GetLastReplacedUnitBJ()), 5.00 )
            call PlaySoundBJ( gg_snd_QuestNew )
            call SetPlayerTechResearchedSwap( 'R05U', 4, Player(PLAYER_NEUTRAL_AGGRESSIVE) )
            call DisplayTextToForce( GetPlayersAll(), "|cffffcc00나인식스|r 등장!" )
        endif
    endif
endfunction

