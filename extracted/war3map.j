//===========================================================================
function Trig_Parasite_Loop_Func001Func003C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R05H', GetOwningPlayer(udg_Hero_DeC)) >= 1 ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Hero_DeC_ParaTgt) == true ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(udg_Hero_DeC_ParaTgt, GetOwningPlayer(udg_Hero_DeC)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Parasite_Loop_Func001Func006Func001Func002Func006C takes nothing returns boolean
    if ( not ( udg_Hero_DeC_ParaTgt == udg_Hero_DeC_Sp2Tgt ) ) then
        return false
    endif
    return true
endfunction

function Trig_Parasite_Loop_Func001Func006Func001Func002C takes nothing returns boolean
    if ( not ( udg_Hero_DeC_ParaInt == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Parasite_Loop_Func001Func006Func001Func003C takes nothing returns boolean
    if ( not ( udg_Hero_DeC_ParaSize >= 10 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Parasite_Loop_Func001Func006Func001Func004C takes nothing returns boolean
    if ( not ( udg_Hero_DeC_ParaSize <= 10 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Parasite_Loop_Func001Func006Func001C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(GetUnitLoc(udg_Hero_DeC), GetUnitLoc(udg_Hero_DeC_ParaTgt)) <= 30.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Parasite_Loop_Func001Func006C takes nothing returns boolean
    if ( not ( udg_Hero_DeC_ParaInt == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Parasite_Loop_Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_DeC_ParaTgt) == true ) ) then
        return false
    endif
    if ( not ( DistanceBetweenPoints(GetUnitLoc(udg_Hero_DeC), GetUnitLoc(udg_Hero_DeC_ParaTgt)) < 1400.00 ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_Hero_DeC, 'B079') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Parasite_Loop_Actions takes nothing returns nothing
    if ( Trig_Parasite_Loop_Func001C() ) then
        if ( Trig_Parasite_Loop_Func001Func006C() ) then
            set udg_Hero_DeC_ParaSize = 1.00
            call SetUnitPositionLoc( udg_Hero_DeC, GetUnitLoc(udg_Hero_DeC_ParaTgt) )
            call SetUnitScalePercent( udg_Hero_DeC, 1.00, 1.00, 1.00 )
        else
            if ( Trig_Parasite_Loop_Func001Func006Func001C() ) then
                if ( Trig_Parasite_Loop_Func001Func006Func001Func002C() ) then
                    set udg_Hero_DeC_ParaInt = 1
                    call AddSpecialEffectTargetUnitBJ( "chest", udg_Hero_DeC_ParaTgt, "Abilities\\Spells\\Undead\\Possession\\PossessionMissile.mdl" )
                    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
                    call StartTimerBJ( udg_Hero_DeC_ParaDmgTimer, false, 0.90 )
                    if ( Trig_Parasite_Loop_Func001Func006Func001Func002Func006C() ) then
                        call UnitRemoveBuffBJ( 'B079', udg_Hero_DeC )
                        set udg_Hero_DeC_Sp2Tgt = null
                        call AbsoluteDamage(udg_Hero_DeC, udg_Hero_DeC_ParaTgt, 800)
                        call AbsoluteDamage(udg_Hero_DeC_ParaTgt, udg_Hero_DeC, 10000)
                        call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_DeC_ParaTgt, "war3mapImported\\DemolisherToxicMissile.mdx" )
                        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
                    else
                    endif
                else
                endif
            else
                if ( Trig_Parasite_Loop_Func001Func006Func001Func003C() ) then
                    set udg_Hero_DeC_ParaSize = ( udg_Hero_DeC_ParaSize - 3.00 )
                else
                    set udg_Hero_DeC_ParaSize = 1.00
                endif
                if ( Trig_Parasite_Loop_Func001Func006Func001Func004C() ) then
                    call SetUnitPositionLoc( udg_Hero_DeC, GetUnitLoc(udg_Hero_DeC_ParaTgt) )
                else
                    call SetUnitPositionLocFacingLocBJ( udg_Hero_DeC, PolarProjectionBJ(GetUnitLoc(udg_Hero_DeC), 20.00, ( AngleBetweenPoints(GetUnitLoc(udg_Hero_DeC), GetUnitLoc(udg_Hero_DeC_ParaTgt)) - -0.00 )), GetUnitLoc(udg_Hero_DeC_ParaTgt) )
                endif
                call SetUnitScalePercent( udg_Hero_DeC, udg_Hero_DeC_ParaSize, udg_Hero_DeC_ParaSize, udg_Hero_DeC_ParaSize )
            endif
        endif
        call StartTimerBJ( udg_Hero_DeC_ParaTimer, false, 0.01 )
    else
        call PauseTimerBJ( true, udg_Hero_DeC_ParaTimer )
        call PauseTimerBJ( true, udg_Hero_DeC_ParaDmgTimer )
        if ( Trig_Parasite_Loop_Func001Func003C() ) then
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(udg_Hero_DeC), GetUnitLoc(udg_Hero_DeC), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 2.50, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A0I0', GetLastCreatedUnit() )
            call IssueTargetOrderBJ( GetLastCreatedUnit(), "drunkenhaze", udg_Hero_DeC_ParaTgt )
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(udg_Hero_DeC), GetUnitLoc(udg_Hero_DeC), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 2.50, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A0II', GetLastCreatedUnit() )
            call IssueTargetOrderBJ( GetLastCreatedUnit(), "drunkenhaze", udg_Hero_DeC )
        else
        endif
        call SetUnitScalePercent( udg_Hero_DeC, 100.00, 100.00, 100.00 )
        call SetUnitInvulnerable( udg_Hero_DeC, false )
        call SetUnitPathing( udg_Hero_DeC, true )
        call DestroyEffectBJ( udg_Hero_DeC_Eff )
        call AddSpecialEffectTargetUnitBJ( "chest", udg_Hero_DeC_ParaTgt, "Abilities\\Spells\\Undead\\Possession\\PossessionMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_DeC_ParaTgt, "Objects\\Spawnmodels\\Orc\\OrcLargeDeathExplode\\OrcLargeDeathExplode.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call SetUnitPositionLocFacingLocBJ( udg_Hero_DeC, GetRandomLocInRect(RectFromCenterSizeBJ(GetUnitLoc(udg_Hero_DeC), 100.00, 100.00)), GetUnitLoc(udg_Hero_DeC_ParaTgt) )
        call SetUnitAnimation( udg_Hero_DeC, "Morph Alternate" )
        call QueueUnitAnimationBJ( udg_Hero_DeC, "stand" )
        call UnitRemoveBuffBJ( 'B079', udg_Hero_DeC )
        set udg_Hero_DeC_ParaTgt = null
        call RemoveUnit( udg_Hero_DeC_ParaWisp )
        set udg_Hero_DeC_ParaWisp = null
    endif
endfunction

