function Trig_TrB_Skil_Effect_Func001Func003C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0RE' ) ) then
        return false
    endif
    if ( not ( udg_Hero_TrB_Inrageint >= 4 ) ) then
        return false
    endif
    return true
endfunction

function Trig_TrB_Skil_Effect_Func001C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A02L' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0RD' ) ) then
        return true
    endif
    if ( Trig_TrB_Skil_Effect_Func001Func003C() ) then
        return true
    endif
    return false
endfunction

function Trig_TrB_Skil_Effect_Conditions takes nothing returns boolean
    if ( not Trig_TrB_Skil_Effect_Func001C() ) then
        return false
    endif
    return true
endfunction

