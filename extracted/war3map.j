//===========================================================================
// Trigger: Free Annihilation
//===========================================================================
function Trig_Free_Annihilation_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetSpellTargetUnit()) == 'Ekgg' ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A0RG', GetSpellTargetUnit()) >= 1 ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(GetSpellTargetUnit(), GetOwningPlayer(GetTriggerUnit())) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Free_Annihilation_Func009C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R00N', GetOwningPlayer(GetSpellTargetUnit())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Free_Annihilation_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Items\\SpellShieldAmulet\\SpellShieldCaster.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call PolledWait( 0.30 )
    call CreateNUnitsAtLoc( 1, 'e00Y', GetOwningPlayer(udg_Hero_Sil), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A03G', GetLastCreatedUnit() )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "soulburn", GetTriggerUnit() )
    if ( Trig_Free_Annihilation_Func009C() ) then
        call CreateNUnitsAtLoc( 1, 'e00Y', GetOwningPlayer(udg_Hero_Sil), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A11C', GetLastCreatedUnit() )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "doom", GetTriggerUnit() )
    else
    endif
    call TextTag( "프리 어나힐레이션!" , GetTriggerUnit() , 10 , 255 , 255 , 150, 3 )
    call PolledWait( ( 27.00 - I2R(( 6 * GetUnitAbilityLevelSwapped('A0RG', udg_Hero_Sil) )) ) )
    call EnableTrigger( GetTriggeringTrigger() )
endfunction

//===========================================================================
function InitTrig_Free_Annihilation takes nothing returns nothing
    set gg_trg_Free_Annihilation = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Free_Annihilation, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Free_Annihilation, Condition( function Trig_Free_Annihilation_Conditions ) )
    call TriggerAddAction( gg_trg_Free_Annihilation, function Trig_Free_Annihilation_Actions )
endfunction

