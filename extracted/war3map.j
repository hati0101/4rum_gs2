//===========================================================================
// Trigger: Rune Sword Master
//===========================================================================
function Trig_Rune_Sword_Master_Conditions takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B00M') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rune_Sword_Master_Func004C takes nothing returns boolean
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) <= udg_Hero_RuK_UltiDmg ) ) then
        return false
    endif
    return true
endfunction

function Trig_Rune_Sword_Master_Actions takes nothing returns nothing
    call UnitRemoveBuffBJ( 'B00M', GetTriggerUnit() )
    set udg_Hero_RuK_UltiDmg = ( ( 0.20 + ( I2R(GetUnitAbilityLevelSwapped('A0GK', GetEventDamageSource())) * 0.10 ) ) * I2R(GetHeroStatBJ(bj_HEROSTAT_INT, GetEventDamageSource(), true)) )
    if ( Trig_Rune_Sword_Master_Func004C() ) then
        call SetUnitLifeBJ( GetTriggerUnit(), 1.00 )
        call UnitDamageTargetBJ( GetEventDamageSource(), GetTriggerUnit(), 20.00, ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
    else
        call UnitDamageTargetBJ( GetEventDamageSource(), GetTriggerUnit(), udg_Hero_RuK_UltiDmg, ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
    endif
    // -
    call TextTag("+" + I2S(R2I(udg_Hero_RuK_UltiDmg)),GetTriggerUnit(), 10, 0, 0, 255, 0.65)
endfunction

//===========================================================================
function InitTrig_Rune_Sword_Master takes nothing returns nothing
    set gg_trg_Rune_Sword_Master = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Rune_Sword_Master, Condition( function Trig_Rune_Sword_Master_Conditions ) )
    call TriggerAddAction( gg_trg_Rune_Sword_Master, function Trig_Rune_Sword_Master_Actions )
endfunction

//===========================================================================
// Trigger: Ragnarok
//===========================================================================
function Trig_Ragnarok_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0L8' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ragnarok_Actions takes nothing returns nothing
    set udg_Hero_RuK_UltiTgt = GetSpellTargetUnit()
    set udg_Hero_RuK_UltiBool = true
    call CreateNUnitsAtLoc( 1, 'h00T', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call SetUnitAnimation( GetLastCreatedUnit(), "Stand Channel" )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitShareVisionBJ( true, udg_Hero_RuK_UltiTgt, GetOwningPlayer(GetTriggerUnit()) )
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Demon\\DarkPortal\\DarkPortalTarget.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call PolledWait( 0.10 )
    set udg_Hero_RuK_UltiDmg = ( ( GetUnitStateSwap(UNIT_STATE_MAX_MANA, GetTriggerUnit()) - GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) ) + 0.00 )
    set udg_Hero_RuK_UltiDmg = RMinBJ(udg_Hero_RuK_UltiDmg, ( 200.00 + ( 300.00 * I2R(GetUnitAbilityLevelSwapped('A0L8', GetTriggerUnit())) ) ))
    call SetUnitAnimation( GetTriggerUnit(), "Attack" )
endfunction

//===========================================================================
function InitTrig_Ragnarok takes nothing returns nothing
    set gg_trg_Ragnarok = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Ragnarok, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Ragnarok, Condition( function Trig_Ragnarok_Conditions ) )
    call TriggerAddAction( gg_trg_Ragnarok, function Trig_Ragnarok_Actions )
endfunction

//===========================================================================
// Trigger: Ragnarok Damage
//===========================================================================
function Trig_Ragnarok_Damage_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0L8' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ragnarok_Damage_Func012C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R05E', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ragnarok_Damage_Actions takes nothing returns nothing
    call SetUnitAnimation( GetTriggerUnit(), "Attack two" )
    call CreateNUnitsAtLoc( 1, 'h00S', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(udg_Hero_RuK_UltiTgt), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(udg_Hero_RuK_UltiTgt), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0GN', GetLastCreatedUnit() )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "purge", udg_Hero_RuK_UltiTgt )
    call UnitDamageTargetBJ( GetTriggerUnit(), udg_Hero_RuK_UltiTgt, udg_Hero_RuK_UltiDmg, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    set udg_Hero_RuK_UltiBool = false
    if ( Trig_Ragnarok_Damage_Func012C() ) then
        call SetUnitManaBJ( udg_Hero_RuK_UltiTgt, ( GetUnitStateSwap(UNIT_STATE_MANA, udg_Hero_RuK_UltiTgt) - udg_Hero_RuK_UltiDmg ) )
    else
    endif
    call UnitShareVisionBJ( false, udg_Hero_RuK_UltiTgt, GetOwningPlayer(GetTriggerUnit()) )
    call PolledWait( 0.10 )
    call TextTag( "+"+I2S(R2I(udg_Hero_RuK_UltiDmg)) , udg_Hero_RuK_UltiTgt, 10 , 127, 255 , 212, 3 )
    set udg_Hero_RuK_UltiTgt = null
endfunction

//===========================================================================
function InitTrig_Ragnarok_Damage takes nothing returns nothing
    set gg_trg_Ragnarok_Damage = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Ragnarok_Damage, EVENT_PLAYER_UNIT_SPELL_FINISH )
    call TriggerAddCondition( gg_trg_Ragnarok_Damage, Condition( function Trig_Ragnarok_Damage_Conditions ) )
    call TriggerAddAction( gg_trg_Ragnarok_Damage, function Trig_Ragnarok_Damage_Actions )
endfunction

