//===========================================================================
// Trigger: Railgun
//===========================================================================
function Trig_Railgun_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0KU' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Railgun_Func007C takes nothing returns boolean
    if ( not ( GetRandomInt(1, ( 6 - GetUnitAbilityLevelSwapped('A004', udg_Hero_LeT) )) == 1 ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A004', udg_Hero_LeT) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Railgun_Func008C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R09M', GetOwningPlayer(udg_Hero_LeT)) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Railgun_Actions takes nothing returns nothing
    set udg_Hero_ReM_Target = GetSpellTargetUnit()
    call CreateNUnitsAtLocFacingLocBJ( 1, 'ewsp', GetTriggerPlayer(), GetUnitLoc(udg_Hero_ReM_Target), GetUnitLoc(GetTriggerUnit()) )
    call UnitApplyTimedLifeBJ( 10.00, 'BTLF', GetLastCreatedUnit() )
    call SetUnitScalePercent( GetLastCreatedUnit(), 250.00, 250.00, 250.00 )
    call UnitAddAbilityBJ( 'A0V8', GetLastCreatedUnit() )
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "silence", GetUnitLoc(GetLastCreatedUnit()) )
    if ( Trig_Railgun_Func007C() ) then
        set udg_Hero_ReM_Dmg = R2I(( ( ( 60.00 + ( 70.00 * ( I2R(GetUnitAbilityLevelSwapped('A0KU', udg_Hero_LeT)) - 0.00 ) ) ) * 33.00 ) / 100.00 ))
        call UnitDamageTargetBJ( udg_Hero_LeT, udg_Hero_ReM_Target, I2R(udg_Hero_ReM_Dmg), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call CreateTextTagUnitBJ( ( "+" + ( I2S(udg_Hero_ReM_Dmg) + "!" ) ), udg_Hero_ReM_Target, 10.00, 10.00, 0.00, 0.00, 100.00, 0 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 30.00, 85.00 )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 2.00 )
        call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 1.50 )
    else
    endif
    if ( Trig_Railgun_Func008C() ) then
        call CreateNUnitsAtLocFacingLocBJ( 1, 'ewsp', GetTriggerPlayer(), GetUnitLoc(udg_Hero_ReM_Target), GetUnitLoc(GetTriggerUnit()) )
        call UnitApplyTimedLifeBJ( 10.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A00H', GetLastCreatedUnit() )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "acidbomb", udg_Hero_ReM_Target )
    else
        call DoNothing(  )
    endif
endfunction

//===========================================================================
function InitTrig_Railgun takes nothing returns nothing
    set gg_trg_Railgun = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Railgun, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Railgun, Condition( function Trig_Railgun_Conditions ) )
    call TriggerAddAction( gg_trg_Railgun, function Trig_Railgun_Actions )
endfunction

//===========================================================================
// Trigger: Tech Mastery Learn
//===========================================================================
function Trig_Tech_Mastery_Learn_Conditions takes nothing returns boolean
    if ( not ( GetLearnedSkillBJ() == 'A004' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tech_Mastery_Learn_Func003Func003C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0HW', GetTriggerUnit()) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tech_Mastery_Learn_Func003Func004C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R09L', GetOwningPlayer(GetTriggerUnit())) == 0 ) ) then
        return false
    endif
    if ( not ( GetLearnedSkillLevel() == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tech_Mastery_Learn_Func003C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R09L', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A0BW', GetTriggerUnit()) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tech_Mastery_Learn_Func004C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R09L', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Tech_Mastery_Learn_Actions takes nothing returns nothing
    call ModifyHeroStat( bj_HEROSTAT_AGI, GetTriggerUnit(), bj_MODIFYMETHOD_ADD, 2 )
    call ModifyHeroStat( bj_HEROSTAT_INT, GetTriggerUnit(), bj_MODIFYMETHOD_ADD, 3 )
    if ( Trig_Tech_Mastery_Learn_Func003C() ) then
        if ( Trig_Tech_Mastery_Learn_Func003Func003C() ) then
            call UnitRemoveAbilityBJ( 'A0HW', GetTriggerUnit() )
        else
        endif
        call UnitAddAbilityBJ( 'A0BW', GetTriggerUnit() )
    else
        if ( Trig_Tech_Mastery_Learn_Func003Func004C() ) then
            call UnitAddAbilityBJ( 'A0HW', GetTriggerUnit() )
        else
        endif
    endif
    if ( Trig_Tech_Mastery_Learn_Func004C() ) then
        call SetUnitAbilityLevelSwapped( 'A0BW', GetTriggerUnit(), GetLearnedSkillLevel() )
    else
        call SetUnitAbilityLevelSwapped( 'A0HW', GetTriggerUnit(), GetLearnedSkillLevel() )
    endif
endfunction

//===========================================================================
function InitTrig_Tech_Mastery_Learn takes nothing returns nothing
    set gg_trg_Tech_Mastery_Learn = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Tech_Mastery_Learn, EVENT_PLAYER_HERO_SKILL )
    call TriggerAddCondition( gg_trg_Tech_Mastery_Learn, Condition( function Trig_Tech_Mastery_Learn_Conditions ) )
    call TriggerAddAction( gg_trg_Tech_Mastery_Learn, function Trig_Tech_Mastery_Learn_Actions )
endfunction

