        call StartTimerBJ( udg_Hero_Des_RetreatTimer, false, 0.30 )
        call SaveUnitHandleBJ( GetTriggerUnit(), GetHandleIdBJ(GetLastCreatedTimerBJ()), StringHashBJ("Retreat"), GetLastCreatedHashtableBJ() )
    else
