function InitTrig_Charging_Shell takes nothing returns nothing
    set gg_trg_Charging_Shell = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Charging_Shell, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Charging_Shell, Condition( function Trig_Charging_Shell_Conditions ) )
    call TriggerAddAction( gg_trg_Charging_Shell, function Trig_Charging_Shell_Actions )
endfunction

