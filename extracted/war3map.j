    local group g
    set udg_Hero_MRG_AtkTarget = null
    set bj_lastLoadedUnit = GetEventDamageSource()
    set g = GetUnitsInRangeOfLocMatching(600, udg_Hero_MRG_UltiPoint, Condition(function Aqua_Sub)) 
    call ForGroupBJ( g, function Trig_Aqua_Ultimatum_Damage_Func003A )
endfunction

