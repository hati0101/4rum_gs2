        return false
    endif
    return true
endfunction

function Trig_Mode_SP_Actions takes nothing returns nothing
    set udg_ModeSP = true
    call PlaySoundBJ( gg_snd_GoodJob )
    call spread()
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 6
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set bj_forLoopBIndex = 1
        set bj_forLoopBIndexEnd = 6
        loop
            exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
            call SetPlayerAllianceStateBJ( udg_SP_Player[GetForLoopIndexA()], udg_SP_Player[GetForLoopIndexB()], bj_ALLIANCE_ALLIED_VISION )
            set bj_forLoopBIndex = bj_forLoopBIndex + 1
        endloop
        set bj_forLoopBIndex = 7
        set bj_forLoopBIndexEnd = 12
        loop
            exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
            call SetPlayerAllianceStateBJ( udg_SP_Player[GetForLoopIndexA()], udg_SP_Player[GetForLoopIndexB()], bj_ALLIANCE_UNALLIED )
            set bj_forLoopBIndex = bj_forLoopBIndex + 1
        endloop
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set bj_forLoopAIndex = 7
    set bj_forLoopAIndexEnd = 12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set bj_forLoopBIndex = 1
        set bj_forLoopBIndexEnd = 6
        loop
            exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
            call SetPlayerAllianceStateBJ( udg_SP_Player[GetForLoopIndexA()], udg_SP_Player[GetForLoopIndexB()], bj_ALLIANCE_UNALLIED )
            set bj_forLoopBIndex = bj_forLoopBIndex + 1
        endloop
        set bj_forLoopBIndex = 7
        set bj_forLoopBIndexEnd = 12
        loop
            exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
            call SetPlayerAllianceStateBJ( udg_SP_Player[GetForLoopIndexA()], udg_SP_Player[GetForLoopIndexB()], bj_ALLIANCE_ALLIED_VISION )
            set bj_forLoopBIndex = bj_forLoopBIndex + 1
        endloop
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    //  
    call SetPlayerColorBJ( udg_SP_Player[2], PLAYER_COLOR_BLUE, true )
    call SetPlayerColorBJ( udg_SP_Player[3], PLAYER_COLOR_CYAN, true )
    call SetPlayerColorBJ( udg_SP_Player[4], PLAYER_COLOR_PURPLE, true )
    call SetPlayerColorBJ( udg_SP_Player[5], PLAYER_COLOR_YELLOW, true )
    call SetPlayerColorBJ( udg_SP_Player[6], PLAYER_COLOR_ORANGE, true )
    call SetPlayerColorBJ( udg_SP_Player[8], PLAYER_COLOR_PINK, true )
    call SetPlayerColorBJ( udg_SP_Player[9], PLAYER_COLOR_LIGHT_GRAY, true )
    call SetPlayerColorBJ( udg_SP_Player[10], PLAYER_COLOR_LIGHT_BLUE, true )
    call SetPlayerColorBJ( udg_SP_Player[11], PLAYER_COLOR_AQUA, true )
    call SetPlayerColorBJ( udg_SP_Player[12], PLAYER_COLOR_BROWN, true )
    //  
    if ( Trig_Mode_SP_Func019C() ) then
        set bj_forLoopAIndex = 2
        set bj_forLoopAIndexEnd = 6
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call SetPlayerName( ConvertedPlayer(GetForLoopIndexA()), ( "플레이어 " + I2S(udg_SP_Number[GetForLoopIndexA()]) ) )
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
        set bj_forLoopAIndex = 8
        set bj_forLoopAIndexEnd = 12
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call SetPlayerName( ConvertedPlayer(GetForLoopIndexA()), ( "플레이어 " + I2S(udg_SP_Number[GetForLoopIndexA()]) ) )
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
    else
    endif
    //  
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Mode_SP_Func021Func001C() ) then
            call MultiboardSetItemValueBJ( udg_MB, 2, ( GetForLoopIndexA() + 1 ), ( ( udg_Colors[GetForLoopIndexA()] + GetPlayerName(udg_SP_Player[GetForLoopIndexA()]) ) + "|r" ) )
        else
            call MultiboardSetItemValueBJ( udg_MB, 2, ( GetForLoopIndexA() + 1 ), ( ( udg_Colors[GetForLoopIndexA()] + "비어있음" ) + "|r" ) )
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    //  
    set udg_Cnt_Player[0] = 0
    set udg_Cnt_Player[1] = 0
    set bj_forLoopAIndex = 2
    set bj_forLoopAIndexEnd = 6
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Mode_SP_Func025Func001C() ) then
            set udg_Cnt_Player[0] = ( udg_Cnt_Player[0] + 1 )
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set bj_forLoopAIndex = 8
    set bj_forLoopAIndexEnd = 12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Mode_SP_Func026Func001C() ) then
            set udg_Cnt_Player[1] = ( udg_Cnt_Player[1] + 1 )
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

