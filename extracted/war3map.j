    return ( IsUnitAlly(GetFilterUnit(), GetOwningPlayer(GetEventDamageSource())) != true )
endfunction

function Trig_Blazing_Axe_Func003Func002Func001C takes nothing returns boolean
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'o000' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blazing_Axe_Func003Func002A takes nothing returns nothing
    if ( Trig_Blazing_Axe_Func003Func002Func001C() ) then
        call UnitDamageTargetBJ( GetEventDamageSource(), GetEnumUnit(), ( ( 2.00 + ( 8.00 * I2R(GetUnitAbilityLevelSwapped('A0RY', GetEventDamageSource())) ) ) + 0.00 ), ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL )
        call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "Abilities\\Spells\\Items\\AIfb\\AIfbSpecialArt.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
endfunction

function Trig_Blazing_Axe_Func003Func006001003 takes nothing returns boolean
    return ( IsUnitAlly(GetFilterUnit(), GetOwningPlayer(GetEventDamageSource())) != true )
endfunction

function Trig_Blazing_Axe_Func003Func006Func001C takes nothing returns boolean
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnumUnit()) != 'o000' ) ) then
        return false
    endif
    return true
endfunction

