        return false
    endif
    return true
endfunction

function Trig_Grand_Phantasm_Illusion_Color_Actions takes nothing returns nothing
    local integer a = 1
    loop
    exitwhen a > 12
    if GetUnitTypeId(GetTriggerUnit()) == GetUnitTypeId(udg_HeroPlayer[a]) then
    call SetUnitColor( GetTriggerUnit(), GetPlayerColor(ConvertedPlayer(udg_SP_Number[a])) )
    set a = 12
    return
    endif
    set a = a +1
    endloop
endfunction

