        return false
    endif
    return true
endfunction

function Trig_RoC_Skill_Learn_Actions takes nothing returns nothing
    if ( Trig_RoC_Skill_Learn_Func001C() ) then
        if ( Trig_RoC_Skill_Learn_Func001Func002C() ) then
            call UnitAddAbilityBJ( 'A0KL', GetTriggerUnit() )
        else
        endif
        if ( Trig_RoC_Skill_Learn_Func001Func003C() ) then
            call SetUnitAbilityLevelSwapped( 'A0KL', GetTriggerUnit(), ( 4 + GetLearnedSkillLevel() ) )
        else
            call SetUnitAbilityLevelSwapped( 'A0KL', GetTriggerUnit(), ( 0 + GetLearnedSkillLevel() ) )
        endif
    else
    endif
    if ( Trig_RoC_Skill_Learn_Func002C() ) then
        call SetPlayerTechResearchedSwap( 'R0BZ', GetLearnedSkillLevel(), GetOwningPlayer(GetTriggerUnit()) )
    else
    endif
