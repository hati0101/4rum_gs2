//===========================================================================
// Trigger: Moon Strike Relis
//===========================================================================
function Trig_Moon_Strike_Relis_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0DX' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'H016' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Moon_Strike_Relis_Actions takes nothing returns nothing
    set udg_Hero_DaW_Loc[2] = GetUnitLoc(GetTriggerUnit())
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), udg_Hero_DaW_Loc[2], bj_UNIT_FACING )
    set udg_Hero_DaW_UltiCaster = GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ( 6.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0US', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0US', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0DX', GetTriggerUnit()) )
    call IssueImmediateOrderBJ( GetLastCreatedUnit(), "tranquility" )
    call RemoveLocation( udg_Hero_DaW_Loc[2] )
    set udg_Hero_DaW_UltiIntA = 0
    loop
        exitwhen udg_Hero_DaW_UltiIntA > 5
        set udg_Hero_DaW_Loc[2] = GetUnitLoc(GetTriggerUnit())
        call AddSpecialEffectLocBJ( PolarProjectionBJ(udg_Hero_DaW_Loc[2], 450.00, ( 60.00 * I2R(udg_Hero_DaW_UltiIntA) )), "Abilities\\Spells\\NightElf\\Starfall\\StarfallCaster.mdl" )
        set udg_Hero_DaW_UltiEff[udg_Hero_DaW_UltiIntA] = GetLastCreatedEffectBJ()
        call RemoveLocation( udg_Hero_DaW_Loc[2] )
        set udg_Hero_DaW_UltiIntA = udg_Hero_DaW_UltiIntA + 1
    endloop
    set udg_Hero_DaW_UltiIntB = 0
    loop
        exitwhen udg_Hero_DaW_UltiIntB > 5
        call PolledWait( 0.15 )
        set udg_Hero_DaW_UltiIntA = 0
        loop
            exitwhen udg_Hero_DaW_UltiIntA > 23
            set udg_Hero_DaW_Loc[2] = GetUnitLoc(GetTriggerUnit())
            call AddSpecialEffectLocBJ( PolarProjectionBJ(udg_Hero_DaW_Loc[2], ( 150.00 * I2R(udg_Hero_DaW_UltiIntB) ), ( 15.00 * I2R(udg_Hero_DaW_UltiIntA) )), "Abilities\\Spells\\Undead\\FreezingBreath\\FreezingBreathMissile.mdl" )
            call DestroyEffectBJ( GetLastCreatedEffectBJ() )
            call RemoveLocation( udg_Hero_DaW_Loc[2] )
            set udg_Hero_DaW_UltiIntA = udg_Hero_DaW_UltiIntA + 1
        endloop
        set udg_Hero_DaW_UltiIntB = udg_Hero_DaW_UltiIntB + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Moon_Strike_Relis takes nothing returns nothing
    set gg_trg_Moon_Strike_Relis = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Moon_Strike_Relis, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Moon_Strike_Relis, Condition( function Trig_Moon_Strike_Relis_Conditions ) )
