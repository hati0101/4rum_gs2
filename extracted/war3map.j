function Trig_Wolfs_Slush_Execute_Actions takes nothing returns nothing
    call StartTimerBJ( udg_Hero_MoW_UltiTimer, false, 0.30 )
    set udg_Hero_MoW_UltiTgtGroup = GetUnitsInRangeOfLocMatching(500.00, GetUnitLoc(udg_Hero_MoW[1]), Condition(function Trig_Wolfs_Slush_Execute_Func002002003))
    if ( Trig_Wolfs_Slush_Execute_Func003C() ) then
        set udg_Hero_MoW_UltiIndex = 1
        loop
            exitwhen udg_Hero_MoW_UltiIndex > 3
            if ( Trig_Wolfs_Slush_Execute_Func003Func003Func001C() ) then
                call StopSoundBJ( gg_snd_BuildingDeathLargeHuman, false )
                set udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex] = GroupPickRandomUnit(udg_Hero_MoW_UltiTgtGroup)
                call SetUnitInvulnerable( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], true )
                call PauseUnitBJ( true, udg_Hero_MoW[udg_Hero_MoW_UltiIndex] )
                call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_MoW[udg_Hero_MoW_UltiIndex], "Abilities\\Weapons\\GryphonRiderMissile\\GryphonRiderMissileTarget.mdl" )
                call SetUnitPositionLocFacingLocBJ( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], PolarProjectionBJ(GetUnitLoc(udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex]), 50.00, GetRandomDirectionDeg()), GetUnitLoc(udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex]) )
                call SetUnitAnimation( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], "attack slam" )
                call SetUnitTimeScalePercent( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], 170.00 )
                call CreateNUnitsAtLocFacingLocBJ( 1, 'o00J', GetOwningPlayer(udg_Hero_MoW[1]), GetUnitLoc(udg_Hero_MoW[udg_Hero_MoW_UltiIndex]), GetUnitLoc(udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex]) )
                call UnitApplyTimedLifeBJ( 0.10, 'BTLF', GetLastCreatedUnit() )
                call SetUnitTimeScalePercent( GetLastCreatedUnit(), 250.00 )
                call SetUnitVertexColorBJ( GetLastCreatedUnit(), 100, 0.00, 0.00, 75.00 )
                call SetUnitAnimation( GetLastCreatedUnit(), "attack slam" )
            else
            endif
            set udg_Hero_MoW_UltiIndex = udg_Hero_MoW_UltiIndex + 1
        endloop
        call PlaySoundAtPointBJ( gg_snd_BuildingDeathLargeHuman, 100, GetUnitLoc(udg_Hero_MoW[1]), 500.00 )
        call TriggerSleepAction( 0.00 )
        set udg_Hero_MoW_UltiIndex = 1
        loop
            exitwhen udg_Hero_MoW_UltiIndex > 3
            if ( Trig_Wolfs_Slush_Execute_Func003Func006Func001C() ) then
                call SetUnitTimeScalePercent( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], 70.00 )
                call UnitDamageTargetBJ( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex], udg_Hero_MoW_UltiDamage[udg_Hero_MoW_UltiIndex], ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
                if ( Trig_Wolfs_Slush_Execute_Func003Func006Func001Func003001() ) then
                    call UnitDamageTargetBJ( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex], 50.00, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_LIGHTNING )
                else
                    call DoNothing(  )
                endif
                call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex]), "Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl" )
                call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex]), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl" )
            else
            endif
            set udg_Hero_MoW_UltiIndex = udg_Hero_MoW_UltiIndex + 1
        endloop
        call GroupClear( udg_Hero_MoW_UltiTgtGroup )
    else
        set udg_Hero_MoW_UltiTgtGroup = GetUnitsInRangeOfLocMatching(500.00, GetUnitLoc(udg_Hero_MoW[1]), Condition(function Trig_Wolfs_Slush_Execute_Func003Func001002003))
        if ( Trig_Wolfs_Slush_Execute_Func003Func002C() ) then
            set udg_Hero_MoW_UltiIndex = 1
            loop
                exitwhen udg_Hero_MoW_UltiIndex > 3
                if ( Trig_Wolfs_Slush_Execute_Func003Func002Func001Func001C() ) then
                    call StopSoundBJ( gg_snd_BuildingDeathLargeHuman, false )
                    set udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex] = GroupPickRandomUnit(udg_Hero_MoW_UltiTgtGroup)
                    call SetUnitInvulnerable( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], true )
                    call PauseUnitBJ( true, udg_Hero_MoW[udg_Hero_MoW_UltiIndex] )
                    call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_MoW[udg_Hero_MoW_UltiIndex], "Abilities\\Weapons\\GryphonRiderMissile\\GryphonRiderMissileTarget.mdl" )
                    call SetUnitPositionLocFacingLocBJ( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], PolarProjectionBJ(GetUnitLoc(udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex]), 50.00, GetRandomDirectionDeg()), GetUnitLoc(udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex]) )
                    call SetUnitAnimation( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], "attack slam" )
                    call SetUnitTimeScalePercent( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], 170.00 )
                    call CreateNUnitsAtLocFacingLocBJ( 1, 'o00J', GetOwningPlayer(udg_Hero_MoW[1]), GetUnitLoc(udg_Hero_MoW[udg_Hero_MoW_UltiIndex]), GetUnitLoc(udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex]) )
                    call UnitApplyTimedLifeBJ( 0.10, 'BTLF', GetLastCreatedUnit() )
                    call SetUnitTimeScalePercent( GetLastCreatedUnit(), 250.00 )
                    call SetUnitVertexColorBJ( GetLastCreatedUnit(), 100, 0.00, 0.00, 75.00 )
                    call SetUnitAnimation( GetLastCreatedUnit(), "attack slam" )
                else
                endif
                set udg_Hero_MoW_UltiIndex = udg_Hero_MoW_UltiIndex + 1
            endloop
            call PlaySoundAtPointBJ( gg_snd_BuildingDeathLargeHuman, 100, GetUnitLoc(udg_Hero_MoW[1]), 500.00 )
            call TriggerSleepAction( 0.00 )
            set udg_Hero_MoW_UltiIndex = 1
            loop
                exitwhen udg_Hero_MoW_UltiIndex > 3
                if ( Trig_Wolfs_Slush_Execute_Func003Func002Func004Func001C() ) then
                    call SetUnitTimeScalePercent( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], 70.00 )
                    call UnitDamageTargetBJ( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex], ( udg_Hero_MoW_UltiDamage[udg_Hero_MoW_UltiIndex] / 3.00 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL )
                    if ( Trig_Wolfs_Slush_Execute_Func003Func002Func004Func001Func003001() ) then
                        call UnitDamageTargetBJ( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex], 50.00, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_LIGHTNING )
                    else
                        call DoNothing(  )
                    endif
                    call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex]), "Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl" )
                    call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_MoW_UltiTarget[udg_Hero_MoW_UltiIndex]), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl" )
                else
                endif
                set udg_Hero_MoW_UltiIndex = udg_Hero_MoW_UltiIndex + 1
            endloop
            call GroupClear( udg_Hero_MoW_UltiTgtGroup )
        else
        endif
    endif
    if ( Trig_Wolfs_Slush_Execute_Func004C() ) then
        set udg_Hero_MoW_UltiTimes = ( udg_Hero_MoW_UltiTimes + 1 )
    else
        call DisableTrigger( GetTriggeringTrigger() )
        call TriggerExecute( gg_trg_Wolfs_Slush_Finish )
    endif
endfunction

//===========================================================================
function InitTrig_Wolfs_Slush_Execute takes nothing returns nothing
    set gg_trg_Wolfs_Slush_Execute = CreateTrigger(  )
    call DisableTrigger( gg_trg_Wolfs_Slush_Execute )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Wolfs_Slush_Execute, udg_Hero_MoW_UltiTimer )
    call TriggerAddAction( gg_trg_Wolfs_Slush_Execute, function Trig_Wolfs_Slush_Execute_Actions )
endfunction

//===========================================================================
// Trigger: Wolfs Slush Finish
//===========================================================================
function Trig_Wolfs_Slush_Finish_Actions takes nothing returns nothing
    set udg_Hero_MoW_UltiIndex = 1
    loop
        exitwhen udg_Hero_MoW_UltiIndex > 3
        call DestroyEffectBJ( udg_Hero_MoW_UltiEff[udg_Hero_MoW_UltiIndex] )
        call ResetUnitAnimation( udg_Hero_MoW[udg_Hero_MoW_UltiIndex] )
        call SetUnitTimeScalePercent( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], 100.00 )
        call PauseUnitBJ( false, udg_Hero_MoW[udg_Hero_MoW_UltiIndex] )
        call SetUnitInvulnerable( udg_Hero_MoW[udg_Hero_MoW_UltiIndex], false )
        set udg_Hero_MoW_UltiIndex = udg_Hero_MoW_UltiIndex + 1
    endloop
    call PolledWait( 1.00 )
    set udg_Hero_MoW_UltiIndex = 1
    loop
        exitwhen udg_Hero_MoW_UltiIndex > 3
        call PauseUnitBJ( false, udg_Hero_MoW[udg_Hero_MoW_UltiIndex] )
        set udg_Hero_MoW_UltiIndex = udg_Hero_MoW_UltiIndex + 1
    endloop
    set udg_Hero_MoW_UltiTimes = 0
endfunction

//===========================================================================
function InitTrig_Wolfs_Slush_Finish takes nothing returns nothing
    set gg_trg_Wolfs_Slush_Finish = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Wolfs_Slush_Finish, function Trig_Wolfs_Slush_Finish_Actions )
endfunction

//===========================================================================
// Trigger: Blazing Earth
//===========================================================================
function Trig_Blazing_Earth_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0N2' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blazing_Earth_Actions takes nothing returns nothing
    local location u_point = GetSpellTargetLoc()
    local unit u_cast = GetSpellAbilityUnit()
    call CreateNUnitsAtLoc( 1, 'e021', GetOwningPlayer(GetSpellAbilityUnit()), GetSpellTargetLoc(), 261.00 )
    call UnitApplyTimedLifeBJ( 2.80, 'BTLF', GetLastCreatedUnit() )
    call CreateNUnitsAtLoc( 1, 'e002', GetOwningPlayer(GetSpellAbilityUnit()), GetSpellTargetLoc(), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 7.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0K8', GetLastCreatedUnit() )
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "cloudoffog", u_point )
    call PolledWait( 0.00 )
    call CreateNUnitsAtLoc( 1, 'e002', GetOwningPlayer(u_cast), u_point, bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0N4', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0N4', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0N2', u_cast) )
    call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
    call PolledWait( 1.00 )
    call CreateNUnitsAtLoc( 1, 'e002', GetOwningPlayer(u_cast), u_point, bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0N4', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0N4', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0N2', u_cast) )
    call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
    call PolledWait( 1.00 )
    call CreateNUnitsAtLoc( 1, 'e002', GetOwningPlayer(u_cast), u_point, bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0N4', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0N4', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0N2', u_cast) )
    call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
endfunction

//===========================================================================
function InitTrig_Blazing_Earth takes nothing returns nothing
    set gg_trg_Blazing_Earth = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Blazing_Earth, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Blazing_Earth, Condition( function Trig_Blazing_Earth_Conditions ) )
    call TriggerAddAction( gg_trg_Blazing_Earth, function Trig_Blazing_Earth_Actions )
endfunction

//===========================================================================
// Trigger: Holy Binding
//===========================================================================
function Trig_Holy_Binding_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0GO' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Binding_Func004Func001Func001C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R03O', GetTriggerPlayer()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Binding_Func004Func001C takes nothing returns boolean
    if ( not ( IsUnitEnemy(GetEnumUnit(), GetOwningPlayer(GetTriggerUnit())) == true ) ) then
        return false
    endif
    if ( not ( DistanceBetweenPoints(GetUnitLoc(GetEnumUnit()), GetSpellTargetLoc()) <= ( 175.00 + ( I2R(GetUnitAbilityLevelSwapped('A0GO', GetTriggerUnit())) * 75.00 ) ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Holy_Binding_Func004A takes nothing returns nothing
    if ( Trig_Holy_Binding_Func004Func001C() ) then
        if ( Trig_Holy_Binding_Func004Func001Func001C() ) then
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetEnumUnit()), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A0RA', GetLastCreatedUnit() )
            call IssueTargetOrderBJ( GetLastCreatedUnit(), "purge", GetEnumUnit() )
        else
        endif
