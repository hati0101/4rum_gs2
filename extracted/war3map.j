    call TriggerRegisterPlayerChatEvent( gg_trg_SwapDialog, Player(8), "-스왑", true )
    call TriggerRegisterPlayerChatEvent( gg_trg_SwapDialog, Player(9), "-스왑", true )
    call TriggerRegisterPlayerChatEvent( gg_trg_SwapDialog, Player(10), "-스왑", true )
    call TriggerRegisterPlayerChatEvent( gg_trg_SwapDialog, Player(11), "-스왑", true )
