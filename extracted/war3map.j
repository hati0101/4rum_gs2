        return false
    endif
    return true
endfunction

function Trig_FireDrunk_Effect_Actions takes nothing returns nothing
    if ( Trig_FireDrunk_Effect_Func001C() ) then
        if ( Trig_FireDrunk_Effect_Func001Func001C() ) then
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A09Z', GetLastCreatedUnit() )
            call IssueTargetOrderBJ( GetLastCreatedUnit(), "cripple", GetTriggerUnit() )
        else
        endif
        call UnitDamageTargetBJ( udg_Hero_PaB, GetTriggerUnit(), ( GetEventDamage() * 2.00 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    else
        call PolledWait( 0.10 )
        call UnitAddAbilityBJ( 'A0BE', GetTriggerUnit() )
    endif
    call PolledWait( 7.10 )
    if ( Trig_FireDrunk_Effect_Func003C() ) then
        call UnitRemoveAbilityBJ( 'A0BE', GetTriggerUnit() )
    else
    endif
endfunction

