// Trigger: BurningFlame Move
//===========================================================================
function Trig_BurningFlame_Move_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEnteringUnit()) == 'e00W' ) ) then
        return false
    endif
    return true
endfunction

function Trig_BurningFlame_Move_Actions takes nothing returns nothing
    local unit dummy
    call DisableTrigger( GetTriggeringTrigger() )
    call CreateNUnitsAtLoc( 1, 'e00L', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(udg_Hero_LOI_Hero), bj_UNIT_FACING )
    set dummy = GetLastCreatedUnit()
    call KillUnit( GetLastCreatedUnit() )
    call SetUnitPositionLoc( udg_Hero_LOI_Hero, GetUnitLoc(GetEnteringUnit()) )
    call SetUnitVertexColorBJ( dummy, 100, 100, 100, 20.00 )
    call SetUnitVertexColorBJ( udg_Hero_LOI_Hero, 100, 100, 100, 80.00 )
    call TriggerSleepAction( 0.10 )
    call SetUnitVertexColorBJ( dummy, 100, 100, 100, 40.00 )
    call SetUnitVertexColorBJ( udg_Hero_LOI_Hero, 100, 100, 100, 60.00 )
    call TriggerSleepAction( 0.10 )
    call SetUnitVertexColorBJ( dummy, 100, 100, 100, 60.00 )
    call SetUnitVertexColorBJ( udg_Hero_LOI_Hero, 100, 100, 100, 40.00 )
    call TriggerSleepAction( 0.10 )
    call SetUnitVertexColorBJ( dummy, 100, 100, 100, 80.00 )
    call SetUnitVertexColorBJ( udg_Hero_LOI_Hero, 100, 100, 100, 20.00 )
    call TriggerSleepAction( 0.10 )
    call SetUnitVertexColorBJ( dummy, 100, 100, 100, 90.00 )
    call SetUnitVertexColorBJ( udg_Hero_LOI_Hero, 100, 100, 100, 0.00 )
    call TriggerSleepAction( 0.10 )
endfunction

