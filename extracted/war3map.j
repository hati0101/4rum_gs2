    set gg_trg_Fighters_Coin = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Fighters_Coin, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_Fighters_Coin, Condition( function Trig_Fighters_Coin_Conditions ) )
