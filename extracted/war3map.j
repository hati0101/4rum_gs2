//===========================================================================
// Trigger: Hailflow
//===========================================================================
function Trig_Hailflow_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0CO' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hailflow_Func007C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_Hero_MeQ_AbilT, 'B09U') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hailflow_Func009C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R04D', GetOwningPlayer(GetTriggerUnit())) > 0 ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) >= ( GetUnitStateSwap(UNIT_STATE_MAX_MANA, GetTriggerUnit()) * 0.65 ) ) ) then
        return false
    endif
    if ( not ( udg_Hero_MeQ_Boolen == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hailflow_Actions takes nothing returns nothing
    local integer i = GetUnitAbilityLevelSwapped('A0CO', GetTriggerUnit())
    set udg_Hero_MeQ_AbilT = GetSpellTargetUnit()
    call CreateNUnitsAtLoc( 1, 'e02F', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(udg_Hero_MeQ_AbilT), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A15A', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) )
    call IssueImmediateOrderBJ( GetLastCreatedUnit(), "fanofknives" )
    if ( Trig_Hailflow_Func007C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(udg_Hero_MeQ_AbilT), GetUnitLoc(udg_Hero_MeQ_AbilT), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A117', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A117', GetLastCreatedUnit(), ( 4 + ( 2 * GetUnitAbilityLevelSwapped('A07Q', GetTriggerUnit()) ) ) )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "thunderbolt", udg_Hero_MeQ_AbilT )
    else
    endif
    call PolledWait( 0.10 )
    if ( Trig_Hailflow_Func009C() ) then
        call UnitRemoveAbilityBJ( 'A0CO', GetTriggerUnit() )
        call UnitAddAbilityBJ( 'A0CO', GetTriggerUnit() )
        call SetUnitAbilityLevelSwapped( 'A0CO', GetTriggerUnit(), i )
        call TextTag( "샘솟는 마력!" , GetTriggerUnit() , 10 , 255 , 255 , 150, 3 )
        set udg_Hero_MeQ_Boolen = true
        call TriggerSleepAction( 6.00 )
        set udg_Hero_MeQ_Boolen = false
    else
    endif
endfunction

