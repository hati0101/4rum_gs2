//===========================================================================
// Trigger: Mode SP
//
// call MultiboardSetItemValueBJ(GetLastCreatedMultiboard(),1,(GetForLoopIndexA()+1),(udg_Colors[GetForLoopIndexA()]+(GetPlayerName(udg_SP_Player[GetForLoopIndexA()])+"|r")))
// ModuloInteger(12, 5)
// SP_Player[] (플래이어)
// 셔플된 플래이어를 취급하는 순서대로 표시
// ex)플래이어2가 셔플후 7이되었을경우
// SP_Player[7]=player(2)
// SP_Number[] (정수)
// 배열에 게임시작시 플래이어번호를 넣어주면 현제 몇번 취급인지 알려줌
// ex)플래이어2가 셔플후 7이되었을경우
// SP_Number[2]=7
//===========================================================================
function spread_option takes player p returns boolean
    if ( GetPlayerController(p) == MAP_CONTROL_USER ) then
    if ( p != udg_Force[1] ) then
    if ( p != udg_Force[2] ) then
        return true
    endif
    endif
    endif
    return false
endfunction

function spread takes nothing returns nothing
    local integer   currRand    = GetRandomInt( 0, 1 )
    local integer   prevRand    = 0 
    local integer   i           = 1
    local force     f           = CreateForce()
    local player    p           = null

    loop
        exitwhen ( i > 12 )
        set p = ConvertedPlayer( i )
        set udg_SP_Player[i] = null
        set udg_SP_Number[i] = 0

        if ( spread_option(p) ) then
            if ( GetPlayerSlotState(p) == PLAYER_SLOT_STATE_PLAYING ) then
                call ForceAddPlayer( f, p )
            endif
        else
            set udg_SP_Player[i] = ConvertedPlayer( i )
            set udg_SP_Number[i] = i
        endif

        set i = i + 1
    endloop

    loop
        exitwhen ( CountPlayersInForceBJ(f) == 0 )
        set p = ForcePickRandomPlayer( f )
        call ForceRemovePlayer( f, p )

        loop
            set currRand = ( GetRandomInt(2, 6) + (1 - currRand - prevRand / 7) * 6  )
            exitwhen ( udg_SP_Player[currRand] == null )
            set currRand = 0
        endloop

        set udg_SP_Player[currRand] = p
        set udg_SP_Number[GetConvertedPlayerId( p )] = currRand
        set prevRand = currRand
        set currRand = 0
    endloop

    set p = null
    call DestroyForce( f )
endfunction

function Trig_Mode_SP_Conditions takes nothing returns boolean
    if ( not ( TimerGetElapsed(udg_MBTime) <= 14.00 ) ) then
        return false
    endif
    if ( not ( udg_ModeSP == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mode_SP_Func019C takes nothing returns boolean
    if ( not ( udg_SP_Level == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mode_SP_Func021Func001Func001C takes nothing returns boolean
    if ( ( GetPlayerSlotState(udg_SP_Player[GetForLoopIndexA()]) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return true
    endif
    if ( ( udg_SP_Player[GetForLoopIndexA()] == udg_Force[1] ) ) then
        return true
    endif
    if ( ( udg_SP_Player[GetForLoopIndexA()] == udg_Force[2] ) ) then
        return true
    endif
    return false
endfunction

function Trig_Mode_SP_Func021Func001C takes nothing returns boolean
    if ( not Trig_Mode_SP_Func021Func001Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Mode_SP_Func025Func001C takes nothing returns boolean
    if ( not ( GetPlayerController(udg_SP_Player[GetForLoopIndexA()]) == MAP_CONTROL_USER ) ) then
        return false
    endif
    if ( not ( GetPlayerSlotState(udg_SP_Player[GetForLoopIndexA()]) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mode_SP_Func026Func001C takes nothing returns boolean
    if ( not ( GetPlayerController(udg_SP_Player[GetForLoopIndexA()]) == MAP_CONTROL_USER ) ) then
        return false
