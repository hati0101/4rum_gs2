//===========================================================================
// Trigger: Ambush Dmg
//===========================================================================
function Trig_Ambush_Dmg_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetEventDamageSource()) == 'Opgh' ) ) then
        return false
    endif
    if ( not ( GetTriggerUnit() == udg_Hero_DrR_AmbuAttacker ) ) then
        return false
    endif
    if ( not ( udg_Hero_DrR_AmbuStun >= 1 ) ) then
        return false
    endif
    if ( not ( GetEventDamage() > 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ambush_Dmg_Func005C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R099', GetOwningPlayer(GetEventDamageSource())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ambush_Dmg_Func009C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R099', GetOwningPlayer(GetEventDamageSource())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ambush_Dmg_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call UnitAddAbilityBJ( 'A0LI', GetLastCreatedUnit() )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    if ( Trig_Ambush_Dmg_Func005C() ) then
        call UnitDamageTargetBJ( GetEventDamageSource(), GetTriggerUnit(), ( I2R(udg_Hero_DrR_AmbuStun) * ( 25.00 + ( 15.00 * I2R(GetUnitAbilityLevelSwapped('A0G4', udg_Hero_DrR)) ) ) ), ATTACK_TYPE_HERO, DAMAGE_TYPE_UNIVERSAL )
        call TextTagForce( ( "앰버쉬 : " + I2S(R2I((I2R(udg_Hero_DrR_AmbuStun)*(25.00+(15.00*I2R(GetUnitAbilityLevelSwapped('A0G4',udg_Hero_DrR)))))))+"!!"), GetTriggerUnit() , 10 , 255 , 255 , 150, 3, GetPlayersAll() )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "thunderbolt", udg_Hero_DrR_AmbuAttacker )
    else
        call SetUnitAbilityLevelSwapped( 'A0LI', GetLastCreatedUnit(), udg_Hero_DrR_AmbuStun )
        call TextTagForce( ( "앰버쉬 : " + I2S(udg_Hero_DrR_AmbuStun) + "초 스턴"), GetTriggerUnit() , 10 , 255 , 255 , 150, 3, GetPlayersAll() )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "thunderbolt", udg_Hero_DrR_AmbuAttacker )
    endif
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetEventDamageSource()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call UnitAddAbilityBJ( 'A0LI', GetLastCreatedUnit() )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    if ( Trig_Ambush_Dmg_Func009C() ) then
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "thunderbolt", udg_Hero_DrR_AmbuAttacker )
    else
        call SetUnitAbilityLevelSwapped( 'A0LI', GetLastCreatedUnit(), udg_Hero_DrR_AmbuStun )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "thunderbolt", udg_Hero_DrR_AmbuAttacker )
    endif
    set udg_Hero_DrR_AmbuStun = 0
    set udg_Hero_DrR_AmbuAttacker = null
    call PolledWait( 1.00 )
    call EnableTrigger( GetTriggeringTrigger() )
endfunction

//===========================================================================
function InitTrig_Ambush_Dmg takes nothing returns nothing
    set gg_trg_Ambush_Dmg = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Ambush_Dmg, Condition( function Trig_Ambush_Dmg_Conditions ) )
    call TriggerAddAction( gg_trg_Ambush_Dmg, function Trig_Ambush_Dmg_Actions )
endfunction

//===========================================================================
// Trigger: Call Hippo
//===========================================================================
function Trig_Call_Hippo_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'O005' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() == 'A0HT' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Call_Hippo_Func006Func005C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R09A', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Call_Hippo_Func006C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0FR', GetTriggerUnit()) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Call_Hippo_Func008C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0FR', GetTriggerUnit()) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Call_Hippo_Func009C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetTriggerUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Call_Hippo_Actions takes nothing returns nothing
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl" )
    call d_effect(GetLastCreatedEffectBJ(),1)
    call PlaySoundBJ( gg_snd_ArcherWarcry1 )
    call SetUnitAbilityLevelSwapped( 'A050', GetTriggerUnit(), GetUnitAbilityLevelSwapped('A0HT', GetTriggerUnit()) )
    call SetUnitAbilityLevelSwapped( 'A14G', GetTriggerUnit(), GetUnitAbilityLevelSwapped('A0HT', GetTriggerUnit()) )
    if ( Trig_Call_Hippo_Func006C() ) then
        call DisableTrigger( gg_trg_Battle_Reflex_Lost )
        set udg_Hero_DrR_ReflexCount = 4
        call SetUnitAbilityLevelSwapped( 'A14A', udg_Hero_DrR, ( ( ( GetUnitAbilityLevelSwapped('A0FR', udg_Hero_DrR) - 1 ) * 4 ) + ( udg_Hero_DrR_ReflexCount + 1 ) ) )
        if ( Trig_Call_Hippo_Func006Func005C() ) then
            call SetUnitAbilityLevelSwapped( 'A12J', GetTriggerUnit(), ( udg_Hero_DrR_ReflexCount + 1 ) )
        else
        endif
    else
    endif
    call PolledWait( ( 12.00 + ( 6.00 * I2R(GetUnitAbilityLevelSwapped('A0HT', GetTriggerUnit())) ) ) )
    if ( Trig_Call_Hippo_Func008C() ) then
        call EnableTrigger( gg_trg_Battle_Reflex_Lost )
    else
    endif
    if ( Trig_Call_Hippo_Func009C() ) then
        call UnitRemoveBuffBJ( 'B06O', GetTriggerUnit() )
        call AddSpecialEffectLocBJ( GetUnitLoc(GetTriggerUnit()), "Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl" )
        call d_effect(GetLastCreatedEffectBJ(),1)
    else
    endif
endfunction

//===========================================================================
function InitTrig_Call_Hippo takes nothing returns nothing
    set gg_trg_Call_Hippo = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Call_Hippo, EVENT_PLAYER_UNIT_SPELL_FINISH )
    call TriggerAddCondition( gg_trg_Call_Hippo, Condition( function Trig_Call_Hippo_Conditions ) )
    call TriggerAddAction( gg_trg_Call_Hippo, function Trig_Call_Hippo_Actions )
endfunction

