// Trigger: BlK Change
//
// 경량화 특성을 배울때 블러디 디펜드 배워져 있는지 체크하고 참일경우 스킬을 뒤바꾼다.
//===========================================================================
function Trig_BlK_Change_Conditions takes nothing returns boolean
    if ( not ( GetResearched() == 'R03P' ) ) then
        return false
    endif
    return true
endfunction

