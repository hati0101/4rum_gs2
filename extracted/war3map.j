//===========================================================================
// Trigger: Hunting Net Explode
//===========================================================================
function Trig_Hunting_Net_Explode_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0KQ' ) ) then
        return false
    endif
    return true
endfunction

function Net_Con takes nothing returns boolean
    return ( GetUnitAbilityLevelSwapped('A0ME', GetFilterUnit()) > 0 )
endfunction

function Trig_Hunting_Net_Explode_Actions takes nothing returns nothing
    local group g = GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Net_Con))
    local unit u = FirstOfGroup(g)
    local unit v = u
    call GroupRemoveUnitSimple( u, g )
    loop
    if ( DistanceBetweenPoints(GetUnitLoc(GetSpellAbilityUnit()), GetUnitLoc(u)) < DistanceBetweenPoints(GetUnitLoc(GetSpellAbilityUnit()), GetUnitLoc(v)) ) then
        set v = u
    else
    endif
    exitwhen ( CountUnitsInGroup(g) <= 0 )
    set u = FirstOfGroup(g)
    call GroupRemoveUnitSimple( u, g )
    endloop
    call IssueImmediateOrderBJ( v, "roar" )
    call DestroyGroup(g)
    set g = null
    set u = null
    set v = null
endfunction

//===========================================================================
function InitTrig_Hunting_Net_Explode takes nothing returns nothing
    set gg_trg_Hunting_Net_Explode = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Hunting_Net_Explode, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Hunting_Net_Explode, Condition( function Trig_Hunting_Net_Explode_Conditions ) )
    call TriggerAddAction( gg_trg_Hunting_Net_Explode, function Trig_Hunting_Net_Explode_Actions )
endfunction


