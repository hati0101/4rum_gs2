//===========================================================================
function Trig_Parasite_Func001C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A0YQ' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0ZR' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Parasite_Conditions takes nothing returns boolean
    if ( not Trig_Parasite_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Parasite_Func009C takes nothing returns boolean
    if ( not ( IsUnitAlly(udg_Hero_DeC_ParaTgt, GetOwningPlayer(udg_Hero_DeC)) == true ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R08U', GetOwningPlayer(GetTriggerUnit())) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Parasite_Func014C takes nothing returns boolean
    if ( not ( IsUnitAlly(udg_Hero_DeC_ParaTgt, GetOwningPlayer(udg_Hero_DeC)) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Parasite_Func015C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R05H', GetOwningPlayer(udg_Hero_DeC)) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Parasite_Func016C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0YQ' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Parasite_Actions takes nothing returns nothing
    call UnitRemoveBuffBJ( 'B09O', udg_Hero_DeC )
    call PauseTimerBJ( true, udg_Hero_DeC_Sp1Timer )
    call StartTimerBJ( udg_Hero_DeC_ParaTimer, false, 0.01 )
    set udg_Hero_DeC_ParaInt = 0
    set udg_Hero_DeC_ParaSize = 100.00
    set udg_Hero_DeC_ParaTgt = GetSpellTargetUnit()
    if ( Trig_Parasite_Func009C() ) then
        call UnitAddItemByIdSwapped( 'I0AU', GetTriggerUnit() )
    else
        call UnitAddItemByIdSwapped( 'I0BT', GetTriggerUnit() )
    endif
    call SetUnitInvulnerable( GetTriggerUnit(), true )
    call SetUnitPathing( GetTriggerUnit(), false )
    call AddSpecialEffectTargetUnitBJ( "overhead", GetSpellTargetUnit(), "Abilities\\Spells\\Other\\Parasite\\ParasiteTarget.mdl" )
    set udg_Hero_DeC_Eff = GetLastCreatedEffectBJ()
    if ( Trig_Parasite_Func014C() ) then
        call CreateNUnitsAtLoc( 1, 'e030', GetOwningPlayer(udg_Hero_DeC_ParaTgt), GetUnitLoc(udg_Hero_DeC_ParaTgt), bj_UNIT_FACING )
        set udg_Hero_DeC_ParaWisp = GetLastCreatedUnit()
        call UnitAddAbilityBJ( 'A0I4', udg_Hero_DeC_ParaWisp )
        call SetUnitAbilityLevelSwapped( 'A0I4', udg_Hero_DeC_ParaWisp, GetUnitAbilityLevelSwapped('A0ZR', udg_Hero_DeC) )
    else
    endif
    if ( Trig_Parasite_Func015C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(udg_Hero_DeC), GetUnitLoc(udg_Hero_DeC), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 2.50, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0I0', GetLastCreatedUnit() )
        call PolledWait( 0.30 )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "drunkenhaze", udg_Hero_DeC_ParaTgt )
    else
    endif
    if ( Trig_Parasite_Func016C() ) then
        set udg_Hero_DeC_Sp2Tgt = GetSpellTargetUnit()
    else
    endif
endfunction

