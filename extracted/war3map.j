    call KillUnit( udg_Hero_PaW_DrunkenUnit )
    call SetUnitAbilityLevelSwapped( 'A138', GetTriggerUnit(), a )
    call CreateNUnitsAtLocFacingLocBJ( 1, 'e03K', GetOwningPlayer(GetTriggerUnit()), GetRectCenter(GetPlayableMapRect()), GetUnitLoc(GetTriggerUnit()) )
    set udg_Hero_PaW_DrunkenUnit = GetLastCreatedUnit()
    call StartTimerBJ( udg_Hero_PaW_AttackTimer, false, 6.00 )
    set udg_Hero_PaW = GetTriggerUnit()
    call TextTagForce( I2S(GetUnitAbilityLevelSwapped('A138', udg_Hero_PaW) - 1), udg_Hero_PaW, 10, 255, 100, 100, 2, GetForceOfPlayer(GetOwningPlayer(udg_Hero_PaW)) )
