    if ( ( IsUnitDeadBJ(udg_Hero_PhM) == true ) ) then
        return true
    endif
    if ( Trig_PhM_Speical_Timer_Func004Func001Func002C() ) then
        return true
    endif
    if ( ( IsUnitDeadBJ(udg_Hero_PhM_Spunit1) == true ) ) then
        return true
    endif
    return false
endfunction

