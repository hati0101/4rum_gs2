        return false
    endif
    return true
endfunction

function Trig_Nature_Func002Func012C takes nothing returns boolean
    if ( not ( udg_Hero_Ele_NatReal <= ( 0.00 + ( 30.00 * I2R(GetUnitAbilityLevelSwapped('A13V', GetTriggerUnit())) ) ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Nature_Func002C takes nothing returns boolean
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) >= GetUnitStateSwap(UNIT_STATE_LIFE, GetSpellTargetUnit()) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Nature_Actions takes nothing returns nothing
    if ( Trig_Nature_Func002C() ) then
        if ( Trig_Nature_Func002Func006C() ) then
            set udg_Hero_Ele_NatReal = RMinBJ(RMinBJ(( 175.00 + ( 75.00 * I2R(GetUnitAbilityLevelSwapped('A13V', GetTriggerUnit())) ) ), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) - 1.00 )), ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetSpellTargetUnit()) - GetUnitStateSwap(UNIT_STATE_LIFE, GetSpellTargetUnit()) ))
        else
            set udg_Hero_Ele_NatReal = RMinBJ(RMinBJ(( 75.00 + ( 75.00 * I2R(GetUnitAbilityLevelSwapped('A13V', GetTriggerUnit())) ) ), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) - 1.00 )), ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetSpellTargetUnit()) - GetUnitStateSwap(UNIT_STATE_LIFE, GetSpellTargetUnit()) ))
        endif
        set udg_Hero_Ele_NatReal = RMinBJ(udg_Hero_Ele_NatReal, ( -0.50 * ( GetUnitStateSwap(UNIT_STATE_LIFE, GetSpellTargetUnit()) - GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) ) ))
        set udg_Hero_Ele_NatReal = RMinBJ(udg_Hero_Ele_NatReal, ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetSpellTargetUnit()) - GetUnitStateSwap(UNIT_STATE_LIFE, GetSpellTargetUnit()) ))
        call SetUnitLifeBJ( GetTriggerUnit(), ( ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + ( 0.00 + ( 0.00 * I2R(GetUnitAbilityLevelSwapped('A13V', GetTriggerUnit())) ) ) ) - udg_Hero_Ele_NatReal ) )
        call SetUnitLifeBJ( GetSpellTargetUnit(), ( ( GetUnitStateSwap(UNIT_STATE_LIFE, GetSpellTargetUnit()) + ( 0.00 + ( 30.00 * I2R(GetUnitAbilityLevelSwapped('A13V', GetTriggerUnit())) ) ) ) + udg_Hero_Ele_NatReal ) )
        set udg_Hero_Ele_NatReal = ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetSpellTargetUnit()) - GetUnitStateSwap(UNIT_STATE_LIFE, GetSpellTargetUnit()) )
        if ( Trig_Nature_Func002Func012C() ) then
            set udg_Hero_Ele_NatReal = ( ( 0.00 + ( 30.00 * I2R(GetUnitAbilityLevelSwapped('A13V', GetTriggerUnit())) ) ) - udg_Hero_Ele_NatReal )
            call SetUnitManaBJ( GetSpellTargetUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetSpellTargetUnit()) + udg_Hero_Ele_NatReal ) )
        else
        endif
    else
        if ( Trig_Nature_Func002Func001C() ) then
            set udg_Hero_Ele_NatReal = RMinBJ(RMinBJ(( 175.00 + ( 75.00 * I2R(GetUnitAbilityLevelSwapped('A13V', GetTriggerUnit())) ) ), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetSpellTargetUnit()) - 1.00 )), ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetTriggerUnit()) - GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) ))
        else
            set udg_Hero_Ele_NatReal = RMinBJ(RMinBJ(( 75.00 + ( 75.00 * I2R(GetUnitAbilityLevelSwapped('A13V', GetTriggerUnit())) ) ), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetSpellTargetUnit()) - 1.00 )), ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetTriggerUnit()) - GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) ))
        endif
        set udg_Hero_Ele_NatReal = RMinBJ(udg_Hero_Ele_NatReal, ( -0.50 * ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) - GetUnitStateSwap(UNIT_STATE_LIFE, GetSpellTargetUnit()) ) ))
        set udg_Hero_Ele_NatReal = RMinBJ(udg_Hero_Ele_NatReal, ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetTriggerUnit()) - GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) ))
        call SetUnitLifeBJ( GetTriggerUnit(), ( ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + ( 0.00 + ( 30.00 * I2R(GetUnitAbilityLevelSwapped('A13V', GetTriggerUnit())) ) ) ) + udg_Hero_Ele_NatReal ) )
        call SetUnitLifeBJ( GetSpellTargetUnit(), ( ( GetUnitStateSwap(UNIT_STATE_LIFE, GetSpellTargetUnit()) + ( 0.00 + ( 0.00 * I2R(GetUnitAbilityLevelSwapped('A13V', GetTriggerUnit())) ) ) ) - udg_Hero_Ele_NatReal ) )
    endif
    set udg_Hero_Ele_Int = ( udg_Hero_Ele_Int - 2 )
    call TextTagForce( I2S(udg_Hero_Ele_Int), udg_Hero_Ele, 10, 45, 143, 38, 3, GetForceOfPlayer(GetOwningPlayer(udg_Hero_Ele)) )
endfunction

