    if ( not ( GetPlayerTechCountSimple('R0BH', GetOwningPlayer(GetTriggerUnit())) == 0 ) ) then
        return false
    endif
    if ( not ( GetLearnedSkillLevel() == 1 ) ) then
        return false
    endif
    return true
