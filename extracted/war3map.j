function InitTrig_BlK_Special_4 takes nothing returns nothing
    set gg_trg_BlK_Special_4 = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_BlK_Special_4, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_BlK_Special_4, Condition( function Trig_BlK_Special_4_Conditions ) )
