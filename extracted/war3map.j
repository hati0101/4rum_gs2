    if ( not ( IsUnitAliveBJ(udg_Hero_Dik_UltiTarget) == true ) ) then
        return false
    endif
    if ( not ( udg_Hero_Dik_UltiTarget != null ) ) then
        return false
    endif
    return true
endfunction

