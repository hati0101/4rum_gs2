    call PolledWait( 0.10 )
    if ( Trig_Special_1_Func003C() ) then
        call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) - 40.00 ) )
        call CreateNUnitsAtLoc( 1, 'ewsp', GetTriggerPlayer(), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0IV', GetLastCreatedUnit() )
