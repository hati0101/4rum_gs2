    if ( not Trig_Tidal_Damage_Func006Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Tidal_Damage_Actions takes nothing returns nothing
    if ( Trig_Tidal_Damage_Func001C() ) then
        call Knockback(GetTriggerUnit(),AngleBetweenPoints(GetUnitLoc(udg_Hero_Ele), GetUnitLoc(GetTriggerUnit())),200,150)
    else
    endif
    call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call UnitDamageTargetBJ( udg_Hero_Ele, GetTriggerUnit(), ( 250.00 + ( 150.00 * I2R(GetUnitAbilityLevelSwapped('A12D', udg_Hero_Ele)) ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call SetUnitPathing( GetTriggerUnit(), false )
    if ( Trig_Tidal_Damage_Func006C() ) then
        call PolledWait( 1.00 )
    else
        call UnitAddAbilityBJ( 'Arav', GetTriggerUnit() )
        call UnitRemoveAbilityBJ( 'Arav', GetTriggerUnit() )
        call SetUnitFlyHeightBJ( GetTriggerUnit(), 2000.00, 4000.00 )
        call SetUnitFlyHeightBJ( GetTriggerUnit(), 2000.00, 4000.00 )
        call PolledWait( 1.00 )
        call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call SetUnitFlyHeightBJ( GetTriggerUnit(), 0.00, 4000.00 )
        call SetUnitFlyHeightBJ( GetTriggerUnit(), 0.00, 4000.00 )
    endif
    call SetUnitPathing( GetTriggerUnit(), true )
    call PolledWait( 0.20 )
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "head", GetTriggerUnit(), "Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
endfunction

