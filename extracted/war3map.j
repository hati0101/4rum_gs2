                call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + ( GetEventDamage() * ( 0.10 + ( 0.10 * I2R(GetUnitAbilityLevelSwapped('A10Z', GetTriggerUnit())) ) ) ) ) )
