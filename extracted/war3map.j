    if ( not ( IsUnitType(GetSpellTargetUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not Trig_Lag_Slash_Func005Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Lag_Slash_Func007Func002Func002C takes nothing returns boolean
    if ( not ( GetHeroLevel(GetSpellTargetUnit()) == GetHeroLevel(GetTriggerUnit()) ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R0BT', GetOwningPlayer(GetTriggerUnit())) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lag_Slash_Func007Func002C takes nothing returns boolean
    if ( ( udg_MBKills[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]] < udg_MBKills[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetSpellTargetUnit()))]] ) ) then
