        else
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetSpellTargetUnit()), castPoint, bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A105', GetLastCreatedUnit() )
