function InitTrig_Free_Annihilation_Orb takes nothing returns nothing
    set gg_trg_Free_Annihilation_Orb = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Free_Annihilation_Orb, Condition( function Trig_Free_Annihilation_Orb_Conditions ) )
    call TriggerAddAction( gg_trg_Free_Annihilation_Orb, function Trig_Free_Annihilation_Orb_Actions )
endfunction

//===========================================================================
// Trigger: Silent Area
//===========================================================================
function Trig_Silent_Area_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A118' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Silent_Area_Func017C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R00J', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Silent_Area_Actions takes nothing returns nothing
    local integer a = 1
    call PlaySoundBJ( gg_snd_DryadPissed3 )
    set udg_Hero_Sil_UltiPoint = GetSpellTargetLoc()
    set udg_Hero_Sil_UltiCount = ( 10 + ( 5 * GetUnitAbilityLevelSwapped('A118', GetTriggerUnit()) ) )
    call TriggerExecute( gg_trg_Silent_Area_Loop )
    loop
    exitwhen a > 12
        call CreateNUnitsAtLoc( 1, 'h01O', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(GetSpellTargetLoc(), 500.00, ( 30.00 * a )), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( ( 2.00 + I2R(GetUnitAbilityLevelSwapped('A118', GetTriggerUnit())) ), 'BTLF', GetLastCreatedUnit() )
    call SetUnitAnimation( GetLastCreatedUnit(), "stand work" )
    set a = a + 1
    endloop
    call CreateNUnitsAtLoc( 1, 'e027', GetOwningPlayer(GetTriggerUnit()), GetSpellTargetLoc(), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( ( 0.10 + I2R(GetUnitAbilityLevelSwapped('A118', GetTriggerUnit())) ), 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A11B', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A11B', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A118', GetTriggerUnit()) )
    if ( Trig_Silent_Area_Func017C() ) then
        call UnitAddAbilityBJ( 'A11E', GetLastCreatedUnit() )
    else
    endif
    call CreateNUnitsAtLoc( 1, 'h00G', GetOwningPlayer(GetTriggerUnit()), GetSpellTargetLoc(), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( ( 2.00 + I2R(GetUnitAbilityLevelSwapped('A118', GetTriggerUnit())) ), 'BTLF', GetLastCreatedUnit() )
    call SetUnitTimeScalePercent( GetLastCreatedUnit(), 25.00 )
endfunction

