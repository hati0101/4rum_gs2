function Trig_Assi_Skill_Add_Actions takes nothing returns nothing
    if ( Trig_Assi_Skill_Add_Func004C() ) then
        call StartTimerBJ( udg_Assi_Timer_Atk[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], false, 10.00 )
        call StartTimerBJ( udg_Assi_Timer[GetConvertedPlayerId(GetOwningPlayer(GetSpellTargetUnit()))], false, 10.00 )
        if ( Trig_Assi_Skill_Add_Func004Func004C() ) then
            call GroupAddUnitSimple( udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], udg_Assi_Group[GetConvertedPlayerId(GetOwningPlayer(GetSpellTargetUnit()))] )
        else
        endif
    else
        if ( Trig_Assi_Skill_Add_Func004Func002C() ) then
            set bj_forLoopAIndex = 8
            set bj_forLoopAIndexEnd = 12
            loop
                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                if ( Trig_Assi_Skill_Add_Func004Func002Func002Func001C() ) then
                    call StartTimerBJ( udg_Assi_Timer_Atk[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], false, 10.00 )
                    if ( Trig_Assi_Skill_Add_Func004Func002Func002Func001Func002C() ) then
                        call GroupAddUnitSimple( udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], udg_Assi_Group[udg_SP_Number[GetForLoopIndexA()]] )
                    else
                    endif
                else
                endif
                set bj_forLoopAIndex = bj_forLoopAIndex + 1
            endloop
        else
            set bj_forLoopAIndex = 2
            set bj_forLoopAIndexEnd = 6
            loop
                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                if ( Trig_Assi_Skill_Add_Func004Func002Func001Func001C() ) then
                    call StartTimerBJ( udg_Assi_Timer_Atk[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], false, 10.00 )
                    if ( Trig_Assi_Skill_Add_Func004Func002Func001Func001Func002C() ) then
                        call GroupAddUnitSimple( udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))], udg_Assi_Group[udg_SP_Number[GetForLoopIndexA()]] )
                    else
                    endif
                else
                endif
                set bj_forLoopAIndex = bj_forLoopAIndex + 1
            endloop
        endif
    endif
endfunction

