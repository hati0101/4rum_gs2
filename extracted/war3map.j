    call TriggerRegisterPlayerEventEndCinematic( gg_trg_Des_Special_3_ESC, Player(2) )
    call TriggerRegisterPlayerEventEndCinematic( gg_trg_Des_Special_3_ESC, Player(3) )
    call TriggerRegisterPlayerEventEndCinematic( gg_trg_Des_Special_3_ESC, Player(4) )
    call TriggerRegisterPlayerEventEndCinematic( gg_trg_Des_Special_3_ESC, Player(5) )
    call TriggerRegisterPlayerEventEndCinematic( gg_trg_Des_Special_3_ESC, Player(7) )
    call TriggerRegisterPlayerEventEndCinematic( gg_trg_Des_Special_3_ESC, Player(8) )
    call TriggerRegisterPlayerEventEndCinematic( gg_trg_Des_Special_3_ESC, Player(9) )
    call TriggerRegisterPlayerEventEndCinematic( gg_trg_Des_Special_3_ESC, Player(10) )
    call TriggerRegisterPlayerEventEndCinematic( gg_trg_Des_Special_3_ESC, Player(11) )
    call TriggerAddCondition( gg_trg_Des_Special_3_ESC, Condition( function Trig_Des_Special_3_ESC_Conditions ) )
