    if ( not ( IsUnitOwnedByPlayer(GetEventDamageSource(), Player(0)) != true ) ) then
        return false
    endif
    if ( not ( IsUnitOwnedByPlayer(GetEventDamageSource(), Player(6)) != true ) ) then
        return false
    endif
    if ( not ( IsUnitOwnedByPlayer(GetEventDamageSource(), Player(PLAYER_NEUTRAL_AGGRESSIVE)) != true ) ) then
        return false
    endif
    if ( not ( IsUnitAlly(GetEventDamageSource(), GetOwningPlayer(GetTriggerUnit())) != true ) ) then
        return false
    endif
    return true
endfunction

