// Trigger: Shadow Break
//===========================================================================
function Trig_Shadow_Break_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A09F' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Shadow_Break_Func004Func011C takes nothing returns boolean
    if ( ( CountLivingPlayerUnitsOfTypeId('e01F', GetOwningPlayer(GetTriggerUnit())) != 0 ) ) then
        return true
    endif
    return false
endfunction

function Trig_Shadow_Break_Func004C takes nothing returns boolean
    if ( not Trig_Shadow_Break_Func004Func011C() ) then
        return false
    endif
    return true
endfunction

function Trig_Shadow_Break_Actions takes nothing returns nothing
    call KillUnit( udg_Hero_BlS_SBIllusion )
    set udg_Hero_BlS_SBTarget = GetSpellTargetUnit()
    call TriggerSleepAction( 0.10 )
    if ( Trig_Shadow_Break_Func004C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(udg_Hero_BlS_SBTarget), GetUnitLoc(udg_Hero_BlS_SBTarget), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0K2', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0K2', GetLastCreatedUnit(), ( ( 4 + GetUnitAbilityLevelSwapped('A09F', udg_Hero_BlS) ) + ( 8 * GetPlayerTechCountSimple('R08X', GetOwningPlayer(udg_Hero_BlS)) ) ) )
        call IssueTargetOrderById( GetLastCreatedUnit(), 852274, udg_Hero_BlS_SBTarget )
    else
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(udg_Hero_BlS_SBTarget), GetUnitLoc(udg_Hero_BlS_SBTarget), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0K2', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0K2', GetLastCreatedUnit(), ( GetUnitAbilityLevelSwapped('A09F', udg_Hero_BlS) + ( 8 * GetPlayerTechCountSimple('R08X', GetOwningPlayer(udg_Hero_BlS)) ) ) )
        call IssueTargetOrderById( GetLastCreatedUnit(), 852274, udg_Hero_BlS_SBTarget )
    endif
endfunction

