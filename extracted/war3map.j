//===========================================================================
// Trigger: Counter Spell
//===========================================================================
function Trig_Counter_Spell_Conditions takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'BNmr') == true ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() != 'AItp' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() != 'A0WI' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() != 'A14Q' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() != 'A15I' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Counter_Spell_Actions takes nothing returns nothing
    call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0DD', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0DD', GetLastCreatedUnit(), ( GetUnitAbilityLevelSwapped('A0D6', udg_Hero_Mel) + ( 4 * GetPlayerTechCountSimple('R04J', GetOwningPlayer(udg_Hero_Mel)) ) ) )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "thunderbolt", GetTriggerUnit() )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0DF', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0DF', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0D6', udg_Hero_Mel) )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "soulburn", GetTriggerUnit() )
    call UnitDamageTargetBJ( udg_Hero_Mel, GetTriggerUnit(), ( 0.00 + ( ( 40.00 + ( 55.00 * I2R(GetPlayerTechCountSimple('R04J', GetOwningPlayer(udg_Hero_Mel))) ) ) * I2R(GetUnitAbilityLevelSwapped('A0D6', udg_Hero_Mel)) ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) - ( ( I2R(GetUnitAbilityLevelSwapped('A0D6', udg_Hero_Mel)) * ( 40.00 + ( 20.00 * I2R(GetPlayerTechCountSimple('R04J', GetOwningPlayer(udg_Hero_Mel))) ) ) ) + ( 20.00 * I2R(GetPlayerTechCountSimple('R04J', GetOwningPlayer(udg_Hero_Mel))) ) ) ) )
    call TextTag( "카운터 스펠!" , GetTriggerUnit() , 10 , 255 , 255 , 150, 3 )
    call UnitRemoveBuffBJ( 'BNmr', GetTriggerUnit() )
endfunction

