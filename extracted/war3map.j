    local integer i = 1
    loop
      exitwhen i > 12
      if ( GetUnitTypeId( udg_HeroPlayer[i] ) == 'Hant' ) then
        call CreateNUnitsAtLoc( 1, 'e018', ConvertedPlayer(i), GetPlayerStartLocationLoc(ConvertedPlayer(i)), bj_UNIT_FACING )
      endif
      set i = i + 1
    endloop
endfunction

