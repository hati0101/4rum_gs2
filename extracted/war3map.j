//===========================================================================
// Trigger: Thunder Lizard Chargeunit
//===========================================================================
function Trig_Thunder_Lizard_Chargeunit_Conditions takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetEnteringUnit()) == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_MECHANICAL) == false ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_MAGIC_IMMUNE) == false ) ) then
        return false
    endif
    if ( not ( GetEnteringUnit() != udg_Hero_ThL ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(GetEnteringUnit(), GetOwningPlayer(udg_Hero_ThL)) == true ) ) then
        return false
    endif
    if ( not ( IsUnitInGroup(GetEnteringUnit(), udg_Hero_ThL_group) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Thunder_Lizard_Chargeunit_Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_ThL) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Thunder_Lizard_Chargeunit_Actions takes nothing returns nothing
    if ( Trig_Thunder_Lizard_Chargeunit_Func001C() ) then
        call GroupAddUnitSimple( GetEnteringUnit(), udg_Hero_ThL_group )
        call AddSpecialEffectTargetUnitBJ( "origin", GetEnteringUnit(), "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(udg_Hero_ThL), GetUnitLoc(udg_Hero_ThL), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A117', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A117', GetLastCreatedUnit(), 4 )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "thunderbolt", GetEnteringUnit() )
        call PolledWait( 1.00 )
        call GroupRemoveGroup( udg_Hero_ThL_group, udg_Hero_ThL_group )
    else
    endif
endfunction

