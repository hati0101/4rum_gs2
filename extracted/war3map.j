//===========================================================================
// Trigger: NEW Perfect Incinerate
//===========================================================================
function Trig_NEW_Perfect_Incinerate_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0SD' ) ) then
        return false
    endif
    return true
endfunction

function Trig_NEW_Perfect_Incinerate_Func002C takes nothing returns boolean
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) <= I2R(( ( GetUnitAbilityLevelSwapped('A0SD', GetTriggerUnit()) * 100 ) + 50 )) ) ) then
        return false
    endif
    return true
endfunction

function Trig_NEW_Perfect_Incinerate_Actions takes nothing returns nothing
    // 체력체크
    if ( Trig_NEW_Perfect_Incinerate_Func002C() ) then
        call IssueImmediateOrderBJ( GetTriggerUnit(), "stop" )
        return
    else
        call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) - I2R(( ( GetUnitAbilityLevelSwapped('A0SD', GetTriggerUnit()) * 100 ) + 50 )) ) )
    endif
    // 퍼펙트 인시너레이트의 이펙트를 사용할 위습이 등장
    call CreateNUnitsAtLoc( 1, 'u00M', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
    call SetUnitTimeScalePercent( GetLastCreatedUnit(), 50.00 )
    // 퍼펙트 인시너레이트 캐스팅 소리
    call PlaySoundBJ( gg_snd_HeroFarseerYesAttack3 )
    set udg_Hero_FlE_UltiCaster = GetSpellAbilityUnit()
    call StartTimerBJ( udg_Hero_FlE_UltiTimer, false, 1.00 )
endfunction

//===========================================================================
function InitTrig_NEW_Perfect_Incinerate takes nothing returns nothing
    set gg_trg_NEW_Perfect_Incinerate = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_NEW_Perfect_Incinerate, EVENT_PLAYER_UNIT_SPELL_CAST )
    call TriggerAddCondition( gg_trg_NEW_Perfect_Incinerate, Condition( function Trig_NEW_Perfect_Incinerate_Conditions ) )
    call TriggerAddAction( gg_trg_NEW_Perfect_Incinerate, function Trig_NEW_Perfect_Incinerate_Actions )
endfunction

//===========================================================================
// Trigger: NEW Perfect Incinerate Timer
//===========================================================================
function Trig_NEW_Perfect_Incinerate_Timer_Func010C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R064', GetOwningPlayer(udg_Hero_FlE_UltiCaster)) > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_NEW_Perfect_Incinerate_Timer_Actions takes nothing returns nothing
    // 실제 데미지 주는 스킬 발동
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(udg_Hero_FlE_UltiCaster), GetUnitLoc(udg_Hero_FlE_UltiCaster), ( I2R(( GetForLoopIndexB() - 1 )) * 30.00 ) )
    call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0IZ', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0IZ', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0SD', udg_Hero_FlE_UltiCaster) )
    call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
    // 원둘래로 위습이 둥글레 파이어 웨이브가 원을 그리며 발사됨
    set bj_forLoopBIndex = 1
    set bj_forLoopBIndexEnd = 12
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call CreateNUnitsAtLoc( 1, 'e01K', GetOwningPlayer(udg_Hero_FlE_UltiCaster), GetUnitLoc(udg_Hero_FlE_UltiCaster), ( I2R(( GetForLoopIndexB() - 1 )) * 30.00 ) )
        call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0SG', GetLastCreatedUnit() )
        call IssuePointOrderLocBJ( GetLastCreatedUnit(), "breathoffrost", PolarProjectionBJ(GetUnitLoc(GetLastCreatedUnit()), 5.00, ( I2R(( GetForLoopIndexB() - 1 )) * 30.00 )) )
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
    // 화염충격
    if ( Trig_NEW_Perfect_Incinerate_Timer_Func010C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(udg_Hero_FlE_UltiCaster), GetUnitLoc(udg_Hero_FlE_UltiCaster), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 10.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0SE', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0SE', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0SD', udg_Hero_FlE_UltiCaster) )
        call IssuePointOrderLocBJ( GetLastCreatedUnit(), "rainoffire", GetUnitLoc(GetLastCreatedUnit()) )
    else
    endif
endfunction

//===========================================================================
function InitTrig_NEW_Perfect_Incinerate_Timer takes nothing returns nothing
    set gg_trg_NEW_Perfect_Incinerate_Timer = CreateTrigger(  )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_NEW_Perfect_Incinerate_Timer, udg_Hero_FlE_UltiTimer )
    call TriggerAddAction( gg_trg_NEW_Perfect_Incinerate_Timer, function Trig_NEW_Perfect_Incinerate_Timer_Actions )
endfunction

