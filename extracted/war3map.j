function Trig_VaL_Skill_Effect_Actions takes nothing returns nothing
    set udg_Hero_VaL_Vam[1] = 'I06D'
    set udg_Hero_VaL_Vam[2] = 'I06C'
    set udg_Hero_VaL_Vam[3] = 'I02O'
    set udg_Hero_VaL_Vam[4] = 'I06S'
    if ( Trig_VaL_Skill_Effect_Func005C() ) then
        call UnitAddItemByIdSwapped( 'I06V', GetTriggerUnit() )
    else
    endif
    if ( Trig_VaL_Skill_Effect_Func006C() ) then
        call UnitAddItemByIdSwapped( udg_Hero_VaL_Vam[GetUnitAbilityLevelSwapped('A0V9', GetTriggerUnit())], GetTriggerUnit() )
    else
    endif
    if ( Trig_VaL_Skill_Effect_Func007C() ) then
        set udg_Hero_VaL_Hero = GetTriggerUnit()
        set udg_Hero_VaL_SBS_Boolean = true
        call PlaySoundBJ( gg_snd_TichondriusWarcry1 )
        call PolledWait( 25.00 )
        set udg_Hero_VaL_SBS_Boolean = false
    else
    endif
    if ( Trig_VaL_Skill_Effect_Func008C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A09H', GetLastCreatedUnit() )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "cripple", GetSpellTargetUnit() )
    else
    endif
    if ( Trig_VaL_Skill_Effect_Func009C() ) then
        set bj_wantDestroyGroup=true
        call ForGroupBJ( GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_VaL_Skill_Effect_Func009Func002001002)), function Trig_VaL_Skill_Effect_Func009Func002A )
    else
    endif
endfunction

