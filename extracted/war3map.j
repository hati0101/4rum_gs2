    call TextTagForce( I2S(udg_Hero_DeM_Soul), udg_Hero_DeM, 10,255, 50, 150, 3, GetForceOfPlayer(GetOwningPlayer(udg_Hero_DeM)) )
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Undead\\DeathPact\\DeathPactCaster.mdl" )
