    set gg_trg_Moon_Blink = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Moon_Blink, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Moon_Blink, Condition( function Trig_Moon_Blink_Conditions ) )
    call TriggerAddAction( gg_trg_Moon_Blink, function Trig_Moon_Blink_Actions )
endfunction

//===========================================================================
// Trigger: Moon Protection
//===========================================================================
function Trig_Moon_Protection_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0GA' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Moon_Protection_Func005C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R057', GetOwningPlayer(udg_Hero_MoW[1])) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Moon_Protection_Actions takes nothing returns nothing
    set udg_Hero_MoW_MPOn = true
    set udg_Hero_MoW_Loc[2] = GetUnitLoc(GetSpellAbilityUnit())
    call StartTimerBJ( udg_Hero_MoW_MP_Timer, true, 0.03 )
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 3
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetSpellAbilityUnit()), udg_Hero_MoW_Loc[2], bj_UNIT_FACING )
        set udg_Hero_MoW_MPCaster2[GetForLoopIndexA()] = GetLastCreatedUnit()
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0TX', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0TX', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0GA', GetSpellAbilityUnit()) )
        call IssueTargetOrderBJ( udg_Hero_MoW_MPCaster2[GetForLoopIndexA()], "rejuvination", udg_Hero_MoW[GetForLoopIndexA()] )
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetSpellAbilityUnit()), udg_Hero_MoW_Loc[2], bj_UNIT_FACING )
        set udg_Hero_MoW_MPCaster[GetForLoopIndexA()] = GetLastCreatedUnit()
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0FP', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0FP', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0GA', GetSpellAbilityUnit()) )
        call IssueTargetOrderBJ( udg_Hero_MoW_MPCaster[GetForLoopIndexA()], "sleep", udg_Hero_MoW[GetForLoopIndexA()] )
        call UnitAddAbilityBJ( 'Avul', udg_Hero_MoW[GetForLoopIndexA()] )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    if ( Trig_Moon_Protection_Func005C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetSpellAbilityUnit()), udg_Hero_MoW_Loc[2], bj_UNIT_FACING )
        set udg_Hero_MoW_StarfallCaster = GetLastCreatedUnit()
        call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0G9', GetLastCreatedUnit() )
        call IssueImmediateOrderBJ( udg_Hero_MoW_StarfallCaster, "starfall" )
    else
    endif
    call EnableTrigger( gg_trg_Moon_Protection_Timer )
    call PolledWait( ( 1 + ( 1 * I2R(GetUnitAbilityLevelSwapped('A0GA', GetTriggerUnit())) ) ) )
    call PauseTimerBJ( true, udg_Hero_MoW_MP_Timer )
    call RemoveLocation( udg_Hero_MoW_Loc[2] )
endfunction

//===========================================================================
function InitTrig_Moon_Protection takes nothing returns nothing
    set gg_trg_Moon_Protection = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Moon_Protection, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Moon_Protection, Condition( function Trig_Moon_Protection_Conditions ) )
    call TriggerAddAction( gg_trg_Moon_Protection, function Trig_Moon_Protection_Actions )
endfunction

//===========================================================================
// Trigger: Moon Protection Timer
//===========================================================================
function Trig_Moon_Protection_Timer_Func001C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_Hero_MoW[1], 'B00B') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Moon_Protection_Timer_Actions takes nothing returns nothing
    if ( Trig_Moon_Protection_Timer_Func001C() ) then
        return
    else
        call PauseTimerBJ( true, udg_Hero_MoW_MP_Timer )
        set bj_forLoopAIndex = 1
        set bj_forLoopAIndexEnd = 3
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call UnitRemoveAbilityBJ( 'Avul', udg_Hero_MoW[GetForLoopIndexA()] )
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
        call DisableTrigger( GetTriggeringTrigger() )
        call TriggerExecute( gg_trg_Stop_Moon_Protection_2 )
    endif
endfunction

//===========================================================================
function InitTrig_Moon_Protection_Timer takes nothing returns nothing
    set gg_trg_Moon_Protection_Timer = CreateTrigger(  )
    call DisableTrigger( gg_trg_Moon_Protection_Timer )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Moon_Protection_Timer, udg_Hero_MoW_MP_Timer )
    call TriggerAddAction( gg_trg_Moon_Protection_Timer, function Trig_Moon_Protection_Timer_Actions )
endfunction

//===========================================================================
// Trigger: Stop Moon Protection
//===========================================================================
function Trig_Stop_Moon_Protection_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(udg_Hero_MoW[1]) == GetTriggerPlayer() ) ) then
        return false
    endif
    if ( not ( udg_Hero_MoW_MPOn == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Stop_Moon_Protection_Actions takes nothing returns nothing
    set udg_Hero_MoW_MPOn = false
    call RemoveUnit( udg_Hero_MoW_StarfallCaster )
    call UnitRemoveBuffsExBJ( bj_BUFF_POLARITY_EITHER, bj_BUFF_RESIST_EITHER, udg_Hero_MoW[1], true, true )
    call UnitRemoveBuffsExBJ( bj_BUFF_POLARITY_EITHER, bj_BUFF_RESIST_EITHER, udg_Hero_MoW[2], true, true )
    call UnitRemoveBuffsExBJ( bj_BUFF_POLARITY_EITHER, bj_BUFF_RESIST_EITHER, udg_Hero_MoW[3], true, true )
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 3
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call UnitRemoveAbilityBJ( 'Avul', udg_Hero_MoW[GetForLoopIndexA()] )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Stop_Moon_Protection takes nothing returns nothing
    set gg_trg_Stop_Moon_Protection = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Stop_Moon_Protection, Condition( function Trig_Stop_Moon_Protection_Conditions ) )
    call TriggerAddAction( gg_trg_Stop_Moon_Protection, function Trig_Stop_Moon_Protection_Actions )
endfunction

