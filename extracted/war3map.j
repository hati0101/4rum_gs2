    set gg_trg_Counter_Spell = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Counter_Spell, EVENT_PLAYER_UNIT_SPELL_CAST )
    call TriggerAddCondition( gg_trg_Counter_Spell, Condition( function Trig_Counter_Spell_Conditions ) )
