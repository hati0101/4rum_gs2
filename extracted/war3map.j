//===========================================================================
// Trigger: Leap Attack
//===========================================================================
function Trig_Leap_Attack_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0AV' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Leap_Attack_Actions takes nothing returns nothing
    local effect a
    call AddSpecialEffectTargetUnitBJ( "weapon", GetTriggerUnit(), "Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile_mini.mdl" )
    set a = GetLastCreatedEffectBJ()
    call PlaySoundBJ( gg_snd_GromYesAttack4 )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(GetSpellTargetLoc(), -100.00, GetUnitFacing(GetTriggerUnit())), bj_UNIT_FACING )
    // 갈수 없는 지역을 표시함
    call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
    set udg_Hero_Gla = GetTriggerUnit()
    set udg_Hero_Gla_LeapHeight = DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(GetLastCreatedUnit()))
    // 스킬 지점의 거리를 설정
    set udg_Hero_Gla_LeapAngle = AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(GetLastCreatedUnit()))
    // 날아갈 각도를 생성
    call UnitAddAbilityBJ( 'Arav', GetTriggerUnit() )
    call UnitRemoveAbilityBJ( 'Arav', GetTriggerUnit() )
    set udg_Hero_Gla_LeapStartLoc = GetUnitLoc(GetTriggerUnit())
    // 스킬을 사용한 지점과, 날아가는 높이와 속도를 설정
    set udg_Hero_Gla_LeapEndLoc = GetUnitLoc(GetLastCreatedUnit())
    // 날아가는 높이와 속도를 설정
    call SetUnitPathing( GetTriggerUnit(), false )
    call PauseUnitBJ( true, GetTriggerUnit() )
    call SetUnitInvulnerable( GetTriggerUnit(), true )
    // 유닛의 충돌 크기를 꺼주고, 유닛을 무적으로 만들어서 원활히 날아가게 함
    call SetUnitTimeScalePercent( GetTriggerUnit(), 70.00 )
    call SetUnitAnimation( GetTriggerUnit(), "slam" )
    call SetUnitFlyHeightBJ( GetTriggerUnit(), ( DistanceBetweenPoints(udg_Hero_Gla_LeapStartLoc, udg_Hero_Gla_LeapEndLoc) / 2.00 ), ( DistanceBetweenPoints(GetUnitLoc(udg_Hero_Gla), udg_Hero_Gla_LeapEndLoc) * 1.30 ) )
    call EnableTrigger( gg_trg_Leap_Attack_Up )
    call PolledWait( 0.80 )
    call DestroyEffectBJ( a )
    set a = null
endfunction

//===========================================================================
function InitTrig_Leap_Attack takes nothing returns nothing
    set gg_trg_Leap_Attack = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Leap_Attack, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Leap_Attack, Condition( function Trig_Leap_Attack_Conditions ) )
    call TriggerAddAction( gg_trg_Leap_Attack, function Trig_Leap_Attack_Actions )
endfunction

//===========================================================================
// Trigger: Leap Attack Up
//===========================================================================
function Trig_Leap_Attack_Up_Func006C takes nothing returns boolean
    if ( not ( udg_Hero_Gla_LeapIndex == 2 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Leap_Attack_Up_Func007C takes nothing returns boolean
    if ( not ( udg_Hero_Gla_LeapIndex == 15 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Leap_Attack_Up_Actions takes nothing returns nothing
    set udg_Hero_Gla_LeapIndex = ( udg_Hero_Gla_LeapIndex + 1 )
    // 갈 거리를 표시함
    call SetUnitPositionLoc( udg_Hero_Gla, PolarProjectionBJ(udg_Hero_Gla_LeapStartLoc, ( I2R(udg_Hero_Gla_LeapIndex) * ( udg_Hero_Gla_LeapHeight / 21.43 ) ), udg_Hero_Gla_LeapAngle) )
    // 유닛을 이동 시킴 나누는 숫자가 클수록 느려짐
    if ( Trig_Leap_Attack_Up_Func006C() ) then
        call SetUnitTimeScalePercent( GetTriggerUnit(), 10.00 )
    else
    endif
    if ( Trig_Leap_Attack_Up_Func007C() ) then
        call SetUnitFlyHeightBJ( udg_Hero_Gla, 0.00, ( DistanceBetweenPoints(udg_Hero_Gla_LeapStartLoc, udg_Hero_Gla_LeapEndLoc) * 1.50 ) )
        set udg_Hero_Gla_LeapIndex = 0
        call DisableTrigger( GetTriggeringTrigger() )
        call EnableTrigger( gg_trg_Leap_Attack_Down )
        // 유닛이 내려가는 트리거를 켜주면서 고도도 내려줌
    else
    endif
endfunction

