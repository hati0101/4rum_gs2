//===========================================================================
// Trigger: Starting Environment
//===========================================================================
function Trig_Starting_Environment_Func002Func001C takes nothing returns boolean
    if ( not ( GetForLoopIndexA() != 1 ) ) then
        return false
    endif
    if ( not ( GetForLoopIndexA() != 7 ) ) then
        return false
    endif
    if ( not ( GetPlayerSlotState(ConvertedPlayer(GetForLoopIndexA())) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    if ( not ( GetPlayerController(ConvertedPlayer(GetForLoopIndexA())) == MAP_CONTROL_USER ) ) then
        return false
    endif
    return true
endfunction

function Trig_Starting_Environment_Func011A takes nothing returns nothing
    call SetPlayerHandicapXPBJ( GetEnumPlayer(), 105.00 )
endfunction

function Trig_Starting_Environment_Func018A takes nothing returns nothing
    call SetPlayerHandicapXPBJ( GetEnumPlayer(), 125.00 )
endfunction

function Trig_Starting_Environment_Actions takes nothing returns nothing
    local integer StartPlayer = 0
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_Starting_Environment_Func002Func001C() ) then
            // 게임 중인 인원 수 세기 (일반유닛팀 제외)
            set StartPlayer = StartPlayer+1
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    if StartPlayer > 8 then
    call TriggerRegisterTimerEventPeriodic( gg_trg_Unit_Upgrade, 600.00 )
    elseif StartPlayer > 6 then
    set udg_GiveGoldAmount[1] = ( udg_GiveGoldAmount[1] + 4 )
    set udg_GiveGoldAmount[2] = ( udg_GiveGoldAmount[2] + 4 )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Unit_Upgrade, 480.00 )
    call SetPlayerTechResearchedSwap( 'R054', 1, udg_Force[1] )
    call SetPlayerTechResearchedSwap( 'R054', 1, udg_Force[2] )
    call ForForce( GetPlayersAll(), function Trig_Starting_Environment_Func011A )
    else
    set udg_GiveGoldAmount[1] = ( udg_GiveGoldAmount[1] + 8 )
    set udg_GiveGoldAmount[2] = ( udg_GiveGoldAmount[2] + 8 )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Unit_Upgrade, 360.00 )
    call SetPlayerTechResearchedSwap( 'R054', 2, udg_Force[1] )
    call SetPlayerTechResearchedSwap( 'R054', 2, udg_Force[2] )
    call ForForce( GetPlayersAll(), function Trig_Starting_Environment_Func018A )
    endif
    if StartPlayer == 1 then
    set udg_ModeSingle = true
    call DisplayTimedTextToForce( GetPlayersAll(), 60.00, "TRIGSTR_833" )
    call DisplayTimedTextToForce( GetPlayersAll(), 60.00, "TRIGSTR_932" )
    endif
endfunction

//===========================================================================
function InitTrig_Starting_Environment takes nothing returns nothing
    set gg_trg_Starting_Environment = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Starting_Environment, function Trig_Starting_Environment_Actions )
endfunction

//===========================================================================
// Trigger: Unit Upgrade
//===========================================================================
function Trig_Unit_Upgrade_Actions takes nothing returns nothing
    call SetPlayerTechResearchedSwap( 'R01Q', ( GetPlayerTechCountSimple('R01Q', udg_Force[1]) + 1 ), udg_Force[1] )
    call SetPlayerTechResearchedSwap( 'R01R', ( GetPlayerTechCountSimple('R01R', udg_Force[1]) + 1 ), udg_Force[1] )
    call SetPlayerTechResearchedSwap( 'R01Q', ( GetPlayerTechCountSimple('R01Q', udg_Force[2]) + 1 ), udg_Force[2] )
    call SetPlayerTechResearchedSwap( 'R01R', ( GetPlayerTechCountSimple('R01R', udg_Force[2]) + 1 ), udg_Force[2] )
    call SetPlayerTechResearchedSwap( 'R085', ( GetPlayerTechCountSimple('R085', udg_Force[1]) + 1 ), udg_Force[1] )
    call SetPlayerTechResearchedSwap( 'R085', ( GetPlayerTechCountSimple('R085', udg_Force[2]) + 1 ), udg_Force[2] )
    set bj_forLoopAIndex = 2
    set bj_forLoopAIndexEnd = 6
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetPlayerTechResearchedSwap( 'R01T', ( GetPlayerTechCountSimple('R01T', ConvertedPlayer(GetForLoopIndexA())) + 1 ), ConvertedPlayer(GetForLoopIndexA()) )
        call SetPlayerTechResearchedSwap( 'R04F', ( GetPlayerTechCountSimple('R01T', ConvertedPlayer(GetForLoopIndexA())) + 1 ), ConvertedPlayer(GetForLoopIndexA()) )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set bj_forLoopAIndex = 8
    set bj_forLoopAIndexEnd = 16
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetPlayerTechResearchedSwap( 'R01T', ( GetPlayerTechCountSimple('R01T', ConvertedPlayer(GetForLoopIndexA())) + 1 ), ConvertedPlayer(GetForLoopIndexA()) )
        call SetPlayerTechResearchedSwap( 'R04F', ( GetPlayerTechCountSimple('R01T', ConvertedPlayer(GetForLoopIndexA())) + 1 ), ConvertedPlayer(GetForLoopIndexA()) )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Unit_Upgrade takes nothing returns nothing
    set gg_trg_Unit_Upgrade = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Unit_Upgrade, function Trig_Unit_Upgrade_Actions )
endfunction

