function InitTrig_Retreat_Casting takes nothing returns nothing
    set gg_trg_Retreat_Casting = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Retreat_Casting, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Retreat_Casting, Condition( function Trig_retreat_Conditions ) )
    call TriggerAddAction( gg_trg_Retreat_Casting, function Trig_retreat_Actions )
endfunction


