///이펙트 삭제 관련 함수

function d_effect_action takes nothing returns nothing
    local effect e = udg_d_effect_e
    local real t = udg_d_effect_t
    call PolledWait( t )
    call DestroyEffectBJ( e )
    call DestroyTrigger( GetTriggeringTrigger() )
endfunction

function d_effect takes effect e, real t returns nothing
    local trigger tr = CreateTrigger()
    set udg_d_effect_e = e
    set udg_d_effect_t = t
    call TriggerAddAction( tr, function d_effect_action )
    call TriggerExecute( tr )
    set tr = null
endfunction


///커스텀값으로 유닛 인벤토리에서 아이템 없애기 or 스택 줄이기

function RemoveMixItem takes integer t, unit u returns nothing
    local integer a = 0
    if GetItemUserData(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(u))]) == t then
        if GetItemType(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(u))]) == ITEM_TYPE_CHARGED and GetItemCharges(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(u))]) > 1 then
        call SetItemCharges(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(u))], GetItemCharges(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(u))]) - 1)
        return
        else
        call RemoveItem(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(u))])
        return
        endif
    endif
    loop
    exitwhen a > 5
    if GetItemUserData(UnitItemInSlot(u, a)) == t then
        if GetItemType(UnitItemInSlot(u, a)) == ITEM_TYPE_CHARGED and GetItemCharges(UnitItemInSlot(u, a)) > 1 then
        call SetItemCharges(UnitItemInSlot(u, a), GetItemCharges(UnitItemInSlot(u, a)) - 1)
        return
        else
        call RemoveItem(UnitItemInSlot(u, a))
        return
        endif
    endif    
    set a = a + 1
    endloop
endfunction

///아이템 숫자 세는 스크립트(소모품일 경우 숫자 세어줌)

function CountItem takes integer t, unit u returns integer
    local integer index = 0
    local integer a = 0
    if GetItemUserData(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(u))]) == t then
        if GetItemType(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(u))]) == ITEM_TYPE_CHARGED and GetItemCharges(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(u))]) > 1 then
        set index = index + GetItemCharges(udg_ItemTaken[GetConvertedPlayerId(GetOwningPlayer(u))])
        else
        set index = index + 1
        endif
    endif
    loop
    exitwhen a > 5
    if GetItemUserData(UnitItemInSlot(u, a)) == t then
        if GetItemType(UnitItemInSlot(u, a)) == ITEM_TYPE_CHARGED and GetItemCharges(UnitItemInSlot(u, a)) > 1 then
        set index = index + GetItemCharges(UnitItemInSlot(u, a))
        else
        set index = index + 1
        endif
    endif 
    set a = a + 1
    endloop
    return index
endfunction

///아이템 조합 스크립트

function ItemMix takes integer index, unit u returns nothing
    local string DB = udg_ItemMix_DB[index]
    local string array m
    local integer x = 1
    local integer a = 1
    local boolean MixFail = false
    set m[1] = ""
    set m[2] = ""
    set m[3] = ""
    set m[4] = ""
    // DB 해석
    loop
    exitwhen StringLength(DB) < 4
    set m[x] = SubStringBJ(DB, 1, 4)
    set DB = SubStringBJ(DB, 5, StringLength(DB))
    set x = x + 1
    endloop
    // 아이템 체크
    loop
    exitwhen a == x
    if SubStringBJ(m[a], 4, 4) == " " then
        if CountItem(S2I(SubStringBJ(m[a], 1, 3)),u) > 0 then
        else
        set MixFail = true
        endif
    else
        if CountItem(S2I(SubStringBJ(m[a], 1, 3)),u) >= S2I(SubStringBJ(m[a], 4, 4)) then
        else
        set MixFail = true
        endif
    endif
    set a = a + 1
    endloop
    // 아이템 생성
    if MixFail == false then
    set a = 1
    call RemoveMixItem(index,u)
    loop
    exitwhen StringLength(m[a]) == 0
    call RemoveMixItem(S2I(SubStringBJ(m[a], 1, 3)),u)
    if S2I(SubStringBJ(m[a], 4, 4)) == 2 then
    call RemoveMixItem(S2I(SubStringBJ(m[a], 1, 3)),u)
    elseif S2I(SubStringBJ(m[a], 4, 4)) == 3 then
    call RemoveMixItem(S2I(SubStringBJ(m[a], 1, 3)),u)
    call RemoveMixItem(S2I(SubStringBJ(m[a], 1, 3)),u)
    endif
    set a = a + 1
    endloop
    call CreateItemLoc( udg_ItemType[S2I(DB)], GetUnitLoc(u) )
    call SetItemUserData( GetLastCreatedItem(), R2I(GetItemLifeBJ(GetLastCreatedItem())) )
    call UnitAddItemSwapped( GetLastCreatedItem(), u )
    call AddSpecialEffectTargetUnitBJ( "origin", u, "Abilities\\Spells\\Items\\AIlm\\AIlmTarget.mdl" )
    call d_effect(GetLastCreatedEffectBJ(),2)
    return
    endif
    // 실패시 변수 초기화 및 레시피 2단계 입력
    if StringLength(udg_ItemMix_DB_2[index]) > 0 then
    else
    return
    endif
    set DB = udg_ItemMix_DB_2[index]
    set m[1] = ""
    set m[2] = ""
    set m[3] = ""
    set m[4] = ""
    set x = 1
    set a = 1
    set MixFail = false
    // DB 해석
    loop
    exitwhen StringLength(DB) < 4
    set m[x] = SubStringBJ(DB, 1, 4)
    set DB = SubStringBJ(DB, 5, StringLength(DB))
    set x = x + 1
    endloop
    // 아이템 체크
    loop
    exitwhen a == x
    if SubStringBJ(m[a], 4, 4) == " " then
        if CountItem(S2I(SubStringBJ(m[a], 1, 3)),u) > 0 then
        else
        set MixFail = true
        endif
    else
        if CountItem(S2I(SubStringBJ(m[a], 1, 3)),u) >= S2I(SubStringBJ(m[a], 4, 4)) then
        else
        set MixFail = true
        endif
    endif
    set a = a + 1
    endloop
    // 아이템 생성
    if MixFail == false then
    set a = 1
    call RemoveMixItem(index,u)
    loop
    exitwhen StringLength(m[a]) == 0
    call RemoveMixItem(S2I(SubStringBJ(m[a], 1, 3)),u)
    if S2I(SubStringBJ(m[a], 4, 4)) == 2 then
    call RemoveMixItem(S2I(SubStringBJ(m[a], 1, 3)),u)
    elseif S2I(SubStringBJ(m[a], 4, 4)) == 3 then
    call RemoveMixItem(S2I(SubStringBJ(m[a], 1, 3)),u)
    call RemoveMixItem(S2I(SubStringBJ(m[a], 1, 3)),u)
    endif
    set a = a + 1
    endloop
    call CreateItemLoc( udg_ItemType[S2I(DB)], GetUnitLoc(u) )
    call SetItemUserData( GetLastCreatedItem(), R2I(GetItemLifeBJ(GetLastCreatedItem())) )
    call UnitAddItemSwapped( GetLastCreatedItem(), u )
    call AddSpecialEffectTargetUnitBJ( "origin", u, "Abilities\\Spells\\Items\\AIlm\\AIlmTarget.mdl" )
    call d_effect(GetLastCreatedEffectBJ(), 2)
    return
    endif
    // 실패시 변수 초기화 및 레시피 2단계 입력
    if StringLength(udg_ItemMix_DB_3[index]) > 0 then
    else
    return
    endif
    set DB = udg_ItemMix_DB_3[index]
    set m[1] = ""
    set m[2] = ""
    set m[3] = ""
    set m[4] = ""
    set x = 1
    set a = 1
    set MixFail = false
    // DB 해석
    loop
    exitwhen StringLength(DB) < 4
    set m[x] = SubStringBJ(DB, 1, 4)
    set DB = SubStringBJ(DB, 5, StringLength(DB))
    set x = x + 1
    endloop
    // 아이템 체크
    loop
    exitwhen a == x
    if SubStringBJ(m[a], 4, 4) == " " then
        if CountItem(S2I(SubStringBJ(m[a], 1, 3)),u) > 0 then
        else
        set MixFail = true
        endif
    else
        if CountItem(S2I(SubStringBJ(m[a], 1, 3)),u) >= S2I(SubStringBJ(m[a], 4, 4)) then
        else
        set MixFail = true
        endif
    endif
    set a = a + 1
    endloop
    // 아이템 생성
    if MixFail == false then
    set a = 1
    call RemoveMixItem(index,u)
    loop
    exitwhen StringLength(m[a]) == 0
    call RemoveMixItem(S2I(SubStringBJ(m[a], 1, 3)),u)
    if S2I(SubStringBJ(m[a], 4, 4)) == 2 then
    call RemoveMixItem(S2I(SubStringBJ(m[a], 1, 3)),u)
    elseif S2I(SubStringBJ(m[a], 4, 4)) == 3 then
    call RemoveMixItem(S2I(SubStringBJ(m[a], 1, 3)),u)
    call RemoveMixItem(S2I(SubStringBJ(m[a], 1, 3)),u)
    endif
    set a = a + 1
    endloop
    call CreateItemLoc( udg_ItemType[S2I(DB)], GetUnitLoc(u) )
    call SetItemUserData( GetLastCreatedItem(), R2I(GetItemLifeBJ(GetLastCreatedItem())) )
    call UnitAddItemSwapped( GetLastCreatedItem(), u )
    call AddSpecialEffectTargetUnitBJ( "origin", u, "Abilities\\Spells\\Items\\AIlm\\AIlmTarget.mdl" )
    call d_effect(GetLastCreatedEffectBJ(),2)
    return
    endif
endfunction

///절대 데미지 스크립트

function AbsoluteDamage takes unit u, unit target, real dmg returns nothing
    if GetUnitStateSwap(UNIT_STATE_LIFE, target) > dmg then
    call SetUnitLifeBJ( target, GetUnitStateSwap(UNIT_STATE_LIFE, target) - dmg )
    else
    call UnitRemoveBuffsBJ( bj_REMOVEBUFFS_ALL, target)
    call SetUnitInvulnerable( target, false )
    call SetUnitLifeBJ( target, 1 )
    call UnitDamageTargetBJ( u, target, 99, ATTACK_TYPE_HERO, DAMAGE_TYPE_UNIVERSAL )
    endif
endfunction

///무적 체크

function GetDamageFactor takes unit u, attacktype a, damagetype d returns real
    local real hp=GetWidgetLife(u)
    local real r=hp
    if (hp<1.0) then
        call SetWidgetLife(u,1.0)
        set r=1
    endif
    call UnitDamageTarget(u,u,0.01,true,false,a,d,null)
    set r=(r-GetWidgetLife(u))*100
    call SetWidgetLife(u,hp)
    return r
endfunction

function IsUnitInvulnerable takes unit u returns boolean
    return (GetDamageFactor(u,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)==0.0)
endfunction

///최단거리 유닛 함수

function GetNearUnit takes unit a, group g returns unit
    local unit u = FirstOfGroup(g)
    local unit v = u
    local real dx
    local real dy
    local real best
    local real candidate
    if u == null then
        return null
    endif
    set dx = GetUnitX(a) - GetUnitX(u)
    set dy = GetUnitY(a) - GetUnitY(u)
    set best = dx * dx + dy * dy
    call GroupRemoveUnitSimple(u,g)
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        set dx = GetUnitX(a) - GetUnitX(u)
        set dy = GetUnitY(a) - GetUnitY(u)
        set candidate = dx * dx + dy * dy
        if candidate < best then
            set v = u
            set best = candidate
        endif
        call GroupRemoveUnitSimple(u,g)
    endloop
    set u = null
    return v
endfunction

///유닛 부착 함수

function MakeUnitFollow_Sub takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local location followLoc
    if (LoadIntegerBJ(GetHandleIdBJ(t), StringHashBJ("Follow3"), GetLastCreatedHashtableBJ()) >= 0) and IsUnitAliveBJ(LoadUnitHandleBJ(GetHandleIdBJ(t),StringHashBJ("Follow2"), GetLastCreatedHashtableBJ())) == true and IsUnitAliveBJ(LoadUnitHandleBJ(GetHandleIdBJ(t),StringHashBJ("Follow1"), GetLastCreatedHashtableBJ())) == true then
        set followLoc = GetUnitLoc(LoadUnitHandleBJ(GetHandleIdBJ(t),StringHashBJ("Follow2"), GetLastCreatedHashtableBJ()))
        call SetUnitPositionLoc( LoadUnitHandleBJ(GetHandleIdBJ(t),StringHashBJ("Follow1"), GetLastCreatedHashtableBJ()), followLoc )
        call RemoveLocation(followLoc)
        call SetUnitFacing( LoadUnitHandleBJ(GetHandleIdBJ(t),StringHashBJ("Follow1"), GetLastCreatedHashtableBJ()), GetUnitFacing(LoadUnitHandleBJ(GetHandleIdBJ(t),StringHashBJ("Follow2"), GetLastCreatedHashtableBJ())) )
        call SaveIntegerBJ( ( LoadIntegerBJ(GetHandleIdBJ(t), StringHashBJ("Follow3"), GetLastCreatedHashtableBJ()) - 1 ), GetHandleIdBJ(t), StringHashBJ("Follow3"), GetLastCreatedHashtableBJ() )
    else
        call RemoveUnit( LoadUnitHandleBJ(GetHandleIdBJ(t), StringHashBJ("Follow1"), GetLastCreatedHashtableBJ()) )
        call DestroyTimer(t)
    endif
    set followLoc = null
    set t = null
endfunction

function MakeUnitFollow takes unit u, unit target, integer time returns nothing
    local timer t = CreateTimer()
    local integer r = time * 25
    call SaveUnitHandleBJ( u, GetHandleIdBJ(t), StringHashBJ("Follow1"), GetLastCreatedHashtableBJ() )
    call SaveUnitHandleBJ( target, GetHandleIdBJ(t), StringHashBJ("Follow2"), GetLastCreatedHashtableBJ() )
    call SaveIntegerBJ( r, GetHandleIdBJ(t), StringHashBJ("Follow3"), GetLastCreatedHashtableBJ() )
    call TimerStart(t, 0.04, true, function MakeUnitFollow_Sub)
endfunction 

///넉백 함수

function Knockback_Action takes nothing returns nothing
    local real x = ( LoadRealBJ(GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("KnockBack4"), GetLastCreatedHashtableBJ()) * CosBJ(LoadRealBJ(GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("KnockBack2"), GetLastCreatedHashtableBJ())) )
    local real y = ( LoadRealBJ(GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("KnockBack4"), GetLastCreatedHashtableBJ()) * SinBJ(LoadRealBJ(GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("KnockBack2"), GetLastCreatedHashtableBJ())) )
    local unit u = LoadUnitHandleBJ(GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("KnockBack1"), GetLastCreatedHashtableBJ())
    local location knockLoc = Location(GetUnitX(u)+x, GetUnitY(u)+y)
    local item i = CreateItemLoc( 'texp', knockLoc )
    call RemoveLocation(knockLoc)
    call SetUnitX(u,GetItemX(i))
    call SetUnitY(u,GetItemY(i))
    call RemoveItem( i )
    call SaveRealBJ( ( LoadRealBJ(GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("KnockBack3"), GetLastCreatedHashtableBJ()) - LoadRealBJ(GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("KnockBack4"), GetLastCreatedHashtableBJ()) ), GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("KnockBack3"), GetLastCreatedHashtableBJ() )
    if (LoadRealBJ(GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("KnockBack3"), GetLastCreatedHashtableBJ()) <= 0.00 ) then
        call DestroyTimer(GetExpiredTimer())
    endif
    set knockLoc = null
    set i = null
    set u = null
endfunction

function Knockback takes unit u, real angle, real distance, real speed returns nothing
    local timer t = CreateTimer()
    call SaveUnitHandleBJ( u, GetHandleIdBJ(t), StringHashBJ("KnockBack1"), GetLastCreatedHashtableBJ() )
    call SaveRealBJ( angle, GetHandleIdBJ(t), StringHashBJ("KnockBack2"), GetLastCreatedHashtableBJ() )
    call SaveRealBJ( distance, GetHandleIdBJ(t), StringHashBJ("KnockBack3"), GetLastCreatedHashtableBJ() )
    call SaveRealBJ( speed/25, GetHandleIdBJ(t), StringHashBJ("KnockBack4"), GetLastCreatedHashtableBJ() )
    call TimerStart(t, 0.04, true, function Knockback_Action)
endfunction

///유동 텍스트 관련 함수

function TextTag takes string s, unit u, real size, real red, real green, real blue, real textlife returns nothing
    local integer viewerIndex = 0
    set bj_lastCreatedTextTag = CreateTextTag()
    call SetTextTagText(bj_lastCreatedTextTag, s, size*0.024/10)
    call SetTextTagPos(bj_lastCreatedTextTag, GetUnitX(u),GetUnitY(u), 0)
    call SetTextTagColor(bj_lastCreatedTextTag, R2I(red),R2I(green), R2I(blue), 255)
    call SetTextTagVelocity(bj_lastCreatedTextTag, 64*0.071/128*Cos(90*bj_DEGTORAD),64*0.071/128*Sin(90*bj_DEGTORAD) )
    call SetTextTagPermanent( bj_lastCreatedTextTag, false )
    call SetTextTagLifespan( bj_lastCreatedTextTag, textlife )
    call SetTextTagVisibility(bj_lastCreatedTextTag,false)
    call SetTextTagFadepointBJ( bj_lastCreatedTextTag, textlife*0.5)
    set viewerIndex = 0
    loop
    exitwhen viewerIndex == 14
        if IsUnitVisible(u,Player(viewerIndex)) == true then
        if GetLocalPlayer() == Player(viewerIndex) then
            call SetTextTagVisibility(bj_lastCreatedTextTag,true)
        endif
        endif
        set viewerIndex = viewerIndex+1
    endloop
endfunction

function TextTagForce takes string s, unit u, real size, real red, real green, real blue, real textlife, force f returns nothing
    set bj_lastCreatedTextTag = CreateTextTag()
    call SetTextTagText(bj_lastCreatedTextTag, s, size*0.024/10)
    call SetTextTagPos(bj_lastCreatedTextTag, GetUnitX(u),GetUnitY(u), 0)
    call SetTextTagColor(bj_lastCreatedTextTag, R2I(red),R2I(green), R2I(blue), 255)
    call SetTextTagVelocity(bj_lastCreatedTextTag, 64*0.071/128*Cos(90*bj_DEGTORAD),64*0.071/128*Sin(90*bj_DEGTORAD) )
    call SetTextTagPermanent( bj_lastCreatedTextTag, false )
    call SetTextTagLifespan( bj_lastCreatedTextTag, textlife )
    call SetTextTagFadepointBJ( bj_lastCreatedTextTag, textlife*0.5)
    call SetTextTagVisibility(bj_lastCreatedTextTag,true)
    call ShowTextTagForceBJ(false, bj_lastCreatedTextTag, GetPlayersAll())
    call ShowTextTagForceBJ(true, bj_lastCreatedTextTag, f)
endfunction
//***************************************************************************
//*
//*  Triggers
//*
//***************************************************************************

//===========================================================================
// Trigger: Setting MapNTimer
//===========================================================================
// GS2 R2: targeted Reforged compatibility fixes. All gameplay writes are synchronized.
function GS2R2_RealHeroDeath takes nothing returns boolean
    return not IsUnitIllusion(GetDyingUnit())
endfunction

function GS2R2_ClearIllusionBounty takes unit u returns nothing
    if u != null and IsUnitIllusion(u) and (GetUnitTypeId(u) == 'Emoo' or GetUnitTypeId(u) == 'Huth') then
        call BlzSetUnitIntegerField(u, ConvertUnitIntegerField('ubba'), 0)
        call BlzSetUnitIntegerField(u, ConvertUnitIntegerField('ubdi'), 0)
        call BlzSetUnitIntegerField(u, ConvertUnitIntegerField('ubsi'), 0)
    endif
endfunction

function GS2R2_IllusionEnter takes nothing returns nothing
    call GS2R2_ClearIllusionBounty(GetEnteringUnit())
endfunction

function GS2R2_IllusionSummon takes nothing returns nothing
    call GS2R2_ClearIllusionBounty(GetSummonedUnit())
endfunction

function GS2R2_GoldBonus takes nothing returns nothing
    local integer i = 2
    loop
        exitwhen i > 12
        if i != 7 then
            call AdjustPlayerStateBJ(5, udg_SP_Player[i], PLAYER_STATE_RESOURCE_GOLD)
        endif
        set i = i + 1
    endloop
endfunction

// The window timer only controls the pre-expiry stun; timed life controls removal.
function GS2R2_BomberWindowEnd takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local hashtable h = GetLastCreatedHashtableBJ()
    local unit u = LoadUnitHandle(h, GetHandleId(t), StringHash("GS2R2.BomberUnit"))
    if u != null then
        call RemoveSavedHandle(h, GetHandleId(u), StringHash("GS2R2.BomberTimer"))
    endif
    call RemoveSavedHandle(h, GetHandleId(t), StringHash("GS2R2.BomberUnit"))
    call PauseTimer(t)
    call DestroyTimer(t)
    set u = null
    set h = null
    set t = null
endfunction

function GS2R2_BomberCast takes nothing returns nothing
    local unit caster = GetTriggerUnit()
    local unit u
    local timer t
    local hashtable h
    local integer level
    local integer unitId = 'n02P'
    local real lifetime = 10.00
    if GetSpellAbilityId() != 'A0NJ' then
        set caster = null
        return
    endif
    set level = GetUnitAbilityLevel(caster, 'A0NJ')
    if level == 2 then
        set unitId = 'n02O'
    elseif level == 3 then
        set unitId = 'n02Q'
    elseif level >= 4 then
        set unitId = 'n02N'
    endif
    set u = CreateUnit(GetOwningPlayer(caster), unitId, GetSpellTargetX(), GetSpellTargetY(), GetUnitFacing(caster))
    if u == null then
        set caster = null
        return
    endif
    call SetUnitVertexColor(u, 255, 255, 255, 128)
    if GetRandomInt(1, 100) <= (20 - GetPlayerTechCountSimple('R07I', GetOwningPlayer(caster)) * 20) then
        set lifetime = 2.00
        call TextTag("Made In China", u, 10, 255, 255, 150, 3)
    endif
    set h = GetLastCreatedHashtableBJ()
    set t = CreateTimer()
    call SaveUnitHandle(h, GetHandleId(t), StringHash("GS2R2.BomberUnit"), u)
    call SaveTimerHandle(h, GetHandleId(u), StringHash("GS2R2.BomberTimer"), t)
    call TimerStart(t, lifetime - 0.50, false, function GS2R2_BomberWindowEnd)
    call UnitApplyTimedLife(u, 'BTLF', lifetime)
    set caster = null
    set u = null
    set t = null
    set h = null
endfunction

function GS2R2_BomberDeath takes nothing returns nothing
    local unit u = GetDyingUnit()
    local integer id = GetUnitTypeId(u)
    local hashtable h
    local timer t
    local unit dummy
    if id != 'n02P' and id != 'n02O' and id != 'n02Q' and id != 'n02N' then
        set u = null
        return
    endif
    set h = GetLastCreatedHashtableBJ()
    set t = LoadTimerHandle(h, GetHandleId(u), StringHash("GS2R2.BomberTimer"))
    if t != null then
        if TimerGetRemaining(t) > 0.00 then
            set dummy = CreateUnit(GetOwningPlayer(u), 'e002', GetUnitX(u), GetUnitY(u), 0.00)
            call UnitApplyTimedLife(dummy, 'BTLF', 1.00)
            call UnitAddAbility(dummy, 'A0NI')
            call IssueImmediateOrder(dummy, "stomp")
            set dummy = null
        endif
        call RemoveSavedHandle(h, GetHandleId(t), StringHash("GS2R2.BomberUnit"))
        call RemoveSavedHandle(h, GetHandleId(u), StringHash("GS2R2.BomberTimer"))
        call PauseTimer(t)
        call DestroyTimer(t)
    endif
    set u = null
    set t = null
    set h = null
endfunction

function GS2_Ver5_FlameEssence takes nothing returns nothing
    local unit oldHero = GetTriggerUnit()
    local item essence = GetManipulatedItem()
    local unit newHero
    local unit oldTraits
    local group traitGroup
    local integer playerIndex
    if GetItemTypeId(GetManipulatedItem()) == 'rlif' and GetUnitTypeId(oldHero) == 'Ofar' and not IsUnitIllusion(oldHero) then
        set playerIndex = GetConvertedPlayerId(GetOwningPlayer(oldHero))
        call ReplaceUnitBJ(oldHero, 'O00M', bj_UNIT_STATE_METHOD_RELATIVE)
        set newHero = GetLastReplacedUnitBJ()
        call RemoveItem(essence)
        set udg_HeroPlayer[playerIndex] = newHero
        set udg_Hero_ThL = newHero
        call MultiboardSetItemIconBJ(GetLastCreatedMultiboard(), 1, udg_SP_Number[playerIndex] + 1, "ReplaceableTextures\\CommandButtons\\BTNThunderLizardSalamander.blp")
        set traitGroup = GetUnitsOfPlayerAndTypeId(GetOwningPlayer(newHero), 'n00W')
        set oldTraits = FirstOfGroup(traitGroup)
        if oldTraits != null then
            call ReplaceUnitBJ(oldTraits, 'n037', bj_UNIT_STATE_METHOD_MAXIMUM)
        endif
        call DestroyGroup(traitGroup)
        call SelectUnitForPlayerSingle(newHero, GetOwningPlayer(newHero))
    endif
    set oldHero = null
    set essence = null
    set newHero = null
    set oldTraits = null
    set traitGroup = null
endfunction

function GS2_Ver6_WaterDummy takes nothing returns boolean
    return GetUnitTypeId(GetFilterUnit()) == 'e01N'
endfunction

function GS2_Ver6_WaterReady takes location p returns boolean
    local group g
    local boolean found
    if GetTerrainCliffLevelBJ(p) == 1 or DistanceBetweenPoints(p, udg_Hero_MRG_UltiPoint) <= 600.00 then
        return true
    endif
    set g = CreateGroup()
    call GroupEnumUnitsInRange(g, GetLocationX(p), GetLocationY(p), 450.00, Filter(function GS2_Ver6_WaterDummy))
    set found = FirstOfGroup(g) != null
    call DestroyGroup(g)
    set g = null
    return found
endfunction

function GS2_Ver6_WaterOrder takes nothing returns nothing
    local unit hero = GetOrderedUnit()
    local location source
    local location target
    if hero != udg_Hero_MRG or GetIssuedOrderId() != OrderId("blink") or GetUnitAbilityLevel(hero, 'A0NL') == 0 then
        set hero = null
        return
    endif
    set source = GetUnitLoc(hero)
    set target = GetOrderPointLoc()
    if not GS2_Ver6_WaterReady(source) or not GS2_Ver6_WaterReady(target) then
        call IssueImmediateOrder(hero, "stop")
        call DisplayTextToForce(GetForceOfPlayer(GetOwningPlayer(hero)), "TRIGSTR_1751")
    endif
    call RemoveLocation(source)
    call RemoveLocation(target)
    set source = null
    set target = null
    set hero = null
endfunction

function GS2R2_Init takes nothing returns nothing
    local trigger t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
    call TriggerAddAction(t, function GS2_Ver6_WaterOrder)
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_PICKUP_ITEM)
    call TriggerAddAction(t, function GS2_Ver5_FlameEssence)
    set t = CreateTrigger()
    // These old handlers store GetLastCreatedTimerBJ instead of their local timer.
    call DisableTrigger(gg_trg_Pocket_Bomber)
    call DisableTrigger(gg_trg_Pocket_Bomber_Stun)
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddAction(t, function GS2R2_BomberCast)
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddAction(t, function GS2R2_BomberDeath)
    call TriggerAddCondition(gg_trg_Death_Hero_New, Condition(function GS2R2_RealHeroDeath))
    call TriggerAddCondition(gg_trg_Death_Hero_EXP, Condition(function GS2R2_RealHeroDeath))
    set t = CreateTrigger()
    call TriggerRegisterEnterRectSimple(t, GetPlayableMapRect())
    call TriggerAddAction(t, function GS2R2_IllusionEnter)
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SUMMON)
    call TriggerAddAction(t, function GS2R2_IllusionSummon)
    set t = null
endfunction

