function Trig_OgL_Atk_Func007Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0AA', GetEventDamageSource()) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_OgL_Atk_Func007C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R01B', GetOwningPlayer(GetEventDamageSource())) == 1 ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A03U', GetEventDamageSource()) >= 1 ) ) then
        return false
    endif
    if ( not ( GetRandomInt(1, 100) <= ( 5 + ( 5 * GetUnitAbilityLevelSwapped('A03U', GetEventDamageSource()) ) ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_OgL_Atk_Actions takes nothing returns nothing
    set udg_Hero_OgL_AtkTarget = null
    // 파워 스트라이크
    if ( Trig_OgL_Atk_Func003C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetEventDamageSource()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
        if ( Trig_OgL_Atk_Func003Func003C() ) then
            set udg_Hero_OgL_PowerDmg = ( I2R(GetUnitAbilityLevelSwapped('A0AA', GetEventDamageSource())) * ( 30.00 + ( I2R(GetUnitAbilityLevelSwapped('A07A', GetEventDamageSource())) * 20.00 ) ) )
            call UnitRemoveAbilityBJ( 'A0AA', GetEventDamageSource() )
            if ( Trig_OgL_Atk_Func003Func003Func004C() ) then
                call UnitAddAbilityBJ( 'A010', GetLastCreatedUnit() )
            else
                call UnitAddAbilityBJ( 'A05G', GetLastCreatedUnit() )
            endif
        else
            if ( Trig_OgL_Atk_Func003Func003Func001C() ) then
                set udg_Hero_OgL_PowerDmg = ( 1.50 * ( 30.00 + ( I2R(GetUnitAbilityLevelSwapped('A07A', GetEventDamageSource())) * 20.00 ) ) )
                call UnitAddAbilityBJ( 'A010', GetLastCreatedUnit() )
                call SetUnitAbilityLevelSwapped( 'A010', GetLastCreatedUnit(), 2 )
            else
                set udg_Hero_OgL_PowerDmg = ( 1.00 * ( 30.00 + ( I2R(GetUnitAbilityLevelSwapped('A07A', GetEventDamageSource())) * 20.00 ) ) )
                call UnitAddAbilityBJ( 'A05G', GetLastCreatedUnit() )
            endif
        endif
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "thunderbolt", GetTriggerUnit() )
        call UnitDamageTarget(GetEventDamageSource(), GetTriggerUnit(), udg_Hero_OgL_PowerDmg,false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,null)
        if ( Trig_OgL_Atk_Func003Func006C() ) then
            call UnitRemoveAbilityBJ( 'A0AA', GetEventDamageSource() )
        else
            call SetUnitAbilityLevelSwapped( 'A0AA', GetEventDamageSource(), ( GetUnitAbilityLevelSwapped('A0AA', GetEventDamageSource()) - 1 ) )
        endif
        call AddSpecialEffectLocBJ( GetUnitLoc(GetTriggerUnit()), "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectLocBJ( GetUnitLoc(GetTriggerUnit()), "Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "Abilities\\Weapons\\FireBallMissile\\FireBallMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
    // 파워 오브 거츠
    if ( Trig_OgL_Atk_Func005C() ) then
        if ( Trig_OgL_Atk_Func005Func002C() ) then
            call SetUnitAbilityLevelSwapped( 'A0ZF', udg_Hero_OgL, ( GetUnitAbilityLevelSwapped('A03U', udg_Hero_OgL) + 1 ) )
        else
        endif
    else
        if ( Trig_OgL_Atk_Func005Func001C() ) then
            call SetUnitAbilityLevelSwapped( 'A0ZF', udg_Hero_OgL, 1 )
        else
        endif
    endif
    // 급격한 분노
    if ( Trig_OgL_Atk_Func007C() ) then
        if ( Trig_OgL_Atk_Func007Func001C() ) then
            call UnitAddAbilityBJ( 'A0AA', GetEventDamageSource() )
        else
            call SetUnitAbilityLevelSwapped( 'A0AA', GetEventDamageSource(), ( GetUnitAbilityLevelSwapped('A0AA', GetEventDamageSource()) + 1 ) )
        endif
        call TextTag( "급격한 분노!" , udg_Hero_OgL , 13 , 255 , 0 , 0, 3 )
    else
    endif
endfunction

