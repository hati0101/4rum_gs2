    if ( Trig_Blazing_Axe_Func003Func006Func001C() ) then
        call UnitDamageTargetBJ( GetEventDamageSource(), GetEnumUnit(), ( ( 2.00 + ( 8.00 * I2R(GetUnitAbilityLevelSwapped('A0RY', GetEventDamageSource())) ) ) * ( ( 1.50 + ( 1 * I2R(GetPlayerTechCountSimple('R07D', GetOwningPlayer(GetEventDamageSource()))) ) ) + 0.00 ) ), ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL )
        call AddSpecialEffectTargetUnitBJ( "chest", GetEnumUnit(), "Abilities\\Spells\\Items\\AIfb\\AIfbSpecialArt.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
endfunction

