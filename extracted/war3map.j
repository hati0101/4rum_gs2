endfunction

//===========================================================================
// Trigger: Set Variable Creep
//
// n: 1 ~ 10
// Creep Level [ n ] Creep_Number = (n - 1) * 5
// -> 생성되는 일반적인 크립 타입
// Creep Level [ n ] Will be replaced with named creep
// -> 생성되어 네임드 크립이 나올 경우 교체될 크립 타입
// Creep Level [ n ] Named creep
// -> 네임드 크립 타입
//===========================================================================
function Trig_Set_Variable_Creep_Actions takes nothing returns nothing
    // Zone Initialize
    set udg_Creep_SpawnZone[0] = gg_rct_Mon_1
    set udg_Creep_SpawnZone[1] = gg_rct_Mon_2
    set udg_Creep_SpawnZone[2] = gg_rct_Mon_3
    set udg_Creep_SpawnZone[3] = gg_rct_Mon_4
    set udg_Creep_SpawnZone[4] = gg_rct_Mon_5
    set udg_Creep_SpawnZone[5] = gg_rct_Mon_6
    set udg_Creep_SpawnZone[6] = gg_rct_Mon_7
    set udg_Creep_SpawnZone[7] = gg_rct_Mon_8
    set udg_Creep_SpawnZone[8] = gg_rct_Mon_9
    set udg_Creep_SpawnZone[9] = gg_rct_Mon_10
    set udg_Creep_SpawnZone[10] = gg_rct_Mon_11
    set udg_Creep_SpawnZone[11] = gg_rct_Mon_12
    // Named Check Initialize
    set udg_Creep_NamedCheck[1] = true
    set udg_Creep_NamedCheck[2] = false
    set udg_Creep_NamedCheck[3] = false
    set udg_Creep_NamedCheck[4] = false
    set udg_Creep_NamedCheck[5] = false
    set udg_Creep_NamedCheck[6] = false
    // Creep Level Group Count Initialize
    set udg_Creep_LvGroupCnt[0] = 0
    set udg_Creep_LvGroupCnt[1] = 0
    set udg_Creep_LvGroupCnt[2] = 0
    // Creep Type Assign
    set udg_Creep_Number = 0
    // Creep Level [ 1 ] Creep_Number = 0 ---------------------------------------------------------
    set udg_Creep_Type[udg_Creep_Number] = 'nkob'
    set udg_Creep_Number = ( udg_Creep_Number + 1 )
    set udg_Creep_Type[udg_Creep_Number] = 'nkob'
    set udg_Creep_Number = ( udg_Creep_Number + 1 )
    set udg_Creep_Type[udg_Creep_Number] = 'nkob'
    set udg_Creep_Number = ( udg_Creep_Number + 1 )
    // Creep Level [ 1 ] Will be replaced with named creep
    set udg_Creep_Type[udg_Creep_Number] = 'nkog'
    set udg_Creep_Number = ( udg_Creep_Number + 1 )
    // Creep Level [ 1 ] Named creep
    set udg_Creep_Type[udg_Creep_Number] = 'nkol'
    set udg_Creep_Number = ( udg_Creep_Number + 1 )
    // Creep Level [ 2 ] Creep_Number = 5 ---------------------------------------------------------
    set udg_Creep_Type[udg_Creep_Number] = 'ngno'
    set udg_Creep_Number = ( udg_Creep_Number + 1 )
    set udg_Creep_Type[udg_Creep_Number] = 'ngno'
    set udg_Creep_Number = ( udg_Creep_Number + 1 )
    set udg_Creep_Type[udg_Creep_Number] = 'ngno'
    set udg_Creep_Number = ( udg_Creep_Number + 1 )
    // Creep Level [ 2 ] Will be replaced with named creep
