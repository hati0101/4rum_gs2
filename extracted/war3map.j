    if ( Trig_Hi_Spceial_Point_Func002C() ) then
        call AdjustPlayerStateBJ( 1, GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_LUMBER )
        call AdjustPlayerStateBJ( 300, GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_GOLD )
        set udg_Special_Point[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = ( udg_Special_Point[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + 1 )
        call DisplayTextToForce( GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), "TRIGSTR_1290" )
        call DisplayTextToForce( GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), "TRIGSTR_1297" )
        call DisplayTextToForce( GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), "TRIGSTR_1300" )
    else
    endif
    if ( Trig_Hi_Spceial_Point_Func003C() ) then
        call AdjustPlayerStateBJ( 1, GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_LUMBER )
        call AdjustPlayerStateBJ( 300, GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_GOLD )
        set udg_Special_Point[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = ( udg_Special_Point[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + 1 )
        call DisplayTextToForce( GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), "TRIGSTR_1302" )
        call DisplayTextToForce( GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), "TRIGSTR_1307" )
        call DisplayTextToForce( GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), "TRIGSTR_1310" )
    else
    endif
    if ( Trig_Hi_Spceial_Point_Func004C() ) then
        call AdjustPlayerStateBJ( 1, GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_LUMBER )
        call AdjustPlayerStateBJ( 300, GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_GOLD )
        call CreateNUnitsAtLocFacingLocBJ( 1, 'e02Z', GetTriggerPlayer(), GetRectCenter(GetPlayableMapRect()), GetUnitLoc(GetTriggerUnit()) )
        set udg_Special_Point[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = ( udg_Special_Point[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + 1 )
        call DisplayTextToForce( GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), "TRIGSTR_1322" )
        call DisplayTextToForce( GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), "TRIGSTR_1332" )
        call DisplayTextToForce( GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), "TRIGSTR_1343" )
    else
    endif
    if ( Trig_Hi_Spceial_Point_Func006C() ) then
        call AdjustPlayerStateBJ( 1, GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_LUMBER )
        call AdjustPlayerStateBJ( 300, GetOwningPlayer(GetTriggerUnit()), PLAYER_STATE_RESOURCE_GOLD )
        set udg_Special_Point[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = ( udg_Special_Point[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + 1 )
        call DisplayTextToForce( GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), "TRIGSTR_1347" )
        call DisplayTextToForce( GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), "TRIGSTR_1350" )
        call DisplayTextToForce( GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())), "TRIGSTR_1352" )
    else
    endif
endfunction

