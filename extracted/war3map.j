            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetSpellAbilityUnit()), castPoint, bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A0NO', GetLastCreatedUnit() )
            call SetUnitAbilityLevelSwapped( 'A0NO', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0NU', GetSpellAbilityUnit()) )
            call IssueTargetOrderBJ( GetLastCreatedUnit(), "bloodlust", GetSpellTargetUnit() )
