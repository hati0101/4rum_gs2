    if ( not ( GetLearnedSkillBJ() == 'A0BO' ) ) then
        return false
    endif
    return true
endfunction

function Trig_BlK_Learn_Func002Func002C takes nothing returns boolean
    if ( not ( GetLearnedSkillLevel() == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BlK_Learn_Func002Func003C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0BL', GetTriggerUnit()) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_BlK_Learn_Func002C takes nothing returns boolean
    if ( not ( GetLearnedSkillBJ() == 'A0NP' ) ) then
        return false
    endif
    return true
endfunction

function Trig_BlK_Learn_Actions takes nothing returns nothing
    if ( Trig_BlK_Learn_Func001C() ) then
        if ( Trig_BlK_Learn_Func001Func002C() ) then
            call UnitAddAbilityBJ( 'A0LD', GetTriggerUnit() )
            if ( Trig_BlK_Learn_Func001Func002Func002C() ) then
                call UnitAddAbilityBJ( 'A0BQ', GetTriggerUnit() )
            else
            endif
        else
        endif
        if ( Trig_BlK_Learn_Func001Func003C() ) then
            call IncUnitAbilityLevelSwapped( 'A0BQ', GetTriggerUnit() )
        else
        endif
        if ( Trig_BlK_Learn_Func001Func004C() ) then
            call UnitAddAbilityBJ( 'A0BP', GetTriggerUnit() )
        else
        endif
        if ( Trig_BlK_Learn_Func001Func005C() ) then
            call IncUnitAbilityLevelSwapped( 'A0BP', GetTriggerUnit() )
        else
        endif
    else
    endif
    if ( Trig_BlK_Learn_Func002C() ) then
        if ( Trig_BlK_Learn_Func002Func002C() ) then
            call UnitAddAbilityBJ( 'A0YF', GetTriggerUnit() )
        else
        endif
        if ( Trig_BlK_Learn_Func002Func003C() ) then
            call UnitAddAbilityBJ( 'A0BL', GetTriggerUnit() )
        else
        endif
        call SetUnitAbilityLevelSwapped( 'A0BL', GetTriggerUnit(), ( 0 + GetLearnedSkillLevel() ) )
    else
    endif
endfunction

