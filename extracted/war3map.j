        return false
    endif
    return true
endfunction

function Trig_Shadow_Break_Illusion_Set_Actions takes nothing returns nothing
    set udg_Hero_BlS_SBIllusion = GetTriggerUnit()
    call SetUnitOwner( udg_Hero_BlS_SBIllusion, Player(PLAYER_NEUTRAL_AGGRESSIVE), true )
    call SetUnitMoveSpeed( udg_Hero_BlS_SBIllusion, 1.00 )
    call SetUnitVertexColorBJ( udg_Hero_BlS_SBIllusion, 0.00, 0.00, 0.00, 60.00 )
    call SetUnitTimeScalePercent( udg_Hero_BlS_SBIllusion, 0.00 )
    call SetUnitTurnSpeedBJ( udg_Hero_BlS_SBIllusion, 0.00 )
    call SetUnitPositionLoc( udg_Hero_BlS_SBIllusion, GetUnitLoc(udg_Hero_BlS) )
    call PolledWait( ( 4.00 + ( 2.00 * I2R(CountLivingPlayerUnitsOfTypeId('e01D', GetOwningPlayer(udg_Hero_BlS))) ) ) )
    if ( Trig_Shadow_Break_Illusion_Set_Func009C() ) then
        call RemoveUnit( udg_Hero_BlS_SBIllusion )
        call UnitDamageTargetBJ( udg_Hero_BlS, udg_Hero_BlS_SBTarget, ( ( udg_Hero_BlS_SBdmg * ( 0.33 + ( 0.07 * I2R(GetPlayerTechCountSimple('R08X', GetOwningPlayer(udg_Hero_BlS))) ) ) ) + 0.00 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_BlS_SBTarget, "Objects\\Spawnmodels\\NightElf\\NightElfLargeDeathExplode\\NightElfLargeDeathExplode.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        set udg_Hero_BlS_SBdmg = 0.00
    else
        call RemoveUnit( udg_Hero_BlS_SBIllusion )
        call UnitDamageTargetBJ( udg_Hero_BlS, udg_Hero_BlS_SBTarget, ( ( udg_Hero_BlS_SBdmg * ( 0.33 + ( 0.07 * I2R(GetPlayerTechCountSimple('R08X', GetOwningPlayer(udg_Hero_BlS))) ) ) ) + 0.00 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_BlS_SBTarget, "Objects\\Spawnmodels\\NightElf\\NightElfLargeDeathExplode\\NightElfLargeDeathExplode.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        set udg_Hero_BlS_SBdmg = 0.00
    endif
endfunction

