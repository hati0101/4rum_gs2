    if ( Trig_VaL_Skill_Effect_Func009Func002Func001C() ) then
        call CreateNUnitsAtLoc( 1, 'e01Z', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetEnumUnit()), bj_UNIT_FACING )
