function Trig_DamageTaken_Actions takes nothing returns nothing
    local integer rand = GetRandomInt( 1 , 100 )
    local string trollsay = ""
    local integer randmsg = GetRandomInt( 1 , 17 )
    local integer chance = ( (5 + ( GetUnitAbilityLevelSwapped('A0H4', GetTriggerUnit()) * 5 )) * ( 1 + ( CountLivingPlayerUnitsOfTypeId('e03K', GetOwningPlayer(GetTriggerUnit())) * 1 ) ) )
    local integer BlS = ( 6 + ( GetUnitAbilityLevelSwapped('A046', GetTriggerUnit()) * 2 ) )
    // 크립 효과
    if ( Trig_DamageTaken_Func007C() ) then
        call IssueTargetOrderBJ( GetTriggerUnit(), "frostnova", GetEventDamageSource() )
    else
    endif
    if ( Trig_DamageTaken_Func008C() ) then
        if ( Trig_DamageTaken_Func008Func001C() ) then
            call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + GetEventDamage() ) )
        else
        endif
    else
    endif
    if ( Trig_DamageTaken_Func009C() ) then
        call IssueTargetOrderBJ( GetTriggerUnit(), "shadowstrike", GetEventDamageSource() )
    else
    endif
    if ( Trig_DamageTaken_Func010C() ) then
        call CreateTextTagLocBJ( "TRIGSTR_1455", GetUnitLoc(GetTriggerUnit()), 0, 10.00, 100.00, 50.00, 85.00, 0.00 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 30.00, 85.00 )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 2.00 )
        call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 1.50 )
        if ( Trig_DamageTaken_Func010Func006C() ) then
            set bj_forLoopAIndex = 2
            set bj_forLoopAIndexEnd = 6
            loop
                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                call ForGroupBJ( GetUnitsOfPlayerMatching(udg_SP_Player[GetForLoopIndexA()], Condition(function Trig_DamageTaken_Func010Func006Func002Func001001002)), function Trig_DamageTaken_Func010Func006Func002Func001A )
                set bj_forLoopAIndex = bj_forLoopAIndex + 1
            endloop
        else
            set bj_forLoopAIndex = 8
            set bj_forLoopAIndexEnd = 12
            loop
                exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
                call ForGroupBJ( GetUnitsOfPlayerMatching(udg_SP_Player[GetForLoopIndexA()], Condition(function Trig_DamageTaken_Func010Func006Func001Func001001002)), function Trig_DamageTaken_Func010Func006Func001Func001A )
                set bj_forLoopAIndex = bj_forLoopAIndex + 1
            endloop
        endif
        set udg_Creep_Named_RoroBback1 = true
    else
    endif
    if ( Trig_DamageTaken_Func011C() ) then
        call CreateTextTagLocBJ( "TRIGSTR_1457", GetUnitLoc(GetTriggerUnit()), 0, 10.00, 100.00, 50.00, 85.00, 0.00 )
        call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 30.00, 85.00 )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 2.00 )
        call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 1.50 )
        call IssueImmediateOrderBJ( GetTriggerUnit(), "metamorphosis" )
        call DisableTrigger( GetTriggeringTrigger() )
        set udg_Creep_Named_RoroBback2 = true
    else
    endif
    // 데미지 반사 효과
    if ( Trig_DamageTaken_Func013C() ) then
        if ( Trig_DamageTaken_Func013Func003C() ) then
            call UnitDamageTargetBJ( GetTriggerUnit(), udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetEventDamageSource()))], ( GetEventDamage() * 0.20 ), ATTACK_TYPE_HERO, DAMAGE_TYPE_UNIVERSAL )
        else
            call UnitDamageTargetBJ( GetTriggerUnit(), GetEventDamageSource(), ( GetEventDamage() * 0.20 ), ATTACK_TYPE_HERO, DAMAGE_TYPE_UNIVERSAL )
        endif
    else
    endif
    if ( Trig_DamageTaken_Func014C() ) then
        if ( Trig_DamageTaken_Func014Func001C() ) then
            call UnitDamageTargetBJ( GetTriggerUnit(), udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetEventDamageSource()))], ( GetEventDamage() * 0.70 ), ATTACK_TYPE_HERO, DAMAGE_TYPE_UNIVERSAL )
        else
            call UnitDamageTargetBJ( GetTriggerUnit(), GetEventDamageSource(), ( GetEventDamage() * 0.70 ), ATTACK_TYPE_HERO, DAMAGE_TYPE_UNIVERSAL )
        endif
    else
    endif
    // 기타 피드백 효과
    if ( Trig_DamageTaken_Func016C() ) then
        call CreateNUnitsAtLocFacingLocBJ( 1, 'e03C', GetOwningPlayer(GetEventDamageSource()), GetRectCenter(GetPlayableMapRect()), GetUnitLoc(GetTriggerUnit()) )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        if ( Trig_DamageTaken_Func016Func003C() ) then
            call UnitDamageTargetBJ( GetLastCreatedUnit(), GetTriggerUnit(), ( 5.00 + ( 5.00 * I2R(GetUnitAbilityLevelSwapped('A145', udg_Hero_MeQ)) ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
            call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) - ( 5.00 + ( 5.00 * I2R(GetUnitAbilityLevelSwapped('A145', udg_Hero_MeQ)) ) ) ) )
        else
            call UnitDamageTargetBJ( GetLastCreatedUnit(), GetTriggerUnit(), ( GetEventDamage() * 0.25 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
            call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) - ( GetEventDamage() * 0.25 ) ) )
        endif
        call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Human\\Feedback\\SpellBreakerAttack.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
    if ( Trig_DamageTaken_Func017C() ) then
        if ( Trig_DamageTaken_Func017Func001C() ) then
            call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + ( GetEventDamage() * ( 1.35 - ( 0.05 * I2R(GetUnitAbilityLevelSwapped('A0RD', GetTriggerUnit())) ) ) ) ) )
        else
            call PolledWait( 0.01 )
            call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + ( GetEventDamage() * ( 1.35 - ( 0.05 * I2R(GetUnitAbilityLevelSwapped('A0RD', GetTriggerUnit())) ) ) ) ) )
        endif
    else
    endif
    // 데미지 무시 효과(선행발동)
    if ( Trig_DamageTaken_Func019C() ) then
        if ( Trig_DamageTaken_Func019Func001C() ) then
            call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + GetEventDamage() ) )
        else
            call PolledWait( 0.01 )
            call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + GetEventDamage() ) )
        endif
        return
    else
    endif
    if ( Trig_DamageTaken_Func020C() ) then
        if ( rand <= 5 ) then
        set trollsay = "Is that all?"
        elseif ( rand <= 10 ) then
        set trollsay = "내 몸은 마취되어 있다!"
        elseif ( rand <= 15 ) then
        set trollsay = "?"
        elseif ( rand <= 20 ) then
        set trollsay = "아픈거 같은 기분이 들어"
        elseif ( rand <= 25 ) then
        set trollsay = "네놈이 날 패봤자 넌 날 죽이지 못한다"
        endif
        set udg_Hero_TrB_DamageTaken[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = ( udg_Hero_TrB_DamageTaken[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + ( GetEventDamage() * 0.90 ) )
        if ( Trig_DamageTaken_Func020Func014C() ) then
            call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + GetEventDamage() ) )
        else
            call PolledWait( 0.01 )
            call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + GetEventDamage() ) )
        endif
        if trollsay != "" then
        call TextTag( trollsay, GetTriggerUnit(), 10, 255, 122, 204, 1)
        endif
        return
    else
    endif
    if ( Trig_DamageTaken_Func021C() ) then
        if ( rand <= BlS ) then
        if ( Trig_DamageTaken_Func021Func005C() ) then
            call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + GetEventDamage() ) )
        else
            call PolledWait( 0.01 )
            call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + GetEventDamage() ) )
        endif
        call CreateTextTagLocBJ( "TRIGSTR_1822", GetUnitLoc(GetTriggerUnit()), 0, 10.00, 0.00, 0.00, 0.00, 20.00 )
        call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
        call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 2.00 )
        call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 0.40 )
