    if ( not ( CountUnitsInGroup(udg_Hero_MoW_UltiTgtGroup) != 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Moon_Strike_Bargas_Actions takes nothing returns nothing
    set bj_wantDestroyGroup=true
    call ForGroupBJ( GetUnitsInRectMatching(GetPlayableMapRect(), Condition(function Trig_Moon_Strike_Bargas_Func002001002)), function Trig_Moon_Strike_Bargas_Func002A )
    set udg_Hero_DaW_UltiCaster = GetSpellAbilityUnit()
    call AddSpecialEffectTargetUnitBJ( "hand right", GetTriggerUnit(), "war3mapImported\\MoonSpear.mdx" )
    set udg_Hero_MoW_UltiEff2[1] = GetLastCreatedEffectBJ()
    call AddSpecialEffectTargetUnitBJ( "hand left", GetTriggerUnit(), "war3mapImported\\MoonSpear.mdx" )
    set udg_Hero_MoW_UltiEff2[2] = GetLastCreatedEffectBJ()
    call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\MoonSpear.mdx" )
    set udg_Hero_MoW_UltiEff[1] = GetLastCreatedEffectBJ()
    set udg_Hero_MoW_UltiDamage[1] = ( 30.00 + ( I2R(GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetSpellAbilityUnit())) * 70.00 ) )
    set udg_Hero_MoW_UltiTgtGroup = GetUnitsInRangeOfLocMatching(500.00, GetUnitLoc(GetSpellAbilityUnit()), Condition(function Trig_Moon_Strike_Bargas_Func011002003))
    call PolledWait( 0.10 )
    if ( Trig_Moon_Strike_Bargas_Func013C() ) then
        if ( Trig_Moon_Strike_Bargas_Func013Func001C() ) then
            call StopSoundBJ( gg_snd_BuildingDeathLargeHuman, false )
            set udg_Hero_DaW_UltiTarget = GroupPickRandomUnit(udg_Hero_MoW_UltiTgtGroup)
            call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_DaW_UltiCaster, "Abilities\\Weapons\\GryphonRiderMissile\\GryphonRiderMissileTarget.mdl" )
            call SetUnitPositionLocFacingLocBJ( udg_Hero_DaW_UltiCaster, PolarProjectionBJ(GetUnitLoc(udg_Hero_DaW_UltiTarget), 50.00, GetRandomDirectionDeg()), GetUnitLoc(udg_Hero_DaW_UltiTarget) )
            call SetUnitAnimation( udg_Hero_DaW_UltiCaster, "attack slam" )
            call SetUnitTimeScalePercent( udg_Hero_DaW_UltiCaster, 170.00 )
            call CreateNUnitsAtLocFacingLocBJ( 1, 'o00J', GetOwningPlayer(GetSpellAbilityUnit()), GetUnitLoc(udg_Hero_DaW_UltiCaster), GetUnitLoc(udg_Hero_DaW_UltiTarget) )
            call UnitApplyTimedLifeBJ( 0.20, 'BTLF', GetLastCreatedUnit() )
            call SetUnitTimeScalePercent( GetLastCreatedUnit(), 250.00 )
            call SetUnitVertexColorBJ( GetLastCreatedUnit(), 100, 0.00, 0.00, 75.00 )
            call SetUnitAnimation( GetLastCreatedUnit(), "attack slam" )
        else
        endif
        call PlaySoundAtPointBJ( gg_snd_BuildingDeathLargeHuman, 100, GetUnitLoc(udg_Hero_MoW[1]), 500.00 )
        call TriggerSleepAction( 0.00 )
        if ( Trig_Moon_Strike_Bargas_Func013Func004C() ) then
            call SetUnitTimeScalePercent( udg_Hero_DaW_UltiCaster, 30.00 )
            if ( Trig_Moon_Strike_Bargas_Func013Func004Func002C() ) then
                call UnitDamageTarget(udg_Hero_DaW_UltiCaster,udg_Hero_DaW_UltiTarget,udg_Hero_MoW_UltiDamage[1],false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,null)
            else
                call UnitDamageTarget(udg_Hero_DaW_UltiCaster,udg_Hero_DaW_UltiTarget,udg_Hero_MoW_UltiDamage[1]*0.5,false,true,ATTACK_TYPE_HERO,DAMAGE_TYPE_NORMAL,null)
            endif
            call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_DaW_UltiTarget), "Objects\\Spawnmodels\\Human\\HumanBlood\\BloodElfSpellThiefBlood.mdl" )
            call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_DaW_UltiTarget), "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl" )
        else
        endif
        call GroupClear( udg_Hero_MoW_UltiTgtGroup )
    else
    endif
    call PolledWait( 0.00 )
    call StartTimerBJ( udg_Hero_MoW_UltiTimer, false, 0.25 )
    call EnableTrigger( gg_trg_Moon_Strike_Execute )
endfunction

