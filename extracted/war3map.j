//===========================================================================
function Trig_Wind_Blade_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetAttacker()) == 'Obla' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wind_Blade_Func003Func001C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A13B', GetAttacker()) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wind_Blade_Func003C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetAttacker(), 'B048') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wind_Blade_Func004C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetAttacker(), 'B048') != true ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A13B', GetAttacker()) != 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Wind_Blade_Actions takes nothing returns nothing
    local integer rand = GetRandomInt( 1 , 100 )
    local integer chance = 30 // 발동 확률
    if ( Trig_Wind_Blade_Func003C() ) then
        if ( Trig_Wind_Blade_Func003Func001C() ) then
            call UnitAddAbilityBJ( 'A13B', GetAttacker() )
            call SetUnitAbilityLevelSwapped( 'A13B', GetAttacker(), GetUnitAbilityLevelSwapped('A00E', GetAttacker()) )
        else
        endif
        if ( rand <= chance ) then
        call CreateNUnitsAtLoc( 1, 'e029', GetOwningPlayer(GetAttacker()), GetPlayerStartLocationLoc(GetOwningPlayer(GetAttacker())), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        endif
    else
    endif
    if ( Trig_Wind_Blade_Func004C() ) then
        call UnitRemoveAbilityBJ( 'A13B', GetAttacker() )
    else
    endif
endfunction

