        call SetUnitAbilityLevelSwapped( 'A0AG', gg_unit_nmoo_0076, ( udg_BlueBosuk[2] + 1 ) )
    endif
    call PolledWait( 0.10 )
    set udg_BlueBosuk_Limiter[GetConvertedPlayerId(GetTriggerPlayer())] = true
endfunction

