function InitTrig_Battle_Reflex_Get takes nothing returns nothing
    set gg_trg_Battle_Reflex_Get = CreateTrigger(  )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Battle_Reflex_Get, udg_Hero_DrR_ReflexTimer[1] )
    call TriggerAddAction( gg_trg_Battle_Reflex_Get, function Trig_Battle_Reflex_Get_Actions )
endfunction

