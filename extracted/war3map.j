// Trigger: Stomp
//===========================================================================
function Trig_Stomp_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0VD' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Stomp_Func003C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R09Q', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Stomp_Actions takes nothing returns nothing
    call CreateNUnitsAtLoc( 1, 'e02B', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 175.00, GetUnitFacing(GetTriggerUnit())), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    if ( Trig_Stomp_Func003C() ) then
        call SetUnitAbilityLevelSwapped( 'A0VE', GetLastCreatedUnit(), ( GetUnitAbilityLevelSwapped('A0VD', GetTriggerUnit()) + 4 ) )
    else
        call SetUnitAbilityLevelSwapped( 'A0VE', GetLastCreatedUnit(), ( GetUnitAbilityLevelSwapped('A0VD', GetTriggerUnit()) + 0 ) )
    endif
    call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 175.00, GetUnitFacing(GetTriggerUnit())), bj_UNIT_FACING )
    call UnitAddAbilityBJ( 'A0T6', GetLastCreatedUnit() )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call IssueImmediateOrderBJ( GetLastCreatedUnit(), "stomp" )
endfunction

