    set gg_trg_Lament_Die = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Lament_Die, Condition( function Trig_Lament_Die_Conditions ) )
    call TriggerAddAction( gg_trg_Lament_Die, function Trig_Lament_Die_Actions )
endfunction

