        return false
    endif
    return true
endfunction

function Trig_Soul_Control_Actions takes nothing returns nothing
    local boolean soul
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0ST', GetLastCreatedUnit() )
    if ( Trig_Soul_Control_Func005C() ) then
        set soul = true
        set udg_Hero_DeM_Soul = ( udg_Hero_DeM_Soul - 5 )
        call TextTagForce( I2S(udg_Hero_DeM_Soul), GetTriggerUnit(), 10,255, 50, 150, 3, GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())) )
        call SetUnitAbilityLevelSwapped( 'A0ST', GetLastCreatedUnit(), ( ( ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ) * 6 ) + ( GetUnitAbilityLevelSwapped('A00K', GetTriggerUnit()) + 2 ) ) )
    else
        call SetUnitAbilityLevelSwapped( 'A0ST', GetLastCreatedUnit(), ( ( ( GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) - 1 ) * 6 ) + 1 ) )
    endif
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "soulburn", GetSpellTargetUnit() )
    if ( Trig_Soul_Control_Func007C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0SU', GetLastCreatedUnit() )
        if soul then
        call SetUnitAbilityLevelSwapped( 'A0SU', GetLastCreatedUnit(), ( 2 + GetUnitAbilityLevelSwapped('A00K', GetTriggerUnit()) ) )
        endif
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "doom", GetSpellTargetUnit() )
    else
    endif
endfunction

