//===========================================================================
// Trigger: Bash
//===========================================================================
function Trig_Bash_Conditions takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetAttacker(), 'B06N') == true ) ) then
        return false
    endif
    if ( not ( IsUnitEnemy(GetAttackedUnitBJ(), GetOwningPlayer(GetAttacker())) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Bash_Actions takes nothing returns nothing
    call PolledWait( 0.30 )
    if UnitHasBuffBJ(GetAttacker(), 'B06N') then
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetAttacker()), GetUnitLoc(GetAttacker()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0O2', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0O2', GetLastCreatedUnit(), ( GetPlayerTechCountSimple('R07L', GetOwningPlayer(GetAttacker())) + 1 ) )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "thunderbolt", GetAttackedUnitBJ() )
    call UnitDamageTargetBJ( GetAttacker(), GetAttackedUnitBJ(), ( 50.00 + ( ( I2R(GetUnitAbilityLevelSwapped('A0O0', GetAttacker())) * 25.00 ) + ( I2R(GetHeroStatBJ(bj_HEROSTAT_STR, GetAttacker(), true)) * ( 0.66 * I2R(GetPlayerTechCountSimple('R07L', GetOwningPlayer(GetAttacker()))) ) ) ) ), ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
    call TextTagForce( ( "+" + I2S( R2I( (50.00+I2R(GetUnitAbilityLevelSwapped('A0O0', GetAttacker())*25)+I2R(GetHeroStatBJ(bj_HEROSTAT_STR, GetAttacker(), true)*GetPlayerTechCountSimple('R07L', GetOwningPlayer(GetAttacker())))*0.66) ))), GetAttackedUnitBJ() , 10 , 255 , 255 , 150, 3, GetPlayersAll() )
    endif
    call UnitRemoveBuffBJ( 'B06N', GetAttacker() )
endfunction

//===========================================================================
function InitTrig_Bash takes nothing returns nothing
    set gg_trg_Bash = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Bash, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_Bash, Condition( function Trig_Bash_Conditions ) )
    call TriggerAddAction( gg_trg_Bash, function Trig_Bash_Actions )
endfunction


//===========================================================================
// Trigger: Avartar Active
//===========================================================================
function Trig_Avartar_Active_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A11H' ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A11I', GetTriggerUnit()) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avartar_Active_Func003C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R07M', GetTriggerPlayer()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Avartar_Active_Actions takes nothing returns nothing
    call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "Abilities\\Spells\\Human\\Avatar\\AvatarCaster.mdl" )
    call d_effect(GetLastCreatedEffectBJ(),1)
    if ( Trig_Avartar_Active_Func003C() ) then
        call CreateNUnitsAtLoc( 1, 'e016', GetOwningPlayer(GetTriggerUnit()), GetPlayerStartLocationLoc(GetTriggerPlayer()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( ( 5.00 + ( 2.00 * I2R(GetUnitAbilityLevelSwapped('A11H', GetSpellAbilityUnit())) ) ), 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'S00C', GetLastCreatedUnit() )
    else
    endif
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 8
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetUnitScalePercent( GetTriggerUnit(), ( 110.00 + ( 5.00 * I2R(GetForLoopIndexA()) ) ), ( 110.00 + ( 5.00 * I2R(GetForLoopIndexA()) ) ), ( 110.00 + ( 5.00 * I2R(GetForLoopIndexA()) ) ) )
        call PolledWait( 0.03 )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Avartar_Active takes nothing returns nothing
    set gg_trg_Avartar_Active = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Avartar_Active, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Avartar_Active, Condition( function Trig_Avartar_Active_Conditions ) )
    call TriggerAddAction( gg_trg_Avartar_Active, function Trig_Avartar_Active_Actions )
endfunction

