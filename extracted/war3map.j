// Trigger: Venom Blast Timer
//===========================================================================
function Trig_Venom_Blast_Timer_Func011Func001001003 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Hero_DeC)) == true )
endfunction

function Trig_Venom_Blast_Timer_Func011Func001A takes nothing returns nothing
    call UnitDamageTargetBJ( udg_Hero_DeC, GetEnumUnit(), ( 66.00 + ( 66.00 * I2R(GetUnitAbilityLevelSwapped('A0ID', udg_Hero_DeC)) ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_POISON )
endfunction

function Trig_Venom_Blast_Timer_Func011C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R068', GetOwningPlayer(udg_Hero_DeC)) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Venom_Blast_Timer_Actions takes nothing returns nothing
    call CreateNUnitsAtLoc( 1, 'e030', GetOwningPlayer(udg_Hero_DeC), GetUnitLoc(udg_Hero_DeC), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0IE', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0IE', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0ID', udg_Hero_DeC) )
    call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
    call CreateNUnitsAtLocFacingLocBJ( 1, 'e032', GetOwningPlayer(udg_Hero_DeC), GetUnitLoc(udg_Hero_DeC), GetUnitLoc(udg_Hero_DeC) )
    call KillUnit( GetLastCreatedUnit() )
    call PauseTimerBJ( true, udg_Hero_DeC_VenomEffTimer )
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 10
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call DestroyEffectBJ( udg_Hero_DeC_VenomEff[GetForLoopIndexA()] )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call PlaySoundBJ( gg_snd_DeC_Ulti )
    if ( Trig_Venom_Blast_Timer_Func011C() ) then
        call ForGroupBJ( GetUnitsInRangeOfLocMatching(200.00, GetUnitLoc(udg_Hero_DeC), Condition(function Trig_Venom_Blast_Timer_Func011Func001001003)), function Trig_Venom_Blast_Timer_Func011Func001A )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Venom_Blast_Timer takes nothing returns nothing
    set gg_trg_Venom_Blast_Timer = CreateTrigger(  )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Venom_Blast_Timer, udg_Hero_DeC_VenomTimer )
    call TriggerAddAction( gg_trg_Venom_Blast_Timer, function Trig_Venom_Blast_Timer_Actions )
endfunction

