    set gg_trg_Shadow_Break = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Shadow_Break, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Shadow_Break, Condition( function Trig_Shadow_Break_Conditions ) )
    call TriggerAddAction( gg_trg_Shadow_Break, function Trig_Shadow_Break_Actions )
endfunction

