        return false
    endif
    if ( not ( GetEventDamage() > 0.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lament_Die_Func005C takes nothing returns boolean
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) != LoadRealBJ(GetConvertedPlayerId(GetTriggerPlayer()), StringHashBJ("Life"), GetLastCreatedHashtableBJ()) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lament_Die_Func006Func008C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R06M', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lament_Die_Func006Func022C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B03K') == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lament_Die_Func006C takes nothing returns boolean
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) <= LoadRealBJ(GetConvertedPlayerId(GetTriggerPlayer()), StringHashBJ("ExtraDamage"), GetLastCreatedHashtableBJ()) ) ) then
        return false
    endif
    if ( not ( IsTriggerEnabled(GetTriggeringTrigger()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Lament_Die_Actions takes nothing returns nothing
    local unit u
    local integer randmsg = GetRandomInt( 1 , 3 )
    if ( Trig_Lament_Die_Func005C() ) then
        call SaveRealBJ( GetEventDamage(), GetConvertedPlayerId(GetTriggerPlayer()), StringHashBJ("ExtraDamage"), GetLastCreatedHashtableBJ() )
        call SaveRealBJ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()), GetConvertedPlayerId(GetTriggerPlayer()), StringHashBJ("Life"), GetLastCreatedHashtableBJ() )
    else
        call SaveRealBJ( ( LoadRealBJ(GetConvertedPlayerId(GetTriggerPlayer()), StringHashBJ("ExtraDamage"), GetLastCreatedHashtableBJ()) + GetEventDamage() ), GetConvertedPlayerId(GetTriggerPlayer()), StringHashBJ("ExtraDamage"), GetLastCreatedHashtableBJ() )
    endif
    if ( Trig_Lament_Die_Func006C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call SetUnitLifePercentBJ( GetTriggerUnit(), 100 )
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetEventDamageSource()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 8.00, 'BTLF', GetLastCreatedUnit() )
        set u = GetLastCreatedUnit()
        if ( Trig_Lament_Die_Func006Func008C() ) then
            call SetUnitInvulnerable( GetTriggerUnit(), true )
        else
        endif
        if randmsg == 1 then
        call TextTag( "나의 죽음, 복수하리라..." , GetTriggerUnit() , 10 , 131 , 77 , 173, 3 )
        endif
        if randmsg == 2 then
        call TextTag( "이 원한은 잊지 않는다..." , GetTriggerUnit() , 10 , 131 , 77 , 173, 3 )
        endif
        if randmsg == 3 then
        call TextTag( "내게 남겨진 건 복수뿐..." , GetTriggerUnit() , 10 , 131 , 77 , 173, 3 )
        endif
        call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "war3mapImported\\RedPillar.mdx" )
        call d_effect(GetLastCreatedEffectBJ(),5)
        call TriggerSleepAction( 0.50 )
        call TriggerSleepAction( ( 1.50 + I2R(GetUnitAbilityLevelSwapped('A0GI', GetTriggerUnit())) ) )
        if ( Trig_Lament_Die_Func006Func022C() ) then
            call AbsoluteDamage(u, GetTriggerUnit(), 10000)
        else
        endif
        call TriggerSleepAction( 1.00 )
        call EnableTrigger( GetTriggeringTrigger() )
    else
    endif
endfunction

