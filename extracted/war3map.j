//===========================================================================
// Trigger: Satellite Launcher Mark
//===========================================================================
function Trig_Satellite_Launcher_Mark_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A00L' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Satellite_Launcher_Mark_Func005C takes nothing returns boolean
    if ( not ( udg_Hero_LeM_UltiInt == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Satellite_Launcher_Mark_Func006C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'kymn') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Satellite_Launcher_Mark_Actions takes nothing returns nothing
    set udg_Hero_LeM_UltiInt = ( udg_Hero_LeM_UltiInt - 1 )
    call CreateNUnitsAtLocFacingLocBJ( 1, 'n005', GetTriggerPlayer(), GetSpellTargetLoc(), GetUnitLoc(GetLastCreatedUnit()) )
    call SetUnitTimeScalePercent( GetLastCreatedUnit(), 470.00 )
    call UnitApplyTimedLifeBJ( 1.25, 'BTLF', GetLastCreatedUnit() )
    if ( Trig_Satellite_Launcher_Mark_Func005C() ) then
        call ExplodeUnitBJ( udg_Hero_ReM_Meca )
    else
    endif
    if ( Trig_Satellite_Launcher_Mark_Func006C() ) then
