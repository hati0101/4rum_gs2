// Trigger: Leaving Game
//===========================================================================
function Trig_Leaving_Game_Func004Func001Func001C takes nothing returns boolean
    if ( not ( GetPlayerController(udg_SP_Player[GetForLoopIndexA()]) == MAP_CONTROL_USER ) ) then
        return false
    endif
    if ( not ( GetPlayerSlotState(udg_SP_Player[GetForLoopIndexA()]) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    return true
endfunction

function Trig_Leaving_Game_Func004Func002Func001C takes nothing returns boolean
    if ( not ( GetPlayerController(udg_SP_Player[GetForLoopIndexA()]) == MAP_CONTROL_USER ) ) then
        return false
    endif
    if ( not ( GetPlayerSlotState(udg_SP_Player[GetForLoopIndexA()]) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    return true
endfunction

function Trig_Leaving_Game_Func004C takes nothing returns boolean
    if ( not ( IsPlayerAlly(GetTriggerPlayer(), udg_Force[1]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Leaving_Game_Func005Func001Func001C takes nothing returns boolean
    if ( not ( GetPlayerController(udg_SP_Player[GetForLoopIndexA()]) == MAP_CONTROL_USER ) ) then
        return false
    endif
    if ( not ( GetPlayerSlotState(udg_SP_Player[GetForLoopIndexA()]) == PLAYER_SLOT_STATE_PLAYING ) ) then
        return false
    endif
    return true
endfunction

