//===========================================================================
// Trigger: Ambush
//===========================================================================
function Trig_Ambush_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0G4' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ambush_Func001Func004C takes nothing returns boolean
    if ( not ( GetLocalPlayer() == GetOwningPlayer(GetTriggerUnit()) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ambush_Actions takes nothing returns nothing
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 18
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc( 1, 'e03P', GetTriggerPlayer(), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 1300.00, ( 20.00 * I2R(GetForLoopIndexA()) )), bj_UNIT_FACING )
        call SetUnitVertexColorBJ( GetLastCreatedUnit(), 100, 100, 100, 100.00 )
        set udg_Hero_DrR_Ambush_SFX[GetForLoopIndexA()] = GetLastCreatedUnit()
        if ( Trig_Ambush_Func001Func004C() ) then
            call SetUnitVertexColorBJ( udg_Hero_DrR_Ambush_SFX[GetForLoopIndexA()], 100, 100, 100, 0.00 )
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set udg_Hero_DrR_AmbuStun = 0
    set udg_Hero_DrR = GetTriggerUnit()
    set udg_Hero_DrR_AmbuLoc = GetUnitLoc(GetTriggerUnit())
    set udg_Hero_DrR_AmbuAttacker = null
    call StartTimerBJ( udg_Hero_DrR_AmbuLevel, false, ( 4.50 - ( 0.50 * I2R(GetUnitAbilityLevelSwapped('A0G4', udg_Hero_DrR)) ) ) )
    call TriggerExecute( gg_trg_Ambush_Check )
endfunction

//===========================================================================
function InitTrig_Ambush takes nothing returns nothing
    set gg_trg_Ambush = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Ambush, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Ambush, Condition( function Trig_Ambush_Conditions ) )
    call TriggerAddAction( gg_trg_Ambush, function Trig_Ambush_Actions )
endfunction

//===========================================================================
// Trigger: Ambush Buff
//===========================================================================
function Trig_Ambush_Buff_Conditions takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_Hero_DrR, 'B0AC') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ambush_Buff_Func002C takes nothing returns boolean
    if ( not ( udg_Hero_DrR_AmbuStun < 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ambush_Buff_Actions takes nothing returns nothing
    if ( Trig_Ambush_Buff_Func002C() ) then
        set udg_Hero_DrR_AmbuStun = IMinBJ(3, ( udg_Hero_DrR_AmbuStun + 1 ))
        call TextTagForce( ( "매복 보너스 + " + I2S(udg_Hero_DrR_AmbuStun) ), udg_Hero_DrR , 10 , 255 , 255 , 150, 3, GetForceOfPlayer(GetOwningPlayer(udg_Hero_DrR)) )
    else
    endif
    call StartTimerBJ( udg_Hero_DrR_AmbuLevel, false, ( 4.50 - ( 0.50 * I2R(GetUnitAbilityLevelSwapped('A0G4', udg_Hero_DrR)) ) ) )
endfunction

//===========================================================================
function InitTrig_Ambush_Buff takes nothing returns nothing
    set gg_trg_Ambush_Buff = CreateTrigger(  )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Ambush_Buff, udg_Hero_DrR_AmbuLevel )
    call TriggerAddCondition( gg_trg_Ambush_Buff, Condition( function Trig_Ambush_Buff_Conditions ) )
    call TriggerAddAction( gg_trg_Ambush_Buff, function Trig_Ambush_Buff_Actions )
endfunction

//===========================================================================
// Trigger: Ambush Check
//
// (Number of units in (Units in Ri_Loca matching ((Matching unit) Equal to Ri_Unit))) Equal to 0
//===========================================================================
function Trig_Ambush_Check_Func002Func002001001003 takes nothing returns boolean
    return ( GetFilterUnit() == udg_Hero_DrR )
endfunction

function Trig_Ambush_Check_Func002C takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsInRangeOfLocMatching(1300.00, udg_Hero_DrR_AmbuLoc, Condition(function Trig_Ambush_Check_Func002Func002001001003))) != 0 ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(udg_Hero_DrR, 'B0AC') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Ambush_Check_Actions takes nothing returns nothing
    call PolledWait( 2 )
    if ( Trig_Ambush_Check_Func002C() ) then
        call TriggerExecute( GetTriggeringTrigger() )
    else
        call DisableTrigger( GetTriggeringTrigger() )
        call RemoveLocation(udg_Hero_DrR_AmbuLoc)
        set udg_Hero_DrR_AmbuLoc = null
        set udg_Hero_DrR_AmbuStun = 0
        set bj_forLoopAIndex = 1
        set bj_forLoopAIndexEnd = 12
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call RemoveUnit( udg_Hero_DrR_Ambush_SFX[GetForLoopIndexA()] )
            set bj_forLoopAIndex = bj_forLoopAIndex + 1
        endloop
        call UnitRemoveBuffBJ( 'B0AC', udg_Hero_DrR )
    endif
endfunction

//===========================================================================
function InitTrig_Ambush_Check takes nothing returns nothing
    set gg_trg_Ambush_Check = CreateTrigger(  )
    call DisableTrigger( gg_trg_Ambush_Check )
    call TriggerAddAction( gg_trg_Ambush_Check, function Trig_Ambush_Check_Actions )
endfunction

