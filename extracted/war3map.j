// Trigger: Fell Prince Special 1
//===========================================================================
function Trig_Fell_Prince_Special_1_Func001C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A0L9' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A0N6' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Fell_Prince_Special_1_Conditions takes nothing returns boolean
    if ( not Trig_Fell_Prince_Special_1_Func001C() ) then
        return false
    endif
    return true
endfunction

function Trig_Fell_Prince_Special_1_Func004C takes nothing returns boolean
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_FeP_Sp1Unit) <= ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, udg_Hero_FeP_Sp1Unit) * 0.15 ) ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_Hero_FeP_Sp1Unit) == true ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R06V', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fell_Prince_Special_1_Func005C takes nothing returns boolean
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_FeP_Sp1Unit) >= ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, udg_Hero_FeP_Sp1Unit) * 0.33 ) ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R0AI', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'Eevi' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() == 'A0L9' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Fell_Prince_Special_1_Actions takes nothing returns nothing
    set udg_Hero_FeP_Sp1Unit = GetSpellTargetUnit()
    call PolledWait( 0.15 )
    if ( Trig_Fell_Prince_Special_1_Func004C() ) then
        call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_FeP_Sp1Unit, "Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl" )
        call d_effect(GetLastCreatedEffectBJ(),2)
        call TextTag( "마무리일격!" , udg_Hero_FeP_Sp1Unit , 10 , 255 , 255 , 150, 3 )
        call AbsoluteDamage(GetTriggerUnit(),udg_Hero_FeP_Sp1Unit, 99999)
    else
    endif
    if ( Trig_Fell_Prince_Special_1_Func005C() ) then
        set udg_Hero_FeP_Sp1Target = true
    else
    endif
endfunction

