endfunction

//===========================================================================
// Trigger: Des Special 3 HP
//===========================================================================
function Trig_Des_Special_3_HP_Conditions takes nothing returns boolean
    if ( not ( ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) - GetEventDamage() ) < 125.00 ) ) then
        return false
    endif
    if ( not ( GetEventDamage() > 0.00 ) ) then
        return false
    endif
    if ( not ( GetEventDamage() < GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R078', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A0PY', GetTriggerUnit()) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Des_Special_3_HP_Func003C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(GetTriggerUnit()) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Des_Special_3_HP_Actions takes nothing returns nothing
    local integer randmsg = GetRandomInt( 1 , 3 )
    call PolledWait( 0.01 )
    if ( Trig_Des_Special_3_HP_Func003C() ) then
        call DisableTrigger( gg_trg_Des_Special_3_HP )
        call SetUnitInvulnerable( GetTriggerUnit(), true )
        call StartTimerBJ( udg_Hero_Des_Sp3Timer, false, 5.00 )
        if ( randmsg == 1 ) then
        call TextTag( "꼴까닥!" , GetTriggerUnit(), 10 , 255 , 255 , 255, 3 )
        elseif ( randmsg == 2 ) then
        call TextTag( "이봐, 죽은 사람은 건드리는 게 아니라고!" , GetTriggerUnit(), 10 , 255 , 255 , 255, 3 )
        elseif ( randmsg == 3 ) then
        call TextTag( "아이고 난 이제 죽었어." , GetTriggerUnit(), 10 , 255 , 255 , 255, 3 )
        endif
        call PauseUnitBJ( true, GetTriggerUnit() )
        call SetUnitAnimation( GetTriggerUnit(), "death" )
        call SetUnitTimeScalePercent( GetTriggerUnit(), 200.00 )
        call PolledWait( 0.50 )
        call SetUnitTimeScalePercent( GetTriggerUnit(), 0.00 )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Des_Special_3_HP takes nothing returns nothing
    set gg_trg_Des_Special_3_HP = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Des_Special_3_HP, Condition( function Trig_Des_Special_3_HP_Conditions ) )
    call TriggerAddAction( gg_trg_Des_Special_3_HP, function Trig_Des_Special_3_HP_Actions )
endfunction

