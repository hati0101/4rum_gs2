function Trig_Building_Backdoor_Actions takes nothing returns nothing
    if ( Trig_Building_Backdoor_Func001C() ) then
        call UnitRemoveAbilityBJ( 'Avul', gg_unit_negf_0016 )
        call UnitRemoveAbilityBJ( 'Avul', gg_unit_negf_0017 )
    else
    endif
    if ( Trig_Building_Backdoor_Func002C() ) then
        call UnitRemoveAbilityBJ( 'Avul', gg_unit_negf_0020 )
        call UnitRemoveAbilityBJ( 'Avul', gg_unit_negf_0019 )
    else
    endif
    if ( Trig_Building_Backdoor_Func003C() ) then
        call UnitRemoveAbilityBJ( 'Avul', gg_unit_n012_0086 )
        call UnitRemoveAbilityBJ( 'Avul', gg_unit_n012_0087 )
    else
    endif
    if ( Trig_Building_Backdoor_Func004C() ) then
        call UnitRemoveAbilityBJ( 'Avul', gg_unit_hbar_0015 )
    else
    endif
    if ( Trig_Building_Backdoor_Func005C() ) then
        call UnitRemoveAbilityBJ( 'Avul', gg_unit_hbar_0018 )
    else
    endif
    if ( Trig_Building_Backdoor_Func006C() ) then
        call UnitRemoveAbilityBJ( 'Avul', gg_unit_hbar_0021 )
    else
