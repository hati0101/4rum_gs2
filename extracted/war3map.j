function Trig_EleHar_Get_Actions takes nothing returns nothing
    if ( Trig_EleHar_Get_Func001C() ) then
        set udg_Hero_Ele_Bool = true
        call DisableTrigger( GetTriggeringTrigger() )
        return
    else
    endif
    if ( Trig_EleHar_Get_Func002C() ) then
        set udg_Hero_Ele_Bool = true
        call DisableTrigger( GetTriggeringTrigger() )
        return
    else
    endif
    if ( Trig_EleHar_Get_Func003C() ) then
        if ( Trig_EleHar_Get_Func003Func002C() ) then
            set udg_Hero_Ele_Int = IMinBJ(15, ( udg_Hero_Ele_Int + 3 ))
        else
            set udg_Hero_Ele_Int = IMinBJ(10, ( udg_Hero_Ele_Int + 3 ))
        endif
    else
        if ( Trig_EleHar_Get_Func003Func001C() ) then
            set udg_Hero_Ele_Int = 15
        else
            set udg_Hero_Ele_Int = 5
        endif
    endif
    if ( Trig_EleHar_Get_Func004C() ) then
        call SetUnitLifeBJ( udg_Hero_Ele, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_Ele) + ( I2R(udg_Hero_Ele_Int) * 3.00 ) ) )
        call SetUnitManaBJ( udg_Hero_Ele, ( GetUnitStateSwap(UNIT_STATE_MANA, udg_Hero_Ele) + ( I2R(udg_Hero_Ele_Int) * 3.00 ) ) )
    else
        if ( Trig_EleHar_Get_Func004Func001C() ) then
            call SetUnitLifeBJ( udg_Hero_Ele, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_Ele) + ( I2R(udg_Hero_Ele_Int) * 5.00 ) ) )
            call SetUnitManaBJ( udg_Hero_Ele, ( GetUnitStateSwap(UNIT_STATE_MANA, udg_Hero_Ele) + ( I2R(udg_Hero_Ele_Int) * 5.00 ) ) )
        else
            if ( Trig_EleHar_Get_Func004Func001Func002C() ) then
                call SetUnitLifeBJ( udg_Hero_Ele, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_Ele) + ( I2R(udg_Hero_Ele_Int) * 7.00 ) ) )
                call SetUnitManaBJ( udg_Hero_Ele, ( GetUnitStateSwap(UNIT_STATE_MANA, udg_Hero_Ele) + ( I2R(udg_Hero_Ele_Int) * 7.00 ) ) )
            else
                if ( Trig_EleHar_Get_Func004Func001Func002Func002C() ) then
                    call SetUnitLifeBJ( udg_Hero_Ele, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_Ele) + ( I2R(udg_Hero_Ele_Int) * 9.00 ) ) )
                    call SetUnitManaBJ( udg_Hero_Ele, ( GetUnitStateSwap(UNIT_STATE_MANA, udg_Hero_Ele) + ( I2R(udg_Hero_Ele_Int) * 9.00 ) ) )
                else
                endif
            endif
        endif
    endif
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_Ele, "Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call TextTagForce( I2S(udg_Hero_Ele_Int), udg_Hero_Ele, 10, 45, 143, 38, 3, GetForceOfPlayer(GetOwningPlayer(udg_Hero_Ele)) )
    if ( Trig_EleHar_Get_Func008C() ) then
        call PolledWait( 8.00 )
    else
        call PolledWait( 15.00 )
    endif
    if ( Trig_EleHar_Get_Func009C() ) then
        call TriggerExecute( gg_trg_EleHar_Get )
    else
    endif
endfunction

