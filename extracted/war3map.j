    if ( not ( GetPlayerTechCountSimple('R06D', GetTriggerPlayer()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_PoD_Skill_Effect_Func006C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0JA' ) ) then
        return false
    endif
    return true
endfunction

function Trig_PoD_Skill_Effect_Func007C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A005' ) ) then
        return false
    endif
    return true
endfunction

function Trig_PoD_Skill_Effect_Actions takes nothing returns nothing
    local location point
    local integer lv
    if ( Trig_PoD_Skill_Effect_Func003C() ) then
        if ( IsUnitAliveBJ(GetSpellTargetUnit()) == true ) then
        set point = GetUnitLoc(GetTriggerUnit())
        else
        set point = OffsetLocation(GetSpellTargetLoc(), 0, 0)
        endif
        set lv = (( R2I(DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), point)) / 100 ) + 1 )
        call AddSpecialEffectLocBJ( GetSpellTargetLoc(), "Objects\\Spawnmodels\\Human\\HCancelDeath\\HCancelDeath.mdl" )
        call d_effect(GetLastCreatedEffectBJ(),1.5)
        call CreateNUnitsAtLoc( 1, 'ewsp', GetTriggerPlayer(), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A006', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A006', GetLastCreatedUnit(), ( ( ( GetUnitAbilityLevelSwapped('A003', GetTriggerUnit()) - 1 ) * 9 ) + lv ) )
        call IssuePointOrderLocBJ( GetLastCreatedUnit(), "breathoffire", point )
        if ( Trig_PoD_Skill_Effect_Func003Func014C() ) then
            call SetUnitVertexColorBJ( GetTriggerUnit(), 100, 100, 100, 100.00 )
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'S00J', GetLastCreatedUnit() )
            call PolledWait( 4.00 )
            call SetUnitVertexColorBJ( GetTriggerUnit(), 100, 100, 100, 0.00 )
        else
        endif
    else
    endif
    if ( Trig_PoD_Skill_Effect_Func004C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetTriggerPlayer(), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        // 타겟이 아군인지 적군인지 검사
        if ( Trig_PoD_Skill_Effect_Func004Func004C() ) then
            call UnitAddAbilityBJ( 'A032', GetLastCreatedUnit() )
            call SetUnitAbilityLevelSwapped( 'A032', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A04P', GetTriggerUnit()) )
            call IssueTargetOrderBJ( GetLastCreatedUnit(), "holybolt", GetSpellTargetUnit() )
        else
            call UnitAddAbilityBJ( 'A031', GetLastCreatedUnit() )
            call SetUnitAbilityLevelSwapped( 'A031', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A04P', GetTriggerUnit()) )
            call IssueTargetOrderBJ( GetLastCreatedUnit(), "faeriefire", GetSpellTargetUnit() )
        endif
    else
    endif
    if ( Trig_PoD_Skill_Effect_Func005C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0JD', GetLastCreatedUnit() )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "soulburn", GetSpellTargetUnit() )
    else
    endif
    if ( Trig_PoD_Skill_Effect_Func006C() ) then
        call PlaySoundBJ( gg_snd_EvilArthasYesAttack2 )
        if ( Trig_PoD_Skill_Effect_Func006Func002C() ) then
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A0JC', GetLastCreatedUnit() )
            call IssueTargetOrderBJ( GetLastCreatedUnit(), "antimagicshell", GetTriggerUnit() )
        else
        endif
    else
    endif
    if ( Trig_PoD_Skill_Effect_Func007C() ) then
        call UnitDamageTargetBJ( GetTriggerUnit(), GetSpellTargetUnit(), ( 15.00 * 1.00 ), ATTACK_TYPE_HERO, DAMAGE_TYPE_DIVINE )
    else
    endif
endfunction

