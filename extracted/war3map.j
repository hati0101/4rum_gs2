// Trigger: Curruption Arrow Skel
//===========================================================================
function Trig_Curruption_Arrow_Skel_Conditions takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B02H') == true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) != true ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_SUMMONED) != true ) ) then
        return false
    endif
    if ( not ( GetUnitPointValue(GetDyingUnit()) < 1250 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Curruption_Arrow_Skel_Func001C takes nothing returns boolean
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) != udg_Hero_SoH_ExtraDmg[2] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Curruption_Arrow_Skel_Func002Func002C takes nothing returns boolean
    if ( not ( IsUnitDeadBJ(GetTriggerUnit()) == true ) ) then
        return false
    endif
    if ( not ( GetTriggerUnit() != null ) ) then
        return false
    endif
    return true
endfunction

function Trig_Curruption_Arrow_Skel_Func002C takes nothing returns boolean
    if ( not ( udg_Hero_SoH_ExtraDmg[1] >= GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Curruption_Arrow_Skel_Actions takes nothing returns nothing
    if ( Trig_Curruption_Arrow_Skel_Func001C() ) then
        set udg_Hero_SoH_ExtraDmg[1] = GetEventDamage()
        set udg_Hero_SoH_ExtraDmg[2] = GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit())
    else
        set udg_Hero_SoH_ExtraDmg[1] = ( GetEventDamage() + udg_Hero_SoH_ExtraDmg[1] )
    endif
    if ( Trig_Curruption_Arrow_Skel_Func002C() ) then
        call PolledWait( 0.10 )
        if ( Trig_Curruption_Arrow_Skel_Func002Func002C() ) then
            if GetUnitAbilityLevelSwapped('A149', udg_Hero_SoH) == 1 then
            call CreateNUnitsAtLoc( 1, 'u00C', GetOwningPlayer(udg_Hero_SoH), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 80.00, 'Brai', GetLastCreatedUnit() )
            call UnitAddTypeBJ( UNIT_TYPE_SUMMONED, GetLastCreatedUnit() )
            call SetUnitAnimation( GetLastCreatedUnit(), "birth" )
            elseif GetUnitAbilityLevelSwapped('A149', udg_Hero_SoH) == 2 then
            call CreateNUnitsAtLoc( 1, 'u00T', GetOwningPlayer(udg_Hero_SoH), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 80.00, 'Brai', GetLastCreatedUnit() )
            call UnitAddTypeBJ( UNIT_TYPE_SUMMONED, GetLastCreatedUnit() )
            call SetUnitAnimation( GetLastCreatedUnit(), "birth" )
            elseif GetUnitAbilityLevelSwapped('A149', udg_Hero_SoH) == 3 then
            call CreateNUnitsAtLoc( 1, 'u00R', GetOwningPlayer(udg_Hero_SoH), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 80.00, 'Brai', GetLastCreatedUnit() )
            call UnitAddTypeBJ( UNIT_TYPE_SUMMONED, GetLastCreatedUnit() )
            call SetUnitAnimation( GetLastCreatedUnit(), "birth" )
            elseif GetUnitAbilityLevelSwapped('A149', udg_Hero_SoH) == 4 then
            call CreateNUnitsAtLoc( 1, 'u00S', GetOwningPlayer(udg_Hero_SoH), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 80.00, 'Brai', GetLastCreatedUnit() )
            call UnitAddTypeBJ( UNIT_TYPE_SUMMONED, GetLastCreatedUnit() )
            call SetUnitAnimation( GetLastCreatedUnit(), "birth" )
            call RemoveUnit( GetTriggerUnit() )
            endif
        else
        endif
    else
    endif
endfunction

