//===========================================================================
// Trigger: Swash Slide
//===========================================================================
function Trig_Swash_Slide_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A01X' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Swash_Slide_Func041C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R00Q', GetTriggerPlayer()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Swash_Slide_Actions takes nothing returns nothing
    local effect eff1
    local effect eff2
    local effect eff3
    local unit target = GetSpellTargetUnit()
    local unit slideunit
    local unit casterunit
    local unit targetunit
    local unit dmgunit
    local unit wisp
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    set wisp = GetLastCreatedUnit()
    if ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I011') == true ) then
        call UnitAddItemByIdSwapped( 'I011', wisp )
    endif
    call PauseUnitBJ( true, GetTriggerUnit() )
    call SetUnitVertexColorBJ( GetTriggerUnit(), 100, 100, 100, 100.00 )
    call CreateNUnitsAtLoc( 1, 'h000', GetTriggerPlayer(), GetUnitLoc(GetTriggerUnit()), GetUnitFacing(GetTriggerUnit()) )
    set slideunit = GetLastCreatedUnit()
    call SetUnitFlyHeightBJ( slideunit, 400.00, 2000.00 ) // 고도설정
    call AddSpecialEffectLocBJ( GetUnitLoc(GetTriggerUnit()), "Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl" )
    set eff1 = GetLastCreatedEffectBJ()
    call CreateNUnitsAtLoc( 1, 'h001', GetTriggerPlayer(), GetUnitLoc(GetTriggerUnit()), GetUnitFacing(GetTriggerUnit()) )
    set casterunit = GetLastCreatedUnit()
    call UnitAddAbilityBJ( 'A01D', casterunit )
    call PolledWait( 0.15 )
    if IsUnitAliveBJ(target) and DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(target)) < 1400  then
    call SetUnitPositionLoc( slideunit, PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), ( DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(target)) - 100.00 ), AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(target))) )
    call SetUnitPositionLoc( GetTriggerUnit(), GetUnitLoc(slideunit) )
    endif
    call SetUnitAnimation( slideunit, "attack" )
    call SetUnitTimeScalePercent( slideunit, 300.00 )
    call SetUnitFlyHeightBJ( slideunit, 0.00, 2000.00 ) // 고도설정
    call AddSpecialEffectLocBJ( GetUnitLoc(GetTriggerUnit()), "Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl" )
    set eff2 = GetLastCreatedEffectBJ()
    call CreateNUnitsAtLoc( 1, 'h001', GetTriggerPlayer(), GetUnitLoc(GetTriggerUnit()), GetUnitFacing(GetTriggerUnit()) )
    set targetunit = GetLastCreatedUnit()
    call PolledWait( 0.15 )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(target), bj_UNIT_FACING )
    set dmgunit = GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', dmgunit )
    if ( Trig_Swash_Slide_Func041C() ) then
        call UnitAddAbilityBJ( 'A01N', dmgunit )
        call IssueImmediateOrderBJ( dmgunit, "stomp" )
    else
    endif
    call UnitAddAbilityBJ( 'A01O', dmgunit )
    call SetUnitAbilityLevelSwapped( 'A01O', dmgunit, ( GetUnitAbilityLevelSwapped('A01X', GetTriggerUnit()) + ( 4 * GetPlayerTechCountSimple('R00Q', GetOwningPlayer(GetTriggerUnit())) ) ) )
    call IssueTargetOrderBJ( dmgunit, "thunderbolt", target )
    call AddSpecialEffectLocBJ( GetUnitLoc(target), "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl" )
    set eff3 = GetLastCreatedEffectBJ()
    call PauseUnitBJ( false, GetTriggerUnit() )
    call SetUnitVertexColorBJ( GetTriggerUnit(), 100, 100, 100, 0.00 )
    call IssueTargetOrderBJ( GetTriggerUnit(), "attack", target )
    call RemoveUnit( slideunit )
    call PolledWait( 0.50 )
    if ( UnitHasItemOfTypeBJ(wisp, 'I011') == true ) then
        call RemoveItem( GetItemOfTypeFromUnitBJ(wisp, 'I011') )
    endif
    call RemoveUnit( wisp )
    call RemoveUnit( casterunit )
    call RemoveUnit( targetunit )
    call DestroyEffectBJ( eff1 )
    call DestroyEffectBJ( eff2 )
endfunction

//===========================================================================
function InitTrig_Swash_Slide takes nothing returns nothing
    set gg_trg_Swash_Slide = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Swash_Slide, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Swash_Slide, Condition( function Trig_Swash_Slide_Conditions ) )
    call TriggerAddAction( gg_trg_Swash_Slide, function Trig_Swash_Slide_Actions )
endfunction

