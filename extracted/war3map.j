    endif
    return true
endfunction

function Trig_MRG_Skill_Effect_Actions takes nothing returns nothing
    if ( Trig_MRG_Skill_Effect_Func001C() ) then
        set bj_wantDestroyGroup=true
        call ForGroupBJ( GetUnitsInRangeOfLocMatching(300.00, GetSpellTargetLoc(), Condition(function Trig_MRG_Skill_Effect_Func001Func004001003)), function Trig_MRG_Skill_Effect_Func001Func004A )
        call CreateNUnitsAtLocFacingLocBJ( 1, 'e03A', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()) )
        call UnitApplyTimedLifeBJ( 20.00, 'BTLF', GetLastCreatedUnit() )
        call MakeUnitFollow(GetLastCreatedUnit(), GetTriggerUnit(), 30)
    else
    endif
    if ( Trig_MRG_Skill_Effect_Func002C() ) then
        call CreateNUnitsAtLocFacingLocBJ( 1, 'n01V', GetOwningPlayer(GetTriggerUnit()), udg_Hero_MRG_SpPoint, GetUnitLoc(GetTriggerUnit()) )
        call UnitApplyTimedLifeBJ( 10.00, 'BTLF', GetLastCreatedUnit() )
        call TextTagForce( "300 범위 내에서 오른쪽 클릭시 이동합니다.", GetLastCreatedUnit(), 10, 20, 20, 255, 4, GetPlayersAllies(GetOwningPlayer(udg_Hero_MRG)) )
    else
    endif
    if ( Trig_MRG_Skill_Effect_Func003C() ) then
        call CreateNUnitsAtLoc( 1, 'e01M', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 4.00, 'BTLF', GetLastCreatedUnit() )
        if ( Trig_MRG_Skill_Effect_Func003Func003C() ) then
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A101', GetLastCreatedUnit() )
            call SetUnitAbilityLevelSwapped( 'A101', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0T7', GetTriggerUnit()) )
            call IssueImmediateOrderBJ( GetLastCreatedUnit(), "fanofknives" )
        else
        endif
        if ( Trig_MRG_Skill_Effect_Func003Func004C() ) then
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), udg_Hero_MRG_UltiPoint, bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A12Y', GetLastCreatedUnit() )
            call IssueImmediateOrderBJ( GetLastCreatedUnit(), "stomp" )
        else
        endif
    else
    endif
endfunction

