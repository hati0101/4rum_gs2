function Trig_Corrosive_Poison_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A03D' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Corrosive_Poison_Actions takes nothing returns nothing
    local unit t = GetTriggerUnit()
    local unit u = GetSpellTargetUnit()
    local boolean sp = false
    if GetPlayerTechCountSimple('R01K', GetOwningPlayer(t)) > 0 then
    set sp = true
    endif
    call PolledWait( 5.00 )
    if UnitHasBuffBJ(u, 'B02U') then
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(u), GetUnitLoc(u), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A13N', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A13N', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A03D', GetTriggerUnit()) )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "thunderbolt", u )
        if sp then
        call UnitDamageTarget(t, u,( 50.00 * I2R(GetUnitAbilityLevelSwapped('A03D', t)) ),true,true,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,null)
        endif
    endif
endfunction

