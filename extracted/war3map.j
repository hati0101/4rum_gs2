//===========================================================================
// Trigger: Creep Spell Limit
//===========================================================================
function Trig_Creep_Spell_Limit_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetTriggerUnit()) == Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    if ( not ( GetPlayerController(GetOwningPlayer(GetSpellTargetUnit())) == MAP_CONTROL_USER ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() != 'A0QJ' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() != 'A0QH' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() != 'A0QK' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() != 'A0QC' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() != 'A0QP' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() != 'A0QQ' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() != 'A0QU' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() != 'A0QT' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() != 'A0D4' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() != 'A0DL' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() != 'A0E3' ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() != 'A0FN' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Creep_Spell_Limit_Actions takes nothing returns nothing
    call KillUnit( GetTriggerUnit() )
endfunction

//===========================================================================
function InitTrig_Creep_Spell_Limit takes nothing returns nothing
    set gg_trg_Creep_Spell_Limit = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Creep_Spell_Limit, EVENT_PLAYER_UNIT_SPELL_CAST )
    call TriggerAddCondition( gg_trg_Creep_Spell_Limit, Condition( function Trig_Creep_Spell_Limit_Conditions ) )
    call TriggerAddAction( gg_trg_Creep_Spell_Limit, function Trig_Creep_Spell_Limit_Actions )
endfunction

