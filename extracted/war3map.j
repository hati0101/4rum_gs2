    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call CreateNUnitsAtLoc( 1, 'e020', GetOwningPlayer(udg_Hero_DeM), GetUnitLoc(udg_Hero_DeM_UltiTarget), 72.00 )
    call SetUnitScalePercent( GetLastCreatedUnit(), 60.00, 60.00, 60.00 )
    call UnitApplyTimedLifeBJ( 0.50, 'BTLF', GetLastCreatedUnit() )
    call CreateNUnitsAtLoc( 1, 'e020', GetOwningPlayer(udg_Hero_DeM), GetUnitLoc(udg_Hero_DeM_UltiTarget), 144.00 )
    call SetUnitScalePercent( GetLastCreatedUnit(), 60.00, 60.00, 60.00 )
    call UnitApplyTimedLifeBJ( 0.50, 'BTLF', GetLastCreatedUnit() )
    call CreateNUnitsAtLoc( 1, 'e020', GetOwningPlayer(udg_Hero_DeM), GetUnitLoc(udg_Hero_DeM_UltiTarget), 216.00 )
    call SetUnitScalePercent( GetLastCreatedUnit(), 60.00, 60.00, 60.00 )
    call UnitApplyTimedLifeBJ( 0.50, 'BTLF', GetLastCreatedUnit() )
    call CreateNUnitsAtLoc( 1, 'e020', GetOwningPlayer(udg_Hero_DeM), GetUnitLoc(udg_Hero_DeM_UltiTarget), 288.00 )
    call SetUnitScalePercent( GetLastCreatedUnit(), 60.00, 60.00, 60.00 )
    call UnitApplyTimedLifeBJ( 0.50, 'BTLF', GetLastCreatedUnit() )
    call CreateNUnitsAtLoc( 1, 'e020', GetOwningPlayer(udg_Hero_DeM), GetUnitLoc(udg_Hero_DeM_UltiTarget), 360.00 )
    call SetUnitScalePercent( GetLastCreatedUnit(), 60.00, 60.00, 60.00 )
    call UnitApplyTimedLifeBJ( 0.50, 'BTLF', GetLastCreatedUnit() )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_DeM_UltiTarget, "Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call CreateNUnitsAtLoc( 1, 'e020', GetOwningPlayer(udg_Hero_DeM), GetUnitLoc(udg_Hero_DeM_UltiTarget), 72.00 )
    call UnitApplyTimedLifeBJ( 0.50, 'BTLF', GetLastCreatedUnit() )
