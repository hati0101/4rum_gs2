    if ( not ( GetUnitTypeId(GetDyingUnit()) == 'hbar' ) ) then
        return false
    endif
    return true
endfunction

function Trig_MegaCreep_System_Actions takes nothing returns nothing
    if ( Trig_MegaCreep_System_Func002C() ) then
        set udg_RevivalTimer[2] = ( udg_RevivalTimer[2] / 3 )
        set udg_RevivalTimer[3] = ( udg_RevivalTimer[3] / 3 )
        set udg_RevivalTimer[4] = ( udg_RevivalTimer[4] / 3 )
        set udg_RevivalTimer[5] = ( udg_RevivalTimer[5] / 3 )
        set udg_RevivalTimer[6] = ( udg_RevivalTimer[6] / 3 )
        if ( Trig_MegaCreep_System_Func002Func012C() ) then
            call PlaySoundBJ( gg_snd_ArrangedTeamInvitation )
            call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_1155" )
        else
            if ( Trig_MegaCreep_System_Func002Func012Func001C() ) then
                if ( Trig_MegaCreep_System_Func002Func012Func001Func002C() ) then
                    call PlaySoundBJ( gg_snd_GameFound )
                    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_1151" )
                    call SetPlayerTechResearchedSwap( 'R04L', 1, udg_Force[2] )
                    call SetPlayerTechResearchedSwap( 'R092', 1, udg_Force[2] )
                else
                    call PlaySoundBJ( gg_snd_ArrangedTeamInvitation )
                    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_1149" )
                endif
            else
                if ( Trig_MegaCreep_System_Func002Func012Func001Func001C() ) then
                    call PlaySoundBJ( gg_snd_DarkVictory )
                    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_1144" )
                    call SetPlayerTechResearchedSwap( 'R04L', 2, udg_Force[2] )
                    call SetPlayerTechResearchedSwap( 'R092', 2, udg_Force[2] )
                    call SetPlayerTechResearchedSwap( 'R0AE', 1, udg_Force[1] )
                else
                endif
            endif
        endif
    else
        set udg_RevivalTimer[8] = ( udg_RevivalTimer[8] / 3 )
        set udg_RevivalTimer[9] = ( udg_RevivalTimer[9] / 3 )
        set udg_RevivalTimer[10] = ( udg_RevivalTimer[10] / 3 )
        set udg_RevivalTimer[11] = ( udg_RevivalTimer[11] / 3 )
        set udg_RevivalTimer[12] = ( udg_RevivalTimer[12] / 3 )
        if ( Trig_MegaCreep_System_Func002Func006C() ) then
            call PlaySoundBJ( gg_snd_ArrangedTeamInvitation )
            call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_1143" )
        else
            if ( Trig_MegaCreep_System_Func002Func006Func001C() ) then
                if ( Trig_MegaCreep_System_Func002Func006Func001Func002C() ) then
                    call PlaySoundBJ( gg_snd_GameFound )
                    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_1028" )
                    call SetPlayerTechResearchedSwap( 'R04L', 1, udg_Force[1] )
                    call SetPlayerTechResearchedSwap( 'R092', 1, udg_Force[1] )
                else
                    call PlaySoundBJ( gg_snd_ArrangedTeamInvitation )
                    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_1115" )
                endif
            else
                if ( Trig_MegaCreep_System_Func002Func006Func001Func001C() ) then
                    call PlaySoundBJ( gg_snd_HeroicVictory )
                    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_941" )
                    call SetPlayerTechResearchedSwap( 'R04L', 2, udg_Force[1] )
                    call SetPlayerTechResearchedSwap( 'R092', 2, udg_Force[1] )
                    call SetPlayerTechResearchedSwap( 'R0AE', 1, udg_Force[2] )
                else
                endif
            endif
        endif
    endif
endfunction

