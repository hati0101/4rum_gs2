    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_DiK_HLTgt) <= ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, udg_Hero_DiK_HLTgt) * 0.50 ) ) ) then
        return false
    endif
    return true
endfunction

