//===========================================================================
// Trigger: Punish Blade Caster
//===========================================================================
function Trig_Punish_Blade_Caster_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0NG' ) ) then
        return false
    endif
    if ( not ( udg_Hero_MRG_IsUltiCasting != true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Punish_Blade_Caster_Func008C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I011') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Punish_Blade_Caster_Func012C takes nothing returns boolean
    if ( not ( udg_Hero_MRG_IsUltiCasting == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Punish_Blade_Caster_Func013C takes nothing returns boolean
    if ( not ( DistanceBetweenPoints(GetUnitLoc(udg_Hero_MRG), GetUnitLoc(udg_Hero_MRG_UltiTarget)) >= 245.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Punish_Blade_Caster_Func016C takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_Hero_MRG_UltiTarget) != 'N02D' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Punish_Blade_Caster_Actions takes nothing returns nothing
    // Skill ready
    set udg_Hero_MRG_IsUltiCasting = true
    call StartTimerBJ( udg_Hero_MRG_PB_Timer, true, 0.20 )
    set udg_Hero_MRG_UltiTarget = GetSpellTargetUnit()
    set udg_Hero_MRG_UltiDmg = I2R(( ( ( GetUnitAbilityLevelSwapped('A0NG', udg_Hero_MRG) * 200 ) + 100 ) + GetHeroStatBJ(bj_HEROSTAT_STR, udg_Hero_MRG, true) ))
    call SetUnitAnimation( GetTriggerUnit(), "attack" )
    call SetUnitTimeScalePercent( GetTriggerUnit(), 12.00 )
    if ( Trig_Punish_Blade_Caster_Func008C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        set udg_Hero_MRG_PB_True = GetLastCreatedUnit()
        call UnitAddItemByIdSwapped( 'I011', udg_Hero_MRG_PB_True )
    else
    endif
    // Now casting...
    call PolledWait( 1.25 )
    // Check cancel
    if ( Trig_Punish_Blade_Caster_Func012C() ) then
        call SetUnitTimeScalePercent( udg_Hero_MRG, 100.00 )
        return
    else
    endif
    if ( Trig_Punish_Blade_Caster_Func013C() ) then
        call SetUnitTimeScalePercent( udg_Hero_MRG, 100.00 )
        call TextTag( "실패!",  udg_Hero_MRG_UltiTarget, 10, 255, 0, 0, 3 )
        set udg_Hero_MRG_IsUltiCasting = false
        return
    else
    endif
    call SetUnitTimeScalePercent( udg_Hero_MRG, 150.00 )
    // Target Effect
    if ( Trig_Punish_Blade_Caster_Func016C() ) then
        call Knockback(udg_Hero_MRG_UltiTarget,AngleBetweenPoints(GetUnitLoc(udg_Hero_MRG), GetUnitLoc(udg_Hero_MRG_UltiTarget)),300,800)
    else
    endif
    call AbsoluteDamage(udg_Hero_MRG,udg_Hero_MRG_UltiTarget, udg_Hero_MRG_UltiDmg)
    // Else effects
    call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_MRG_UltiTarget), "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_MRG_UltiTarget, "Objects\\Spawnmodels\\NightElf\\NEDeathSmall\\NEDeathSmall.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call PlaySoundBJ( gg_snd_MRG_Ulti )
    call CreateNUnitsAtLoc( 1, 'e03Q', GetOwningPlayer(udg_Hero_MRG), GetUnitLoc(GetSpellTargetUnit()), GetUnitFacing(udg_Hero_MRG) )
    set udg_Hero_MRG_PB_Sfx = GetLastCreatedUnit()
    call UnitApplyTimedLifeBJ( 0.30, 'BTLF', GetLastCreatedUnit() )
    call Knockback(udg_Hero_MRG_PB_Sfx,AngleBetweenPoints(GetUnitLoc(udg_Hero_MRG), GetUnitLoc(udg_Hero_MRG_PB_Sfx)),300,800)
    call CreateTextTagUnitBJ( "TRIGSTR_1754", udg_Hero_MRG_UltiTarget, 40.00, 20.00, 100, 0.00, 0.00, 0 )
    call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
    call SetTextTagSuspendedBJ( GetLastCreatedTextTag(), false )
    call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 2.00 )
    call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 5 )
    call CreateTextTagUnitBJ( ( ( "           " + I2S(R2I(udg_Hero_MRG_UltiDmg)) ) + "!" ), udg_Hero_MRG_UltiTarget, -15.00, 15.00, 100, 0.00, 0.00, 0 )
    call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
    call SetTextTagSuspendedBJ( GetLastCreatedTextTag(), false )
    call SetTextTagFadepointBJ( GetLastCreatedTextTag(), 2.00 )
    call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 5 )
    call PauseTimerBJ( true, udg_Hero_MRG_PB_Timer )
    call PolledWait( 0.30 )
    call SetUnitTimeScalePercent( udg_Hero_MRG, 100.00 )
    call RemoveUnit( udg_Hero_MRG_PB_True )
endfunction

