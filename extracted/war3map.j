function Trig_DamageTaken_Func016Func003C takes nothing returns boolean
    if ( not ( ( GetEventDamage() * 0.25 ) > ( 5.00 + ( 5.00 * I2R(GetUnitAbilityLevelSwapped('A145', udg_Hero_MeQ)) ) ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_DamageTaken_Func016C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B0CI') == true ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A145', udg_Hero_MeQ) >= 1 ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEventDamageSource(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEventDamageSource()) != 'e03C' ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) > 5.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DamageTaken_Func017Func001C takes nothing returns boolean
    if ( not ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetTriggerUnit()) >= ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + ( GetEventDamage() * ( 1.35 - ( 0.05 * I2R(GetUnitAbilityLevelSwapped('A0RD', GetTriggerUnit())) ) ) ) ) ) ) then
        return false
    endif
