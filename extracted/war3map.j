    set gg_trg_Link_of_Darkness_Cast = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Link_of_Darkness_Cast, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Link_of_Darkness_Cast, Condition( function Trig_Link_of_Darkness_Cast_Conditions ) )
    call TriggerAddAction( gg_trg_Link_of_Darkness_Cast, function Trig_Link_of_Darkness_Cast_Actions )
