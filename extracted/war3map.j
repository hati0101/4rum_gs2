// Trigger: Mandoc Timer
//===========================================================================
function Trig_Mandoc_Timer_Func001Func005C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R04X', GetOwningPlayer(udg_Hero_Mon)) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mandoc_Timer_Func001C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(udg_Hero_Mon, 'B03K') == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Mandoc_Timer_Actions takes nothing returns nothing
    if ( Trig_Mandoc_Timer_Func001C() ) then
        call UnitRemoveBuffsBJ( bj_REMOVEBUFFS_NEGATIVE, udg_Hero_Mon )
        call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_Mon, "Abilities\\Spells\\NightElf\\FaerieDragonInvis\\FaerieDragon_Invis.mdl" )
        call d_effect(GetLastCreatedEffectBJ(), 1)
        if ( Trig_Mandoc_Timer_Func001Func005C() ) then
            call SetUnitLifeBJ( udg_Hero_Mon, ( GetUnitStateSwap(UNIT_STATE_LIFE, udg_Hero_Mon) + 60.00 ) )
            call SetUnitManaBJ( udg_Hero_Mon, ( GetUnitStateSwap(UNIT_STATE_MANA, udg_Hero_Mon) + 30.00 ) )
            call AddSpecialEffectTargetUnitBJ( "origin", udg_Hero_Mon, "Abilities\\Spells\\Human\\Heal\\HealTarget.mdl" )
            call d_effect(GetLastCreatedEffectBJ(), 1)
        else
        endif
    else
    endif
    call StartTimerBJ( udg_Hero_Mon_MandocTimer, false, ( 16.00 - ( 2.00 * I2R(GetUnitAbilityLevelSwapped('A0MG', udg_Hero_Mon)) ) ) )
endfunction

