endfunction


//===========================================================================
// Trigger: Arcane Shift
//===========================================================================
function Trig_Arcane_Shift_Conditions takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B07Y') == false ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B03O') == false ) ) then
        return false
    endif
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'BNmr') == false ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() == 'A12I' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Arcane_Shift_Func006C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(LoadUnitHandleBJ(StringHashBJ("ArA"), StringHashBJ("ShiftIllusion"), GetLastCreatedHashtableBJ())) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Arcane_Shift_Actions takes nothing returns nothing
    call PolledWait( 2.00 )
    set udg_Hero_ArA_Loc2 = GetUnitLoc(GetTriggerUnit())
    if ( Trig_Arcane_Shift_Func006C() ) then
        call SaveLocationHandleBJ( GetUnitLoc(LoadUnitHandleBJ(StringHashBJ("ArA"), StringHashBJ("ShiftIllusion"), GetLastCreatedHashtableBJ())), StringHashBJ("ArA"), StringHashBJ("ShiftPoint"), GetLastCreatedHashtableBJ() )
        call SetUnitPositionLoc( LoadUnitHandleBJ(StringHashBJ("ArA"), StringHashBJ("ShiftIllusion"), GetLastCreatedHashtableBJ()), udg_Hero_ArA_Loc2 )
        call SetUnitPositionLoc( GetTriggerUnit(), LoadLocationHandleBJ(StringHashBJ("ArA"), StringHashBJ("ShiftPoint"), GetLastCreatedHashtableBJ()) )
    else
    endif
    call SaveUnitHandleBJ( null, StringHashBJ("ArA"), StringHashBJ("ShiftIllusion"), GetLastCreatedHashtableBJ() )
    call RemoveLocation( udg_Hero_ArA_Loc2 )
endfunction

//===========================================================================
function InitTrig_Arcane_Shift takes nothing returns nothing
    set gg_trg_Arcane_Shift = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Arcane_Shift, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Arcane_Shift, Condition( function Trig_Arcane_Shift_Conditions ) )
    call TriggerAddAction( gg_trg_Arcane_Shift, function Trig_Arcane_Shift_Actions )
endfunction

//===========================================================================
// Trigger: Arcane Shift Start
//===========================================================================
function Trig_Arcane_Shift_Start_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A12I' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Arcane_Shift_Start_Func012C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R03V', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Arcane_Shift_Start_Actions takes nothing returns nothing
    set udg_Hero_ArA_Loc = GetSpellTargetLoc()
    set udg_Hero_ArA_Ang = GetUnitLoc(GetTriggerUnit())
    call SaveLocationHandleBJ( GetUnitLoc(GetTriggerUnit()), StringHashBJ("ArA"), StringHashBJ("ShiftPoint"), GetLastCreatedHashtableBJ() )
    call CreateNUnitsAtLoc( 1, 'e00Q', GetOwningPlayer(GetTriggerUnit()), udg_Hero_ArA_Loc, bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), udg_Hero_ArA_Ang, bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A11Z', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A11Z', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) )
    call IssueTargetOrderById( GetLastCreatedUnit(), 852274, GetTriggerUnit() )
    call PolledWait( 0.01 )
    if ( Trig_Arcane_Shift_Start_Func012C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), udg_Hero_ArA_Loc, bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A12B', GetLastCreatedUnit() )
        call IssuePointOrderLocBJ( GetLastCreatedUnit(), "silence", GetUnitLoc(GetLastCreatedUnit()) )
        call RemoveLocation( udg_Hero_ArA_Loc )
        call RemoveLocation( udg_Hero_ArA_Ang )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Arcane_Shift_Start takes nothing returns nothing
    set gg_trg_Arcane_Shift_Start = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Arcane_Shift_Start, EVENT_PLAYER_UNIT_SPELL_CAST )
    call TriggerAddCondition( gg_trg_Arcane_Shift_Start, Condition( function Trig_Arcane_Shift_Start_Conditions ) )
