    set gg_trg_Summoning_Dradon_Remove = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Summoning_Dradon_Remove, EVENT_PLAYER_UNIT_SPELL_ENDCAST )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Summoning_Dradon_Remove, EVENT_PLAYER_UNIT_SPELL_FINISH )
