//===========================================================================
// Trigger: Battle Fury AtkDmg
//
// 다리 절단
//===========================================================================
function Trig_Battle_Fury_AtkDmg_Func005C takes nothing returns boolean
    if ( ( UnitHasItemOfTypeBJ(GetEventDamageSource(), 'I08Z') == true ) ) then
        return true
    endif
    if ( ( UnitHasItemOfTypeBJ(GetEventDamageSource(), 'I09H') == true ) ) then
        return true
    endif
    return false
endfunction

function Trig_Battle_Fury_AtkDmg_Conditions takes nothing returns boolean
    if ( not Trig_Battle_Fury_AtkDmg_Func005C() ) then
        return false
    endif
    if ( not ( GetTriggerUnit() == udg_Item_Target_Furymage[GetConvertedPlayerId(GetOwningPlayer(GetEventDamageSource()))] ) ) then
        return false
    endif
    if ( not ( GetEventDamage() > 20.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Battle_Fury_AtkDmg_Func004Func001C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(GetEventDamageSource(), 'I09H') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Battle_Fury_AtkDmg_Func004C takes nothing returns boolean
    if ( not ( UnitHasItemOfTypeBJ(GetEventDamageSource(), 'I08Z') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Battle_Fury_AtkDmg_Actions takes nothing returns nothing
    local integer rand = GetRandomInt( 1 , 100 )
    local integer chance = 30 // 발동 확률
    set udg_Item_Target_Furymage[GetConvertedPlayerId(GetOwningPlayer(GetEventDamageSource()))] = null
    if ( Trig_Battle_Fury_AtkDmg_Func004C() ) then
        if IsUnitType(GetTriggerUnit(), UNIT_TYPE_SUMMONED) then
        call d_effect(GetLastCreatedEffectBJ(),0.5)
        elseif ( rand <= chance ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetEventDamageSource()), GetUnitLoc(GetEventDamageSource()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A06F', GetLastCreatedUnit() )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "chainlightning", GetTriggerUnit() )
        endif
        return
    else
        if ( Trig_Battle_Fury_AtkDmg_Func004Func001C() ) then
            if IsUnitType(GetTriggerUnit(), UNIT_TYPE_SUMMONED) then
            call d_effect(GetLastCreatedEffectBJ(),0.5)
            elseif ( rand <= chance ) then
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetEventDamageSource()), GetUnitLoc(GetEventDamageSource()), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A0XL', GetLastCreatedUnit() )
            call IssueTargetOrderBJ( GetLastCreatedUnit(), "chainlightning", GetTriggerUnit() )
            endif
        else
        endif
    endif
endfunction

