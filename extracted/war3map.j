    else
    endif
    if ( Trig_ThL_Change_Func004C() ) then
        call UnitAddAbilityBJ( 'A0WL', udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] )
    else
    endif
