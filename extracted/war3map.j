//===========================================================================
// Trigger: Chakra Magic
//===========================================================================
function Trig_Chakra_Magic_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A06X' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Chakra_Magic_Func013C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R01W', GetTriggerPlayer()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Chakra_Magic_Actions takes nothing returns nothing
    local unit target = GetSpellTargetUnit()
    local integer level = GetUnitAbilityLevelSwapped('A06X', GetTriggerUnit())
    local real mana = ( 50.00 + ( 25.00 * level ) )
    local real mana2 = ( GetUnitStateSwap(UNIT_STATE_MAX_MANA, target) * ( 0.06 + ( 0.04 * level ) ) )
    if (IsUnitAlly(target, GetTriggerPlayer()) == true) then
    call SetUnitManaBJ( target, ( GetUnitStateSwap(UNIT_STATE_MANA, target) + mana ) )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetSpellTargetUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0UP', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0UP', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped(GetSpellAbilityId(), GetTriggerUnit()) )
    call IssueImmediateOrderById( GetLastCreatedUnit(), 852277 )
    else
    if ( Trig_Chakra_Magic_Func013C() ) then
        call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) + (mana2* 0.5) ) )
        call UnitDamageTargetBJ( GetTriggerUnit(), target, ( 60.00 * I2R(GetUnitAbilityLevelSwapped('A06X', GetTriggerUnit())) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetSpellAbilityUnit()), GetUnitLoc(GetSpellTargetUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0WB', GetLastCreatedUnit() )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "entanglingroots", GetSpellTargetUnit() )
    else
        call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) + mana2 ) )
    endif
    call SetUnitManaBJ( target, ( GetUnitStateSwap(UNIT_STATE_MANA, target) - mana2 ) )
    endif
endfunction

//===========================================================================
function InitTrig_Chakra_Magic takes nothing returns nothing
    set gg_trg_Chakra_Magic = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Chakra_Magic, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Chakra_Magic, Condition( function Trig_Chakra_Magic_Conditions ) )
    call TriggerAddAction( gg_trg_Chakra_Magic, function Trig_Chakra_Magic_Actions )
endfunction

//===========================================================================
// Trigger: Summon Treant
//===========================================================================
function Trig_Summon_Treant_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A06U' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Summon_Treant_Func001001 takes nothing returns boolean
    return ( GetUnitAbilityLevelSwapped('A06U', GetTriggerUnit()) == 1 )
endfunction

function Trig_Summon_Treant_Func002001 takes nothing returns boolean
    return ( GetUnitAbilityLevelSwapped('A06U', GetTriggerUnit()) == 2 )
endfunction

function Trig_Summon_Treant_Func003001 takes nothing returns boolean
    return ( GetUnitAbilityLevelSwapped('A06U', GetTriggerUnit()) == 3 )
endfunction

function Trig_Summon_Treant_Func004001 takes nothing returns boolean
    return ( GetUnitAbilityLevelSwapped('A06U', GetTriggerUnit()) == 4 )
endfunction

function Trig_Summon_Treant_Actions takes nothing returns nothing
    if ( Trig_Summon_Treant_Func001001() ) then
        set udg_Hero_ElD_TreantCount[1] = 999
    else
        call DoNothing(  )
    endif
    if ( Trig_Summon_Treant_Func002001() ) then
        set udg_Hero_ElD_TreantCount[1] = ( 4 - GetPlayerTechCountSimple('R01X', GetOwningPlayer(GetTriggerUnit())) )
    else
        call DoNothing(  )
    endif
    if ( Trig_Summon_Treant_Func003001() ) then
        set udg_Hero_ElD_TreantCount[1] = ( 3 - GetPlayerTechCountSimple('R01X', GetOwningPlayer(GetTriggerUnit())) )
    else
        call DoNothing(  )
    endif
    if ( Trig_Summon_Treant_Func004001() ) then
        set udg_Hero_ElD_TreantCount[1] = ( 3 - GetPlayerTechCountSimple('R01X', GetOwningPlayer(GetTriggerUnit())) )
    else
        call DoNothing(  )
    endif
    set udg_Hero_ElD_TreantCount[2] = ( udg_Hero_ElD_TreantCount[2] + 1 )
    if ( udg_Hero_ElD_TreantCount[2] >= udg_Hero_ElD_TreantCount[1] ) then
    set udg_Hero_ElD_TreantCount[2] = 0
    call CreateNUnitsAtLoc( 1, 'e00D', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 200.00, GetUnitFacing(GetTriggerUnit())), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 50.00, 'BEfn', GetLastCreatedUnit() )
    call SetUnitAnimation( GetLastCreatedUnit(), "birth" )
    endif
    call CreateNUnitsAtLoc( 1, 'e00C', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 200.00, GetUnitFacing(GetTriggerUnit())), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 50.00, 'BEfn', GetLastCreatedUnit() )
    call SetUnitAnimation( GetLastCreatedUnit(), "birth" )
endfunction

