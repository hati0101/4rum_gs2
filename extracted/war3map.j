//===========================================================================
// Trigger: SwapDialog
//===========================================================================
function Trig_SwapDialog_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())]) != 0 ) ) then
        return false
    endif
    if ( not ( TimerGetElapsed(udg_MBTime) <= 120.00 ) ) then
        return false
    endif
    if ( not ( udg_HeroRepick[GetConvertedPlayerId(GetTriggerPlayer())] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_SwapDialog_Func015Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_HeroPlayer[GetForLoopIndexA()]) == true ) ) then
        return false
    endif
    if ( not ( GetForLoopIndexA() != GetConvertedPlayerId(GetTriggerPlayer()) ) ) then
        return false
    endif
    if ( not ( IsPlayerAlly(ConvertedPlayer(GetForLoopIndexA()), GetTriggerPlayer()) == true ) ) then
        return false
    endif
    if ( not ( udg_HeroRepick[GetForLoopIndexA()] == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_SwapDialog_Actions takes nothing returns nothing
    call PolledWait( 0.10 )
    call DialogClearBJ( udg_Sys_SwapDialog[GetConvertedPlayerId(GetTriggerPlayer())] )
    call DialogSetMessageBJ( udg_Sys_SwapDialog[GetConvertedPlayerId(GetTriggerPlayer())], "TRIGSTR_1444" )
    call DialogAddButtonBJ( udg_Sys_SwapDialog[GetConvertedPlayerId(GetTriggerPlayer())], "TRIGSTR_1445" )
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        if ( Trig_SwapDialog_Func015Func001C() ) then
            call DialogAddButtonBJ( udg_Sys_SwapDialog[GetConvertedPlayerId(GetTriggerPlayer())], GetUnitName(udg_HeroPlayer[GetForLoopIndexA()]) )
            call SaveButtonHandleBJ( GetLastCreatedButtonBJ(), GetConvertedPlayerId(GetTriggerPlayer()), StringHashBJ(( "Swap" + I2S(GetForLoopIndexA()) )), GetLastCreatedHashtableBJ() )
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call DialogDisplayBJ( true, udg_Sys_SwapDialog[GetConvertedPlayerId(GetTriggerPlayer())], GetTriggerPlayer() )
endfunction

