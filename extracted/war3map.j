function InitTrig_Hell_Explode takes nothing returns nothing
    set gg_trg_Hell_Explode = CreateTrigger(  )
    call DisableTrigger( gg_trg_Hell_Explode )
    call TriggerAddCondition( gg_trg_Hell_Explode, Condition( function Trig_Hell_Explode_Conditions ) )
    call TriggerAddAction( gg_trg_Hell_Explode, function Trig_Hell_Explode_Actions )
