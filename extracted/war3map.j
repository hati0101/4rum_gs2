function InitTrig_Hailflow takes nothing returns nothing
    set gg_trg_Hailflow = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Hailflow, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Hailflow, Condition( function Trig_Hailflow_Conditions ) )
    call TriggerAddAction( gg_trg_Hailflow, function Trig_Hailflow_Actions )
