//===========================================================================
// Trigger: Divine Strike
//===========================================================================
function Trig_Divine_Strike_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0DQ' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Divine_Strike_Func001C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B09Y') == true ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) > 100.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Divine_Strike_Sub takes nothing returns nothing
    local unit u = LoadUnitHandleBJ(GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("CruTgt"), GetLastCreatedHashtableBJ())
    local integer LoopX = LoadIntegerBJ(GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("CruIndex"),GetLastCreatedHashtableBJ() )
    local real angle = LoadRealBJ(GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("CruAngle"),GetLastCreatedHashtableBJ() )
    call SetUnitPositionLoc( u, PolarProjectionBJ(GetUnitLoc(u), -10.00, angle) )
    call SaveIntegerBJ( LoopX + 1, GetHandleIdBJ(GetExpiredTimer()), StringHashBJ("CruIndex"), GetLastCreatedHashtableBJ() )
    if IsUnitAliveBJ(u) != true or LoopX > 35 then
    call DestroyTimer(GetExpiredTimer())
    endif
endfunction

function Trig_Divine_Strike_Actions takes nothing returns nothing
    local real angle = GetUnitFacing(GetSpellTargetUnit())
    local timer t = CreateTimer()
    local unit u = GetSpellTargetUnit()
    local integer LoopX = 1
    call PlaySoundBJ( gg_snd_HeroPaladinYesAttack3 )
    call PolledWait( 0.15 )
    call PauseUnitBJ( true, GetTriggerUnit() )
    call PolledWait( 0.15 )
    call PauseUnitBJ( false, GetTriggerUnit() )
    if DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetUnitLoc(u)) < 1600.00 then
    call SetUnitPositionLocFacingBJ( GetTriggerUnit(), PolarProjectionBJ(GetUnitLoc(u), 100.00, GetUnitFacing(u)), ( GetUnitFacing(u) + 180.00 ) )
    endif
    call IssueTargetOrderBJ( GetTriggerUnit(), "attack", u )
    call UnitDamageTargetBJ( GetTriggerUnit(), u, ( 125.00 + ( I2R(GetUnitAbilityLevelSwapped('A0DQ', GetTriggerUnit())) * 125.00 ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call AddSpecialEffectTargetUnitBJ( "origin", u, "LightStrikeArray.mdx" )
    call d_effect(GetLastCreatedEffectBJ(),1.5)
    call SaveUnitHandleBJ( u, GetHandleIdBJ(t), StringHashBJ("CruTgt"), GetLastCreatedHashtableBJ() )
    call SaveIntegerBJ( 0, GetHandleIdBJ(t), StringHashBJ("CruIndex"), GetLastCreatedHashtableBJ() )
    call SaveRealBJ( angle, GetHandleIdBJ(t), StringHashBJ("CruAngle"), GetLastCreatedHashtableBJ() )
    if ( Trig_Divine_Strike_Func001C() ) then
        call UnitDamageTargetBJ( GetTriggerUnit(), u, ( 31.25 + ( I2R(GetUnitAbilityLevelSwapped('A0DQ', GetTriggerUnit())) * 31.25 ) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) - 100.00 ) )
        call AddSpecialEffectTargetUnitBJ( "origin", u, "Abilities\\Spells\\Human\\Resurrect\\ResurrectCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    endif
    call TimerStart(t, 0.05, true, function Trig_Divine_Strike_Sub)
endfunction

//===========================================================================
function InitTrig_Divine_Strike takes nothing returns nothing
    set gg_trg_Divine_Strike = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Divine_Strike, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Divine_Strike, Condition( function Trig_Divine_Strike_Conditions ) )
    call TriggerAddAction( gg_trg_Divine_Strike, function Trig_Divine_Strike_Actions )
endfunction


