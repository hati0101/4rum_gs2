function Trig_Curse_Attack_Orbs_Actions takes nothing returns nothing
    call UnitRemoveBuffBJ( 'B04U', GetTriggerUnit() )
    if ( Trig_Curse_Attack_Orbs_Func002C() ) then
        if ( Trig_Curse_Attack_Orbs_Func002Func001C() ) then
            set udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = ( udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + 1 )
            set udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = IMinBJ(15, udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))])
            call TextTag( I2S(udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]) , GetTriggerUnit() , 10 , 255 , 50 , 150, 3 )
        else
            set udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = ( udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + 1 )
            set udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = IMinBJ(12, udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))])
            call TextTag( I2S(udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]) , GetTriggerUnit() , 10 , 255 , 50 , 150, 3 )
        endif
        if ( Trig_Curse_Attack_Orbs_Func002Func002C() ) then
            set udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = ( udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + 2 )
            set udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = IMinBJ(15, udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))])
