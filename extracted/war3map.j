    call TriggerRegisterAnyUnitEventBJ( gg_trg_DrA_Special_3, EVENT_PLAYER_UNIT_DEATH )
    call TriggerAddCondition( gg_trg_DrA_Special_3, Condition( function Trig_DrA_Special_3_Conditions ) )
