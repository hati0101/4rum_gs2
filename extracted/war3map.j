function Trig_Destructable_Replace_Func001C takes nothing returns boolean
    if ( not ( GetTimeOfDay() == 18.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Destructable_Replace_Func004A takes nothing returns nothing
    call DestructableRestoreLife( GetEnumDestructable(), GetDestructableMaxLife(GetEnumDestructable()), false )
endfunction

function Trig_Destructable_Replace_Actions takes nothing returns nothing
    if ( Trig_Destructable_Replace_Func001C() ) then
        call SetPlayerTechResearchedSwap( 'R0C7', ( GetPlayerTechCountSimple('R0C7', Player(0)) + 1 ), Player(0) )
        call SetPlayerTechResearchedSwap( 'R0C7', ( GetPlayerTechCountSimple('R0C7', Player(6)) + 1 ), Player(6) )
    else
    endif
    call EnumDestructablesInRectAll( GetPlayableMapRect(), function Trig_Destructable_Replace_Func004A )
endfunction

