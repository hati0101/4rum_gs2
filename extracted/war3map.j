//===========================================================================
// Trigger: Flare Missile Fire
//===========================================================================
function Trig_Flare_Missile_Fire_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0CA' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Flare_Missile_Fire_Func006C takes nothing returns boolean
    if ( not ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) >= ( ( 55.00 + ( I2R(GetUnitAbilityLevelSwapped('A0CA', udg_Hero_LeT)) * 15.00 ) ) + ( 5.00 + ( 15.00 * I2R(GetUnitAbilityLevelSwapped('A0CA', udg_Hero_LeT)) ) ) ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Flare_Missile_Fire_Actions takes nothing returns nothing
    call CreateNUnitsAtLoc( 1, 'e02C', GetOwningPlayer(GetTriggerUnit()), OffsetLocation(GetSpellTargetLoc(), 256.00, 256.00), GetUnitFacing(GetTriggerUnit()) )
    call UnitApplyTimedLifeBJ( 5.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0VW', GetLastCreatedUnit() )
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "summonfactory", GetSpellTargetLoc() )
    if ( Trig_Flare_Missile_Fire_Func006C() ) then
        call SetUnitManaBJ( udg_Hero_LeT, ( GetUnitStateSwap(UNIT_STATE_MANA, udg_Hero_LeT) - ( 5.00 + ( 15.00 * I2R(GetUnitAbilityLevelSwapped('A0CA', udg_Hero_LeT)) ) ) ) )
        set udg_Hero_LeT_Flare_Boolean = true
    else
        set udg_Hero_LeT_Flare_Boolean = false
    endif
endfunction

//===========================================================================
function InitTrig_Flare_Missile_Fire takes nothing returns nothing
    set gg_trg_Flare_Missile_Fire = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Flare_Missile_Fire, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Flare_Missile_Fire, Condition( function Trig_Flare_Missile_Fire_Conditions ) )
    call TriggerAddAction( gg_trg_Flare_Missile_Fire, function Trig_Flare_Missile_Fire_Actions )
endfunction

//===========================================================================
// Trigger: Flare Missile Boom
//===========================================================================
function Trig_Flare_Missile_Boom_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'n011' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Flare_Missile_Boom_Func006C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R09O', GetOwningPlayer(udg_Hero_LeT)) == 1 ) ) then
        return false
    endif
    if ( not ( udg_Hero_LeT_Flare_Boolean == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Flare_Missile_Boom_Func008001003001 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Hero_LeT)) == true )
endfunction

function Trig_Flare_Missile_Boom_Func008001003002 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == true )
endfunction

function Trig_Flare_Missile_Boom_Func008001003 takes nothing returns boolean
    return GetBooleanAnd( Trig_Flare_Missile_Boom_Func008001003001(), Trig_Flare_Missile_Boom_Func008001003002() )
endfunction

function Trig_Flare_Missile_Boom_Func008A takes nothing returns nothing
    call CreateNUnitsAtLocFacingLocBJ( 1, 'e00V', GetOwningPlayer(udg_Hero_LeT), GetUnitLoc(GetEnumUnit()), GetUnitLoc(GetEnumUnit()) )
    call UnitApplyTimedLifeBJ( ( 5.00 + I2R(GetUnitAbilityLevelSwapped('A004', udg_Hero_LeT)) ), 'BTLF', GetLastCreatedUnit() )
    call MakeUnitFollow(GetLastCreatedUnit(), GetEnumUnit(), 30)
endfunction

function Trig_Flare_Missile_Boom_Actions takes nothing returns nothing
    call CreateNUnitsAtLocFacingLocBJ( 1, 'ewsp', GetOwningPlayer(udg_Hero_LeT), GetUnitLoc(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()) )
    call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A13K', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A13K', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0CA', udg_Hero_LeT) )
    call IssuePointOrderLocBJ( GetLastCreatedUnit(), "selfdestruct", GetUnitLoc(GetTriggerUnit()) )
    if ( Trig_Flare_Missile_Boom_Func006C() ) then
        call CreateNUnitsAtLocFacingLocBJ( 1, 'ewsp', GetOwningPlayer(udg_Hero_LeT), GetUnitLoc(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()) )
        call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0YX', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0YX', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0CA', udg_Hero_LeT) )
        call IssuePointOrderLocBJ( GetLastCreatedUnit(), "flamestrike", GetUnitLoc(GetLastCreatedUnit()) )
        set udg_Hero_LeT_Flare_Boolean = false
    else
    endif
    set bj_wantDestroyGroup=true
    call ForGroupBJ( GetUnitsInRangeOfLocMatching(300.00, GetUnitLoc(GetTriggerUnit()), Condition(function Trig_Flare_Missile_Boom_Func008001003)), function Trig_Flare_Missile_Boom_Func008A )
endfunction

//===========================================================================
function InitTrig_Flare_Missile_Boom takes nothing returns nothing
    set gg_trg_Flare_Missile_Boom = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_Flare_Missile_Boom, GetEntireMapRect() )
    call TriggerAddCondition( gg_trg_Flare_Missile_Boom, Condition( function Trig_Flare_Missile_Boom_Conditions ) )
    call TriggerAddAction( gg_trg_Flare_Missile_Boom, function Trig_Flare_Missile_Boom_Actions )
endfunction

