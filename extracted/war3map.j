function InitTrig_Setting_MapNTimer takes nothing returns nothing
    set gg_trg_Setting_MapNTimer = CreateTrigger(  )
    call TriggerRegisterTimerEventSingle( gg_trg_Setting_MapNTimer, 0.00 )
    call TriggerAddAction( gg_trg_Setting_MapNTimer, function Trig_Setting_MapNTimer_Actions )
endfunction

