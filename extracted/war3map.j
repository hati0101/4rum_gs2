    if ( not ( CountLivingPlayerUnitsOfTypeId('e01D', GetOwningPlayer(GetTriggerUnit())) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Black_Serge_Actions takes nothing returns nothing
    if ( Trig_Black_Serge_Func001C() ) then
        call PlaySoundBJ( gg_snd_KurenoZenoside )
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 30.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A04L', GetLastCreatedUnit() )
        return
    else
    endif
    if ( Trig_Black_Serge_Func002C() ) then
        call PlaySoundBJ( gg_snd_KurenoBlackSurge )
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
        call CreateNUnitsAtLoc( 1, 'e01D', GetOwningPlayer(GetTriggerUnit()), GetPlayerStartLocationLoc(GetOwningPlayer(GetTriggerUnit())), bj_UNIT_FACING )
        call UnitAddAbilityBJ( 'S00K', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'S004', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'S004', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A04U', GetTriggerUnit()) )
        call UnitApplyTimedLifeBJ( 30.00, 'BTLF', GetLastCreatedUnit() )
        call CreateNUnitsAtLoc( 1, 'e01F', GetOwningPlayer(GetTriggerUnit()), GetPlayerStartLocationLoc(GetOwningPlayer(GetTriggerUnit())), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 30.00, 'BTLF', GetLastCreatedUnit() )
        call CreateNUnitsAtLoc( 1, 'e037', GetOwningPlayer(GetTriggerUnit()), GetPlayerStartLocationLoc(GetOwningPlayer(GetTriggerUnit())), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 30.00, 'BTLF', GetLastCreatedUnit() )
        if ( Trig_Black_Serge_Func002Func013C() ) then
            call UnitAddAbilityBJ( 'A0K7', GetLastCreatedUnit() )
        else
        endif
        if ( Trig_Black_Serge_Func002Func014C() ) then
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 30.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A04L', GetLastCreatedUnit() )
        else
        endif
    else
    endif
endfunction

