    else
    endif
    if ( Trig_DamageTaken_Func036C() ) then
        set udg_Shield[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = ( udg_Shield[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] * ( 0.90 - ( I2R(GetUnitAbilityLevelSwapped('A11S', udg_Hero_MRG)) * 0.05 ) ) )
    else
    endif
    if ( Trig_DamageTaken_Func037C() ) then
        set udg_Shield[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = ( udg_Shield[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] * ( 1.00 - ( I2R(GetUnitAbilityLevelSwapped('A04Y', GetTriggerUnit())) * 0.05 ) ) )
    else
    endif
    if ( Trig_DamageTaken_Func038C() ) then
        set udg_Shield[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = ( udg_Shield[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] * 0.85 )
    else
