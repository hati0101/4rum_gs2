    set gg_trg_Drunk_Attack_Damage = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Drunk_Attack_Damage, Condition( function Trig_Drunk_Attack_Damage_Conditions ) )
    call TriggerAddAction( gg_trg_Drunk_Attack_Damage, function Trig_Drunk_Attack_Damage_Actions )
endfunction

