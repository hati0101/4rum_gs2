//===========================================================================
// Trigger: Spawn New Creep
//===========================================================================
function Trig_Spawn_New_Creep_Actions takes nothing returns nothing
    local integer LoopX = 0
    loop
    exitwhen LoopX > 13
    if GetExpiredTimer() != udg_Creep_Timer[LoopX] then
    set LoopX = LoopX + 1
    else
    set udg_Creep_Number = LoopX
    call TriggerExecute( gg_trg_Creep_Spawn )
    return
    endif
    endloop
endfunction

