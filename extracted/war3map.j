    call TriggerAddCondition( gg_trg_Building_Destroy_Gold, Condition( function Trig_Building_Destroy_Gold_Conditions ) )
    call TriggerAddAction( gg_trg_Building_Destroy_Gold, function Trig_Building_Destroy_Gold_Actions )
endfunction

//===========================================================================
// Trigger: Select Hero
//===========================================================================
function Trig_Select_Hero_Conditions takes nothing returns boolean
    if ( not ( IsUnitType(GetSoldUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Select_Hero_Func002Func002C takes nothing returns boolean
    if ( not ( IsPlayerAlly(GetOwningPlayer(GetSoldUnit()), udg_Force[1]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Select_Hero_Func002Func003Func001A takes nothing returns nothing
    set bj_forLoopBIndex = 1
    set bj_forLoopBIndexEnd = udg_HeroMax[3]
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call SetPlayerUnitAvailableBJ( udg_Hero[GetForLoopIndexB()], false, GetEnumPlayer() )
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
endfunction

function Trig_Select_Hero_Func002Func003C takes nothing returns boolean
    if ( not ( udg_Mode3P2R_Pick[1] >= 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Select_Hero_Func002Func004Func001A takes nothing returns nothing
    set bj_forLoopBIndex = 1
    set bj_forLoopBIndexEnd = udg_HeroMax[3]
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        call SetPlayerUnitAvailableBJ( udg_Hero[GetForLoopIndexB()], false, GetEnumPlayer() )
        set bj_forLoopBIndex = bj_forLoopBIndex + 1
    endloop
endfunction

function Trig_Select_Hero_Func002Func004C takes nothing returns boolean
    if ( not ( udg_Mode3P2R_Pick[2] >= 3 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Select_Hero_Func002C takes nothing returns boolean
    if ( not ( udg_Mode3P2R == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Select_Hero_Func012Func002Func001C takes nothing returns boolean
    if ( not ( IsUnitAlly(GetSoldUnit(), udg_Force[1]) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Select_Hero_Func012Func002C takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetSoldUnit()) == udg_Hero[GetForLoopIndexA()] ) ) then
        return false
    endif
    return true
endfunction

function Trig_Select_Hero_Func014C takes nothing returns boolean
    if ( not ( udg_SP_Level == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Select_Hero_Actions takes nothing returns nothing
    set udg_RepickTimer[GetConvertedPlayerId(GetTriggerPlayer())] = true
    if ( Trig_Select_Hero_Func002C() ) then
        set udg_HeroRepick[GetConvertedPlayerId(GetOwningPlayer(GetSoldUnit()))] = false
        if ( Trig_Select_Hero_Func002Func002C() ) then
            set udg_Mode3P2R_Pick[1] = ( udg_Mode3P2R_Pick[1] + 1 )
        else
            set udg_Mode3P2R_Pick[2] = ( udg_Mode3P2R_Pick[2] + 1 )
        endif
        if ( Trig_Select_Hero_Func002Func003C() ) then
            call ForForce( GetPlayersAllies(udg_Force[1]), function Trig_Select_Hero_Func002Func003Func001A )
        else
        endif
        if ( Trig_Select_Hero_Func002Func004C() ) then
            call ForForce( GetPlayersAllies(udg_Force[2]), function Trig_Select_Hero_Func002Func004Func001A )
        else
        endif
    else
    endif
    set udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetSoldUnit()))] = GetSoldUnit()
    call UnitAddItemByIdSwapped( 'I08I', GetSoldUnit() )
    call SetItemUserData( GetLastCreatedItem(), 32 )
    call UnitAddItemByIdSwapped( 'I06G', GetSoldUnit() )
    call SetItemUserData( GetLastCreatedItem(), 28 )
    call DisplayTimedTextToForce( GetForceOfPlayer(GetOwningPlayer(GetSoldUnit())), 30, ( udg_Colors[3] + "|cffffcc00F8|r을 사용하여 특성을 선택할 수 있습니다.|r" ) )
    call DisplayTimedTextToForce( GetPlayersEnemies(GetOwningPlayer(GetSoldUnit())), 30.00, ( ( ( udg_Colors[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetSoldUnit()))]] + GetPlayerName(GetOwningPlayer(GetSoldUnit())) ) + "|r님의 선택 영웅 : " ) + GetUnitName(GetSoldUnit()) ) )
    call MultiboardSetItemStyleBJ( GetLastCreatedMultiboard(), 1, ( udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetSoldUnit()))] + 1 ), false, true )
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = 12
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetPlayerTechMaxAllowedSwap( GetUnitTypeId(GetSoldUnit()), 0, ConvertedPlayer(GetForLoopIndexA()) )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = udg_HeroMax[3]
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetPlayerTechMaxAllowedSwap( udg_Hero[GetForLoopIndexA()], 0, GetOwningPlayer(GetSoldUnit()) )
        if ( Trig_Select_Hero_Func012Func002C() ) then
            if ( Trig_Select_Hero_Func012Func002Func001C() ) then
                call CreateNUnitsAtLoc( 1, udg_HeroSpeciel[GetForLoopIndexA()], GetOwningPlayer(GetSoldUnit()), GetRectCenter(gg_rct_G_Home_Revive), bj_UNIT_FACING )
                call SetUnitPositionLoc( GetSoldUnit(), GetRectCenter(gg_rct_G_Home_Revive) )
            else
                call CreateNUnitsAtLoc( 1, udg_HeroSpeciel[GetForLoopIndexA()], GetOwningPlayer(GetSoldUnit()), GetRectCenter(gg_rct_D_Home_Revive), bj_UNIT_FACING )
                call SetUnitPositionLoc( GetSoldUnit(), GetRectCenter(gg_rct_D_Home_Revive) )
            endif
            set udg_RandHero[GetForLoopIndexA()] = true
            call MultiboardSetItemIconBJ( GetLastCreatedMultiboard(), 1, ( udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetSoldUnit()))] + 1 ), udg_HeroIcon[GetForLoopIndexA()] )
        else
        endif
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call PanCameraToTimedLocForPlayer( GetOwningPlayer(GetSoldUnit()), GetUnitLoc(GetSoldUnit()), 0.50 )
    if ( Trig_Select_Hero_Func014C() ) then
        call SetPlayerName( GetOwningPlayer(GetSoldUnit()), GetHeroProperName(GetSoldUnit()) )
        call MultiboardSetItemValueBJ( udg_MB, 2, ( udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetSoldUnit()))] + 1 ), ( ( udg_Colors[udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetSoldUnit()))]] + GetPlayerName(GetOwningPlayer(GetSoldUnit())) ) + "|r" ) )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Select_Hero takes nothing returns nothing
    set gg_trg_Select_Hero = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Select_Hero, EVENT_PLAYER_UNIT_SELL )
    call TriggerAddCondition( gg_trg_Select_Hero, Condition( function Trig_Select_Hero_Conditions ) )
    call TriggerAddAction( gg_trg_Select_Hero, function Trig_Select_Hero_Actions )
endfunction

//===========================================================================
// Trigger: Random Hero
//
// udg_HeroPlayer[GetConvertedPlayerId(RandPlayer)] = null
//===========================================================================
function Trig_random_Conditions takes nothing returns boolean
    if ( not ( TimerGetElapsed(udg_MBTime) >= 14.00 ) ) then
        return false
    endif
    return true
    if ( not ( GetUnitTypeId(udg_HeroPlayer[GetConvertedPlayerId(GetTriggerPlayer())]) == 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_random_Actions takes nothing returns nothing
local player RandPlayer = GetTriggerPlayer()
local integer RandHero
local integer RandMax
local integer RandDark
local integer i = 0

if ( udg_RandomRuning == false ) then
if (udg_HeroPlayer[GetConvertedPlayerId(RandPlayer)] == null) then

//트리거가 작동하고 있으면 발동하지 않음. (임시)
set udg_RandomRuning = true

//올랜덤시 변수 설정 (조만간 구현 ㅠㅠ)
//if (GetTriggerPlayer() == null) then
//set RandPlayer = udg_RandPlayer
//endif

//올픽관련
if (udg_ModeAllpick == true) then
set RandMax = udg_HeroMax[3]
else
if (IsPlayerAlly(RandPlayer,udg_Force[1])) then
set RandMax = udg_HeroMax[1]
else
set RandMax = udg_HeroMax[2]
endif
endif

set i = 0

loop
set i = i+1
call SetPlayerTechMaxAllowedSwap( udg_Hero[i], 0, RandPlayer )
exitwhen (i >= udg_HeroMax[3])
endloop

loop
set RandHero = GetRandomInt(1, RandMax)

if ( CountUnitsInGroup(GetUnitsOfTypeIdAll( udg_Hero[RandHero] )) == 0 ) and (udg_ModeAllpick == false) and (IsPlayerAlly(RandPlayer,udg_Force[2])) then
set RandHero = RandHero+udg_HeroMax[1]
endif

if (udg_RandHero[RandHero] == false) then
set udg_HeroPlayer[GetConvertedPlayerId(RandPlayer)] = CreateUnitAtLoc( RandPlayer, udg_Hero[RandHero], GetPlayerStartLocationLoc(RandPlayer), bj_UNIT_FACING )
set udg_RandHero[RandHero] = true
    if (IsPlayerAlly(RandPlayer,udg_Force[1])) then
    call CreateUnitAtLoc( RandPlayer, udg_HeroSpeciel[RandHero], GetRectCenter(gg_rct_G_Home), bj_UNIT_FACING )
    call SetUnitPositionLoc( udg_HeroPlayer[GetConvertedPlayerId(RandPlayer)], GetRectCenter(gg_rct_G_Home_Revive) )
    call PanCameraToTimedLocForPlayer( GetTriggerPlayer(), GetRectCenter(gg_rct_G_Home_Revive), 0.50 )
    else
    call CreateUnitAtLoc( RandPlayer, udg_HeroSpeciel[RandHero], GetRectCenter(gg_rct_D_Home), bj_UNIT_FACING )
    call SetUnitPositionLoc( udg_HeroPlayer[GetConvertedPlayerId(RandPlayer)], GetRectCenter(gg_rct_D_Home_Revive) )
    call PanCameraToTimedLocForPlayer( GetTriggerPlayer(), GetRectCenter(gg_rct_D_Home_Revive), 0.50 )
    endif

set i = 0
loop
set i = i+1
call SetPlayerTechMaxAllowedSwap( GetUnitTypeId(udg_HeroPlayer[GetConvertedPlayerId(RandPlayer)]), 0, ConvertedPlayer(i) )
exitwhen (i >= 12)
endloop
endif

exitwhen (IsUnitAliveBJ(udg_HeroPlayer[GetConvertedPlayerId(RandPlayer)]) == true)
endloop

call UnitAddItemByIdSwapped( 'I08I', udg_HeroPlayer[GetConvertedPlayerId(RandPlayer)] )
call SetItemUserData( GetLastCreatedItem(), 32 )
call UnitAddItemByIdSwapped( 'I06G', udg_HeroPlayer[GetConvertedPlayerId(RandPlayer)] )
call SetItemUserData( GetLastCreatedItem(), 28 )
call DisplayTimedTextToForce( GetForceOfPlayer(RandPlayer), 30, ( udg_Colors[3] + "|cffffcc00F8|r을 사용하여 특성을 선택할 수 있습니다.|r" ) )
call MultiboardSetItemStyleBJ( GetLastCreatedMultiboard(), 1, ( udg_SP_Number[GetConvertedPlayerId(RandPlayer)] + 1 ), false, true )
call MultiboardSetItemIconBJ( GetLastCreatedMultiboard(), 1, ( udg_SP_Number[GetConvertedPlayerId(RandPlayer)] + 1 ), udg_HeroIcon[RandHero] )
call DisplayTimedTextToForce( GetPlayersEnemies(GetTriggerPlayer()), 30.00, ( ( ( udg_Colors[udg_SP_Number[GetConvertedPlayerId(RandPlayer)]] + GetPlayerName(RandPlayer) ) + "|r님의 랜덤 영웅 : " ) + GetUnitName(udg_HeroPlayer[GetConvertedPlayerId(RandPlayer)]) ) )

set udg_RandomRuning = false

endif
endif

if ( udg_SP_Level == 1 ) then
    call SetPlayerName( RandPlayer, GetHeroProperName(udg_HeroPlayer[GetConvertedPlayerId(RandPlayer)]) )
    call MultiboardSetItemValueBJ( udg_MB, 2, (udg_SP_Number[GetConvertedPlayerId( RandPlayer )] + 1), (udg_Colors[udg_SP_Number[GetConvertedPlayerId( RandPlayer )]] + GetPlayerName( RandPlayer ) + "|r") )
endif

//리픽 타이머 돌림
    set udg_RepickTimer[GetConvertedPlayerId(GetTriggerPlayer())] = true
    call PolledWait( 3.00 )
    set udg_RepickTimer[GetConvertedPlayerId(GetTriggerPlayer())] = false


endfunction

