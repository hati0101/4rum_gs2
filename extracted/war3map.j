//===========================================================================
// Trigger: Life Drain
//===========================================================================
function Trig_Life_Drain_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A02W' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Life_Drain_Func004Func002001003 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetTriggerPlayer()) == true )
endfunction

function Trig_Life_Drain_Func004Func002Func001C takes nothing returns boolean
    if ( not ( GetEnumUnit() != GetSpellTargetUnit() ) ) then
        return false
    endif
    return true
endfunction

function Trig_Life_Drain_Func004Func002A takes nothing returns nothing
    if ( Trig_Life_Drain_Func004Func002Func001C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetSpellTargetUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0TW', GetLastCreatedUnit() )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "chainlightning", GetEnumUnit() )
        call UnitDamageTargetBJ( GetLastCreatedUnit(), GetEnumUnit(), ( 30.00 + ( 30.00 * I2R(GetUnitAbilityLevelSwapped('A02W', GetTriggerUnit())) ) ), ATTACK_TYPE_HERO, DAMAGE_TYPE_FIRE )
    else
    endif
endfunction

function Trig_Life_Drain_Func004C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R001', GetOwningPlayer(GetTriggerUnit())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Life_Drain_Actions takes nothing returns nothing
    set udg_Hero_DaP_LifeDrain = ( 0.15 * GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetSpellTargetUnit()) )
    call AbsoluteDamage(GetTriggerUnit(), GetSpellTargetUnit(), ( GetUnitStateSwap(UNIT_STATE_MAX_LIFE, GetSpellTargetUnit()) * ( 0.15 + ( 0.08 * I2R(GetPlayerTechCountSimple('R0BE', GetOwningPlayer(GetTriggerUnit()))) ) )))
    call SetUnitLifeBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_LIFE, GetTriggerUnit()) + udg_Hero_DaP_LifeDrain ) )
    if ( Trig_Life_Drain_Func004C() ) then
        set bj_wantDestroyGroup=true
        call ForGroupBJ( GetUnitsInRangeOfLocMatching(300.00, GetUnitLoc(GetSpellTargetUnit()), Condition(function Trig_Life_Drain_Func004Func002001003)), function Trig_Life_Drain_Func004Func002A )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Life_Drain takes nothing returns nothing
    set gg_trg_Life_Drain = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Life_Drain, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Life_Drain, Condition( function Trig_Life_Drain_Conditions ) )
    call TriggerAddAction( gg_trg_Life_Drain, function Trig_Life_Drain_Actions )
endfunction

