    if ( Trig_Retreat_Timer_Func004C() ) then
        call StartTimerBJ( udg_Hero_OgL_Sp3Timer, false, 0.30 )
        call SaveUnitHandleBJ( GetTriggerUnit(), GetHandleIdBJ(GetLastCreatedTimerBJ()), StringHashBJ("Cry"), GetLastCreatedHashtableBJ() )
