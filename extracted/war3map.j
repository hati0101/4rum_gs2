function Trig_Libido_Func031001 takes nothing returns boolean
    return ( GetUnitTypeId(udg_Hero_DaP_LibidoTarget) == 'Hhkl' )
endfunction

function Trig_Libido_Func031Func001002 takes nothing returns nothing
    call RemoveUnit( GetEnumUnit() )
endfunction

function Trig_Libido_Actions takes nothing returns nothing
    local unit target_unit = GetSpellTargetUnit()
    set udg_Hero_DaP = GetTriggerUnit()
    call DisableTrigger( GetTriggeringTrigger() )
    call PlaySoundBJ( gg_snd_DaP_Ulti )
    call SetUnitLifePercentBJ( GetSpellTargetUnit(), 100 )
    call SetUnitManaPercentBJ( GetSpellTargetUnit(), 100 )
    call UnitResetCooldown( GetSpellTargetUnit() )
    if ( Trig_Libido_Func008C() ) then
        call UnitRemoveAbilityBJ( 'A07W', udg_Hero_DaT )
        call UnitAddAbilityBJ( 'A0P0', udg_Hero_DaT )
        call SetUnitAbilityLevelSwapped( 'A0P0', udg_Hero_DaT, GetUnitAbilityLevelSwapped('A0PC', udg_Hero_DaT) )
        call PauseTimerBJ( true, udg_Hero_DaT_UltiTimer )
        set udg_Hero_DaT = null
    else
    endif
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetSpellTargetUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0QD', GetLastCreatedUnit() )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "parasite", GetSpellTargetUnit() )
    call PolledWait( ( 5.80 + ( 3.00 * I2R(GetUnitAbilityLevelSwapped('A03B', GetTriggerUnit())) ) ) )
    set udg_Hero_DaP_LibidoTarget = target_unit
    if ( Trig_Libido_Func015001() ) then
        call ForGroupBJ( GetUnitsOfPlayerAndTypeId(GetOwningPlayer(udg_Hero_DaP_LibidoTarget), 'e01S'), function Trig_Libido_Func015002002 )
    else
        call DoNothing(  )
    endif
    call PolledWait( 0.10 )
    call ConditionalTriggerExecute( gg_trg_Libido_Dead )
    call PolledWait( 1.00 )
    if ( Trig_Libido_Func019001() ) then
        call CreateNUnitsAtLoc( 1, 'e01S', GetOwningPlayer(udg_Hero_DaP_LibidoTarget), GetPlayerStartLocationLoc(GetOwningPlayer(udg_Hero_DaP_LibidoTarget)), bj_UNIT_FACING )
    else
        call DoNothing(  )
    endif
    call PolledWait( 0.10 )
    if ( Trig_Libido_Func021001() ) then
        call ForGroupBJ( GetUnitsOfPlayerAndTypeId(GetOwningPlayer(udg_Hero_DaP_LibidoTarget), 'e01S'), function Trig_Libido_Func021002002 )
    else
        call DoNothing(  )
    endif
    call PolledWait( 1.00 )
    call ConditionalTriggerExecute( gg_trg_Libido_Dead )
    call PolledWait( 0.10 )
    if ( Trig_Libido_Func025001() ) then
        call CreateNUnitsAtLoc( 1, 'e01S', GetOwningPlayer(udg_Hero_DaP_LibidoTarget), GetPlayerStartLocationLoc(GetOwningPlayer(udg_Hero_DaP_LibidoTarget)), bj_UNIT_FACING )
    else
        call DoNothing(  )
    endif
    call PolledWait( 0.10 )
    if ( Trig_Libido_Func027001() ) then
        call ForGroupBJ( GetUnitsOfPlayerAndTypeId(GetOwningPlayer(udg_Hero_DaP_LibidoTarget), 'e01S'), function Trig_Libido_Func027002002 )
    else
        call DoNothing(  )
    endif
    call PolledWait( 1.00 )
    call ConditionalTriggerExecute( gg_trg_Libido_Dead )
    call PolledWait( 0.10 )
    if ( Trig_Libido_Func031001() ) then
        call CreateNUnitsAtLoc( 1, 'e01S', GetOwningPlayer(udg_Hero_DaP_LibidoTarget), GetPlayerStartLocationLoc(GetOwningPlayer(udg_Hero_DaP_LibidoTarget)), bj_UNIT_FACING )
    else
        call DoNothing(  )
    endif
    call EnableTrigger( GetTriggeringTrigger() )
endfunction

