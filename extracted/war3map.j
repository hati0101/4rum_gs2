//===========================================================================
// Trigger: Charging Shell
//
//     set udg_int = GetConvertedPlayerId(GetOwningPlayer(GetAttackedUnitBJ()))
//===========================================================================
function Trig_Charging_Shell_Func001C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'Orex' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetTriggerUnit()) == 'O006' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Charging_Shell_Func011C takes nothing returns boolean
    if ( ( GetSpellAbilityId() == 'A0MC' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A007' ) ) then
        return true
    endif
    if ( ( GetSpellAbilityId() == 'A00N' ) ) then
        return true
    endif
    return false
endfunction

function Trig_Charging_Shell_Conditions takes nothing returns boolean
    if ( not Trig_Charging_Shell_Func001C() ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A0WY', GetTriggerUnit()) >= 1 ) ) then
        return false
    endif
    if ( not Trig_Charging_Shell_Func011C() ) then
        return false
    endif
    return true
endfunction

function Trig_Charging_Shell_Func002Func002C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A00N' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charging_Shell_Func002Func003C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0MC' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charging_Shell_Func002Func004C takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A007' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charging_Shell_Func002C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetTriggerUnit(), 'B0C9') == true ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R0AT', GetOwningPlayer(GetTriggerUnit())) >= 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Charging_Shell_Actions takes nothing returns nothing
    if ( Trig_Charging_Shell_Func002C() ) then
        call PolledWait( 0.10 )
        if ( Trig_Charging_Shell_Func002Func002C() ) then
            call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) + ( ( 0.40 + ( 0.10 * I2R(GetUnitAbilityLevelSwapped('A0WY', GetTriggerUnit())) ) ) * ( 60.00 + ( 10.00 * I2R(GetUnitAbilityLevelSwapped('A00N', GetTriggerUnit())) ) ) ) ) )
        else
        endif
        if ( Trig_Charging_Shell_Func002Func003C() ) then
            call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) + ( ( 0.40 + ( 0.10 * I2R(GetUnitAbilityLevelSwapped('A0WY', GetTriggerUnit())) ) ) * ( 70.00 + ( 10.00 * I2R(GetUnitAbilityLevelSwapped('A0N3', GetTriggerUnit())) ) ) ) ) )
        else
        endif
        if ( Trig_Charging_Shell_Func002Func004C() ) then
            call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) + ( ( 0.40 + ( 0.10 * I2R(GetUnitAbilityLevelSwapped('A0WY', GetTriggerUnit())) ) ) * ( 30.00 + ( 10.00 * I2R(GetUnitAbilityLevelSwapped('A007', GetTriggerUnit())) ) ) ) ) )
        else
        endif
        call TextTag(  "연료 공급!" , GetTriggerUnit(), 10 , 0, 0, 100, 3 )
    else
    endif
    call PolledWait( 0.10 )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0M1', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0M1', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0WY', GetTriggerUnit()) )
    call IssueImmediateOrderBJ( GetLastCreatedUnit(), "roar" )
endfunction

