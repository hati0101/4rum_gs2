function Trig_Blood_Strike_DM_Actions takes nothing returns nothing
    set udg_Hero_FuF_BS_Damage = ( R2I(GetEventDamage()) / 2 )
    set udg_Hero_FuF_BS_Target = null
    set udg_Hero_FuF_BS_Loc = GetUnitLoc(GetTriggerUnit())
    if ( Trig_Blood_Strike_DM_Func010C() ) then
        call DisableTrigger( GetTriggeringTrigger() )
        call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "war3mapImported\\blood.mdx" )
        call DestroyEffectBJ( udg_Hero_FuF_BS_SFX )
        set udg_Hero_FuF_BS_SFX = GetLastCreatedEffectBJ()
        call SetUnitLifeBJ( GetEventDamageSource(), ( ( 20.00 + ( 20.00 * I2R(GetUnitAbilityLevelSwapped('A0KR', GetEventDamageSource())) ) ) + GetUnitStateSwap(UNIT_STATE_LIFE, GetEventDamageSource()) ) )
