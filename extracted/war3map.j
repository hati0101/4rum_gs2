    if ( not ( GetPlayerTechCountSimple('R013', GetTriggerPlayer()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_PhM_Skill_Effect_Actions takes nothing returns nothing
    if ( Trig_PhM_Skill_Effect_Func001C() ) then
        if ( Trig_PhM_Skill_Effect_Func001Func002C() ) then
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetSpellTargetUnit()), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A10E', GetLastCreatedUnit() )
            if ( Trig_PhM_Skill_Effect_Func001Func002Func008C() ) then
                call SetUnitAbilityLevelSwapped( 'A10E', GetLastCreatedUnit(), ( 1 + ( 0 + GetUnitAbilityLevelSwapped('A023', GetTriggerUnit()) ) ) )
                call AddSpecialEffectLocBJ( GetSpellTargetLoc(), "Abilities\\Spells\\Human\\FlameStrike\\FlameStrike1.mdl" )
                call d_effect( GetLastCreatedEffectBJ(), 3.00 )
            else
                call SetUnitAbilityLevelSwapped( 'A10E', GetLastCreatedUnit(), 1 )
            endif
            call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
        else
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetSpellTargetLoc(), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A10E', GetLastCreatedUnit() )
            call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
        endif
    else
    endif
    if ( Trig_PhM_Skill_Effect_Func002C() ) then
        call StartTimerBJ( udg_Hero_PhM_TelTimer, false, ( 2.50 - ( 0.50 * I2R(GetPlayerTechCountSimple('R014', GetOwningPlayer(GetTriggerUnit()))) ) ) )
        set udg_Hero_PhM_TeleLoc = GetSpellTargetLoc()
        if ( Trig_PhM_Skill_Effect_Func002Func003C() ) then
            call AddSpecialEffectLocBJ( udg_Hero_PhM_TeleLoc, "war3mapImported\\FlameStrikeTarget.mdx" )
            call d_effect( GetLastCreatedEffectBJ(), 3.00 )
        else
        endif
    else
    endif
    if ( Trig_PhM_Skill_Effect_Func003C() ) then
        set udg_Hero_PhM = GetTriggerUnit()
        call RemoveUnit( udg_Hero_PhM_Spunit1 )
        call RemoveUnit( udg_Hero_PhM_Spunit2 )
        call RemoveUnit( udg_Hero_PhM_Spunit3 )
        call CreateNUnitsAtLocFacingLocBJ( 1, 'hphx', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 120.00, ( GetUnitFacing(GetTriggerUnit()) - 180.00 )), GetUnitLoc(GetTriggerUnit()) )
        call UnitApplyTimedLifeBJ( 20.00, 'BTLF', GetLastCreatedUnit() )
        set udg_Hero_PhM_Spunit1 = GetLastCreatedUnit()
        call AddSpecialEffectLocBJ( GetUnitLoc(GetLastCreatedUnit()), "Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosTarget.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call CreateNUnitsAtLocFacingLocBJ( 1, 'hphx', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 120.00, ( GetUnitFacing(GetTriggerUnit()) - 140.00 )), GetUnitLoc(GetTriggerUnit()) )
        call UnitApplyTimedLifeBJ( 20.00, 'BTLF', GetLastCreatedUnit() )
        set udg_Hero_PhM_Spunit2 = GetLastCreatedUnit()
        call AddSpecialEffectLocBJ( GetUnitLoc(GetLastCreatedUnit()), "Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosTarget.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call CreateNUnitsAtLocFacingLocBJ( 1, 'hphx', GetOwningPlayer(GetTriggerUnit()), PolarProjectionBJ(GetUnitLoc(GetTriggerUnit()), 120.00, ( GetUnitFacing(GetTriggerUnit()) - 220.00 )), GetUnitLoc(GetTriggerUnit()) )
        call UnitApplyTimedLifeBJ( 20.00, 'BTLF', GetLastCreatedUnit() )
        set udg_Hero_PhM_Spunit3 = GetLastCreatedUnit()
        call AddSpecialEffectLocBJ( GetUnitLoc(GetLastCreatedUnit()), "Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosTarget.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call StartTimerBJ( udg_Hero_PhM_SpTimer, true, 0.03 )
    else
    endif
    if ( Trig_PhM_Skill_Effect_Func004C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetSpellAbilityUnit()), GetUnitLoc(GetSpellTargetUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A026', GetLastCreatedUnit() )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "faeriefire", GetSpellTargetUnit() )
    else
    endif
endfunction

