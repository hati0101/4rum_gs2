    set gg_trg_GoT_Special_3 = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_GoT_Special_3, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_GoT_Special_3, Condition( function Trig_GoT_Special_3_Conditions ) )
    call TriggerAddAction( gg_trg_GoT_Special_3, function Trig_GoT_Special_3_Actions )
