//===========================================================================
// Trigger: Etherial
//===========================================================================
function Trig_Etherial_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0OF' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Etherial_Actions takes nothing returns nothing
    call UnitRemoveBuffsBJ( bj_REMOVEBUFFS_NEGATIVE, GetSpellTargetUnit() )
    set udg_Item_Target = GetSpellTargetUnit()
    call ConditionalTriggerExecute( gg_trg_Etherial_Check )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetSpellTargetUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0B6', GetLastCreatedUnit() )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "banish", GetSpellTargetUnit() )
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetSpellTargetUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A0N0', GetLastCreatedUnit() )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "doom", GetSpellTargetUnit() )
endfunction

//===========================================================================
function InitTrig_Etherial takes nothing returns nothing
    set gg_trg_Etherial = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Etherial, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Etherial, Condition( function Trig_Etherial_Conditions ) )
    call TriggerAddAction( gg_trg_Etherial, function Trig_Etherial_Actions )
endfunction

//===========================================================================
// Trigger: Etherial Check
//===========================================================================
function Trig_Etherial_Check_Actions takes nothing returns nothing
    local unit u = udg_Item_Target
    loop
    exitwhen UnitHasBuffBJ(u, 'B094') == TRUE
    call PolledWait( 0.10 )
    endloop
    call UnitAddAbilityBJ( 'Avul', u )
    loop
    exitwhen UnitHasBuffBJ(u, 'B094') != TRUE
    call PolledWait( 0.10 )
    endloop
    set udg_Item_Target = u
    call UnitRemoveAbilityBJ( 'Avul', udg_Item_Target )
endfunction

//===========================================================================
function InitTrig_Etherial_Check takes nothing returns nothing
    set gg_trg_Etherial_Check = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Etherial_Check, function Trig_Etherial_Check_Actions )
endfunction

