function InitTrig_Full_Inv_Get takes nothing returns nothing
    set gg_trg_Full_Inv_Get = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Full_Inv_Get, EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER )
    call TriggerAddCondition( gg_trg_Full_Inv_Get, Condition( function Trig_Full_Inv_Get_Conditions ) )
    call TriggerAddAction( gg_trg_Full_Inv_Get, function Trig_Full_Inv_Get_Actions )
endfunction

