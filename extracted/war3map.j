// Trigger: Pick Blader
//===========================================================================
function Trig_Pick_Blader_Conditions takes nothing returns boolean
    if ( not ( GetHeroSkillPoints(GetTriggerUnit()) == 2 ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) == 'Npbm' ) ) then
        return false
    endif
    if ( not ( GetHeroLevel(GetTriggerUnit()) == 2 ) ) then
        return false
    endif
    if ( not ( UnitHasItemOfTypeBJ(GetTriggerUnit(), 'I00T') == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pick_Blader_Func011A takes nothing returns nothing
    call ReplaceUnitBJ( GetEnumUnit(), 'n01M', bj_UNIT_STATE_METHOD_MAXIMUM )
    set udg_SpeBuilding = GetLastReplacedUnitBJ()
    call TriggerExecute( gg_trg_Skill_Remove )
endfunction

function Trig_Pick_Blader_Actions takes nothing returns nothing
    call MultiboardSetItemStyleBJ( GetLastCreatedMultiboard(), 1, ( udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + 1 ), false, false )
    call MultiboardSetItemStyleBJ( GetLastCreatedMultiboard(), 1, ( udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + 1 ), false, true )
    call MultiboardSetItemIconBJ( GetLastCreatedMultiboard(), 1, ( udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + 1 ), "ReplaceableTextures\\CommandButtons\\BTNFireBrewmaster.blp" )
    call ReplaceUnitBJ( GetTriggerUnit(), 'N01L', bj_UNIT_STATE_METHOD_ABSOLUTE )
    set udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = GetLastReplacedUnitBJ()
    call AddSpecialEffectTargetUnitBJ( "origin", GetLastReplacedUnitBJ(), "Abilities\\Spells\\Other\\Awaken\\Awaken.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call UnitAddAbilityBJ( 'A00F', GetLastReplacedUnitBJ() )
    call UnitMakeAbilityPermanent( GetLastReplacedUnitBJ(), true, 'A00F' )
    call ForGroupBJ( GetUnitsOfPlayerAndTypeId(GetOwningPlayer(GetTriggerUnit()), 'n020'), function Trig_Pick_Blader_Func011A )
endfunction

