//===========================================================================
function Trig_Hell_Moving_Func001Func002C takes nothing returns boolean
    if ( not ( udg_Hero_LOI_UltiIN_1 <= 230 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hell_Moving_Func001Func005C takes nothing returns boolean
    if ( not ( udg_Hero_LOI_UltiIN_1 == 33 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hell_Moving_Func001Func006C takes nothing returns boolean
    if ( not ( udg_Hero_LOI_UltiIN_1 == 75 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hell_Moving_Func001Func007C takes nothing returns boolean
    if ( not ( udg_Hero_LOI_UltiIN_1 == 117 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hell_Moving_Func001Func008C takes nothing returns boolean
    if ( not ( udg_Hero_LOI_UltiIN_1 == 159 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hell_Moving_Func001Func009C takes nothing returns boolean
    if ( not ( udg_Hero_LOI_UltiIN_1 == 201 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hell_Moving_Func001Func010C takes nothing returns boolean
    if ( not ( udg_Hero_LOI_UltiIN_1 >= 290 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hell_Moving_Func001C takes nothing returns boolean
    if ( not ( IsUnitAliveBJ(udg_Hero_LOI_Unit) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hell_Moving_Actions takes nothing returns nothing
    if ( Trig_Hell_Moving_Func001C() ) then
        set udg_Hero_LOI_UltiIN_1 = ( udg_Hero_LOI_UltiIN_1 + 3 )
        if ( Trig_Hell_Moving_Func001Func002C() ) then
            call SetUnitScalePercent( udg_Hero_LOI_Unit, ( 140.00 + I2R(udg_Hero_LOI_UltiIN_1) ), ( 140.00 + I2R(udg_Hero_LOI_UltiIN_1) ), ( 140.00 + I2R(udg_Hero_LOI_UltiIN_1) ) )
        else
        endif
        call SetUnitPositionLocFacingBJ( udg_Hero_LOI_Unit, PolarProjectionBJ(GetUnitLoc(udg_Hero_LOI_Unit), 29.50, GetUnitFacing(udg_Hero_LOI_Unit)), GetUnitFacing(udg_Hero_LOI_Unit) )
        if ( Trig_Hell_Moving_Func001Func005C() ) then
            set udg_Hero_LOI_UltiIN_2 = 1
            call TriggerRegisterUnitInRangeSimple( gg_trg_Hell_Explode, 130.00, udg_Hero_LOI_Unit )
        else
        endif
        if ( Trig_Hell_Moving_Func001Func006C() ) then
            set udg_Hero_LOI_UltiIN_2 = 2
            call TriggerRegisterUnitInRangeSimple( gg_trg_Hell_Explode, 160.00, udg_Hero_LOI_Unit )
        else
        endif
        if ( Trig_Hell_Moving_Func001Func007C() ) then
            set udg_Hero_LOI_UltiIN_2 = 3
            call TriggerRegisterUnitInRangeSimple( gg_trg_Hell_Explode, 190.00, udg_Hero_LOI_Unit )
        else
        endif
        if ( Trig_Hell_Moving_Func001Func008C() ) then
            set udg_Hero_LOI_UltiIN_2 = 4
            call TriggerRegisterUnitInRangeSimple( gg_trg_Hell_Explode, 220.00, udg_Hero_LOI_Unit )
        else
        endif
        if ( Trig_Hell_Moving_Func001Func009C() ) then
            set udg_Hero_LOI_UltiIN_2 = 5
            call TriggerRegisterUnitInRangeSimple( gg_trg_Hell_Explode, 250.00, udg_Hero_LOI_Unit )
        else
        endif
        if ( Trig_Hell_Moving_Func001Func010C() ) then
            call TriggerExecute( gg_trg_Hell_Explode )
        else
        endif
    else
        call DisableTrigger( GetTriggeringTrigger() )
    endif
endfunction

//===========================================================================
function InitTrig_Hell_Moving takes nothing returns nothing
    set gg_trg_Hell_Moving = CreateTrigger(  )
    call DisableTrigger( gg_trg_Hell_Moving )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Hell_Moving, 0.03 )
    call TriggerAddAction( gg_trg_Hell_Moving, function Trig_Hell_Moving_Actions )
endfunction

//===========================================================================
// Trigger: Hell Explode
//===========================================================================
function Trig_Hell_Explode_Conditions takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A00O', GetTriggerUnit()) == 0 ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'u00L' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'n00Y' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'o00K' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'o000' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'o00L' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'o00S' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'o001' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'o002' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'o003' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'o004' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'o00U' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'n02P' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'n02O' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'n02Q' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'n02N' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetEnteringUnit()) != 'n004' ) ) then
        return false
    endif
    if ( not ( GetUnitStateSwap(UNIT_STATE_LIFE, GetEnteringUnit()) >= 1.00 ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('Avul', GetEnteringUnit()) == 0 ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_STRUCTURE) == false ) ) then
        return false
    endif
    if ( not ( IsPlayerEnemy(GetOwningPlayer(udg_Hero_LOI_Hero), GetOwningPlayer(GetEnteringUnit())) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hell_Explode_Func022C takes nothing returns boolean
    if GetEnteringUnit() == null then
        return false
    endif
    if ( not ( udg_Hero_LOI_Limit < ( GetUnitAbilityLevelSwapped('A0ZS', udg_Hero_LOI_Hero) + ( 2 * GetPlayerTechCountSimple('R089', GetOwningPlayer(udg_Hero_LOI_Hero)) ) ) ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetEnteringUnit()) != Player(bj_PLAYER_NEUTRAL_VICTIM) ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetEnteringUnit()) != Player(PLAYER_NEUTRAL_AGGRESSIVE) ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'o00N' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'o00O' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'o00P' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'u000' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'u001' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'u002' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'u005' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'u006' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'u007' ) ) then
        return false
    endif
    if ( not ( GetUnitTypeId(GetTriggerUnit()) != 'n01U' ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetEnteringUnit(), UNIT_TYPE_HERO) == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Hell_Explode_Actions takes nothing returns nothing
    if ( Trig_Hell_Explode_Func022C() ) then
        set udg_Hero_LOI_Limit = ( udg_Hero_LOI_Limit + 1 )
        call UnitAddAbilityBJ( 'A00O', GetTriggerUnit() )
        call UnitDamageTargetBJ( udg_Hero_LOI_Hero, GetTriggerUnit(), ( ( -100.00 + ( 200.00 * I2R(GetUnitAbilityLevelSwapped('A0ZS', udg_Hero_LOI_Hero)) ) ) + I2R(( udg_Hero_LOI_UltiIN_2 * 100 )) ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
        call AddSpecialEffectLocBJ( GetUnitLoc(GetTriggerUnit()), "Abilities\\Weapons\\GyroCopter\\GyroCopterMissile.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        return
    else
    endif
    call DisableTrigger( GetTriggeringTrigger() )
    call ExplodeUnitBJ( udg_Hero_LOI_Unit )
    call CreateTextTagLocBJ( ( udg_Colors[1] + ( I2S(( -100 + ( ( 200 * GetUnitAbilityLevelSwapped('A0ZS', udg_Hero_LOI_Hero) ) + ( 100 * udg_Hero_LOI_UltiIN_2 ) ) )) + "!!" ) ), GetUnitLoc(udg_Hero_LOI_Unit), 0, 20.00, 100.00, 100.00, 100.00, 0 )
    call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
    call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 2.50 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 65.00, 90 )
    call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_LOI_Unit), "Objects\\Spawnmodels\\Human\\HCancelDeath\\HCancelDeath.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call AddSpecialEffectLocBJ( GetUnitLoc(udg_Hero_LOI_Unit), "Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call CreateNUnitsAtLoc( 1, 'e01O', GetOwningPlayer(udg_Hero_LOI_Hero), GetUnitLoc(udg_Hero_LOI_Unit), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 3.00, 'BTLF', GetLastCreatedUnit() )
    call SetUnitAbilityLevelSwapped( 'A0LO', GetLastCreatedUnit(), udg_Hero_LOI_UltiIN_2 )
    call IssueImmediateOrderBJ( GetLastCreatedUnit(), "thunderclap" )
    set bj_forLoopAIndex = 1
    set bj_forLoopAIndexEnd = ( 4 + udg_Hero_LOI_UltiIN_2 )
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call CreateNUnitsAtLoc( 1, 'e01H', GetOwningPlayer(udg_Hero_LOI_Hero), GetRandomLocInRect(RectFromCenterSizeBJ(GetUnitLoc(udg_Hero_LOI_Unit), ( 100.00 + I2R(udg_Hero_LOI_UltiIN_1) ), ( 100.00 + I2R(udg_Hero_LOI_UltiIN_1) ))), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( GetRandomReal(6.00, 8.00), 'BTLF', GetLastCreatedUnit() )
        call TriggerRegisterUnitInRangeSimple( gg_trg_BurningFlame_Move, 125.00, GetLastCreatedUnit() )
        set bj_forLoopAIndex = bj_forLoopAIndex + 1
    endloop
    call TriggerSleepAction( 1.00 )
    call UnitRemoveAbilityBJ( 'A00O', GetTriggerUnit() )
endfunction

