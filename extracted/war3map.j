    if ( not ( udg_Hero_GrW_Skillint > 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blazing_Axe_Actions takes nothing returns nothing
    call UnitRemoveBuffBJ( 'B0CO', GetTriggerUnit() )
    if ( Trig_Blazing_Axe_Func003C() ) then
        set udg_Hero_GrW_Skillint = ( udg_Hero_GrW_Skillint - 1 )
        set bj_wantDestroyGroup=true
        call ForGroupBJ( GetUnitsInRangeOfLocMatching(350.00, GetUnitLoc(GetEventDamageSource()), Condition(function Trig_Blazing_Axe_Func003Func006001003)), function Trig_Blazing_Axe_Func003Func006A )
    else
        set bj_wantDestroyGroup=true
        call ForGroupBJ( GetUnitsInRangeOfLocMatching(250.00, GetUnitLoc(GetEventDamageSource()), Condition(function Trig_Blazing_Axe_Func003Func002001003)), function Trig_Blazing_Axe_Func003Func002A )
    endif
endfunction

