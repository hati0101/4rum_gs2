//===========================================================================
function Trig_Time_of_Death_Damage_Func001Func001A takes nothing returns nothing
    call GroupRemoveUnitSimple( GetEnumUnit(), udg_Hero_ChW_UltiGroup )
    set udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetEnumUnit()))] = 0
    call DestroyEffectBJ( LoadEffectHandleBJ(GetHandleIdBJ(GetEnumUnit()), StringHashBJ("SepiUltiEff"), GetLastCreatedHashtableBJ()) )
endfunction

function Trig_Time_of_Death_Damage_Func001Func004Func006C takes nothing returns boolean
    if ( not ( IsUnitType(GetEnumUnit(), UNIT_TYPE_MAGIC_IMMUNE) == true ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R06J', GetOwningPlayer(udg_Hero_ChW)) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Time_of_Death_Damage_Func001Func004A takes nothing returns nothing
    call UnitDamageTargetBJ( udg_Hero_ChW, GetEnumUnit(), I2R(( udg_Hero_ChW_UltiDmg * udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetEnumUnit()))] )), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC )
    call CreateTextTagLocBJ( ( I2S(( udg_Hero_ChW_UltiDmg * udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetEnumUnit()))] )) + "!" ), GetUnitLoc(GetEnumUnit()), 0, 10.00, 100.00, 20.00, 60.00, 0 )
    call SetTextTagPermanentBJ( GetLastCreatedTextTag(), false )
    call SetTextTagLifespanBJ( GetLastCreatedTextTag(), 1.00 )
    call SetTextTagVelocityBJ( GetLastCreatedTextTag(), 65.00, 90 )
    if ( Trig_Time_of_Death_Damage_Func001Func004Func006C() ) then
        call UnitDamageTargetBJ( udg_Hero_ChW, GetEnumUnit(), ( 0.50 * I2R(( udg_Hero_ChW_UltiDmg * ( udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetEnumUnit()))] * ( 8 - udg_Hero_ChW_UltiCount ) ) )) ), ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL )
        set udg_Hero_ChW_Curse[GetConvertedPlayerId(GetOwningPlayer(GetEnumUnit()))] = 0
        call DestroyEffectBJ( LoadEffectHandleBJ(GetHandleIdBJ(GetEnumUnit()), StringHashBJ("SepiUltiEff"), GetLastCreatedHashtableBJ()) )
        call GroupRemoveUnitSimple( GetEnumUnit(), udg_Hero_ChW_UltiGroup )
        call AddSpecialEffectTargetUnitBJ( "origin", GetEnumUnit(), "war3mapImported\\DarkPillar.mdx" )
        call d_effect(GetLastCreatedEffectBJ(),0.7)
    else
    endif
endfunction

function Trig_Time_of_Death_Damage_Func001C takes nothing returns boolean
    if ( not ( udg_Hero_ChW_UltiCount < 7 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Time_of_Death_Damage_Actions takes nothing returns nothing
    if ( Trig_Time_of_Death_Damage_Func001C() ) then
        set udg_Hero_ChW_UltiCount = ( udg_Hero_ChW_UltiCount + 1 )
        call StartTimerBJ( udg_Hero_ChW_UltiTimer, false, 1.00 )
        call ForGroupBJ( udg_Hero_ChW_UltiGroup, function Trig_Time_of_Death_Damage_Func001Func004A )
    else
        call ForGroupBJ( udg_Hero_ChW_UltiGroup, function Trig_Time_of_Death_Damage_Func001Func001A )
    endif
endfunction

