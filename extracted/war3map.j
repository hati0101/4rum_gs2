//*  Destructable Objects
//*
//***************************************************************************

function CreateAllDestructables takes nothing returns nothing
    local destructable d
    local trigger t
    local real life
    set d = BlzCreateDestructableWithSkinPitchRollColor( 'BTtw', -4800.0, 5312.0, 270.000, 0.000, 0.000, 1.125, 8, 'BTtw', ConvertPlayerColor(24) )
    call SetDestructableVertexColor( d, 255, 255, 255, 255 )
    set t = CreateTrigger(  )
    call TriggerRegisterDeathEvent( t, d )
    call TriggerAddAction( t, function SaveDyingWidget )
    call TriggerAddAction( t, function Doodad001643_DropItems )
    set d = BlzCreateDestructableWithSkinPitchRollColor( 'ZTtw', 5056.0, -5312.0, 270.000, 0.000, 0.000, 0.793, 9, 'ZTtw', ConvertPlayerColor(24) )
    call SetDestructableVertexColor( d, 255, 255, 255, 255 )
    set t = CreateTrigger(  )
    call TriggerRegisterDeathEvent( t, d )
    call TriggerAddAction( t, function SaveDyingWidget )
    call TriggerAddAction( t, function Doodad003445_DropItems )
endfunction

