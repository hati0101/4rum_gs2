function Trig_LoN_Skill_Effect_Actions takes nothing returns nothing
    if ( Trig_LoN_Skill_Effect_Func001C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetSpellAbilityUnit()), GetUnitLoc(GetSpellAbilityUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0ES', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0ES', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0EI', GetTriggerUnit()) )
        call IssuePointOrderLocBJ( GetLastCreatedUnit(), "silence", GetUnitLoc(GetTriggerUnit()) )
        if ( Trig_LoN_Skill_Effect_Func001Func006C() ) then
            call ForGroupBJ( GetUnitsInRectAll(GetPlayableMapRect()), function Trig_LoN_Skill_Effect_Func001Func006Func001A )
        else
        endif
    else
    endif
    if ( Trig_LoN_Skill_Effect_Func002C() ) then
        call SetUnitManaBJ( GetTriggerUnit(), ( GetUnitStateSwap(UNIT_STATE_MANA, GetTriggerUnit()) - 20.00 ) )
        call CreateNUnitsAtLoc( 1, 'ewsp', GetTriggerPlayer(), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0FL', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0FL', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0EJ', GetTriggerUnit()) )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "rejuvination", GetSpellTargetUnit() )
    else
