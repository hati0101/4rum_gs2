// Trigger: Blazing Rider Damage
//===========================================================================
function Trig_Blazing_Rider_Damage_Conditions takes nothing returns boolean
    if ( not ( GetAttacker() == udg_Hero_FlB ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blazing_Rider_Damage_Func001Func001C takes nothing returns boolean
    if ( not ( UnitHasBuffBJ(GetAttacker(), 'B005') == true ) ) then
        return false
    endif
    if ( not ( GetAttackedUnitBJ() != udg_Hero_FlB_ChargeTarget ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blazing_Rider_Damage_Func001Func008C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R07B', GetOwningPlayer(GetAttacker())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blazing_Rider_Damage_Func001C takes nothing returns boolean
    if ( not ( GetAttackedUnitBJ() == udg_Hero_FlB_ChargeTarget ) ) then
        return false
    endif
    return true
endfunction

function Trig_Blazing_Rider_Damage_Actions takes nothing returns nothing
    if ( Trig_Blazing_Rider_Damage_Func001C() ) then
        call SetUnitAnimation( GetAttacker(), "slam" )
        call UnitDamageTargetBJ( GetAttacker(), GetAttackedUnitBJ(), ( ( ( 70.00 * I2R(GetUnitAbilityLevelSwapped('A0Z4', udg_Hero_FlB)) ) + 30.00 ) + 0.00 ), ATTACK_TYPE_NORMAL, DAMAGE_TYPE_DIVINE )
        call AddSpecialEffectLocBJ( GetUnitLoc(GetAttackedUnitBJ()), "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call StartTimerBJ( udg_Hero_FlB_ChargeDur, false, 0.10 )
        // ===================================================
        if ( Trig_Blazing_Rider_Damage_Func001Func008C() ) then
            call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetAttacker()), GetUnitLoc(GetAttackedUnitBJ()), bj_UNIT_FACING )
            call UnitApplyTimedLifeBJ( 2.00, 'BTLF', GetLastCreatedUnit() )
            call UnitAddAbilityBJ( 'A0VH', GetLastCreatedUnit() )
            call IssueTargetOrderBJ( GetLastCreatedUnit(), "creepthunderbolt", GetAttackedUnitBJ() )
        else
        endif
        // ===================================================
    else
        if ( Trig_Blazing_Rider_Damage_Func001Func001C() ) then
            call StartTimerBJ( udg_Hero_FlB_ChargeDur, false, 0.01 )
        else
        endif
    endif
endfunction

