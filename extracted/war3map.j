    call TriggerRegisterPlayerChatEvent( gg_trg_Mode_SP, Player(1), "-apsp", true )
    call TriggerRegisterPlayerChatEvent( gg_trg_Mode_SP, Player(1), "-spap", true )
    call TriggerRegisterPlayerChatEvent( gg_trg_Mode_SP, Player(1), "-메네", true )
    call TriggerRegisterPlayerChatEvent( gg_trg_Mode_SP, Player(1), "-네메", true )
    call TriggerAddCondition( gg_trg_Mode_SP, Condition( function Trig_Mode_SP_Conditions ) )
    call TriggerAddAction( gg_trg_Mode_SP, function Trig_Mode_SP_Actions )
endfunction


