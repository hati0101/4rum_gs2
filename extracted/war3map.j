    if ( not ( UnitHasBuffBJ(GetEventDamageSource(), 'B04O') == true ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A138', GetEventDamageSource()) > 2 ) ) then
