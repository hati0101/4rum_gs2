//===========================================================================
// Trigger: Gold Give
//===========================================================================
function Trig_Gold_Give_Func003C takes nothing returns boolean
    if ( not ( udg_GoldBonusTimer[1] > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Gold_Give_Func004C takes nothing returns boolean
    if ( not ( udg_GoldBonusTimer[2] > 0 ) ) then
        return false
    endif
    return true
endfunction

function GS2_Ver1_Income takes integer base, boolean bonus returns integer
    local real multiplier = 1.10
    if ( TimerGetElapsed(udg_MBTime) >= 1200.00 ) then
        set multiplier = 1.25
    elseif ( TimerGetElapsed(udg_MBTime) >= 600.00 ) then
        set multiplier = 1.15
    endif
    if TimerGetElapsed(udg_MBTime) < 600.00 and base == 21 then
        set multiplier = 1.25
    endif
    if bonus then
        set base = base + 5
    endif
    return R2I(I2R(base) * multiplier + 0.50)
endfunction

function Trig_Gold_Give_Actions takes nothing returns nothing
    local integer i = 2
    loop
        exitwhen i > 6
        call AdjustPlayerStateBJ( GS2_Ver1_Income(udg_GiveGoldAmount[1], udg_GoldBonusTimer[1] > 0), udg_SP_Player[i], PLAYER_STATE_RESOURCE_GOLD )
        set i = i + 1
    endloop
    set i = 8
    loop
        exitwhen i > 12
        call AdjustPlayerStateBJ( GS2_Ver1_Income(udg_GiveGoldAmount[2], udg_GoldBonusTimer[2] > 0), udg_SP_Player[i], PLAYER_STATE_RESOURCE_GOLD )
        set i = i + 1
    endloop
endfunction

//===========================================================================
function InitTrig_Gold_Give takes nothing returns nothing
    set gg_trg_Gold_Give = CreateTrigger(  )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Gold_Give, udg_Goldgive )
    call TriggerAddAction( gg_trg_Gold_Give, function Trig_Gold_Give_Actions )
endfunction

