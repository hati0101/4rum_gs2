    set gg_trg_Silent_Area = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Silent_Area, EVENT_PLAYER_UNIT_SPELL_EFFECT )
    call TriggerAddCondition( gg_trg_Silent_Area, Condition( function Trig_Silent_Area_Conditions ) )
    call TriggerAddAction( gg_trg_Silent_Area, function Trig_Silent_Area_Actions )
endfunction

//===========================================================================
// Trigger: Silent Area Loop
//===========================================================================
function Trig_Silent_Area_Loop_Func002Func001002003001 takes nothing returns boolean
    return ( IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) == true )
endfunction

function Trig_Silent_Area_Loop_Func002Func001002003002 takes nothing returns boolean
    return ( IsUnitEnemy(GetFilterUnit(), GetOwningPlayer(udg_Hero_Sil)) == true )
endfunction

function Trig_Silent_Area_Loop_Func002Func001002003 takes nothing returns boolean
    return GetBooleanAnd( Trig_Silent_Area_Loop_Func002Func001002003001(), Trig_Silent_Area_Loop_Func002Func001002003002() )
endfunction

function Trig_Silent_Area_Loop_Func002Func002A takes nothing returns nothing
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetEnumUnit()), GetUnitLoc(GetEnumUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'A01A', GetLastCreatedUnit() )
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "soulburn", GetEnumUnit() )
endfunction

function Trig_Silent_Area_Loop_Func002C takes nothing returns boolean
    if ( not ( udg_Hero_Sil_UltiCount > 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Silent_Area_Loop_Actions takes nothing returns nothing
    if ( Trig_Silent_Area_Loop_Func002C() ) then
        set udg_Hero_Sil_UltiGroup = GetUnitsInRangeOfLocMatching(500.00, udg_Hero_Sil_UltiPoint, Condition(function Trig_Silent_Area_Loop_Func002Func001002003))
        call ForGroupBJ( udg_Hero_Sil_UltiGroup, function Trig_Silent_Area_Loop_Func002Func002A )
        call StartTimerBJ( udg_Hero_Sil_UltiTimer, false, 0.20 )
        set udg_Hero_Sil_UltiCount = ( udg_Hero_Sil_UltiCount - 1 )
        call GroupClear( udg_Hero_Sil_UltiGroup )
    else
    endif
endfunction

//===========================================================================
function InitTrig_Silent_Area_Loop takes nothing returns nothing
    set gg_trg_Silent_Area_Loop = CreateTrigger(  )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Silent_Area_Loop, udg_Hero_Sil_UltiTimer )
    call TriggerAddAction( gg_trg_Silent_Area_Loop, function Trig_Silent_Area_Loop_Actions )
endfunction

