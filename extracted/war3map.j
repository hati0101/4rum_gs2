function InitTrig_Tartaros_Come_on takes nothing returns nothing
    set gg_trg_Tartaros_Come_on = CreateTrigger(  )
    call TriggerAddCondition( gg_trg_Tartaros_Come_on, Condition( function Trig_Tartaros_Come_on_Conditions ) )
    call TriggerAddAction( gg_trg_Tartaros_Come_on, function Trig_Tartaros_Come_on_Actions )
endfunction

