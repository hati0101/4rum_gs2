//===========================================================================
function Trig_Inrage_Start_Conditions takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A0RE', GetTriggerUnit()) >= 1 ) ) then
        return false
    endif
    if ( not ( GetEventDamage() >= 5.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Inrage_Start_Func003C takes nothing returns boolean
    if ( not ( udg_Hero_TrB_InrageDamage >= 50.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Inrage_Start_Func004C takes nothing returns boolean
    if ( not ( udg_Hero_TrB_Inrageint >= ( 2 + ( 2 * GetUnitAbilityLevelSwapped('A0RE', GetTriggerUnit()) ) ) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Inrage_Start_Func005C takes nothing returns boolean
    if ( not ( udg_Hero_TrB_InrageDamage >= 50.00 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Inrage_Start_Actions takes nothing returns nothing
    call StartTimerBJ( udg_Hero_TrB_InrageTimer, false, 20.00 )
    set udg_Hero_TrB_InrageDamage = ( udg_Hero_TrB_InrageDamage + GetEventDamage() )
    if ( Trig_Inrage_Start_Func003C() ) then
        set udg_Hero_TrB_Inrageint = ( udg_Hero_TrB_Inrageint + ( R2I(udg_Hero_TrB_InrageDamage) / 50 ) )
    else
    endif
    if ( Trig_Inrage_Start_Func004C() ) then
        set udg_Hero_TrB_Inrageint = ( 2 + ( 2 * GetUnitAbilityLevelSwapped('A0RE', GetTriggerUnit()) ) )
    else
    endif
    if ( Trig_Inrage_Start_Func005C() ) then
        call TextTagForce( I2S(udg_Hero_TrB_Inrageint), GetTriggerUnit(), 10, 200, 0, 0, 2, GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit())) )
        set udg_Hero_TrB_InrageDamage = 0.00
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 1.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0IP', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0IP', GetLastCreatedUnit(), udg_Hero_TrB_Inrageint )
        call IssueImmediateOrderBJ( GetLastCreatedUnit(), "battleroar" )
    else
    endif
endfunction

