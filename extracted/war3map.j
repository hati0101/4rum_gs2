function InitTrig_Pack_Horse_Give_Mix takes nothing returns nothing
    set gg_trg_Pack_Horse_Give_Mix = CreateTrigger(  )
    call TriggerAddAction( gg_trg_Pack_Horse_Give_Mix, function Trig_Pack_Horse_Give_Mix_Actions )
endfunction

