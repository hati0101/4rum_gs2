    endif
    if ( not Trig_Lag_Slash_Func007Func002C() ) then
        return false
    endif
    return true
endfunction

function Trig_Lag_Slash_Actions takes nothing returns nothing
    if ( Trig_Lag_Slash_Func001C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 6.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0AU', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0AU', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0D0', GetTriggerUnit()) )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "unholyfrenzy", GetSpellTargetUnit() )
    else
    endif
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 4.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'S00I', GetLastCreatedUnit() )
    if ( Trig_Lag_Slash_Func005C() ) then
        call SetUnitAbilityLevelSwapped( 'S00I', GetLastCreatedUnit(), ( GetUnitAbilityLevelSwapped('A0D0', GetTriggerUnit()) + 4 ) )
        call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
        call SetUnitAbilityLevelSwapped( 'S00I', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0D0', GetTriggerUnit()) )
    endif
    call IssueTargetOrderBJ( GetLastCreatedUnit(), "cripple", GetSpellTargetUnit() )
    if ( Trig_Lag_Slash_Func007C() ) then
        call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetTriggerUnit()), GetUnitLoc(GetTriggerUnit()), bj_UNIT_FACING )
        call UnitApplyTimedLifeBJ( 4.00, 'BTLF', GetLastCreatedUnit() )
        call UnitAddAbilityBJ( 'A0RV', GetLastCreatedUnit() )
        call SetUnitAbilityLevelSwapped( 'A0RV', GetLastCreatedUnit(), GetUnitAbilityLevelSwapped('A0D0', GetTriggerUnit()) )
        call IssueTargetOrderBJ( GetLastCreatedUnit(), "drunkenhaze", GetSpellTargetUnit() )
        call AddSpecialEffectTargetUnitBJ( "origin", GetTriggerUnit(), "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    else
    endif
endfunction

