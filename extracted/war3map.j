//===========================================================================
function Trig_DrA_Special_3_Func009C takes nothing returns boolean
    if ( ( GetUnitTypeId(GetKillingUnitBJ()) == 'Ewrd' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetKillingUnitBJ()) == 'ewsp' ) ) then
        return true
    endif
    if ( ( GetUnitTypeId(GetKillingUnitBJ()) == 'e00Q' ) ) then
        return true
    endif
    return false
endfunction

function Trig_DrA_Special_3_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) == 'Ewrd' ) ) then
        return false
    endif
    if ( not ( IsUnitAliveBJ(udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetKillingUnitBJ()))]) == true ) ) then
        return false
    endif
    if ( not Trig_DrA_Special_3_Func009C() ) then
        return false
    endif
    if ( not ( IsUnitType(GetDyingUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    if ( not ( GetPlayerTechCountSimple('R03A', GetOwningPlayer(GetKillingUnitBJ())) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DrA_Special_3_Func004C takes nothing returns boolean
    if ( not ( TimerGetRemaining(udg_Hero_DrA_Cool[1]) >= 0.05 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DrA_Special_3_Func005C takes nothing returns boolean
    if ( not ( TimerGetRemaining(udg_Hero_DrA_Cool[2]) >= 0.05 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DrA_Special_3_Func006C takes nothing returns boolean
    if ( not ( TimerGetRemaining(udg_Hero_DrA_Cool[3]) >= 0.05 ) ) then
        return false
    endif
    return true
endfunction

function Trig_DrA_Special_3_Actions takes nothing returns nothing
    call CreateNUnitsAtLoc( 1, 'ewsp', GetOwningPlayer(GetKillingUnitBJ()), GetPlayerStartLocationLoc(GetOwningPlayer(GetKillingUnitBJ())), bj_UNIT_FACING )
    call UnitApplyTimedLifeBJ( 45.00, 'BTLF', GetLastCreatedUnit() )
    call UnitAddAbilityBJ( 'S002', GetLastCreatedUnit() )
    if ( Trig_DrA_Special_3_Func004C() ) then
        call UnitRemoveAbilityBJ( 'A0AK', udg_Hero_DrA )
        call UnitAddAbilityBJ( 'A0AK', udg_Hero_DrA )
        call SetUnitAbilityLevelSwapped( 'A0AK', udg_Hero_DrA, GetUnitAbilityLevelSwapped('A013', udg_Hero_DrA) )
    else
    endif
    if ( Trig_DrA_Special_3_Func005C() ) then
        call UnitRemoveAbilityBJ( 'A0AM', udg_Hero_DrA )
        call UnitAddAbilityBJ( 'A0AM', udg_Hero_DrA )
        call SetUnitAbilityLevelSwapped( 'A0AM', udg_Hero_DrA, GetUnitAbilityLevelSwapped('A0A7', udg_Hero_DrA) )
    else
    endif
    if ( Trig_DrA_Special_3_Func006C() ) then
        call UnitRemoveAbilityBJ( 'A06B', udg_Hero_DrA )
        call UnitAddAbilityBJ( 'A06B', udg_Hero_DrA )
        call SetUnitAbilityLevelSwapped( 'A06B', udg_Hero_DrA, GetUnitAbilityLevelSwapped('A0ZT', udg_Hero_DrA) )
    else
    endif
endfunction

