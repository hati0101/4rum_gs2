    set gg_trg_Hallucination = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_Hallucination, EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerAddCondition( gg_trg_Hallucination, Condition( function Trig_Hallucination_Conditions ) )
    call TriggerAddAction( gg_trg_Hallucination, function Trig_Hallucination_Actions )
