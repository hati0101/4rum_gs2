// Trigger: Pick DawnWolf
//===========================================================================
function Trig_Pick_DawnWolf_Conditions takes nothing returns boolean
    if ( not ( GetTimeOfDay() <= 6.00 ) ) then
        return false
    endif
    if ( not ( GetSpellAbilityId() == 'A0GA' ) ) then
        return false
    endif
    if ( not ( GetHeroLevel(GetTriggerUnit()) == 1 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Pick_DawnWolf_Func012A takes nothing returns nothing
    call ReplaceUnitBJ( GetEnumUnit(), 'n03J', bj_UNIT_STATE_METHOD_MAXIMUM )
endfunction

function Trig_Pick_DawnWolf_Actions takes nothing returns nothing
    set udg_Hero_MoW[1] = null
    call MultiboardSetItemStyleBJ( GetLastCreatedMultiboard(), 1, ( udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + 1 ), false, false )
    call MultiboardSetItemStyleBJ( GetLastCreatedMultiboard(), 1, ( udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + 1 ), false, true )
    call MultiboardSetItemIconBJ( GetLastCreatedMultiboard(), 1, ( udg_SP_Number[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] + 1 ), "ReplaceableTextures\\CommandButtons\\BTN_Units_WhiteWolfRellice.blp" )
    call ReplaceUnitBJ( GetTriggerUnit(), 'H016', bj_UNIT_STATE_METHOD_ABSOLUTE )
    set udg_HeroPlayer[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))] = GetLastReplacedUnitBJ()
    call AddSpecialEffectTargetUnitBJ( "origin", GetLastReplacedUnitBJ(), "Abilities\\Spells\\Other\\Awaken\\Awaken.mdl" )
    call DestroyEffectBJ( GetLastCreatedEffectBJ() )
    call UnitAddAbilityBJ( 'A00F', GetLastReplacedUnitBJ() )
    call UnitMakeAbilityPermanent( GetLastReplacedUnitBJ(), true, 'A00F' )
    call ForGroupBJ( GetUnitsOfPlayerAndTypeId(GetOwningPlayer(GetTriggerUnit()), 'n01Y'), function Trig_Pick_DawnWolf_Func012A )
endfunction

