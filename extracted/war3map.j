function Trig_Charge_Conditions takes nothing returns boolean
    if ( not ( GetSpellAbilityId() == 'A0KT' ) ) then
        return false
    endif
    return true
endfunction

function Charged_Sub takes nothing returns nothing
    local real x = 40 * CosBJ(udg_Hero_DrK_ChargeAngle) 
    local real y = 40 * SinBJ(udg_Hero_DrK_ChargeAngle) 
    local unit u = udg_Hero_DrK
    local item i = CreateItemLoc( 'texp', Location(GetUnitX(u)+x, GetUnitY(u)+y) )
    if DistanceBetweenPoints(Location(GetUnitX(u)+x, GetUnitY(u)+y),GetItemLoc(i)) < 20 then
    call SetUnitX(u,GetItemX(i))
    call SetUnitY(u,GetItemY(i))
    call SetUnitAnimation( u, "walk fast" )
    call SetUnitFacing( u, udg_Hero_DrK_ChargeAngle )
    set udg_Hero_DrK_ChargeLoopCount = udg_Hero_DrK_ChargeLoopCount - 1
    else
    set udg_Hero_DrK_ChargeLoopCount = 0
    endif
    call RemoveItem( i )    
    if (udg_Hero_DrK_ChargeLoopCount <= 0 ) or udg_Hero_DrK_ChargeStop then
        set udg_Hero_DrK_ChargeStop = true
        set udg_Hero_DrK_ChargeLoopCount = 0
        call DestroyTimer(GetExpiredTimer())
        call ResetUnitAnimation( u )
        call DestroyEffectBJ( udg_Hero_DrK_ChargeEff )
        call SetUnitAnimation( u, "Attack Slam" )
        call AddSpecialEffectTargetUnitBJ( "origin", u, "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" )
        call DestroyEffectBJ( GetLastCreatedEffectBJ() )
        call DisableTrigger( gg_trg_Charge_Unit )
    endif
endfunction

function Trig_Charge_Actions takes nothing returns nothing
    local timer t = CreateTimer()
    set udg_Hero_DrK_ChargeStop = false
    set udg_Hero_DrK = GetTriggerUnit()
    set udg_Hero_DrK_ChargeAngle = AngleBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetSpellTargetLoc())
    set udg_Hero_DrK_ChargeLoopCount = R2I(( DistanceBetweenPoints(GetUnitLoc(GetTriggerUnit()), GetSpellTargetLoc()) / 40.00 ))
    call AddSpecialEffectTargetUnitBJ( "chest", GetTriggerUnit(), "Abilities\\Spells\\Undead\\DarkSummoning\\DarkSummonMissile.mdl" )
    set udg_Hero_DrK_ChargeEff = GetLastCreatedEffectBJ()
    call TimerStart(t, 0.03, true, function Charged_Sub)
endfunction

